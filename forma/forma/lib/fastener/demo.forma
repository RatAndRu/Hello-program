# Пример: плита со стойками M3 — та же библиотека, но высота и зазор свои.
# Главный приём параметризации без Python:
#   умолчания → переопределение → фигуры → сборка.

включить файл=defaults.f3d
стойка_высота = 14
м3_проход = 3.6
включить файл=shapes.f3d

# плита 90×60×6, стойки по углам с шагом 70×40
плита = box size=[90,60,6]
опоры = array [стойка_м3] mode=grid counts=[2,2,1] spacing=[70,40,0] at=[-35,-20,6]

# пазы под гайки — с нижней стороны плиты (шестигранник 5.5 под ключ)
пазы = array [паз_гайки_м3] mode=grid counts=[2,2,1] spacing=[70,40,0] at=[-35,-20,-2.2]

сборка = union [плита, опоры]
сборка = difference [сборка, пазы]

check сборка size 89.95..90.05 59.95..60.05 19.95..20.05
check сборка watertight
