# Фигуры крепежа. Читают числа из defaults.f3d; сцена может переопределить
# любое число МЕЖДУ двумя включениями — тогда фигуры получатся другие.
#
# Имена с суффиксом _резец — вычитаемые тела (сверло, паз), их не видно в отчёте,
# пока сцена сама не вычтет. Остальные — готовые детали, их можно ставить
# через place/array или объединять.

# --- винт M3: проходное отверстие и зенковка под головку ---------------------
сверло_м3 = cylinder radius=м3_проход/2 height=стойка_высота+2 segments=32 at=[0,0,-1]
зенковка_м3 = cylinder radius=м3_головка/2 height=1.2 segments=32 at=[0,0,стойка_высота]

# --- стойка под винт M3 ------------------------------------------------------
стойка_м3 = cylinder radius=м3_проход/2+стойка_стенка height=стойка_высота segments=32
стойка_м3 = difference [стойка_м3, сверло_м3]

# --- паз под гайку M3 (шестигранник) ----------------------------------------
# Шестигранник строится профилем: `cylinder` не умеет 6 сегментов (минимум 8),
# а вершины задаются через описанный радиус и cos30 = 0.8660254.
гайка_k = 0.8660254
паз_гайки_м3 = extrude profile=[[м3_гайка_r,0],[м3_гайка_r/2,м3_гайка_r*гайка_k],[-м3_гайка_r/2,м3_гайка_r*гайка_k],[-м3_гайка_r,0],[-м3_гайка_r/2,-м3_гайка_r*гайка_k],[м3_гайка_r/2,-м3_гайка_r*гайка_k]] height=м3_гайка_высота

# --- винт M4: то же самое, другие числа -------------------------------------
сверло_м4 = cylinder radius=м4_проход/2 height=стойка_высота+2 segments=32 at=[0,0,-1]
стойка_м4 = cylinder radius=м4_проход/2+стойка_стенка height=стойка_высота segments=32
стойка_м4 = difference [стойка_м4, сверло_м4]
паз_гайки_м4 = extrude profile=[[м4_гайка_r,0],[м4_гайка_r/2,м4_гайка_r*гайка_k],[-м4_гайка_r/2,м4_гайка_r*гайка_k],[-м4_гайка_r,0],[-м4_гайка_r/2,-м4_гайка_r*гайка_k],[м4_гайка_r/2,-м4_гайка_r*гайка_k]] height=м4_гайка_высота
