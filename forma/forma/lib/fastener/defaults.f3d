# Таблица размеров крепежа (мм). Правьте только этот файл — фигуры подстроятся.
#
# Порядок подключения в сценарии:
#   включить файл=defaults.f3d      ← числа по умолчанию
#   м3_проход = 3.6                 ← необязательное переопределение
#   включить файл=shapes.f3d        ← фигуры, уже с вашими числами
#
# Числа: ISO 273 (средний зазор), ISO 4762 (головка цилиндрическая),
# ISO 4032 (гайка). Это наши допуски на печать, а не буква стандарта.

м3_проход = 3.4                  # отверстие под винт M3
м3_головка = 6.2                 # Ø головки цилиндрической
м3_гайка_af = 5.5                # гайка M3 «под ключ»
м3_гайка_r = 3.175               # описанная окружность шестигранника (AF / 2 / cos30)
м3_гайка_высота = 2.4

м4_проход = 4.5
м4_головка = 8.2
м4_гайка_r = 4.05
м4_гайка_высота = 3.2

стойка_стенка = 2.0              # стенка стойки вокруг винта
стойка_высота = 10.0             # высота стойки по умолчанию
