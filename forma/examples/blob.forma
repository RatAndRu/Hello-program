# Органическая форма (метаболы): сферы и капсулы плавно сливаются.
# Так можно лепить фигурки, игрушки и персонажей.

капля = blob spheres=[
    [0, 0, 40, 32],
    [0, 0, 92, 26],
    [26, 0, 118, 14],
    [-20, 6, 60, 16]
  ] capsules=[
    [0, 0, 20, 0, 0, 55, 12],
    [10, -8, 70, 34, -14, 62, 8]
  ] blend=10

капля = place [капля] at=[0,0,0] align=bottom
color капля #7ee0c0 material=plastic
check капля watertight
check капля height 120..165
check капля parts 1
