# Яблоко: тело вращения с настоящими впадинами сверху и снизу.
# Верхняя чашечка глубже — из неё выходит черешок; нижняя — аккуратная ямка.

яблоко = lathe points=[
    [0.00, 4.10], [4.91, 2.45], [8.17, 1.49], [11.38, 1.75],
    [14.51, 2.70], [17.55, 4.00], [20.48, 5.55], [23.27, 7.33],
    [25.91, 9.34], [28.39, 11.56], [30.68, 13.97], [32.77, 16.56],
    [34.65, 19.31], [36.30, 22.20], [37.72, 25.22], [38.89, 28.35],
    [39.81, 31.56], [40.47, 34.84], [40.87, 38.16], [41.00, 41.50],
    [40.87, 44.84], [40.47, 48.16], [39.81, 51.44], [38.89, 54.65],
    [37.72, 57.78], [36.30, 60.80], [34.65, 63.69], [32.77, 66.44],
    [30.68, 69.03], [28.39, 71.44], [25.91, 73.66], [23.27, 75.67],
    [20.48, 77.44], [17.55, 78.95], [14.51, 80.01], [11.38, 80.07],
    [8.17, 78.20], [4.91, 74.23], [0.00, 73.83],
  ] segments=96 smooth=2
яблоко = scale [яблоко] factor=[1.0, 0.985, 1.0]
color яблоко #a8121b material=plastic rough=0.36 metal=0.0

# Черешок из верхней чашечки
черешок = sweep path=[
    [0.0, 0.0, 68.0], [0.15, 0.05, 72.2], [0.5, 0.2, 76.4],
    [1.3, 0.5, 80.6], [2.8, 1.0, 84.2], [4.8, 1.6, 87.4]
  ] radius=2.2 scale_curve=[1.25, 1.10, 1.00, 0.90, 0.80, 0.72] smooth=18 sides=24 round_caps=0.5
color черешок #5b3a22 material=wood rough=0.85

# Лист
лист = sweep path=[
    [2.6, 0.9, 84.0], [-0.7, 4.9, 85.3], [-4.5, 8.7, 86.7],
    [-8.8, 12.1, 88.1],[-13.5, 15.1, 89.5],[-18.5, 17.6, 90.9],
    [-23.8, 19.6, 92.3],[-29.4, 21.1, 93.7],[-35.2, 22.0, 95.1]
  ] profile=[
      [8.00,0.00], [7.93,0.10], [7.73,0.19], [7.39,0.29], [6.93,0.38], [6.35,0.46], [5.66,0.53], [4.87,0.60],
      [4.00,0.66], [3.06,0.75], [2.07,0.92], [1.04,1.17], [0.00,1.30], [-1.04,1.17], [-2.07,0.92], [-3.06,0.75],
      [-4.00,0.66], [-4.87,0.60], [-5.66,0.53], [-6.35,0.46], [-6.93,0.38], [-7.39,0.29], [-7.73,0.19], [-7.93,0.10],
      [-8.00,0.00], [-7.93,-0.10], [-7.73,-0.19], [-7.39,-0.29], [-6.93,-0.37], [-6.35,-0.46], [-5.66,-0.53], [-4.87,-0.60],
      [-4.00,-0.65], [-3.06,-0.69], [-2.07,-0.72], [-1.04,-0.74], [-0.00,-0.75], [1.04,-0.74], [2.07,-0.72], [3.06,-0.69],
      [4.00,-0.65], [4.87,-0.60], [5.66,-0.53], [6.35,-0.46], [6.93,-0.38], [7.39,-0.29], [7.73,-0.19], [7.93,-0.10]
  ] sides=40 smooth=10 up=[0.34,0.79,0.54] scale_curve=[0.16, 0.55, 0.86, 1.00, 0.98, 0.86, 0.64, 0.38, 0.07] round_caps=1.0
color лист #3f7d2c material=plastic rough=0.55

check яблоко watertight
check яблоко parts 1
check яблоко genus 0
check яблоко height 78..84
check яблоко width 78..84
check яблоко depth 78..84
check яблоко volume 250..360
check черешок watertight
check лист watertight
