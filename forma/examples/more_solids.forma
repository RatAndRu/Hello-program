# Новые тела 0.38: слиток, параболоид, седло, ступеньки, круг, овал,
# сектор круга и бусина. Все — одной командой каждое.

# --- плоские с объёмом ---
блин = disc diameter=120 thickness=8 round=2 at=[-340,0,0]
плита = oval width=200 length=120 thickness=8 round=2 at=[-120,0,0]
кусок = pie diameter=140 angle=90 thickness=8 at=[80,0,0]
подвес = pie diameter=140 angle=60 start=200 thickness=6 at=[230,0,0]

# --- точёные: чаша, купол, седло ---
чаша = paraboloid diameter=140 height=34 at=[-340,0,140]
купол = paraboloid diameter=110 height=60 wall=3 at=[-150,0,140]
крыша = saddle length=160 width=120 rise=40 thickness=4 at=[60,0,140]
чипс = saddle length=120 width=120 rise=30 thickness=4 mode=седло at=[260,0,140]

# --- объёмные с формой ---
слиток = ingot length=100 width=50 height=22 taper=8 round=3 at=[-330,0,270]
груз = ingot length=60 width=40 height=30 taper=12 round=5 at=[-180,0,270]
бусина = bead diameter=40 hole=10 chamfer=2 at=[-60,0,270]
башня = bead diameter=34 height=60 hole=8 at=[40,0,270]

# --- готовый марш ---
марш = stairs steps=6 rise=18 run=28 width=120 at=[150,0,285]
мягкий = stairs steps=5 rise=16 run=30 width=100 shape=скруглённая at=[360,0,285]

# Дальше всё это зовётся по имени: `place бусы on=бусина`, `rotate марш …`.
