# Шестерня: настоящий зубчатый венец (20 зубьев), ступица со шпоночным пазом
# и облегчающие окна четырёх разных форм — круглые, треугольные, квадратные, овальные.

венец = extrude profile=[[57.29,-9.07],[71.46,-8.8],[71.46,8.8],[57.29,9.07],[57.29,9.07],[70.68,13.71],[65.24,30.45],[51.68,26.33],[51.68,26.33],[62.98,34.88],[52.64,49.12],[41.01,41.01],[41.01,41.01],[49.12,52.64],[34.88,62.98],[26.33,51.68],[26.33,51.68],[30.45,65.24],[13.71,70.68],[9.07,57.29],[9.07,57.29],[8.8,71.46],[-8.8,71.46],[-9.07,57.29],[-9.07,57.29],[-13.71,70.68],[-30.45,65.24],[-26.33,51.68],[-26.33,51.68],[-34.88,62.98],[-49.12,52.64],[-41.01,41.01],[-41.01,41.01],[-52.64,49.12],[-62.98,34.88],[-51.68,26.33],[-51.68,26.33],[-65.24,30.45],[-70.68,13.71],[-57.29,9.07],[-57.29,9.07],[-71.46,8.8],[-71.46,-8.8],[-57.29,-9.07],[-57.29,-9.07],[-70.68,-13.71],[-65.24,-30.45],[-51.68,-26.33],[-51.68,-26.33],[-62.98,-34.88],[-52.64,-49.12],[-41.01,-41.01],[-41.01,-41.01],[-49.12,-52.64],[-34.88,-62.98],[-26.33,-51.68],[-26.33,-51.68],[-30.45,-65.24],[-13.71,-70.68],[-9.07,-57.29],[-9.07,-57.29],[-8.8,-71.46],[8.8,-71.46],[9.07,-57.29],[9.07,-57.29],[13.71,-70.68],[30.45,-65.24],[26.33,-51.68],[26.33,-51.68],[34.88,-62.98],[49.12,-52.64],[41.01,-41.01],[41.01,-41.01],[52.64,-49.12],[62.98,-34.88],[51.68,-26.33],[51.68,-26.33],[65.24,-30.45],[70.68,-13.71],[57.29,-9.07]] height=12 fillet=1.2

ступица = cylinder radius=26 height=14 segments=96 round=1.5
шестерня = union [венец, ступица]

# шпоночный паз: цилиндрическое отверстие + прямоугольная канавка
вал = cylinder radius=11 height=60 segments=72
вал = place [вал] at=[0,0,-20]
паз = box size=[6,20,60]
паз = place [паз] at=[12,0,-20]
шестерня = difference [шестерня, вал, паз]

окно1 = cylinder radius=9 height=40 segments=64
окно1 = place [окно1] at=[44.0,0.0 ,6] align=center
окно2 = extrude profile=[[-10,-9],[10,-9],[0,12]] height=40
окно2 = place [окно2] at=[31.11,31.11 ,6] align=center
окно3 = box size=[15,15,40] round=2
окно3 = place [окно3] at=[0.0,44.0 ,6] align=center
окно4 = cylinder radius=10 height=40 segments=64
окно4 = scale [окно4] factor=[1.0,0.55,1.0]
окно4 = place [окно4] at=[-31.11,31.11 ,6] align=center
окно5 = cylinder radius=9 height=40 segments=64
окно5 = place [окно5] at=[-44.0,0.0 ,6] align=center
окно6 = extrude profile=[[-10,-9],[10,-9],[0,12]] height=40
окно6 = place [окно6] at=[-31.11,-31.11 ,6] align=center
окно7 = box size=[15,15,40] round=2
окно7 = place [окно7] at=[-0.0,-44.0 ,6] align=center
окно8 = cylinder radius=10 height=40 segments=64
окно8 = scale [окно8] factor=[1.0,0.55,1.0]
окно8 = place [окно8] at=[31.11,-31.11 ,6] align=center

шестерня = difference [шестерня, окно1, окно2, окно3, окно4, окно5, окно6, окно7, окно8]
color шестерня #c9873c metal=0.85 rough=0.28

check шестерня watertight
check шестерня parts 1
check шестерня height 11..15
check шестерня width 140..150
