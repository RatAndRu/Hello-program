# Городская инфраструктура — игровой набор «КВАРТАЛ 01».
# Модуль тротуара 6 × 6 м: дорога 3 м + бордюр 150 + тротуар 3 м, плюс 10
# съёмных пропов (каждый — отдельный объект GLB, пивот в основании по центру).
#
# Канон: верх +Z, низ −Z, перед −Y (дорога), зад +Y (тротуар), право +X.
# Единицы — миллиметры. Верх тротуара Z=+150, верх асфальта Z=0.
# Стыковка модулей: шаг 6000 по X и по Y, кромка модуля — ровно на ±3000.

param tile=6000 min=3000 max=12000 step=500 label="Шаг модуля, мм"
param road_w=2850 min=2000 max=5000 step=50 label="Ширина дороги, мм"
param kerb_w=150 min=80 max=400 step=10 label="Ширина бордюра, мм"
param kerb_h=150 min=80 max=300 step=10 label="Высота бордюра, мм"

half_t = derive tile / 2
road_c = derive -half_t + road_w / 2
side_d = derive tile - road_w - kerb_w
side_c = derive kerb_w / 2 + side_d / 2
kerb_c = derive -half_t + road_w + kerb_w / 2

precision mode=fine tolerance=0.35

# --------------------------------------------------------------- основание --
дорога = box size=[tile, road_w, 150] at=[0, road_c, -150]
бордюр = box size=[tile, kerb_w, 300] at=[0, kerb_c, -kerb_h]
тротуар = box size=[tile, side_d, 300] at=[0, side_c, -kerb_h]
color дорога #3a3d42 material=plastic rough=0.9
color бордюр #9c9a92 material=plastic rough=0.85
color тротуар #b6b2a8 material=plastic rough=0.8

# ------------------------------------------------------------ уличный фонарь
# 4,4 м: плита 280, стойка Ø140, отвод 1,1 м в сторону дороги, корпус светильника.
ф_плита = cylinder radius=140 height=120 at=[0, 0, 0]
ф_стойка = cylinder radius=70 height=4200 at=[0, 0, 120]
ф_отвод = box size=[90, 1100, 90] at=[0, -550, 4270]
ф_голова = box size=[280, 640, 130] round=45 at=[0, -1010, 4200]
фонарь = union [ф_плита, ф_стойка, ф_отвод, ф_голова]
фонарь = translate [фонарь] offset=[-1900, 2500, 150]
color фонарь #2c3136 material=metal rough=0.4

# ------------------------------------------------------- пожарный гидрант ---
# 790 мм: корпус Ø150, фланец Ø230, купол, два патрубка Ø96, гайка под ключ.
г_корпус = cylinder radius=75 height=560 at=[0, 0, 0]
г_фланец = cylinder radius=115 height=60 at=[0, 0, 560]
г_купол = sphere radius=80 at=[0, 0, 620]
г_патY = cylinder radius=48 height=190
г_патY = rotate [г_патY] angle=90 axis=x
г_патY = translate [г_патY] offset=[0, 0, 430]
г_патX = cylinder radius=48 height=190
г_патX = rotate [г_патX] angle=90 axis=y
г_патX = translate [г_патX] offset=[0, 0, 430]
г_гайка = prism sides=6 radius=42 height=60 at=[0, 0, 690]
гидрант = union [г_корпус, г_фланец, г_купол, г_патY, г_патX, г_гайка]
гидрант = translate [гидрант] offset=[-500, 620, 150]
color гидрант #c2382a material=metal rough=0.35

# ------------------------------------------------------------ мусорный бак --
# 870 мм: корпус Ø420, обруч, крышка с наклоном.
б_корпус = cylinder radius=210 height=780 at=[0, 0, 0]
б_обруч = cylinder radius=228 height=45 at=[0, 0, 780]
б_крышка = cylinder radius=215 height=45 at=[0, 0, 825]
б_ручка = box size=[60, 240, 40] at=[0, -190, 870]
бак = union [б_корпус, б_обруч, б_крышка, б_ручка]
бак = translate [бак] offset=[2400, 500, 150]
color бак #37624a material=metal rough=0.45

# --------------------------------------------------------------- скамейка ---
# 1500 × 500 × 880: три рейки сиденья, две рейки спинки, две ноги.
с_нога1 = box size=[70, 460, 430] at=[-620, 0, 0]
с_нога2 = box size=[70, 460, 430] at=[620, 0, 0]
с_рейка1 = box size=[1500, 120, 45] at=[0, -150, 430]
с_рейка2 = box size=[1500, 120, 45] at=[0, 0, 430]
с_рейка3 = box size=[1500, 120, 45] at=[0, 150, 430]
с_спинка1 = box size=[1500, 45, 130] at=[0, 215, 560]
с_спинка2 = box size=[1500, 45, 130] at=[0, 215, 720]
с_стойка1 = box size=[70, 70, 450] at=[-620, 195, 430]
с_стойка2 = box size=[70, 70, 450] at=[620, 195, 430]
скамейка = union [с_нога1, с_нога2, с_рейка1, с_рейка2, с_рейка3, с_спинка1, с_спинка2, с_стойка1, с_стойка2]
скамейка = translate [скамейка] offset=[-700, 2450, 150]
color скамейка #8a6b45 material=plastic rough=0.65

# ------------------------------------------------------------- болларды -----
# Ø150 × 850 с шаровой головкой и отражающим кольцом.
бд_тело = cylinder radius=75 height=850 at=[0, 0, 0]
бд_шар = sphere radius=75 at=[0, 0, 850]
бд_кольцо = cylinder radius=85 height=45 at=[0, 0, 720]
боллард = union [бд_тело, бд_шар, бд_кольцо]
боллард_1 = translate [боллард] offset=[2700, 260, 150]
боллард_2 = translate [боллард] offset=[2700, 700, 150]
боллард_3 = translate [боллард] offset=[2700, 1140, 150]
color боллард_1 #d9b23c material=metal rough=0.4
color боллард_2 #d9b23c material=metal rough=0.4
color боллард_3 #d9b23c material=metal rough=0.4

# --------------------------------------------------------------- светофор ---
# 3,0 м: стойка Ø120, корпус Ø на 3 секции, три линзы Ø150.
св_плита = cylinder radius=150 height=90 at=[0, 0, 0]
св_стойка = cylinder radius=60 height=2910 at=[0, 0, 90]
св_корпус = box size=[250, 210, 720] round=35 at=[0, -250, 2200]
светофор = union [св_плита, св_стойка, св_корпус]
светофор = translate [светофор] offset=[200, 420, 150]
color светофор #26292d material=metal rough=0.45

сл_красный = cylinder radius=75 height=50
сл_красный = rotate [сл_красный] angle=90 axis=x
сл_красный = translate [сл_красный] offset=[200, 245, 2620]
color сл_красный #c02a22 material=plastic rough=0.3
сл_жёлтый = cylinder radius=75 height=50
сл_жёлтый = rotate [сл_жёлтый] angle=90 axis=x
сл_жёлтый = translate [сл_жёлтый] offset=[200, 245, 2390]
color сл_жёлтый #d8a52a material=plastic rough=0.3
сл_зелёный = cylinder radius=75 height=50
сл_зелёный = rotate [сл_зелёный] angle=90 axis=x
сл_зелёный = translate [сл_зелёный] offset=[200, 245, 2160]
color сл_зелёный #2f8a4a material=plastic rough=0.3

# ------------------------------------------------------ дерево в лунке ------
# Лунка 1300 × 1300 с рамкой 120, грунт ниже уровня, ствол Ø190, крона из трёх шаров.
л_рамка = box size=[1300, 1300, 90] at=[0, 0, 0]
л_вырез = box size=[1060, 1060, 90] at=[0, 0, 0]
л_рамка = difference [л_рамка, л_вырез]
л_рамка = translate [л_рамка] offset=[1500, 1900, 150]
color л_рамка #6f6c64 material=metal rough=0.7
л_грунт = box size=[1060, 1060, 150] at=[1500, 1900, 90]
color л_грунт #4a3a2a material=plastic rough=1
л_ствол = cylinder radius=95 height=2400 at=[1500, 1900, 150]
color л_ствол #6b4a2f material=plastic rough=0.9
л_крона = sphere radius=700 at=[1500, 1900, 2950]
л_крона_л = sphere radius=470 at=[1140, 2000, 2620]
л_крона_п = sphere radius=430 at=[1880, 1800, 2660]
крона = union [л_крона, л_крона_л, л_крона_п]
color крона #4f7a3a material=plastic rough=0.85

# --------------------------------------------------------- люк в дороге -----
лк_крышка = cylinder radius=290 height=40 at=[-1600, -1200, -30]
лк_обод = cylinder radius=330 height=25 at=[-1600, -1200, -25]
лк_обод = difference [лк_обод, лк_крышка]
люк = union [лк_крышка, лк_обод]
color люк #4a4e54 material=metal rough=0.55

# --------------------------------------------------- дождеприёмник у борта --
дп_рамка = box size=[520, 380, 45] at=[-200, -380, -45]
дп_паз1 = box size=[70, 290, 60] at=[-380, -380, -45]
дп_паз2 = box size=[70, 290, 60] at=[-240, -380, -45]
дп_паз3 = box size=[70, 290, 60] at=[-100, -380, -45]
дп_паз4 = box size=[70, 290, 60] at=[40, -380, -45]
решётка = difference [дп_рамка, дп_паз1, дп_паз2, дп_паз3, дп_паз4]
color решётка #3c4046 material=metal rough=0.6

# ------------------------------------------------------------- разметка -----
# Осевая прерывистая (600 через 600) и пешеходный переход из четырёх полос.
рм_1 = box size=[600, 120, 6] at=[-2400, road_c, 0]
рм_2 = box size=[600, 120, 6] at=[-1200, road_c, 0]
рм_3 = box size=[600, 120, 6] at=[0, road_c, 0]
рм_4 = box size=[600, 120, 6] at=[1200, road_c, 0]
рм_5 = box size=[600, 120, 6] at=[2400, road_c, 0]
разметка = union [рм_1, рм_2, рм_3, рм_4, рм_5]
color разметка #e6e4d8 material=plastic rough=0.7
зб_1 = box size=[460, 2800, 6] at=[1900, road_c, 0]
зб_2 = box size=[460, 2800, 6] at=[2460, road_c, 0]
зб_3 = box size=[460, 2800, 6] at=[-1900, road_c, 0]
зб_4 = box size=[460, 2800, 6] at=[-2460, road_c, 0]
зебра = union [зб_1, зб_2, зб_3, зб_4]
color зебра #e6e4d8 material=plastic rough=0.7

# ------------------------------------------------------------ материалы -----
scene bg=#e8eaec shadows=да ground=да
light preset=студия strength=1.05

# ------------------------------------------------------------------ проверки
check дорога watertight
check тротуар watertight
check бордюр watertight
check фонарь watertight
check гидрант watertight
check решётка watertight
check люк watertight
