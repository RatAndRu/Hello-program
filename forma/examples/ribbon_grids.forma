# 0.44 — полосы, сквозные решётки, шипы, колонна и профиль 2020.
# 15 отдельных тел; миллиметры, верх +Z, перёд −Y.
scene bg=#10121f grid=нет

# Полосы: независимые кромки, зигзаг, сквозная выемка и изгиб.
лента = strip length=140 width=36 thickness=3 ends=овальные collapse_left=0.55 collapse_right=0.25 at=[-240,140,0] color=gold
зигзаг = strip length=140 width=30 thickness=3 path=зигзаг curve=28 at=[-80,140,0] color=cyan
окно = strip length=140 width=44 thickness=4 recess=треугольник recess_size=18 at=[80,140,0] color=orange
дуга = strip length=140 width=30 thickness=3 bend=60 at=[240,140,0] color=violet

# Три решётки: ячейки вычитаются насквозь, рамка и рейки остаются одним телом.
планки = grating width=140 height=90 depth=4 pattern=планки bars=5 bar=3 frame=6 at=[-240,-30,0] color=steel
клетка = grating width=140 height=90 depth=4 pattern=клетка cols=4 rows=3 bar=3 frame=6 at=[-80,-30,0] color=mint
соты = grating width=150 height=100 depth=4 pattern=соты cell=20 bar=3 frame=6 at=[80,-30,0] color=green
шипы = box size=[120,80,4] round=0 at=[240,-30,0] color=red
шипы = spikes [шипы] surface=верх cols=4 rows=3 height=24 base_d=11 tip_d=0.5 sides=16 color=red

# Новые конструкционные формы и простая труба без координат path.
колонна = column height=150 width=34 form=песочные waist=0.55 base_size=60 base_h=10 rim=6 rim_h=8 at=[-240,-190,0] color=copper
палатка = arc_prism a=90 b=80 c=80 height=90 arc_a=0 arc_b=-12 arc_c=-12 at=[-80,-190,0] color=violet
профиль = profile2020 length=140 size=20 groove=овальная rail=скруглённая bore=5 bore_shape=шестигранник at=[80,-190,0] color=steel
труба = pipe length=180 angle=90 radius=55 joint=плавный diameter=20 wall=2 at=[240,-190,0] color=cyan

# Доработанные прежние примитивы.
вогнутый_круг = disc diameter=90 thickness=7 top=вогнутая sag=3 at=[-240,-350,0] color=blue
выпуклый_овал = oval width=130 length=85 thickness=6 top=выпуклая sag=4 at=[-80,-350,0] color=pink
треугольный_куб = cube_hole size=[55,55,45] hole=20 hole_shape=треугольник at=[80,-350,0] color=gold

check лента watertight
check зигзаг watertight
check окно watertight
check дуга watertight
check планки watertight
check клетка watertight
check соты watertight
check шипы watertight
check колонна watertight
check палатка watertight
check профиль watertight
check труба watertight
check вогнутый_круг watertight
check выпуклый_овал watertight
check треугольный_куб watertight
