# Кружка 350 мл — ровная, гладкая, без «спаек» внутри.
# Тело вращения + дуга-ручка, сглаживание мягкое (без лишних полигонов).

R = 42
H = 95
t = 4

корпус = lathe points=[
    [0, 0], [R - 7, 0], [R - 3.5, 0.8], [R - 1.2, 2.6],
    [R, 6], [R, H - 7], [R - 0.6, H - 2.4], [R - 2.6, H - 0.5], [R - 5, H], [0, H]
  ] segments=160 smooth=3 fillet=0.5

# полость: стенка 4 мм, дно скруглено, кромка аккуратная
полость = lathe points=[
    [0, t], [R - t - 2, t], [R - t - 0.6, t + 1.4], [R - t, t + 3],
    [R - t, H - 3], [R - t + 0.4, H + 1], [R - t + 3, H + 5], [0, H + 5]
  ] segments=160 smooth=3 fillet=0.4
корпус = difference [корпус, полость]

# ручка начинается снаружи стенки — внутрь кружки ничего не торчит
ручка = sweep path=[
    [R + 0.5, 0, 24], [R + 12, 0, 24], [R + 22, 0, 34], [R + 24, 0, 50],
    [R + 22, 0, 66], [R + 12, 0, 76], [R + 0.5, 0, 76]
  ] width=11 height=14 sides=36 up=[0,1,0] smooth=18

кружка = union [корпус, ручка]
# сглаживаем стыки ручки и кромку; дробление не нужно — сетка и так плотная
кружка = smooth [кружка] angle=48 soft=0.40 levels=1

color кружка #efe9df material=ceramic
texture кружка kind=керамика scale=0.7 uv=auto

# презентационное вращение — кнопка «играть» работает сразу
animate kind=spin axis=z seconds=8 loop=да

check кружка watertight
check кружка parts 1
check кружка genus 1
check кружка height 93..97
check кружка wall 3..5
check кружка flat_bottom 3..
check кружка symmetric y
check кружка tris ..120000
