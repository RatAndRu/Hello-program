# Кружка 350 мл — гладкая, ровная, как заводская.
# Профиль вращается вокруг оси Z: (радиус, высота). Толщина стенки задаётся
# параметром thickness — внутренняя полость строится автоматически.

радиус = 42
высота = 95
стенка = 4

корпус = lathe points=[
    [0, 0],
    [радиус - 5, 0],
    [радиус - 2, 1.5],
    [радиус, 5],
    [радиус + 1, 10],
    [радиус + 1, высота - 7],
    [радиус - 1, высота - 2],
    [радиус - 3, высота],
    [0, высота]
  ] segments=144 fillet=1.0 thickness=стенка open=top

# ручка: круглое сечение, овальное — удобнее держать
ручка = sweep path=[
    [радиус - 3, 0, 28],
    [58, 0, 28],
    [67, 0, 42],
    [67, 0, 62],
    [58, 0, 76],
    [радиус - 3, 0, 76]
  ] width=9 height=13 sides=28 up=[0,1,0] smooth=10

# небольшие «наплывы» в местах стыка — ручка примыкает плавно
узел1 = sphere radius=7.5 at=[радиус - 1, 0, 28]
узел2 = sphere radius=7.5 at=[радиус - 1, 0, 76]

кружка = union [корпус, ручка, узел1, узел2]
color кружка material=ceramic

# ---- словесная проверка результата ----
check кружка watertight
check кружка parts 1
check кружка genus 1
check кружка height 93..97
check кружка width 105..120
check кружка volume 120..200
check кружка wall 3..5
check кружка flat_bottom 3..
check кружка symmetric y
check кружка tris ..80000
