# ============================================================================
#  УЗЛЫ И КРЕПЁЖ: подшипник, шкив, вал, болт, гайка, шайба
# ============================================================================
#  Сцены: «вентилятор» (ротор и шкив крутятся), «прыжок» (шарик скачет и
#  упруго сжимается), «падение» (гайка падает на плиту и подпрыгивает).
#  Клипы привязаны к объектам и группам — движения идут параллельно.
# ----------------------------------------------------------------------------

scene bg=#161a20 env=studio shadows=да grid=нет
light preset=студия strength=1.1

# ---------- ОСНОВАНИЕ ----------
плита = box size=[700, 450, 14] round=6 center=да at=[0, 0, 7]
плита = holes [плита] grid=[4,2] diameter=9 pitch=[150,330]
подпятник = box size=[240, 180, 10] round=4 center=да at=[0, -120, 19]

# ---------- ВЕНТИЛЯТОР: корпус, ступица, лопасти ----------
корпус_вент = cylinder radius=118 height=64 segments=96
полость_вент = cylinder radius=102 height=70 segments=96
корпус_вент = difference [корпус_вент, полость_вент]
корпус_вент = rotate [корпус_вент] angle=90 axis=x
стойка_вент = cylinder radius=22 height=254 segments=48
мотор = cylinder radius=46 height=94 segments=64
мотор = rotate [мотор] angle=90 axis=x

лопасть = box size=[92, 8, 44] center=да at=[74, 0, 0]
лопасть = rotate [лопасть] angle=26 axis=x
лопасти = array [лопасть] count=5 mode=radial around=y center=[0, 0, 0]
ступица = cylinder radius=30 height=56 segments=48
ступица = rotate [ступица] angle=90 axis=x
ротор = union [лопасти, ступица]

корпус_вент = translate [корпус_вент] offset=[0, -150, 268]
ротор = translate [ротор] offset=[0, -150, 268]
мотор = translate [мотор] offset=[0, -74, 268]
стойка_вент = translate [стойка_вент] offset=[0, -150, 14]
вентилятор = group [ротор, корпус_вент, мотор]
стойка_вент = union [стойка_вент, мотор]

# ---------- ПОДШИПНИКОВЫЙ УЗЕЛ ----------
вал = shaft diameter=24 length=190 chamfer=1.5 bore=0
вал = rotate [вал] angle=90 axis=y
вал = translate [вал] offset=[250, 30, 99]
подшипник = bearing outer=52 inner=24 width=16 balls=10
подшипник = rotate [подшипник] angle=90 axis=x
подшипник = translate [подшипник] offset=[250, -30, 99]
опора = box size=[90, 60, 60] round=4 center=да at=[250, -30, 44]
подшипник = union [подшипник, опора]
шкив = pulley diameter=96 width=26 bore=24 groove=8
шкив = rotate [шкив] angle=90 axis=x
шкив = translate [шкив] offset=[250, 96, 99]

# ---------- КРЕПЁЖ НА ПЛИТЕ ----------
болт = bolt d=10 length=42
болт = rotate [болт] angle=90 axis=x
болт = translate [болт] offset=[-250, -30, 22]
гайка = nut d=10 h=8
гайка = rotate [гайка] angle=90 axis=x
гайка = translate [гайка] offset=[-250, 30, 22]
шайба = washer outer=22 inner=11 thickness=2
шайба = rotate [шайба] angle=90 axis=x
шайба = translate [шайба] offset=[-250, 78, 25]

# ---------- УПРУГИЕ ТЕЛА ----------
шарик = sphere radius=24 segments=48 at=[-90, 130, 38]
падающая_гайка = nut d=18 h=14
падающая_гайка = translate [падающая_гайка] offset=[80, 140, 210]
пружина = spring diameter=34 wire=3.4 turns=7 pitch=9
пружина = translate [пружина] offset=[-160, 140, 14]

# ---------- АНИМАЦИЯ ----------
animate ротор fan rpm=1200 axis=y seconds=4 scene=вентилятор
animate шкив fan rpm=600 axis=y seconds=4 scene=вентилятор

animate шарик jump height=130 elastic=да seconds=1.6 scene=прыжок
animate шарик wait seconds=0.4 scene=прыжок
animate шарик jump height=90 elastic=да seconds=1.4 scene=прыжок

animate падающая_гайка fall height=196 elastic=да seconds=1.4 scene=падение
animate падающая_гайка move dz=18 seconds=0.4 scene=падение

# ---------- ПРОВЕРКИ ----------
check плита watertight
check плита parts 1
check плита size 698..702 448..452 12..16
check корпус_вент watertight
check корпус_вент parts 1
check ротор parts 1
check ротор watertight
check вал parts 1
check подшипник parts 1
check подшипник watertight
check шкив parts 1
check болт parts 1
check гайка parts 1
check шарик parts 1
check шарик height 46..50
check пружина parts 1
check подшипник height 110..112
check гайка height 15..17
check шайба height 20..24

# ---------- МАТЕРИАЛ ----------
color плита #3a4048 metal=0.5 rough=0.45
color подпятник #4a5159 metal=0.5 rough=0.4
color корпус_вент #2c3138 metal=0.6 rough=0.35
color ротор #b9c0c7 metal=0.85 rough=0.22
color стойка_вент #8e959c metal=0.8 rough=0.3
color мотор #23262b metal=0.5 rough=0.5
color вал #c3c9cf metal=0.9 rough=0.18
color подшипник #d0d5da metal=0.95 rough=0.15
color опора #5a616a metal=0.6 rough=0.4
color шкив #9aa2aa metal=0.85 rough=0.25
color болт #cfd4d9 metal=0.95 rough=0.2
color гайка #cfd4d9 metal=0.95 rough=0.2
color шайба #cfd4d9 metal=0.95 rough=0.2
color шарик #d96a4a rough=0.35
color падающая_гайка #e0b24a metal=0.9 rough=0.25
color пружина #b9bec4 metal=0.9 rough=0.2
