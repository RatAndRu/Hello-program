# Форма 3D 0.76.5 — пример пространственного паспорта для нейросети.
# +Z вверх, +X вправо, −Y вперёд, единицы — миллиметры.
# Откройте этот файл в редакторе, нажмите «Собрать», затем «Экспорт» →
# «Паспорт для нейросети — быстро» или «подробно».

заготовка = box size=[100,70,8] at=[0,0,0] color=#c4d4cf
резец = cylinder radius=8 height=10 segments=48 at=[-20,0,-1]
плита = difference [заготовка,резец]

опора = box size=[12,12,30] at=[28,0,8] color=#9c927c
сфера = sphere radius=12 segments=24 at=[28,0,50] color=#ba7860

# Габаритные коробки и обзорные сечения — подсказка, не доказательство контакта
# и не полная проверка всех отверстий. Ограничения сохранены в отчёте ZIP.
