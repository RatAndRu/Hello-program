# Сопряжения: деталь встаёт на место отношением, а не координатами.
# Каждая связь запоминается, а `check имя связь` следит, чтобы она не разъехалась.
# Виды: плоскость · ось · паз · зазор · точка · петля.
основание = box size=[320, 200, 14] round=6 at=[0, 0, 0]
рейка = box size=[40, 190, 12] at=[0, 0, 300]
сопряжение рейка основание type=плоскость axis=z

# Каретка садится в паз рейки: центруется по ней и встаёт на верхнюю грань.
каретка = box size=[90, 70, 40] round=8 at=[250, 0, 300]
сопряжение каретка рейка type=паз axis=y

# Вал выходит из каретки по оси X, колесо садится на его конец.
вал = cylinder radius=9 height=100 center=да at=[95, 0, 500]
вал = rotate [вал] angle=90 axis=y pivot=[95, 0, 500]
сопряжение вал каретка type=ось axis=x
колесо = wheel diameter=64 width=22 rim=12 spokes=5 hub=16 tire=3 segments=64 at=[140, 0, 900]
колесо = rotate [колесо] angle=90 axis=z pivot=[140, 0, 900]
сопряжение колесо вал type=ось axis=x

# Дверь поворачивается вокруг петли, а не вокруг своего центра.
корпус = box size=[300, 24, 220] round=4 at=[0, 100, 14]
дверь = box size=[140, 16, 180] round=3 at=[0, 80, 14]
сопряжение дверь корпус type=петля axis=z point=[-70, 80, 100] angle=-28

# Точка: угол шильдика ставится точно на верхнюю плоскость основания.
шильдик = box size=[84, 3, 30] round=1 at=[0, 0, 600]
сопряжение шильдик основание type=точка point=[0, 0, 600] to=[-80, -78, 14]

# Зазор: шайба висит над основанием ровно в 6 мм.
шайба = cylinder radius=24 height=4 center=да at=[-90, -40, 400]
сопряжение шайба основание type=зазор offset=6

# Связи не мешают анимации: дверь открывается вокруг той же петли.
animate дверь turn axis=z angle=-50 pivot=[-70, 80, 100] seconds=3 track=2
animate колесо spin axis=x turns=6 seconds=6 track=1
scene bg=#0b0e13 env=studio exposure=1.05 shadows=да grid=да

цвет основание #3d4056 metal=0.5 rough=0.42
цвет рейка #c9d1e3 metal=0.9 rough=0.25
цвет каретка #e08a3c metal=0.35 rough=0.4
цвет вал #9aa6b8 metal=1 rough=0.2
цвет колесо #2b2f36 metal=0.4 rough=0.55
цвет корпус #6d7f95 metal=0.6 rough=0.35
цвет дверь #c96f3c metal=0.3 rough=0.45
цвет шильдик #e8dfcf metal=0.1 rough=0.5
цвет шайба #b9c3cf metal=1 rough=0.18

check основание watertight
check рейка связь
check каретка связь
check вал связь
check колесо связь
check дверь связь
check шильдик связь
check шайба связь
check колесо parts 1
check основание height 14..14
