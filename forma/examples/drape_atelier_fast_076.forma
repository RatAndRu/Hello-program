# ФОРМА 3D 0.76.1 — облегчённая сцена: два слоя, полый рукав, шар и стол.
# В миллиметрах; +Z вверх. Это одна рассчитанная поза, не анимация.
# При вставке текста в редактор снимите галочку «авто» и нажмите «Собрать» один раз.
# Расчёт приближённый: равновесие и абсолютная нерастяжимость не гарантированы.
# Перед экспортом проверяйте предупреждения и возможные пересечения.

пол = box size=[620,200,6] at=[0,0,-6] color=#d8d8d0

# Два отдельных слоя; для границы между ними оставлен зазор 0.12 мм.
нижний_лист = box size=[72,60,0.6] at=[-235,0,30] color=#438eac
верхний_лист = box size=[60,48,0.6] at=[-234,0,38] color=#eecb91
слои = drape [нижний_лист,верхний_лист] on=пол mesh=6 particles=2200 steps=60 constraints=14 bend=0.25 damping=0.4 g=0.16 self=да self_gap=0.12

# Деформируемый полый рукав: диаметр исходной формы 22 мм, 24 стороны.
рукав = pipe length=70 diameter=22 wall=0.6 sides=24 at=[-115,0,40] color=#ad6e83
упавший_рукав = drape рукав on=пол mesh=7 particles=1800 steps=80 constraints=18 bend=0.25 damping=0.2 friction=0.9 g=0.10 self=да self_gap=0.25

# Шар — отдельная падающая фигура с автоматически определяемой жёсткостью.
шар = sphere radius=18 segments=64 detail=4 at=[-15,0,55] color=#d77d48
упавший_шар = drape шар on=пол mesh=6 particles=2000 steps=60 constraints=16 g=0.05 damping=0.3

# Столешница со скруглённой кромкой и четыре отдельные ножки.
болванка_стола = box size=[80,80,40] round=12 at=[150,0,0] color=#9a765f
срез_под_столом = box size=[100,100,21] at=[150,0,-1]
столешница = difference [болванка_стола,срез_под_столом]
ножка_левая_передняя = box size=[7,7,20] at=[122,-28,0] color=#7b5b49
ножка_правая_передняя = box size=[7,7,20] at=[178,-28,0] color=#7b5b49
ножка_левая_задняя = box size=[7,7,20] at=[122,28,0] color=#7b5b49
ножка_правая_задняя = box size=[7,7,20] at=[178,28,0] color=#7b5b49

# Лист 120×120 мм шире стола. Зазор 0.7 мм до опор — не идеальное касание.
лист_скатерти = box size=[120,120,0.6] at=[150,0,70] color=#94a788
скатерть = drape лист_скатерти on=[столешница,ножка_левая_передняя,ножка_правая_передняя,ножка_левая_задняя,ножка_правая_задняя,пол] gravity=z- mesh=8 particles=2200 steps=70 constraints=16 bend=0.2 damping=0.2 friction=0.2 g=0.15 self=да self_gap=0.12 gap=0.7
