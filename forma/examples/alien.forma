# Капля → пришелец: тело лепится из метаболов (blob), поэтому голова,
# антенны и руки срастаются плавно, без стыков и швов.

пришелец = blob spheres=[
    [0, 0, 120, 95],
    [0, 0, 240, 70],
    [0, 0, 330, 62],
    [0, 0, 460, 120],
    [0, 0, 520, 92],
    [-108, 0, 679, 16],
    [108, 0, 679, 16]
  ] capsules=[
    [-52, 0, 540, -108, 0, 679, 7],
    [52, 0, 540, 108, 0, 679, 7],
    [-80, 0, 310, -190, 0, 190, 18],
    [80, 0, 310, 190, 0, 190, 18]
  ] blend=34

пришелец = place [пришелец] at=[0,0,0] align=bottom
color пришелец #86d9b0 metal=0.0 rough=0.42

# глаза-линзы: чуть утоплены в голову, поэтому не «наклеены»
глаз_л = sphere radius=54 segments=48
глаз_л = scale [глаз_л] factor=[1.05,0.52,1.20]
глаз_л = place [глаз_л] at=[-47,84,468] align=center
глаз_п = sphere radius=54 segments=48
глаз_п = scale [глаз_п] factor=[1.05,0.52,1.20]
глаз_п = place [глаз_п] at=[47,84,468] align=center
color глаз_л #0d1118 metal=0.25 rough=0.12
color глаз_п #0d1118 metal=0.25 rough=0.12

check пришелец watertight
check пришелец parts 1
check пришелец height 660..730
check пришелец symmetric y 6
