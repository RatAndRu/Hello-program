# Кружка «студийная»: керамика + дерево, текстура, свет и анимация.
# Всё это открывается в Blender из GLB вместе с материалами.

радиус = 42
высота = 95
стенка = 4

корпус = lathe points=[
    [0, 0], [радиус - 5, 0], [радиус - 2, 1.5], [радиус, 5],
    [радиус + 1, 10], [радиус + 1, высота - 7], [радиус - 1, высота - 2],
    [радиус - 3, высота], [0, высота]
  ] segments=144 fillet=1.0 thickness=стенка open=top

ручка = sweep path=[
    [радиус - 3, 0, 28], [58, 0, 28], [67, 0, 42],
    [67, 0, 62], [58, 0, 76], [радиус - 3, 0, 76]
  ] width=9 height=13 sides=28 up=[0,1,0] smooth=10

кружка = union [корпус, ручка]
color кружка #e8dfd0 material=ceramic
texture кружка kind=мрамор scale=1.3
color ручка #b07c4a material=wood

light preset=студия strength=1.1
scene bg=#0d1218 env=studio exposure=1.0
animate kind=spin seconds=10 loop=да

check кружка watertight
check кружка height 90..100
check кружка wall 3..5
check кружка mass 250..450
check кружка symmetric y
