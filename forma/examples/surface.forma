# Посадка на настоящую границу, а не на центр габарита.
# place ставит деталь относительно центра «коробки» вокруг предмета; у тора
# эта коробка шире кольца, и «сбоку» получается сбоку от пустоты.
# на_границе ищет ближайшую точку настоящей поверхности: шайба садится на
# кольцо, шарик — на бок трубки, и ещё разворачивается по нормали.

кольцо = torus major=40 minor=8 at=[0,0,70]
color кольцо color=#c9ccd2 metal=0.8 rough=0.25

шайба = cylinder radius=6 height=4
шайба = на_границе [шайба] on=кольцо point=[60,0,70] offset=1 align=нормаль
color шайба color=#e0a33a metal=0.7 rough=0.3

шарик = sphere radius=6
шарик = на_границе [шарик] on=кольцо point=[0,-60,70] offset=0 align=нормаль
color шарик color=#3ac07a metal=0.3 rough=0.5

# внутренняя кромка: точка в центре кольца — ближайшая поверхность внутри
втулка = cylinder radius=4 height=10
втулка = на_границе [втулка] on=кольцо point=[0,0,70] offset=0.5
color втулка color=#d94f3d metal=0.4 rough=0.45

# и то же самое без формул — от верха куба, а не от его центра
куб = box size=[80,80,80] at=[160,0,0]
наклейка = полуовал width=50 height=28 thickness=4 hole=8
наклейка = на_границе [наклейка] on=куб point=[160,0,100] offset=0.3
color наклейка color=#8a6ce0 metal=0.2 rough=0.6
