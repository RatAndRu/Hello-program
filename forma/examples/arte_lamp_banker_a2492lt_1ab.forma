# Arte Lamp Banker A2492LT-1AB — компактная параметрическая модель по референсам.
# Единицы: мм. Верх +Z, перед -Y, длинная ось абажура +X.
# Дополнительные ракурсы: bclight.ru/catalog/product-arte-lamp-a2492lt-1ab
# и lightil.ru/nastolnie-lampy/ofisnye/nastolnaya-lampa-arte-lamp-banker-a2492lt-1ab-16506.
# Общая высота 400; основание Ø180; абажур 240×110×90.

# Независимые размеры. derive ниже — размерные связи, пересчитываемые rebuild.
param base_h=68 min=45 max=100 step=1 label="Высота основания"
param base_d=180 min=140 max=220 step=1 label="Диаметр основания"
param column_ratio=1.25 min=0.8 max=1.8 step=0.05 label="Высота колонны / основания"
base_r = derive base_d / 2
column_h = derive base_h * column_ratio
column_top = derive base_h + column_h
joint_z = derive column_top + 12
chain_top = 304
chain_bottom = derive chain_top - (30 - 1) * 3
tip_z = derive chain_bottom - 1.5 - 10
bulb_z = 354
socket_z = derive bulb_z + 14
rod_top = derive socket_z + 12 + 16.2
arm_z1 = derive joint_z + 8 + (310 - joint_z - 8) * (35 / 137)
arm_z2 = derive arm_z1 + (310 - arm_z1) * (29.5 / 102)
arm_z3 = derive arm_z2 + (310 - arm_z2) * (62.5 / 72.5)

# Силуэт основания: низкий купол и две ступени, без плотного набора микродуг.
основание = lathe points=[[0,0],[base_r*0.8667,0],[base_r*0.9556,base_h*0.03],[base_r,base_h*0.09],[base_r,base_h*0.27],[base_r*0.9778,base_h*0.34],[base_r*0.9111,base_h*0.42],[base_r*0.90568203,base_h*0.49570519],[base_r*0.88952083,base_h*0.57011505],[base_r*0.86289291,base_h*0.64195639],[base_r*0.82625389,base_h*0.71000000],[base_r*0.78023067,base_h*0.77308163],[base_r*0.72561072,base_h*0.83012193],[base_r*0.66332861,base_h*0.88014494],[base_r*0.59445000,base_h*0.92229473],[base_r*0.52015342,base_h*0.95585013],[base_r*0.44171010,base_h*0.98023698],[base_r*0.36046224,base_h*0.99503802],[base_r*0.27780000,base_h*1.00000000],[0,base_h]] segments=64 fillet=0.45 fillet_steps=4 color=#967532 metal=0.88 rough=0.24

# Фигурная колонна начинается ровно на верхней плоскости основания.
колонна = lathe points=[[0,base_h],[base_r*0.2444,base_h],[base_r*0.2667,base_h+column_h*0.0471],[base_r*0.2667,base_h+column_h*0.1176],[base_r*0.2222,base_h+column_h*0.1647],[base_r*0.2222,base_h+column_h*0.2824],[base_r*0.3000,base_h+column_h*0.3412],[base_r*0.3333,base_h+column_h*0.4235],[base_r*0.3111,base_h+column_h*0.5059],[base_r*0.2333,base_h+column_h*0.5647],[base_r*0.2222,base_h+column_h*0.6824],[base_r*0.2667,base_h+column_h*0.7294],[base_r*0.2667,base_h+column_h*0.8235],[base_r*0.2111,base_h+column_h*0.8824],[base_r*0.2111,column_top],[0,column_top]] segments=48 fillet=0.55 fillet_steps=4 color=#967532 metal=0.88 rough=0.24
шарнир_седло = cylinder radius=7 height=4 at=[0,0,column_top] segments=24 color=#967532 metal=0.88 rough=0.22
шарнир = sphere radius=10 at=[0,0,joint_z] segments=24 color=#967532 metal=0.88 rough=0.22

# Тонкая наружная оболочка: два сечения, настоящая полость и открытый низ.
абажур_наружный = loft sections=[[[55,310],[55,345],[54.529467,352.178941],[53.12592,359.235047],[50.813374,366.047589],[47.631397,372.5],[43.634434,378.481879],[38.890873,383.890873],[33.481879,388.634434],[27.5,392.631397],[21.047589,395.813374],[14.235047,398.12592],[7.178941,399.529467],[0,400],[-7.178941,399.529467],[-14.235047,398.12592],[-21.047589,395.813374],[-27.5,392.631397],[-33.481879,388.634434],[-38.890873,383.890873],[-43.634434,378.481879],[-47.631397,372.5],[-50.813374,366.047589],[-53.12592,359.235047],[-54.529467,352.178941],[-55,345],[-55,310]],[[55,310],[55,345],[54.529467,352.178941],[53.12592,359.235047],[50.813374,366.047589],[47.631397,372.5],[43.634434,378.481879],[38.890873,383.890873],[33.481879,388.634434],[27.5,392.631397],[21.047589,395.813374],[14.235047,398.12592],[7.178941,399.529467],[0,400],[-7.178941,399.529467],[-14.235047,398.12592],[-21.047589,395.813374],[-27.5,392.631397],[-33.481879,388.634434],[-38.890873,383.890873],[-43.634434,378.481879],[-47.631397,372.5],[-50.813374,366.047589],[-53.12592,359.235047],[-54.529467,352.178941],[-55,345],[-55,310]]] positions=[-120,120] axis=x smooth=1 color=#087d28 rough=0.17
абажур_полость = loft sections=[[[52.6,305],[52.6,345],[52.15,351.865678],[50.807698,358.613882],[48.596063,365.129149],[45.552936,371.3],[41.730386,377.020851],[37.193817,382.193817],[32.020851,386.730386],[26.3,390.552936],[20.129149,393.596063],[13.613882,395.807698],[6.865678,397.15],[0,397.6],[-6.865678,397.15],[-13.613882,395.807698],[-20.129149,393.596063],[-26.3,390.552936],[-32.020851,386.730386],[-37.193817,382.193817],[-41.730386,377.020851],[-45.552936,371.3],[-48.596063,365.129149],[-50.807698,358.613882],[-52.15,351.865678],[-52.6,345],[-52.6,305]],[[52.6,305],[52.6,345],[52.15,351.865678],[50.807698,358.613882],[48.596063,365.129149],[45.552936,371.3],[41.730386,377.020851],[37.193817,382.193817],[32.020851,386.730386],[26.3,390.552936],[20.129149,393.596063],[13.613882,395.807698],[6.865678,397.15],[0,397.6],[-6.865678,397.15],[-13.613882,395.807698],[-20.129149,393.596063],[-26.3,390.552936],[-32.020851,386.730386],[-37.193817,382.193817],[-41.730386,377.020851],[-45.552936,371.3],[-48.596063,365.129149],[-50.807698,358.613882],[-52.15,351.865678],[-52.6,345],[-52.6,305]]] positions=[-118,118] axis=x smooth=1
абажур = difference [абажур_наружный,абажур_полость] color=#087d28 rough=0.17

# Светлый вкладыш меньше полости на 0.4 мм; фиксаторы ниже удерживают его за кромку.
вкладыш_наружный = loft sections=[[[52.2,310],[52.2,345],[51.753422,351.813467],[50.421328,358.510354],[48.226512,364.976075],[45.206526,371.1],[41.413044,376.777347],[36.910974,381.910974],[31.777347,386.413044],[26.1,390.206526],[19.976075,393.226512],[13.510354,395.421328],[6.813467,396.753422],[0,397.2],[-6.813467,396.753422],[-13.510354,395.421328],[-19.976075,393.226512],[-26.1,390.206526],[-31.777347,386.413044],[-36.910974,381.910974],[-41.413044,376.777347],[-45.206526,371.1],[-48.226512,364.976075],[-50.421328,358.510354],[-51.753422,351.813467],[-52.2,345],[-52.2,310]],[[52.2,310],[52.2,345],[51.753422,351.813467],[50.421328,358.510354],[48.226512,364.976075],[45.206526,371.1],[41.413044,376.777347],[36.910974,381.910974],[31.777347,386.413044],[26.1,390.206526],[19.976075,393.226512],[13.510354,395.421328],[6.813467,396.753422],[0,397.2],[-6.813467,396.753422],[-13.510354,395.421328],[-19.976075,393.226512],[-26.1,390.206526],[-31.777347,386.413044],[-36.910974,381.910974],[-41.413044,376.777347],[-45.206526,371.1],[-48.226512,364.976075],[-50.421328,358.510354],[-51.753422,351.813467],[-52.2,345],[-52.2,310]]] positions=[-117.8,117.8] axis=x smooth=1 color=#f2e7c6 rough=0.28
вкладыш_полость = loft sections=[[[51.4,304.5],[51.4,345],[50.960266,351.709046],[49.648587,358.303299],[47.487408,364.669928],[44.513706,370.7],[40.778362,376.290337],[36.345289,381.345289],[31.290337,385.778362],[25.7,389.513706],[19.669928,392.487408],[13.303299,394.648587],[6.709046,395.960266],[0,396.4],[-6.709046,395.960266],[-13.303299,394.648587],[-19.669928,392.487408],[-25.7,389.513706],[-31.290337,385.778362],[-36.345289,381.345289],[-40.778362,376.290337],[-44.513706,370.7],[-47.487408,364.669928],[-49.648587,358.303299],[-50.960266,351.709046],[-51.4,345],[-51.4,304.5]],[[51.4,304.5],[51.4,345],[50.960266,351.709046],[49.648587,358.303299],[47.487408,364.669928],[44.513706,370.7],[40.778362,376.290337],[36.345289,381.345289],[31.290337,385.778362],[25.7,389.513706],[19.669928,392.487408],[13.303299,394.648587],[6.709046,395.960266],[0,396.4],[-6.709046,395.960266],[-13.303299,394.648587],[-19.669928,392.487408],[-25.7,389.513706],[-31.290337,385.778362],[-36.345289,381.345289],[-40.778362,376.290337],[-44.513706,370.7],[-47.487408,364.669928],[-49.648587,358.303299],[-50.960266,351.709046],[-51.4,345],[-51.4,304.5]]] positions=[-116.8,116.8] axis=x smooth=1
вкладыш = difference [вкладыш_наружный,вкладыш_полость] color=#f2e7c6 rough=0.28
вкладыш_фиксатор_л = sweep path=[[-90,52.2,313],[-90,52.6,313]] radius=1.2 sides=12 round_caps=0 color=#d7c69c metal=0.35 rough=0.3
вкладыш_фиксатор_п = sweep path=[[90,52.2,313],[90,52.6,313]] radius=1.2 sides=12 round_caps=0 color=#d7c69c metal=0.35 rough=0.3

# Лампочка, цоколь и реальный подвес к внутренней арке (не парящая лампочка).
лампочка = sphere radius=14 at=[0,0,bulb_z] segments=24 color=#fff3cf rough=0.2 emissive=#ffe7a0 emissive_strength=0.35
цоколь = cylinder radius=7 height=12 at=[0,0,socket_z] segments=24 color=#d7c69c metal=0.35 rough=0.3
патрон_подвес = cylinder radius=3 height=rod_top-(socket_z+12) at=[0,0,socket_z+12] segments=20 color=#d7c69c metal=0.35 rough=0.3

# Боковые оси начинаются на торцевых стенках; набалдашники — отдельные детали.
крепление_л = sweep path=[[-120,0,350],[-130,0,350]] radius=5 sides=20 round_caps=0 color=#967532 metal=0.88 rough=0.22
крепление_п = sweep path=[[120,0,350],[130,0,350]] radius=5 sides=20 round_caps=0 color=#967532 metal=0.88 rough=0.22
набалдашник_л = sphere radius=8 at=[-130,0,350] segments=24 color=#967532 metal=0.88 rough=0.22
набалдашник_п = sphere radius=8 at=[130,0,350] segments=24 color=#967532 metal=0.88 rough=0.22

# Внешний задний держатель: ничего не проходит сквозь стекло абажура.
рама_абажура = box size=[160,2,10] at=[0,56,335] color=#967532 metal=0.88 rough=0.23
держатель_л = sweep path=[[-112,55,340],[-112,65,340]] radius=4 sides=16 round_caps=0 color=#967532 metal=0.88 rough=0.23
держатель_п = sweep path=[[112,55,340],[112,65,340]] radius=4 sides=16 round_caps=0 color=#967532 metal=0.88 rough=0.23
держатель_перекладина = sweep path=[[-112,65,340],[112,65,340]] radius=4 sides=16 round_caps=0 color=#967532 metal=0.88 rough=0.23
стойка = sweep path=[[0,0,joint_z+8],[0,8,arm_z1],[0,38,arm_z2],[0,66,arm_z3],[0,65,340]] radius=5.5 sides=20 smooth=4 round_caps=0.12 color=#967532 metal=0.88 rough=0.23

# Цепочка: бусины касаются друг друга, а тонкий сердечник связывает их с наконечником.
крепление_цепочки = sphere radius=2.5 at=[-65,-53.8,307.5] segments=16 color=#967532 metal=0.88 rough=0.22
цепочка_штифт = cylinder radius=1 height=2 at=[-65,-53.8,chain_top+1.5] segments=12 color=#967532 metal=0.88 rough=0.22
бусина = sphere radius=1.5 at=[-65,-53.8,chain_top] segments=10 color=#967532 metal=0.88 rough=0.22
цепочка = array [бусина] mode=linear count=30 offset=[0,0,-3] as=objects
цепочка_сердечник = cylinder radius=0.45 height=chain_top+1.5-tip_z at=[-65,-53.8,tip_z] segments=10 color=#967532 metal=0.88 rough=0.22
наконечник = lathe points=[[0,0],[3.5,0],[4.5,1],[4.2,3],[2.8,8],[2.2,10],[0,10]] segments=24 fillet=0.25 fillet_steps=3 color=#967532 metal=0.88 rough=0.22
translate наконечник offset=[-65,-53.8,tip_z]

check абажур watertight
check вкладыш watertight
check основание watertight
check колонна watertight
check стойка watertight
check основание tris ..6000
check колонна tris ..6000
check абажур tris ..400
check вкладыш tris ..400
check основание gap колонна 0..0.05
check крепление_цепочки gap абажур 0..0.05
check патрон_подвес gap вкладыш 0..0.05
