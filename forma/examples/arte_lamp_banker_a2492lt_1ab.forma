вкладыш = difference [вкладыш_наружный,вкладыш_полость] color=#f2e7c6 rough=0.28

# Лампочка и цоколь видны через настоящую полость.
лампочка = sphere radius=14 at=[0,-8,326] segments=40 color=#fff3cf rough=0.2 emissive=#ffe7a0 emissive_strength=0.35
цоколь = cylinder radius=7 height=12 at=[0,-8,340] segments=40 color=#d7c69c metal=0.35 rough=0.3

# Боковые оси и шаровые набалдашники абажура.
крепление_л = sweep path=[[-130,0,350],[-112,0,350]] radius=5 sides=28 round_caps=0.35 color=#967532 metal=0.88 rough=0.22
крепление_п = sweep path=[[112,0,350],[130,0,350]] radius=5 sides=28 round_caps=0.35 color=#967532 metal=0.88 rough=0.22
набалдашник_л = sphere radius=8 at=[-130,0,350] segments=32 color=#967532 metal=0.88 rough=0.22
набалдашник_п = sphere radius=8 at=[130,0,350] segments=32 color=#967532 metal=0.88 rough=0.22

# П-образный задний держатель и внутренняя рама, соединённая со стойкой.
держатель_л = sweep path=[[-112,0,350],[-112,65,350]] radius=4 sides=24 round_caps=0.25 color=#967532 metal=0.88 rough=0.23
держатель_п = sweep path=[[112,0,350],[112,65,350]] radius=4 sides=24 round_caps=0.25 color=#967532 metal=0.88 rough=0.23
держатель_перекладина = sweep path=[[-112,65,350],[112,65,350]] radius=4 sides=24 round_caps=0.25 color=#967532 metal=0.88 rough=0.23
рама_абажура = sweep path=[[-112,20,350],[112,20,350]] radius=3.5 sides=24 color=#967532 metal=0.88 rough=0.23
кронштейн = sweep path=[[0,45,338],[0,45,350],[0,20,350]] radius=4 sides=24 smooth=4 color=#967532 metal=0.88 rough=0.23

# Цепочка выключателя спереди слева; каждая бусина — отдельный selectable-объект.
крепление_цепочки = sphere radius=2.5 at=[-65,-35,310] segments=20 color=#967532 metal=0.88 rough=0.22
цепочка_штифт = cylinder radius=1 height=6 at=[-65,-35,304] segments=16 color=#967532 metal=0.88 rough=0.22
бусина = sphere radius=1.5 at=[-65,-35,304] segments=12 color=#967532 metal=0.88 rough=0.22
цепочка = array [бусина] mode=linear count=30 offset=[0,0,-4] as=objects
наконечник = lathe points=[[0,0],[3.5,0],[4.5,1],[4.2,3],[2.8,8],[2.2,10],[0,10]] segments=40 fillet=0.25 color=#967532 metal=0.88 rough=0.22
translate наконечник offset=[-65,-35,176]
цепочка_звено = cylinder radius=1 height=3 at=[-65,-35,185] segments=16 color=#967532 metal=0.88 rough=0.22

# Проверки основных деталей остаются в редактируемом исходнике.
check абажур watertight
check вкладыш watertight
check основание watertight
check колонна watertight
check стойка watertight
