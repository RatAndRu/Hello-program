# Форма 3D 0.76.5 — ваза с росписью кистью.
# Самостоятельный пример по мотивам цветочной вазы; это не копия фотографии.
# Цветок нарисован только спереди (со стороны -Y). Дополнительных файлов нет.
# Роспись хранится в сценарии как пространственные мазки, а не как PNG.
# Точки заданы в мировых координатах: при сильном изменении профиля мазки могут сойти с поверхности.
# В GLB цвет относится к треугольникам, поэтому мелкие штрихи могут быть зубчатыми.
# Числа профиля записаны как миллиметры *16: затем scale возвращает реальный размер.
# Это добавляет сегменты по окружности без команды refine.

ваза = lathe points=[
 [0*16,0*16],
 [19*16,0*16],
 [22*16,3*16],
 [26*16,11*16],
 [30*16,20*16],
 [34*16,31*16],
 [38*16,44*16],
 [41*16,58*16],
 [42*16,72*16],
 [42*16,85*16],
 [40*16,100*16],
 [37*16,114*16],
 [33*16,129*16],
 [30*16,140*16],
 [29*16,146*16],
 [28*16,148*16],
 [25*16,148*16],
 [24*16,146*16],
 [25*16,140*16],
 [28*16,129*16],
 [32*16,114*16],
 [35*16,100*16],
 [37*16,85*16],
 [37*16,72*16],
 [36*16,59*16],
 [33*16,46*16],
 [29*16,33*16],
 [25*16,22*16],
 [21*16,13*16],
 [17*16,7*16],
 [0*16,6*16],
] segments=256 smooth=6
# Масштабирование назад даёт больше сегментов для тонкой росписи.
ваза = scale [ваза] factor=0.0625

color ваза #f5f1e6 material=ceramic rough=0.45

# Каждый мазок можно удалить или изменить отдельно.
