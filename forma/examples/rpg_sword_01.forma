# Магический меч «Изумрудная жила» — RPG-ассет, общая длина 1 300 мм.
# Ось клинка — Z: 0 — низ навершия, 1 296 — острие.
#
# КОНСТРУКЦИЯ — как у настоящего полуторного меча:
#   • клинок с ПРОФИЛЬНЫМ (86 → 1,5 мм) и ДИСТАЛЬНЫМ (10 → 0,6 мм) конусом;
#     сечение шестигранное: две плоские грани (кристалл) и две кромки;
#   • по кромкам — золотой обод, по граням — светящиеся жилы;
#   • рикассо закрыто золочёной обоймой, плечи клинка входят в экюссон гарды;
#   • гарда: экюссон + два S-образных пера с гранёными шипами и кабошонами,
#     сверху — лангеты (накладки) на пласть клинка;
#   • рукоять с талией под хват, обмотана шнуром по винтовой линии
#     (9 витков), сверху и снизу — латунные феррулы;
#   • навершие гранёное, с кабошоном; хвостовик расклёпан в нём.
#
# Канон осей: +Z — острие, −Y — передняя пласть, +X — право.

precision mode=fine tolerance=0.12

# ------------------------------------------------------------------ клинок --
сеч_клинка = [
  [[-43.00,0.00],[-17.20,5.00],[17.20,5.00],[43.00,0.00],[17.20,-5.00],[-17.20,-5.00]],
  [[-44.00,0.00],[-17.60,4.95],[17.60,4.95],[44.00,0.00],[17.60,-4.95],[-17.60,-4.95]],
