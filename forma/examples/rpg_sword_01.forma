шип_пр = translate [шип] offset=[128, 0, 302]
шип_лв = rotate [шип_пр] angle=180 axis=z
color шип_пр #b8913f material=gold rough=0.25 visible=да
color шип_лв #b8913f material=gold rough=0.25

