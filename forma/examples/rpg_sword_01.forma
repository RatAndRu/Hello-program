  [[-22.50,0.00],[-9.00,2.00],[9.00,2.00],[22.50,0.00],[9.00,-2.00],[-9.00,-2.00]],
  [[-17.00,0.00],[-6.80,1.50],[6.80,1.50],[17.00,0.00],[6.80,-1.50],[-6.80,-1.50]],
  [[-12.00,0.00],[-4.80,1.05],[4.80,1.05],[12.00,0.00],[4.80,-1.05],[-4.80,-1.05]],
  [[-6.50,0.00],[-2.60,0.65],[2.60,0.65],[6.50,0.00],[2.60,-0.65],[-2.60,-0.65]],
  [[-0.75,0.00],[-0.30,0.30],[0.30,0.30],[0.75,0.00],[0.30,-0.30],[-0.30,-0.30]],
]
клинок = loft sections=сеч_клинка positions=[356,420,500,600,700,800,900,990,1070,1140,1200,1245,1280,1296] axis=z smooth=3
color клинок #3ddc8d material=plastic rough=0.1

# --------------------------------------------------------- обойма рикассо --
рикассо = box size=[92, 18, 56] at=[0, 0, 356] round=4
color рикассо #c9a24b material=gold rough=0.22

# --------------------------------------------------------------- гарда -----
экюссон = box size=[84, 42, 26] at=[0, 0, 330] round=5
экюссон_верх = box size=[64, 34, 14] at=[0, 0, 356] round=4 top_size=[54, 28]
лангет_п = box size=[28, 4, 62] at=[0, -7.5, 350] round=2
лангет_з = box size=[28, 4, 62] at=[0, 7.5, 350] round=2
гарда = union [экюссон, экюссон_верх, лангет_п, лангет_з]
color гарда #c9a24b material=gold rough=0.2

перо_пр = sweep path=[[6,0,342],[42,0,352],[80,0,355],[110,0,347],[130,0,330]] radius=9.5 smooth=8 scale_curve=[1.3,1.15,1.0,0.8,0.55]
перо_лв = rotate [перо_пр] angle=180 axis=z
color перо_пр #c9a24b material=gold rough=0.2 visible=да
color перо_лв #c9a24b material=gold rough=0.2

сеч_шипа = [
