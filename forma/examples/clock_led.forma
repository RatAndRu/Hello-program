# ============================================================================
#  НАСТОЛЬНЫЕ ЧАСЫ С ГОРЯЩИМ СВЕТОДИОДНЫМ ЦИФЕРБЛАТОМ
# ============================================================================
#  Корпус — один сварной объём (fuse): стойка плавно переходит в рамку,
#  без «приставленных» друг к другу кубиков.
#  Экран тёмный, стекло прозрачное (transmission), цифры светятся: материал
#  led + emissive. В окне при наличии эмиссии сам включается bloom.
#  Габарит ≈ 210 × 62 × 130 мм. Лицо смотрит в −Y, ось Z — вверх.
# ----------------------------------------------------------------------------
#  Подсказка по координатам: у примитивов `at` опускает низ детали на z,
#  у `place … align=center` — ставит центр габарита в точку.
# ============================================================================

scene bg=#0a0c10 env=studio shadows=да grid=нет

# ---------- КОРПУС: стойка + блок + скос, сваренные в одно ----------
стойка = box size=[200,62,34] round=8 at=[0,0,0] color=#1b1e24 material=plastic
блок = box size=[210,52,96] round=12 at=[0,0,20] color=#1b1e24 material=plastic
скос = box size=[188,20,26] round=6 at=[0,-14,8] color=#1b1e24
корпус = fuse [стойка, блок, скос] radius=9 edges=все

# ---------- НИША ПОД ЭКРАН ----------
ниша = box size=[188,26,78] round=6 at=[0,-24,27]
корпус = difference [корпус, ниша]

# ---------- ЭКРАН И СТЕКЛО ----------
экран = box size=[184,3,74] round=1.4 at=[0,-22,29] material=screen color=#0d1410
стекло = box size=[186,1.4,76] round=0.7 at=[0,-27,28] material=glass
color стекло #7fd6e8 transmission=0.72 rough=0.04 metal=0

# ---------- ЦИФРЫ ----------
цифры = seven_seg text="21:38" height=54 width=26 thick=8.2 gap=11 depth=2.2
цифры = rotate [цифры] angle=90 axis=x
цифры = place [цифры] at=[0,-25.4,66] align=center
color цифры #2bff72 emissive=#2bff72 emissive_strength=4.5

# индикатор включения — маленькая точка слева
точка = sphere radius=2.6 at=[-76,-23.5,38] color=#ff4d5a emissive=#ff4d5a emissive_strength=5

# ---------- ЗАДНЯЯ КРЫШКА И НОЖКИ ----------
крышка = box size=[150,6,62] round=3 at=[0,26,34] color=#15171c material=plastic
ножка_1 = cylinder radius=7 height=8 at=[-74,0,0] color=#0f1114
ножка_2 = cylinder radius=7 height=8 at=[74,0,0] color=#0f1114

# ---------- ПРОВЕРКИ ----------
check корпус watertight
check корпус size 208..212 60..64 114..118
check экран watertight
check цифры watertight
check цифры size 150..162 1..4 52..56
check стекло watertight

# ---------- МАТЕРИАЛ ----------
color корпус #1b1e24 material=plastic
color крышка #15171c material=plastic
color ножка_1 #0f1114
color ножка_2 #0f1114
