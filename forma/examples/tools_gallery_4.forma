# ============================================================================
#  ВЫСТАВКА ИНСТРУМЕНТОВ 0.49 — ЧАСТЬ 4/4: ВАФЛЯ, ВОЛОСЫ И РЕЛЬЕФ
#  Пять стендов из прежнего четырёхрядного проекта; упрощена только
#  учебная тесселяция/плотность, не геометрические возможности инструментов.
# ============================================================================
scene bg=#eef1f4 env=studio shadows=да grid=нет
light preset=студия strength=1.1

подиум = box size=[1400,330,20] round=8 at=[0,-450,0]
color подиум #d7dde3 rough=0.72

# ---------- РЯД 4: ВАФЛЯ, ВОЛОСЫ, РЕЛЬЕФ И ПОКРАСКА ----------
# 16. corrugate / вафля: двумерный узор, тем же шагом отличается от рифления.
вафля = sheet width=105 length=145 thickness=1
вафля = corrugate [вафля] mode=вафля step=18 amp=5 angle=0 detail=4
вафля = translate [вафля] offset=[-520,-450,20]
color вафля #d5c9a8 metal=.15 rough=0.5
подпись_вафля = text "ВАФЛЯ" size=15 depth=1 plane=xy at=[-520,-545,20] color=#33404d

# 17. hair / иголки: корни только на верхней грани цилиндра, головы нет.
иголки = cylinder radius=43 height=28 segments=32
иголки = hair [иголки] style=иголки surface=верх count=32 length=22 thick=1.6 spread=.18 seed=4
иголки = translate [иголки] offset=[-260,-450,20]
color иголки #8797a5 rough=0.5
подпись_иголки = text "ИГОЛКИ" size=15 depth=1 plane=xy at=[-260,-545,20] color=#33404d

# 18. hair / локоны: 14 витых прядей на выбранной поверхности, одно тело.
локоны = cylinder radius=43 height=28 segments=32
локоны = hair [локоны] style=локоны surface=верх count=10 length=24 thick=2.2 turns=1.3 seed=5
локоны = translate [локоны] offset=[0,-450,20]
color локоны #8e7466 rough=0.65
подпись_локоны = text "ЛОКОНЫ" size=15 depth=1 plane=xy at=[0,-545,20] color=#33404d

# 19. relief: встроенная docs/pattern.png, image специально не задан.
рельеф = box size=[125,100,12]
рельеф = relief [рельеф] depth=2 mode=плоскость detail=3
рельеф = translate [рельеф] offset=[260,-450,20]
color рельеф #c8d1c4 rough=0.6
подпись_рельеф = text "RELIEF" size=15 depth=1 plane=xy at=[260,-545,20] color=#33404d

# 20. pattern: покраска, не рельеф; куб сам разбивается под круги 10 мм.
узор = box size=[80,80,80]
color узор #f0e6cf rough=0.55
pattern узор #b44b3e shape=круги size=14 step=24
узор = translate [узор] offset=[520,-450,60]
подпись_узор = text "PATTERN" size=15 depth=1 plane=xy at=[520,-545,20] color=#33404d

# Проверяются реальные тела этого ряда и его подиум.
check подиум watertight
check подиум parts 1
check вафля watertight
check иголки watertight
check иголки parts 1
check локоны watertight
check локоны parts 1
check рельеф watertight
check узор watertight
check узор parts 1
