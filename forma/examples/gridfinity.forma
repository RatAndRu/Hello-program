ящик_b = difference [оболочка, полость]


# Ящики ставятся ЦЕНТРОМ В ЯЧЕЙКУ: у плиты 2×2 центры карманов (±21, ±21).
# Низ ящика лежит на дне кармана — 0.15 мм над нижней плоскостью плиты.
ящик_a = place [ящик_a] at=[-21,-21,0.15]
ящик_b = place [ящик_b] at=[0,21,0.15]
# group, а не union: ящики стоят на плите, но остаются отдельными деталями —
# так видно, что это сборка, и не появляются совпадающие грани на дне кармана.
сборка = group [плита, ящик_a, ящик_b]

check плита watertight
check ящик_a watertight
check ящик_b watertight
