# ============================================================================
#  ВИТРИНА ИНСТРУМЕНТОВ — 1400 × 950 мм
# ============================================================================
#  Каждый предмет сделан своим инструментом: примитив, тело вращения,
#  протяжка, массив (линейный, круговой, сеткой), оболочка, отверстия,
#  готовые узлы (колесо, вал, муфта, радиатор, рейка, ручка, коробка).
#  Один и тот же редактор закрывает посуду, механику, крепёж, мебель и
#  природу — без сторонних моделей.
# ----------------------------------------------------------------------------

scene bg=#eef1f4 env=studio shadows=да grid=нет
light preset=студия strength=1.05

# ---------- ПОДИУМ: корпус с полостью и низким бортиком ----------
подиум = box_body size=[1400, 1100, 70] wall=24 bottom=16 round=22 segments=12
внутренность = box size=[1360, 1060, 34] round=8 center=да at=[0, 0, 81]
бортик = box size=[1436, 1136, 12] round=6 center=да at=[0, 0, 70]
бортик = difference [бортик, внутренность]
подиум = union [подиум, бортик]

# ---------- ПОДСТАВКИ: сетка 5 × 3 ----------
подставка = cylinder radius=76 height=24 segments=64
подставки = array [подставка] count=1 mode=grid counts=[5,4,1] spacing=[270, 280, 0]
подставки = translate [подставки] offset=[-540, -420, 70]

# ---------- ЛИНЕЙНЫЙ МАССИВ: ряд латунных штифтов по бортику ----------
штифт = cylinder radius=7 height=12 segments=28
ряд_штифтов = array [штифт] count=13 mode=linear offset=[100, 0, 0]
ряд_штифтов = translate [ряд_штифтов] offset=[-600, 537, 76]

# ---------- ЗАДНИЙ РЯД: посуда и украшения ----------
ваза = lathe points=[[0,0],[64,0],[70,8],[58,26],[74,120],[96,170],[104,206],
                     [98,214],[92,206],[84,174],[64,126],[50,30],[56,8],[0,8]]
ваза = translate [ваза] offset=[-540, 420, 86]
кубок = cup diameter=104 height=132 wall=3.2 bottom=7 handle=да
кубок = translate [кубок] offset=[-270, 420, 86]
тарелка = plate diameter=210 depth=26 wall=3.5
тарелка = translate [тарелка] offset=[0, 420, 86]
звезда = star points=7 outer=88 inner=38 depth=14 bevel=3 smooth=0.5
звезда = translate [звезда] offset=[270, 420, 86]
кольцо = torus major=62 minor=14 segments=72
кольцо = translate [кольцо] offset=[540, 420, 110]

# ---------- СРЕДНИЙ РЯД: механизм ----------
шестерня = gear teeth=28 module=2 thickness=12 bore=16 hub=30
шестерня = rotate [шестерня] angle=90 axis=x
шестерня = translate [шестерня] offset=[-540, 140, 124]
пружина = spring diameter=40 wire=4 turns=9 pitch=9
пружина = translate [пружина] offset=[-270, 140, 86]
лепесток = extrude profile=[[-18,-52],[0,-22],[18,-52],[52,-18],[22,0],[52,18],
                            [18,52],[0,22],[-18,52],[-52,18],[-22,0],[-52,-18]] height=12 fillet=3
турбина = array [лепесток] count=12 mode=radial around=z center=[0, 0, 0]
турбина = translate [турбина] offset=[0, 140, 95]
колесо = wheel diameter=230 width=84 rim=18 spokes=6 hub=40
колесо = translate [колесо] offset=[270, 140, 86]
вал = shaft diameter=34 length=190 chamfer=2 bore=8
вал = rotate [вал] angle=90 axis=x
вал = translate [вал] offset=[540, 140, 102]

# ---------- ПЕРЕДНИЙ РЯД: техника, мебель, природа ----------
плитка = box size=[96, 132, 12] round=3 center=да at=[0, 0, 0]
плитка = holes [плитка] grid=[3,4] diameter=8 pitch=[28,30]
плитки = array [плитка] count=1 mode=grid counts=[3,2,1] spacing=[112, 150, 0]
плитки = translate [плитки] offset=[-540, -140, 102]
рейка = rack length=210 teeth=21 module=2 thickness=10 height=14
рейка = translate [рейка] offset=[0, -140, 86]
муфта = coupling diameter=64 length=76 bore=20
муфта = translate [муфта] offset=[540, -140, 102]
радиатор = heatsink size=[150, 96, 58] fins=11
радиатор = translate [радиатор] offset=[270, -140, 86]
камень = rock size=[170, 130, 78] seed=7 rough=0.42
камень = translate [камень] offset=[0, -450, 86]
ветка = branch length=190 diameter=20 taper=0.55 bend=[40, 20]
ветка = rotate [ветка] angle=90 axis=y
ветка = translate [ветка] offset=[0, -390, 128]
лист = leaf length=74 width=40 thickness=2 curl=0.3
листва = scatter [лист] count=14 area=[250, 210] seed=12 scale=[0.7, 1.2] z=0
листва = translate [листва] offset=[270, -420, 88]

# ---------- СВОБОДНЫЕ МЕСТА: труба, коробка, скульптура ----------
труба = pipe path=[[0,0,0],[0,0,130],[54,0,184],[130,0,184],[170,0,144]] diameter=26 wall=2.5
труба = translate [труба] offset=[-270, -140, 86]
ящик = box_body size=[200, 150, 104] wall=5 bottom=7 round=10
ящик = translate [ящик] offset=[-540, -420, 86]
ручка = handle length=140 height=28 diameter=8
ручка = translate [ручка] offset=[-540, -499, 110]
ящик = union [ящик, ручка]

# ---------- ОБОЛОЧКА: скульптура ----------
низ_скульптуры = prism sides=6 radius=76 height=58 center=да at=[0, 0, 29]
верх_скульптуры = sphere radius=62 segments=48 at=[0, 0, 100]
скульптура = hull objects=[низ_скульптуры, верх_скульптуры]
скульптура = translate [скульптура] offset=[-270, -420, 86]

призма = prism sides=6 radius=56 height=140 center=да at=[540, -420, 96]

# ---------- НОВЫЕ ИНСТРУМЕНТЫ (0.17) ----------
направляющая = rail length=300 width=30 height=14 wall=2
направляющая = translate [направляющая] offset=[180, -470, 96]
профиль = profile2020 length=280 size=20
профиль = rotate [профиль] angle=90 axis=x
профиль = translate [профиль] offset=[330, -420, 96]
панель = panel size=[200, 140, 22] wall=3 round=8
панель = translate [панель] offset=[500, -330, 96]
люверс = grommet diameter=14 height=9 wall=1.8 flange=3
люверс = translate [люверс] offset=[380, -500, 96]
червяк = worm length=110 diameter=30 pitch=8 depth=4
червяк = rotate [червяк] angle=90 axis=x
червяк = translate [червяк] offset=[250, -330, 120]
колесо_червя = gear teeth=40 module=2 thickness=10 bore=6
колесо_червя = rotate [колесо_червя] angle=90 axis=x
колесо_червя = rotate [колесо_червя] angle=90 axis=y
колесо_червя = translate [колесо_червя] offset=[250, -330, 190]
рог = horn length=150 radius=20 tip=3 bend=48
рог = translate [рог] offset=[120, -330, 96]
ручка_накатка = cylinder radius=16 height=70 segments=48
ручка_накатка = knurl [ручка_накатка] count=22 depth=1
ручка_накатка = translate [ручка_накатка] offset=[620, -470, 96]

# ---------- ПРОВЕРКИ ----------
check подиум watertight
check подиум parts 1
check подиум size 1434..1438 1134..1138 74..78
check подставки parts 20
check ряд_штифтов parts 13
check ваза watertight
check ваза parts 1
check кубок watertight
check кубок parts 1
check шестерня parts 1
check турбина parts 1
check колесо parts 1
check вал parts 1
check плитки parts 6
check муфта watertight
check муфта parts 1
check рейка parts 1
check радиатор parts 1
check труба watertight
check труба parts 1
check камень watertight
check камень parts 1
check скульптура watertight
check скульптура parts 1
check призма parts 1
check призма watertight
check ящик watertight
check ящик parts 1
check направляющая parts 1
check направляющая watertight
check профиль parts 1
check профиль watertight
check панель parts 1
check панель watertight
check люверс parts 1
check люверс watertight
check червяк parts 1
check червяк watertight
check колесо_червя parts 1
check рог parts 1
check рог watertight
check ручка_накатка parts 1
check ручка_накатка watertight
check ваза height 212..216
check колесо height 228..232

# ---------- МАТЕРИАЛ ----------
color подиум #2f333b rough=0.55 metal=0.15
color подставки #4c525b rough=0.5 metal=0.2
color ряд_штифтов #d8b263 metal=0.9 rough=0.25
color ваза #a05f38 rough=0.45
color кубок #e6e0d4 rough=0.4
color тарелка #eae6dc rough=0.45
color звезда #d8a93f metal=0.85 rough=0.25
color кольцо #c9a45c metal=0.9 rough=0.2
color шестерня #9aa0a6 metal=0.8 rough=0.3
color пружина #b9bec4 metal=0.9 rough=0.2
color турбина #c98f4e metal=0.7 rough=0.3
color колесо #23252a metal=0.4 rough=0.7
color вал #aeb4ba metal=0.9 rough=0.22
color плитки #7d8288 metal=0.5 rough=0.4
color муфта #7d838a metal=0.85 rough=0.3
color рейка #9aa0a6 metal=0.8 rough=0.3
color радиатор #b7bdc4 metal=0.9 rough=0.24
color труба #6f8f9c metal=0.7 rough=0.3
color камень #77726a rough=0.85
color ветка #6b4a2f rough=0.75
color листва #4f7f45 rough=0.7
color ящик #a8794a rough=0.6
color скульптура #b9c2c9 metal=0.3 rough=0.35
color призма #cfd6dc metal=0.2 rough=0.4
color направляющая #9aa0a6 metal=0.85 rough=0.28
color профиль #b9c0c8 metal=0.9 rough=0.24
color панель #7d8288 metal=0.5 rough=0.4
color люверс #c9a45c metal=0.9 rough=0.2
color червяк #b0b6bd metal=0.9 rough=0.22
color колесо_червя #d8b263 metal=0.85 rough=0.25
color рог #d9c7a3 rough=0.5
color ручка_накатка #3a3e45 metal=0.8 rough=0.35
