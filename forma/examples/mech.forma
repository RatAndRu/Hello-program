# Механика 0.40: лестница, рычаг, кнопка, треугольная призма и сектор тора.
# Каждый предмет — одна команда; кнопка сразу даёт ДВЕ детали.

# --- лестница: форма реек и перекладин настраивается ---
приставная = ladder length=1800 width=420 rungs=9 tilt=72 at=[-900,0,0]
деревянная = ladder length=1500 width=380 rail=брусок rail_d=44 rung=брусок rung_d=34 rungs=7 tilt=84 at=[-300,0,0]
стремянка = ladder length=1200 width=340 rail=овал rail_d=32 rungs=6 tilt=90 at=[300,0,0]

# --- рычаг: палка и ручка разных форм ---
джойстик = lever length=180 diameter=14 knob=шар knob_d=34 at=[-900,0,2100]
педаль = lever length=260 shaft=брусок size=20 knob=цилиндр knob_d=30 knob_h=70 angle=18 at=[-600,0,2100]
ворот = lever length=140 shaft=брусок size=20 knob=цилиндр knob_d=30 knob_h=60 at=[-250,0,2100]
флажок = lever length=200 diameter=10 knob=шар knob_d=26 angle=35 at=[100,0,2100]

# --- кнопка: шляпка + гнездо, две отдельные детали ---
пуск = button diameter=30 height=10 top=вогнутая at=[500,0,2200]
аварийная = button diameter=60 height=18 top=выпуклая base_d=110 base_h=14 at=[700,0,2200]
тумблер = button diameter=34 height=12 fit=зазор gap=3 base=квадрат at=[900,0,2200]

# --- треугольная призма с произвольными углами ---
клин = tri_prism a=120 b=90 c=60 height=80 at=[1100,0,0]
прямоугольная = tri_prism a=100 b=80 c=60 height=60 at=[1400,0,0]
по_углам = tri_prism base=100 angle_a=30 angle_b=120 height=50 at=[1650,0,0]

# --- сектор тора: дуга бублика, при hole>0 — с отверстием ---
полукольцо = torus_sector major=60 minor=10 angle=180 at=[1100,0,500]
подвес = torus_sector major=50 minor=12 angle=200 hole=8 at=[1350,0,500]
звено = torus_sector major=30 minor=8 angle=300 hole=6 at=[1580,0,500]

# Кнопка — это два объекта: `пуск` — сама шляпка (её и двигают ради
# анимации нажатия), `пуск_гнездо` — неподвижная платформа.
