# СХЕМА ОРИЕНТАЦИИ — ЭКСПЕРИМЕНТАЛЬНЫЙ МАКЕТ, НЕ ГОТОВЫЙ ФАЙЛ ДЛЯ ПЕЧАТИ.
# На столе только 7 видимых тел: многоцветный корпус (5 тел), крышка и кнопка.
# Электроника, крепёж и батарея скрыты. Многоцветная нарезка и печать не проверены.
# Этот файл воспроизводится утилитой tools/make_clover_led_compact_print_layout.py.
# Посадки, сборка, прочность и безопасность не подтверждены.

# КОМПАКТНЫЙ КЛЕВЕР — ИЛЛЮСТРАТИВНЫЙ 3D-КОНЦЕПТ, НЕ ДЛЯ ПЕЧАТИ.
# В сцене есть условные держатель 31×23×6, батарейка, Pololu 2808, LED,
# провода и головки винтов ниже СКРЫТЫ. Их реальные размеры,
# размещение, крепление, проводка, усилие, допуски и безопасность НЕ ПРОВЕРЕНЫ.
# Это не готовый механизм. Перед изготовлением нужны детали и физические тесты.
# Лицо +Z; плата и отсеки показаны условно, а не как заводские CAD-модели.
# Короткие нажатия могут чередовать вкл/выкл только при покупке, подключении
# и подходящем питании отдельного электронного модуля Pololu 2808 LV.
# Штатный ползунок держателя должен оставаться в ON; провода нужно подключить
# к модулю и LED, а совместимость реальной проводки необходимо проверить.
# Подробнее: forma/docs/clover_led_compact_concept.md
# Цветок 57×57 мм, с ушком и крышкой ориентировочно 57×65×19,3 мм.
# Макет отсека и камера проводов сдвинуты на -2,6 мм вдоль своей оси.
# Четыре одинаковых цветных тела предназначены для рассмотрения печати
# вместе с корпусом лицом к столу. Слайсер и печать НЕ ПРОВЕРЕНЫ.

# ---------------- Симметричный контур и цветные листочки ----------------
контур = contour2d start=[0,26] segments=[["bezier",[[0.0,26.0],[2.3,26.0],[3.0,28.5],[6.7,28.5]]],["bezier",[[6.7,28.5],[12.5,28.5],[16.5,24.0],[16.5,21.0]]],["bezier",[[16.5,21.0],[16.5,20.7],[16.7,18.3],[17.5,17.5]]],["bezier",[[17.5,17.5],[18.3,16.7],[20.7,16.5],[21.0,16.5]]],["bezier",[[21.0,16.5],[24.0,16.5],[28.5,12.5],[28.5,6.7]]],["bezier",[[28.5,6.7],[28.5,3.0],[26.0,2.3],[26.0,0.0]]],["bezier",[[26.0,0.0],[26.0,-2.3],[28.5,-3.0],[28.5,-6.7]]],["bezier",[[28.5,-6.7],[28.5,-12.5],[24.0,-16.5],[21.0,-16.5]]],["bezier",[[21.0,-16.5],[20.7,-16.5],[18.3,-16.7],[17.5,-17.5]]],["bezier",[[17.5,-17.5],[16.7,-18.3],[16.5,-20.7],[16.5,-21.0]]],["bezier",[[16.5,-21.0],[16.5,-24.0],[12.5,-28.5],[6.7,-28.5]]],["bezier",[[6.7,-28.5],[3.0,-28.5],[2.3,-26.0],[0.0,-26.0]]],["bezier",[[0.0,-26.0],[-2.3,-26.0],[-3.0,-28.5],[-6.7,-28.5]]],["bezier",[[-6.7,-28.5],[-12.5,-28.5],[-16.5,-24.0],[-16.5,-21.0]]],["bezier",[[-16.5,-21.0],[-16.5,-20.7],[-16.7,-18.3],[-17.5,-17.5]]],["bezier",[[-17.5,-17.5],[-18.3,-16.7],[-20.7,-16.5],[-21.0,-16.5]]],["bezier",[[-21.0,-16.5],[-24.0,-16.5],[-28.5,-12.5],[-28.5,-6.7]]],["bezier",[[-28.5,-6.7],[-28.5,-3.0],[-26.0,-2.3],[-26.0,0.0]]],["bezier",[[-26.0,0.0],[-26.0,2.3],[-28.5,3.0],[-28.5,6.7]]],["bezier",[[-28.5,6.7],[-28.5,12.5],[-24.0,16.5],[-21.0,16.5]]],["bezier",[[-21.0,16.5],[-20.7,16.5],[-18.3,16.7],[-17.5,17.5]]],["bezier",[[-17.5,17.5],[-16.7,18.3],[-16.5,20.7],[-16.5,21.0]]],["bezier",[[-16.5,21.0],[-16.5,24.0],[-12.5,28.5],[-6.7,28.5]]],["bezier",[[-6.7,28.5],[-3.0,28.5],[-2.3,26.0],[0.0,26.0]]]] closed=да tolerance=0.025
заготовка_корпуса = extrude profile=контур height=17.3
заготовка_корпуса = translate [заготовка_корпуса] offset=[0,0,-14.3]
защита_цвета = cylinder radius=4.6 height=1.8 segments=96 at=[0,0,1.6]
рез_лист_верх_мест = heart width=26 depth=1.4 plane=flat at=[0,14,1.8]
рез_лист_верх = rotate [рез_лист_верх_мест] angle=0 axis=z
рез_лист_верх = difference [рез_лист_верх,защита_цвета]
лист_верх_мест = heart width=26 depth=1.2 plane=flat at=[0,14,1.8]
лист_верх = rotate [лист_верх_мест] angle=0 axis=z
лист_верх = difference [лист_верх,защита_цвета]
color лист_верх #66d976 rough=0.6
рез_лист_право_мест = heart width=26 depth=1.4 plane=flat at=[0,14,1.8]
рез_лист_право = rotate [рез_лист_право_мест] angle=-90 axis=z
рез_лист_право = difference [рез_лист_право,защита_цвета]
лист_право_мест = heart width=26 depth=1.2 plane=flat at=[0,14,1.8]
лист_право = rotate [лист_право_мест] angle=-90 axis=z
лист_право = difference [лист_право,защита_цвета]
color лист_право #f5c84c rough=0.6
рез_лист_низ_мест = heart width=26 depth=1.4 plane=flat at=[0,14,1.8]
рез_лист_низ = rotate [рез_лист_низ_мест] angle=180 axis=z
рез_лист_низ = difference [рез_лист_низ,защита_цвета]
лист_низ_мест = heart width=26 depth=1.2 plane=flat at=[0,14,1.8]
лист_низ = rotate [лист_низ_мест] angle=180 axis=z
лист_низ = difference [лист_низ,защита_цвета]
color лист_низ #eb6b83 rough=0.6
рез_лист_лево_мест = heart width=26 depth=1.4 plane=flat at=[0,14,1.8]
рез_лист_лево = rotate [рез_лист_лево_мест] angle=90 axis=z
рез_лист_лево = difference [рез_лист_лево,защита_цвета]
лист_лево_мест = heart width=26 depth=1.2 plane=flat at=[0,14,1.8]
лист_лево = rotate [лист_лево_мест] angle=90 axis=z
лист_лево = difference [лист_лево,защита_цвета]
color лист_лево #41bfd0 rough=0.6

# Гнездо держателя в локальных координатах, затем поворот на 45°.
# Верхний торец условного держателя — Y=+9,9, скруглённый — Y=-21,1.
# Камера проводов заканчивается на Y=+21,4. Гнездо заканчивается на Z=-4;
# условный держатель опирается здесь на подложку, а не висит на проводах.
# При печати лицом к столу камера открывается вверх; опора и её прочность
# требуют проверки на настоящем держателе и пробном образце.
D_прямой = box size=[23.6,19.8,10.4] at=[0,0.3,-14.4]
D_круг = cylinder radius=11.8 height=10.4 segments=96 at=[0,-9.6,-14.4]
D_местный = union [D_прямой,D_круг]
D_вырез = rotate [D_местный] angle=45 axis=z
камера_блок = box size=[16,5.8,10.4] at=[0,10.5,-14.4]
камера_круг = cylinder radius=8 height=10.4 segments=96 at=[0,13.4,-14.4]
камера_местная = union [камера_блок,камера_круг]
камера = rotate [камера_местная] angle=45 axis=z
# Скруглённый запас слева от петли: без острого угла на маршруте.
карман_петли_серед = box size=[3,4,10.4] at=[-4.3,19.2,-14.4]
карман_петли_конец1 = cylinder radius=2 height=10.4 segments=48 at=[-5.8,19.2,-14.4]
карман_петли_конец2 = cylinder radius=2 height=10.4 segments=48 at=[-2.8,19.2,-14.4]
карман_петли_мест = union [карман_петли_серед,карман_петли_конец1,карман_петли_конец2]
карман_петли = rotate [карман_петли_мест] angle=45 axis=z
# Две боковые дорожки: это запас пространства, не готовая трасса проводов.
канал_л_сред = box size=[2.4,6,10.4] at=[-9,11,-14.4]
канал_л_конец1 = cylinder radius=1.2 height=10.4 segments=32 at=[-9,8,-14.4]
канал_л_конец2 = cylinder radius=1.2 height=10.4 segments=32 at=[-9,14,-14.4]
канал_п_сред = box size=[2.4,6,10.4] at=[9,11,-14.4]
канал_п_конец1 = cylinder radius=1.2 height=10.4 segments=32 at=[9,8,-14.4]
канал_п_конец2 = cylinder radius=1.2 height=10.4 segments=32 at=[9,14,-14.4]
каналы_местные = union [канал_л_сред,канал_л_конец1,канал_л_конец2,канал_п_сред,канал_п_конец1,канал_п_конец2]
каналы = rotate [каналы_местные] angle=45 axis=z
# Канал ближе к лицу: проводка и резистор; плавные концы в плане.
лицевой_канал_прямой = box size=[8,14,4.2] at=[0,6,-4.1]
лицевой_канал_начало = cylinder radius=4 height=4.2 segments=64 at=[0,-1,-4.1]
лицевой_канал_конец = cylinder radius=4 height=4.2 segments=64 at=[0,13,-4.1]
лицевой_канал_местный = union [лицевой_канал_прямой,лицевой_канал_начало,лицевой_канал_конец]
лицевой_канал = rotate [лицевой_канал_местный] angle=45 axis=z
# Вертикальное отверстие LED расширяется в сторону полости, а не образует
# нависающую внутреннюю полку при печати лицом вниз.
LED_сквозное = cylinder radius=2.65 height=7.3 segments=96 at=[0,0,-4.1]
LED_буртик_вырез = cylinder radius=3.25 height=4.9 segments=96 at=[0,0,-4.1]

# Облегчающие сердцевидные выемки открыты назад; у каждого винта остаётся кольцо R3,2.
защита_винта1 = cylinder radius=3.2 height=10.3 segments=96 at=[0,21.5,-14.4]
пилот1 = cylinder radius=0.85 height=6.4 segments=48 at=[0,21.5,-14.4]
защита_винта2 = cylinder radius=3.2 height=10.3 segments=96 at=[21.5,0,-14.4]
пилот2 = cylinder radius=0.85 height=6.4 segments=48 at=[21.5,0,-14.4]
защита_винта3 = cylinder radius=3.2 height=10.3 segments=96 at=[0,-21.5,-14.4]
пилот3 = cylinder radius=0.85 height=6.4 segments=48 at=[0,-21.5,-14.4]
защита_винта4 = cylinder radius=3.2 height=10.3 segments=96 at=[-21.5,0,-14.4]
пилот4 = cylinder radius=0.85 height=6.4 segments=48 at=[-21.5,0,-14.4]
вес_верх_мест = heart width=20 depth=9.8 plane=flat at=[0,14,-14.4]
вес_верх_заг = rotate [вес_верх_мест] angle=0 axis=z
вес_верх = difference [вес_верх_заг,защита_винта1,защита_винта2,защита_винта3,защита_винта4]
вес_право_мест = heart width=20 depth=9.8 plane=flat at=[0,14,-14.4]
вес_право_заг = rotate [вес_право_мест] angle=-90 axis=z
вес_право = difference [вес_право_заг,защита_винта1,защита_винта2,защита_винта3,защита_винта4]
вес_низ_мест = heart width=20 depth=9.8 plane=flat at=[0,14,-14.4]
вес_низ_заг = rotate [вес_низ_мест] angle=180 axis=z
вес_низ = difference [вес_низ_заг,защита_винта1,защита_винта2,защита_винта3,защита_винта4]
вес_лево_мест = heart width=20 depth=9.8 plane=flat at=[0,14,-14.4]
вес_лево_заг = rotate [вес_лево_мест] angle=90 axis=z
вес_лево = difference [вес_лево_заг,защита_винта1,защита_винта2,защита_винта3,защита_винта4]
корпус_черновик = difference [заготовка_корпуса,рез_лист_верх,рез_лист_право,рез_лист_низ,рез_лист_лево,D_вырез,камера,карман_петли,каналы,лицевой_канал,LED_сквозное,LED_буртик_вырез,вес_верх,вес_право,вес_низ,вес_лево,пилот1,пилот2,пилот3,пилот4]
# Ушко начинается прямо на лицевой плоскости Z=3 и может лечь на стол.
мостик_ушка = box size=[5.4,8,3.8] at=[0,29,-0.8]
край_ушка = cylinder radius=5 height=3.8 segments=96 at=[0,31.5,-0.8]
ушко_заг = union [мостик_ушка,край_ушка]
отверстие_ушка = cylinder radius=2.5 height=4.2 segments=96 at=[0,31.5,-1]
ушко = difference [ушко_заг,отверстие_ушка]
корпус_клевера = union [корпус_черновик,ушко]
color корпус_клевера #185b3a rough=0.58

# ----------------------- Одноцветная крышка -------------------------------
крышка_заг = extrude profile=контур height=2
крышка_заг = translate [крышка_заг] offset=[0,0,-16.3]

отв_крышки1 = cylinder radius=1.1 height=2.2 segments=48 at=[0,21.5,-16.4]
зенковка1 = cylinder radius=1.9 r2=1.1 height=0.8 segments=48 at=[0,21.5,-16.4]
отв_крышки2 = cylinder radius=1.1 height=2.2 segments=48 at=[21.5,0,-16.4]
зенковка2 = cylinder radius=1.9 r2=1.1 height=0.8 segments=48 at=[21.5,0,-16.4]
отв_крышки3 = cylinder radius=1.1 height=2.2 segments=48 at=[0,-21.5,-16.4]
зенковка3 = cylinder radius=1.9 r2=1.1 height=0.8 segments=48 at=[0,-21.5,-16.4]
отв_крышки4 = cylinder radius=1.1 height=2.2 segments=48 at=[-21.5,0,-16.4]
зенковка4 = cylinder radius=1.9 r2=1.1 height=0.8 segments=48 at=[-21.5,0,-16.4]
отв_кнопки_мест = cylinder radius=1.85 height=2.2 segments=64 at=[0,12.2,-16.4]
отв_кнопки = rotate [отв_кнопки_мест] angle=45 axis=z
крышка_пластина = difference [крышка_заг,отв_крышки1,отв_крышки2,отв_крышки3,отв_крышки4,зенковка1,зенковка2,зенковка3,зенковка4,отв_кнопки]
# Четыре упора касаются предполагаемой неподвижной части отсека, не его крышки.
упор_л1_мест = cylinder radius=0.8 height=4.25 segments=40 at=[-10.65,7.2,-14.3]
упор_л2_мест = cylinder radius=0.8 height=4.25 segments=40 at=[-10.65,9,-14.3]
упор_п1_мест = cylinder radius=0.8 height=4.25 segments=40 at=[10.65,7.2,-14.3]
упор_п2_мест = cylinder radius=0.8 height=4.25 segments=40 at=[10.65,9,-14.3]
упор_л1 = rotate [упор_л1_мест] angle=45 axis=z
упор_л2 = rotate [упор_л2_мест] angle=45 axis=z
упор_п1 = rotate [упор_п1_мест] angle=45 axis=z
упор_п2 = rotate [упор_п2_мест] angle=45 axis=z
# УСЛОВНЫЕ направляющие платы: по длине заложено по 0,25 мм на сторону.
# Тонкие захваты толщиной 0,25 мм, доступ к пайке, монтаж и долговечность
# не подтверждены; их нужно переработать под измеренный модуль и процесс.

напр_перед_л_мест = box size=[3,0.8,3.9] at=[-5.5,-4.34,-14.3]
напр_перед_л = rotate [напр_перед_л_мест] angle=45 axis=z
край_перед_л_мест = box size=[3,1,0.25] at=[-5.5,-3.85,-10.65]
край_перед_л = rotate [край_перед_л_мест] angle=45 axis=z
напр_перед_п_мест = box size=[3,0.8,3.9] at=[5.5,-4.34,-14.3]
напр_перед_п = rotate [напр_перед_п_мест] angle=45 axis=z
край_перед_п_мест = box size=[3,1,0.25] at=[5.5,-3.85,-10.65]
край_перед_п = rotate [край_перед_п_мест] angle=45 axis=z
напр_зад_л_мест = box size=[3,0.8,3.9] at=[-5.5,14.74,-14.3]
напр_зад_л = rotate [напр_зад_л_мест] angle=45 axis=z
край_зад_л_мест = box size=[3,1,0.25] at=[-5.5,14.25,-10.65]
край_зад_л = rotate [край_зад_л_мест] angle=45 axis=z
напр_зад_п_мест = box size=[3,0.8,3.9] at=[5.5,14.74,-14.3]
напр_зад_п = rotate [напр_зад_п_мест] angle=45 axis=z
край_зад_п_мест = box size=[3,1,0.25] at=[5.5,14.25,-10.65]
край_зад_п = rotate [край_зад_п_мест] angle=45 axis=z
# Два экспериментальных ограничителя хода толкателя. Из-за неизвестной
# геометрии заводской кнопки их нельзя считать готовым узлом.
стойка_л_мест = box size=[1.2,2,1.3] at=[-3.4,12.2,-14.3]
стойка_п_мест = box size=[1.2,2,1.3] at=[3.4,12.2,-14.3]
стоп_л_мест = box size=[1,2,0.25] at=[-2.65,12.2,-13.25]
стоп_п_мест = box size=[1,2,0.25] at=[2.65,12.2,-13.25]
стойка_л = rotate [стойка_л_мест] angle=45 axis=z
стойка_п = rotate [стойка_п_мест] angle=45 axis=z
стоп_л = rotate [стоп_л_мест] angle=45 axis=z
стоп_п = rotate [стоп_п_мест] angle=45 axis=z
крышка_клевера = union [крышка_пластина,упор_л1,упор_л2,упор_п1,упор_п2,напр_перед_л,напр_перед_п,напр_зад_л,напр_зад_п,край_перед_л,край_перед_п,край_зад_л,край_зад_п,стойка_л,стойка_п,стоп_л,стоп_п]
color крышка_клевера #206640 rough=0.62
# Плунжер вставляется изнутри: буртик шире отверстия. Ход и возврат пока
# не доказаны. Отверстие не герметизировано; свободная радиальная посадка 0,25.
стержень_мест = cylinder radius=1.6 height=2.35 segments=64 at=[0,12.2,-16.2]
бурт_мест = cylinder radius=2.45 height=0.3 segments=64 at=[0,12.2,-14.15]
кнопка_мест = union [стержень_мест,бурт_мест]
кнопка = rotate [кнопка_мест] angle=45 axis=z
color кнопка #3d9b61 rough=0.54

шляпка1_заг = cylinder radius=1.65 r2=1.0 height=0.65 segments=48 at=[0,21.5,-16.28]
шлиц1 = box size=[2,0.35,0.2] at=[0,21.5,-16.3]
шляпка1 = difference [шляпка1_заг,шлиц1]
color шляпка1 #b8c5bf material=steel rough=0.3
paint шляпка1 #33443e box=[-1.1,21.3,-16.11,1.1,21.7,-16.09]
шляпка2_заг = cylinder radius=1.65 r2=1.0 height=0.65 segments=48 at=[21.5,0,-16.28]
шлиц2 = box size=[2,0.35,0.2] at=[21.5,0,-16.3]
шляпка2 = difference [шляпка2_заг,шлиц2]
color шляпка2 #b8c5bf material=steel rough=0.3
paint шляпка2 #33443e box=[20.4,-0.2,-16.11,22.6,0.2,-16.09]
шляпка3_заг = cylinder radius=1.65 r2=1.0 height=0.65 segments=48 at=[0,-21.5,-16.28]
шлиц3 = box size=[2,0.35,0.2] at=[0,-21.5,-16.3]
шляпка3 = difference [шляпка3_заг,шлиц3]
