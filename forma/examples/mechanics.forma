# ============================================================================
#  МЕХАНИКА: ВЕНТИЛЯТОР, ПРЫЖОК И ПАДЕНИЕ
# ============================================================================
#  Три готовые сцены в одном файле:
#    scene=вентилятор — лопасти раскручиваются до рабочих оборотов;
#    scene=прыжок     — мяч прыгает и упруго сжимается при отталкивании;
#    scene=падение    — кубик падает с высоты и «садится» на пол.
#  Переключаются в окне просмотра, сценарий при этом не меняется.
# ----------------------------------------------------------------------------

scene bg=#12161d env=studio shadows=да grid=нет
light preset=студия strength=1.1

# ---------- ОСНОВАНИЕ СТОЙКИ ----------
плита = box size=[260, 190, 14] round=6 center=да at=[0, 0, 7]
стойка = cylinder radius=16 height=150 segments=48 center=да at=[0, 0, 80]

# ---------- МОТОР ВЕНТИЛЯТОРА (ось Z — лопасти сверху) ----------
мотор = cylinder radius=42 height=62 segments=64 at=[0, 0, 149]
мотор = bevel [мотор] radius=3
# ступица садится на мотор: низ 210 при верхе мотора 211
ступица = cylinder radius=18 height=70 segments=48
ступица = translate [ступица] offset=[0, 0, 210]

# ---------- ЛОПАСТИ: наклон 22°, пять штук по кругу ----------
лопасть = box size=[150, 26, 5] round=2
# сначала наклон вокруг начала координат, потом сдвиг на ступицу:
# rotate без pivot крутит вокруг [0,0,0], поэтому порядок важен
лопасть = rotate [лопасть] angle=22 axis=x
лопасть = translate [лопасть] offset=[85, 0, 244]
лопасти = array [лопасть] count=5 mode=radial around=z center=[0, 0, 244]

# ---------- ПРЫГАЮЩИЙ МЯЧ И ПАДАЮЩИЙ ГРУЗ ----------
мяч = sphere radius=30 segments=48 at=[120, 0, 30]
груз = box size=[64, 64, 64] round=8 center=да at=[-120, 0, 32]

# ---------- СБОРКА ----------
стойка_сборка = union [плита, стойка, мотор]
ротор = group [лопасти, ступица]

# ---------- АНИМАЦИЯ: КАЖДАЯ СЦЕНА — СВОЙ НАБОР КЛИПОВ ----------
animate ротор fan rpm=240 seconds=3 axis=z scene=вентилятор
animate мяч jump height=120 seconds=1.2 elastic=да scene=прыжок
animate мяч wait seconds=0.6 scene=прыжок
animate мяч jump height=70 seconds=0.9 elastic=нет scene=прыжок
animate груз fall height=180 seconds=1.3 elastic=да scene=падение

# ---------- ПРОВЕРКИ ----------
check плита watertight
check стойка_сборка watertight
check стойка_сборка parts 1
check мяч size 59..61 59..61 59..61
check лопасти parts 5

# ---------- МАТЕРИАЛ ----------
color стойка_сборка #3b4654 metal=0.55 rough=0.42
color лопасти #d8dee8 rough=0.38
color ступица #22272e metal=0.7 rough=0.3
color мяч #e05a3a rough=0.55
color груз #e0b23a metal=0.4 rough=0.4
