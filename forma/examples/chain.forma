# ============================================================================
#  ЦЕПЬ И СОЕДИНЕНИЕ ДЕТАЛЕЙ — звенья, подвес и провис
# ----------------------------------------------------------------------------
#  `цепь` строит настоящую цепь: звенья вытянутые (стадион), соседние
#  повёрнуты на 90° и проходят друг сквозь друга — они зацеплены, а не
#  нанизаны на одну ось.
#
#  `соединить` берёт ДВЕ ГОТОВЫЕ детали, находит, где они ближе всего,
#  и вешает между ними цепь с провисом: число звеньев подбирается по длине.
#  Это честное соединение без склейки — деталь висит на цепи.
# ============================================================================

# ---------- 1. простая цепь вдоль стола ----------
прямая = цепь links=10 size=26 wire=3.4 at=[-130,70,20] dir=[1,0,0]
color прямая color=#c9ccd2 metal=0.8 rough=0.32

# ---------- 2. подвес: балка и лампа на цепи ----------
балка = box size=[150,40,12] round=2 at=[0,-80,200]
color балка color=#4a4f57 metal=0.4 rough=0.5

лампа = hemisphere radius=26 at=[0,-80,60]
color лампа color=#f0c46a emissive=#ffd27f emissive_strength=1.4 rough=0.4

подвес = соединить [балка, лампа] size=17 wire=2.4 sag=0.1
color подвес color=#c9ccd2 metal=0.8 rough=0.32

# ---------- 3. короткая цепь кольцом вокруг крюка ----------
крюк = torus major=20 minor=4 at=[110,-80,190]
color крюк color=#9aa2ad metal=0.9 rough=0.25

связка = соединить [крюк, балка] size=13 wire=2 sag=0.3 from=[110,-80,190] to=[40,-80,200]
color связка color=#b9bfc7 metal=0.8 rough=0.35

scene bg=#f7f3e9 shadows=да
light preset=студия strength=1.1
