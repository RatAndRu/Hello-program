# Кронштейн правый 00.039 — модель по чертежу А2 (1:1.5, материал АЛ9).
# Оси: X — вдоль плиты (0…210), Y — поперёк (0…130),
# Z = 0 — нижняя плоскость плиты; крепёж смотрит вниз, патрубок — вверх.
# Собрано скриптом docs/make_bracket_00039.py из чисел чертежа.

# --------------------------------------------------- 1. плита 210×130×15
# Углы R15 стоят по центрам болтов: на чертеже R15 привязан к отверстию,
# поэтому скругление угла и отверстие концентричны.
плита = extrude profile=[[0,15],[0.13,13.04],[0.51,11.12],[1.14,9.26],[2.01,7.5],[3.1,5.87],[4.39,4.39],[5.87,3.1],[7.5,2.01],[9.26,1.14],[11.12,0.51],[13.04,0.13],[15,0],[195,0],[196.96,0.13],[198.88,0.51],[200.74,1.14],[202.5,2.01],[204.13,3.1],[205.61,4.39],[206.9,5.87],[207.99,7.5],[208.86,9.26],[209.49,11.12],[209.87,13.04],[210,15],[210,115],[209.87,116.96],[209.49,118.88],[208.86,120.74],[207.99,122.5],[206.9,124.13],[205.61,125.61],[204.13,126.9],[202.5,127.99],[200.74,128.86],[198.88,129.49],[196.96,129.87],[195,130],[15,130],[13.04,129.87],[11.12,129.49],[9.26,128.86],[7.5,127.99],[5.87,126.9],[4.39,125.61],[3.1,124.13],[2.01,122.5],[1.14,120.74],[0.51,118.88],[0.13,116.96],[0,115]] height=15
# «2×45°, 2 фаску» на чертеже — фаски кромок плиты; снимаем до объединения,
# пока сетка плиты простая.
плита = chamfer [плита] width=2 edges=convex

# Цековки Ø20×3 под головки болтов — четыре площадки на плите.
цековка_1 = cylinder radius=10 height=4 segments=48
цековка_1 = place [цековка_1] at=[15,15,14]
цековка_2 = cylinder radius=10 height=4 segments=48
цековка_2 = place [цековка_2] at=[15,115,14]
цековка_3 = cylinder radius=10 height=4 segments=48
цековка_3 = place [цековка_3] at=[150,15,14]
цековка_4 = cylinder radius=10 height=4 segments=48
цековка_4 = place [цековка_4] at=[150,115,14]
основа = union [плита, цековка_1, цековка_2, цековка_3, цековка_4]

# ------------------------------------------------- 2. бобышка и нижний прилив
# Ø70 высотой 25 с галтелью R5 у основания; снизу прилив Ø60 (35) с буртиком
# Ø65×2. Расточка: Ø40×20 сверху, Ø35H7 длиной 38, Ø30×18 снизу.
бобышка = lathe points=[[0,0],[40,0],[40,0],[38.45,0.24],[37.06,0.95],[35.95,2.06],[35.24,3.45],[35,5],[35,25],[0,25]] segments=96
бобышка = place [бобышка] at=[50,65,15]
прилив = cylinder radius=30 height=33 segments=160
прилив = place [прилив] at=[50,65,-35]
буртик = cylinder radius=32.5 height=2 segments=160
буртик = place [буртик] at=[50,65,-2]
основа = union [основа, бобышка, прилив, буртик]

# ------------------------------------------------------- 3. стойка и патрубок
# Стойка стоит в 60±0.2 от оси бобышки и несёт патрубок Ø50 (ось на 75).
# Это не сплошная стенка: на разрезе Б-Б видно окно со скруглением R7.5, а по
# бокам остаются ножки 25 (слева) и 40 (справа) — окно прорезано насквозь по Y.
стойка = box size=[85,100,36]
стойка = place [стойка] at=[152.5,65,15]
окно = extrude profile=[[0,7.5],[0.14,6.04],[0.57,4.63],[1.26,3.33],[2.2,2.2],[3.33,1.26],[4.63,0.57],[6.04,0.14],[7.5,0],[32.5,0],[33.96,0.14],[35.37,0.57],[36.67,1.26],[37.8,2.2],[38.74,3.33],[39.43,4.63],[39.86,6.04],[40,7.5],[40,18.5],[39.86,19.96],[39.43,21.37],[38.74,22.67],[37.8,23.8],[36.67,24.74],[35.37,25.43],[33.96,25.86],[32.5,26],[7.5,26],[6.04,25.86],[4.63,25.43],[3.33,24.74],[2.2,23.8],[1.26,22.67],[0.57,21.37],[0.14,19.96],[0,18.5]] height=104
окно = rotate [окно] angle=90 axis=x
окно = place [окно] at=[152.5,65,32.5] align=center
стойка = difference [стойка, окно]
патрубок = cylinder radius=25 height=100 segments=128
патрубок = rotate [патрубок] angle=90 axis=x
патрубок = place [патрубок] at=[165,65,75] align=center
патрубок = chamfer [патрубок] width=2 edges=convex

# Ребро справа: от низа патрубка вниз к плите, катет 40 («40» на разрезе
# Б-Б), толщина 15 по Y, посередине ширины.
ребро = extrude profile=[[0,0],[40,0],[0,20]] height=15
ребро = rotate [ребро] angle=-90 axis=x
ребро = place [ребро] at=[175,65,25] align=center

# Второе ребро — между бобышкой и стойкой: наклонная плоскость от плиты к
# верху стойки (на изометрии референса видна как наклонная грань у окна).
ребро_л = extrude profile=[[0,0],[25,0],[25,35]] height=15
ребро_л = rotate [ребро_л] angle=-90 axis=x
ребро_л = place [ребро_л] at=[97.5,65,32.5] align=center

тело = union [основа, стойка, патрубок, ребро, ребро_л]

# Галтели R5 и R7.5 заложены в профили (бобышка, стойка, ребро): так они
# точные и не раздувают сетку. Глобальный fillet на такой сборке разрастается
# до 400 тысяч треугольников и отказывается работать — это проверено.

# --------------------------------------------------------- 6. отверстия
# Сверлим после объединения, чтобы отверстия проходили все слои насквозь.
сверло_1 = cylinder radius=4.5 height=60 segments=40
сверло_1 = place [сверло_1] at=[15,15,-40]
сверло_2 = cylinder radius=4.5 height=60 segments=40
сверло_2 = place [сверло_2] at=[15,115,-40]
сверло_3 = cylinder radius=4.5 height=60 segments=40
сверло_3 = place [сверло_3] at=[150,15,-40]
сверло_4 = cylinder radius=4.5 height=60 segments=40
сверло_4 = place [сверло_4] at=[150,115,-40]
штифт_1 = cylinder radius=4 height=60 segments=40
штифт_1 = place [штифт_1] at=[95,45,-40]
штифт_2 = cylinder radius=4 height=60 segments=40
штифт_2 = place [штифт_2] at=[95,85,-40]

# Расточка бобышки сверху вниз: Ø40×20 → Ø35H7 (38) → Ø30×18.
ц_40 = cylinder radius=20 height=21 segments=96
ц_40 = place [ц_40] at=[50,65,20]
ц_35 = cylinder radius=17.5 height=40 segments=96
ц_35 = place [ц_35] at=[50,65,-18]
ц_30 = cylinder radius=15 height=20 segments=96
ц_30 = place [ц_30] at=[50,65,-37]

# Расточка патрубка: Ø30 насквозь и цековки Ø35H7×18 с обоих торцов.
ц_п = cylinder radius=15 height=104 segments=96
ц_п = rotate [ц_п] angle=90 axis=x
ц_п = place [ц_п] at=[165,65,75] align=center
к_1 = cylinder radius=17.5 height=18 segments=96
к_1 = rotate [к_1] angle=90 axis=x
к_1 = place [к_1] at=[165,24,75] align=center
к_2 = cylinder radius=17.5 height=18 segments=96
к_2 = rotate [к_2] angle=90 axis=x
к_2 = place [к_2] at=[165,106,75] align=center

# M10-H7 сверху патрубка: резьба по оси детали, глубиной 12.
м10 = cylinder radius=4.2 height=14 segments=32
м10 = place [м10] at=[165,65,88]

тело = difference [тело, сверло_1, сверло_2, сверло_3, сверло_4, штифт_1, штифт_2,
                  ц_40, ц_35, ц_30, ц_п, к_1, к_2, м10]

# --------------------------------------------- 7. материал и вид
color тело #b9bdc5 metal=0.85 rough=0.28

# ----------------------------------------------------------- 8. проверки
# Допуски с чертежа: центры отверстий ±0.2, габарит, замкнутость, дно.
check сверло_1 center 14.8..15.2 14.8..15.2 -14..-6
check сверло_2 center 14.8..15.2 114.8..115.2 -14..-6
check сверло_3 center 149.8..150.2 14.8..15.2 -14..-6
check сверло_4 center 149.8..150.2 114.8..115.2 -14..-6
check тело size 209.7..210.3 129.7..130.3 134.5..135.5
check тело watertight
check тело parts 1
passport тело
