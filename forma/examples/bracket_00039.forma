# Кронштейн правый 00.039 — модель по чертежу А2 (1:1.5, материал АЛ9).
# Оси: X — вдоль плиты (0…210), Y — поперёк (0…130), Z = 0 — низ плиты.
# Собрано скриптом docs/make_bracket_00039.py из чисел чертежа.

# --------------------------------------------------- 1. плита 210×130×15
# Углы R15, фаска 2×45° по верхней кромке.
плита = extrude profile=[[0,15],[0.18,12.65],[0.73,10.36],[1.63,8.19],[2.86,6.18],[4.39,4.39],[6.18,2.86],[8.19,1.63],[10.36,0.73],[12.65,0.18],[15,0],[195,0],[197.35,0.18],[199.64,0.73],[201.81,1.63],[203.82,2.86],[205.61,4.39],[207.14,6.18],[208.37,8.19],[209.27,10.36],[209.82,12.65],[210,15],[210,115],[209.82,117.35],[209.27,119.64],[208.37,121.81],[207.14,123.82],[205.61,125.61],[203.82,127.14],[201.81,128.37],[199.64,129.27],[197.35,129.82],[195,130],[15,130],[12.65,129.82],[10.36,129.27],[8.19,128.37],[6.18,127.14],[4.39,125.61],[2.86,123.82],[1.63,121.81],[0.73,119.64],[0.18,117.35],[0,115]] height=15
плита = chamfer [плита] width=2 edges=convex

# Ø20×3 — ЦЕКОВКИ под головки: углубления в плите (не площадки).
цековка_1 = cylinder radius=10 height=30 segments=64
цековка_1 = place [цековка_1] at=[15,15,12]
цековка_2 = cylinder radius=10 height=30 segments=64
цековка_2 = place [цековка_2] at=[15,115,12]
цековка_3 = cylinder radius=10 height=30 segments=64
цековка_3 = place [цековка_3] at=[150,15,12]
цековка_4 = cylinder radius=10 height=30 segments=64
цековка_4 = place [цековка_4] at=[150,115,12]

# -------------------------------------------------- 2. бобышка и прилив
# Ø70 высотой 25, снизу вогнутая юбка R5; расточка Ø40×20 сверху,
# Ø35H7 длиной 38, Ø30×18 снизу. Под плитой прилив Ø60 с буртиком Ø65×2.
бобышка = lathe points=[[0,0],[40,0],[40,0],[39.02,0.1],[38.09,0.38],[37.22,0.84],[36.46,1.46],[35.84,2.22],[35.38,3.09],[35.1,4.02],[35,5],[35,25],[0,25]] segments=128
бобышка = place [бобышка] at=[45,65,15]
прилив = cylinder radius=30 height=33 segments=128
прилив = place [прилив] at=[45,65,-35]
буртик = cylinder radius=32.5 height=2 segments=128
буртик = place [буртик] at=[45,65,-2]

# ------------------------------------------------------- 3. опора-стенка
# Разрез Б-Б: левая грань — скос 45° от плиты (X 88) к полке
# (X 124, Z 52), справа — скос 40 мм от низа патрубка
# к плите. Толщина стенки по Y — 100. Стенка и патрубок сливаются галтелью R5,
# поэтому скосы и седло считаются ДО вырезания окна.
опора = extrude profile=[[88,12],[124,52],[182,52],[152,12]] height=100
опора = rotate [опора] angle=90 axis=x
опора = place [опора] at=[135,65,33.5] align=center

# ----------------------------------------------------------- 4. патрубок
# Ø50 длиной 100 вдоль X (ось на Z 75 = 75±0.1 над низом плиты).
# Фаски 2×45° заложены в профиль: `chamfer` по торцу цилиндра оставлял в
# сетке 3 граничных ребра (проверено экспортом STL — файл не проходил).
патрубок = lathe points=[[0,0],[23,0],[25,2],[25,98],[23,100],[0,100]] segments=128
патрубок = rotate [патрубок] angle=90 axis=y
патрубок = place [патрубок] at=[135,65,75] align=center

узел = union [опора, патрубок]
узел = fillet [узел] radius=5 edges=concave segments=10

# Окно вырезается ПОСЛЕ галтели: иначе R5 зализал бы его кромки.
окно = extrude profile=[[108.07,15],[106.62,15.22],[105.29,15.84],[104.21,16.83],[103.45,18.09],[103.1,19.51],[103.17,20.98],[103.66,22.36],[104.54,23.54],[115.8,34.8],[116.35,35.3],[116.94,35.74],[117.57,36.11],[118.24,36.43],[118.93,36.68],[119.64,36.86],[120.37,36.96],[121.11,37],[134.5,37],[135.96,36.86],[137.37,36.43],[138.67,35.74],[139.8,34.8],[140.74,33.67],[141.43,32.37],[141.86,30.96],[142,29.5],[142,22.5],[141.86,21.04],[141.43,19.63],[140.74,18.33],[139.8,17.2],[138.67,16.26],[137.37,15.57],[135.96,15.14],[134.5,15]] height=108
окно = rotate [окно] angle=90 axis=x
окно = place [окно] at=[119,65,26] align=center
узел = difference [узел, окно]

тело = union [плита, бобышка, прилив, буртик, узел]

# --------------------------------------------------------- 5. отверстия
# В плите — крепёж и штифты.
сверло_1 = cylinder radius=4.5 height=80 segments=48
сверло_1 = place [сверло_1] at=[15,15,-50]
сверло_2 = cylinder radius=4.5 height=80 segments=48
сверло_2 = place [сверло_2] at=[15,115,-50]
сверло_3 = cylinder radius=4.5 height=80 segments=48
сверло_3 = place [сверло_3] at=[150,15,-50]
сверло_4 = cylinder radius=4.5 height=80 segments=48
сверло_4 = place [сверло_4] at=[150,115,-50]
штифт_1 = cylinder radius=4 height=80 segments=48
штифт_1 = place [штифт_1] at=[90,45,-50]
штифт_2 = cylinder radius=4 height=80 segments=48
штифт_2 = place [штифт_2] at=[90,85,-50]
ц_40 = cylinder radius=20 height=21 segments=96
ц_40 = place [ц_40] at=[45,65,20]
ц_35 = cylinder radius=17.5 height=42 segments=96
ц_35 = place [ц_35] at=[45,65,-18]
ц_30 = cylinder radius=15 height=22 segments=96
ц_30 = place [ц_30] at=[45,65,-35]
# В патрубке — Ø30 насквозь и цековки Ø35H7×18 с обоих торцов.
ц_п = cylinder radius=15 height=106 segments=96
ц_п = rotate [ц_п] angle=90 axis=y
ц_п = place [ц_п] at=[135,65,75] align=center
к_1 = cylinder radius=17.5 height=18 segments=96
к_1 = rotate [к_1] angle=90 axis=y
к_1 = place [к_1] at=[94,65,75] align=center
к_2 = cylinder radius=17.5 height=18 segments=96
к_2 = rotate [к_2] angle=90 axis=y
к_2 = place [к_2] at=[176,65,75] align=center
# M10-H7 — радиальное отверстие сверху патрубка, по его середине.
м10 = cylinder radius=4.2 height=26 segments=32
м10 = place [м10] at=[135,65,74]

тело = difference [тело, сверло_1, сверло_2, сверло_3, сверло_4, штифт_1, штифт_2,
                  цековка_1, цековка_2, цековка_3, цековка_4,
                  ц_40, ц_35, ц_30, ц_п, к_1, к_2, м10]
color тело #c9ccd2 metal=0.9 rough=0.22

# ----------------------------------------------------------- 6. проверки
check сверло_1 center 14.8..15.2 14.8..15.2 -14..-6
check сверло_2 center 14.8..15.2 114.8..115.2 -14..-6
check сверло_3 center 149.8..150.2 14.8..15.2 -14..-6
check сверло_4 center 149.8..150.2 114.8..115.2 -14..-6
check тело size 209.7..210.3 129.7..130.3 134.5..135.5
check тело watertight
check тело parts 1
passport тело
