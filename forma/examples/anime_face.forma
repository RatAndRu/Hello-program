# РАДУЖКА (правый): крупная, почти на весь глаз
радужка_правый = extrude profile=[
      [51.0, 11.0], [50.6, 15.1], [49.3, 19.0], [47.2, 22.5], [44.5, 25.5],
      [41.2, 27.8], [37.4, 29.3], [33.5, 30.0], [29.5, 29.7], [25.7, 28.7],
      [22.1, 26.7], [19.1, 24.1], [16.6, 20.8], [15.0, 17.1], [14.1, 13.1],
      [14.1, 8.9], [15.0, 4.9], [16.6, 1.2], [19.1, -2.1], [22.1, -4.7],
      [25.7, -6.7], [29.5, -7.7], [33.5, -8.0], [37.4, -7.3], [41.2, -5.8],
      [44.5, -3.5], [47.2, -0.5], [49.3, 3.0], [50.6, 6.9], [51.0, 11.0]
    ] height=1.6
радужка_правый = translate [радужка_правый] offset=[0, 0, 17.6]

# БЛИК (правый)
блик_правый = extrude profile=[
      [29.0, 20.0], [28.7, 21.8], [27.7, 23.4], [26.2, 24.5], [24.5, 25.0],
      [22.6, 24.8], [21.0, 24.0], [19.7, 22.6], [19.1, 20.9], [19.1, 19.1],
      [19.7, 17.4], [21.0, 16.0], [22.6, 15.2], [24.5, 15.0], [26.2, 15.5],
      [27.7, 16.6], [28.7, 18.2], [29.0, 20.0]
    ] height=1.2
блик_правый = translate [блик_правый] offset=[0, 0, 19.2]

# ВЕКО (правый): жирная линия века
веко_правый = extrude profile=[
      [58.6, 18.9], [57.9, 22.3], [56.5, 25.7], [54.4, 28.8], [51.9, 31.6],
      [48.8, 34.0], [45.3, 36.1], [41.5, 37.6], [37.4, 38.7], [33.1, 39.2],
      [28.9, 39.2], [24.6, 38.7], [20.5, 37.6], [16.7, 36.1], [13.2, 34.0],
      [10.1, 31.6], [7.6, 28.8], [5.5, 25.7], [4.1, 22.3], [3.4, 18.9],
      [5.1, 20.8], [6.0, 23.8], [7.6, 26.6], [9.9, 29.1], [12.8, 31.4],
      [16.2, 33.3], [20.1, 34.8], [24.3, 35.8], [28.8, 36.3], [33.2, 36.3],
      [37.7, 35.8], [41.9, 34.8], [45.8, 33.3], [49.2, 31.4], [52.1, 29.1],
      [54.4, 26.6], [56.0, 23.8], [56.9, 20.8]
    ] height=3.0
веко_правый = translate [веко_правый] offset=[0, 0, 17.6]

# ГЛАЗ (левый): белок
белок_левый = extrude profile=[
      [-4.8, 19.3], [-6.1, 22.6], [-8.1, 25.6], [-10.6, 28.4], [-13.6, 30.8],
      [-17.0, 32.8], [-20.7, 34.3], [-24.7, 35.4], [-28.9, 35.9], [-33.1, 35.9],
      [-37.3, 35.4], [-41.3, 34.3], [-45.0, 32.8], [-48.4, 30.8], [-51.4, 28.4],
      [-53.9, 25.6], [-55.9, 22.6], [-57.2, 19.3], [-57.2, 18.1], [-55.6, 21.0],
      [-53.3, 23.6], [-50.3, 25.9], [-46.7, 27.8], [-42.6, 29.4], [-38.1, 30.4],
      [-33.4, 30.9], [-28.6, 30.9], [-23.9, 30.4], [-19.4, 29.4], [-15.3, 27.8],
      [-11.7, 25.9], [-8.7, 23.6], [-6.4, 21.0], [-4.8, 18.1]
    ] height=3.6
белок_левый = translate [белок_левый] offset=[0, 0, 14.0]

# РАДУЖКА (левый): крупная, почти на весь глаз
радужка_левый = extrude profile=[
      [-14.0, 11.0], [-14.4, 15.1], [-15.7, 19.0], [-17.8, 22.5], [-20.5, 25.5],
      [-23.8, 27.8], [-27.6, 29.3], [-31.5, 30.0], [-35.5, 29.7], [-39.3, 28.7],
      [-42.9, 26.7], [-45.9, 24.1], [-48.4, 20.8], [-50.0, 17.1], [-50.9, 13.1],
      [-50.9, 8.9], [-50.0, 4.9], [-48.4, 1.2], [-45.9, -2.1], [-42.9, -4.7],
      [-39.3, -6.7], [-35.5, -7.7], [-31.5, -8.0], [-27.6, -7.3], [-23.8, -5.8],
      [-20.5, -3.5], [-17.8, -0.5], [-15.7, 3.0], [-14.4, 6.9], [-14.0, 11.0]
    ] height=1.6
радужка_левый = translate [радужка_левый] offset=[0, 0, 17.6]

# БЛИК (левый)
блик_левый = extrude profile=[
      [-19.0, 20.0], [-19.3, 21.8], [-20.3, 23.4], [-21.8, 24.5], [-23.5, 25.0],
      [-25.4, 24.8], [-27.0, 24.0], [-28.3, 22.6], [-28.9, 20.9], [-28.9, 19.1],
      [-28.3, 17.4], [-27.0, 16.0], [-25.4, 15.2], [-23.5, 15.0], [-21.8, 15.5],
      [-20.3, 16.6], [-19.3, 18.2], [-19.0, 20.0]
    ] height=1.2
блик_левый = translate [блик_левый] offset=[0, 0, 19.2]

# ВЕКО (левый): жирная линия века
веко_левый = extrude profile=[
      [-3.4, 18.9], [-4.1, 22.3], [-5.5, 25.7], [-7.6, 28.8], [-10.1, 31.6],
      [-13.2, 34.0], [-16.7, 36.1], [-20.5, 37.6], [-24.6, 38.7], [-28.9, 39.2],
      [-33.1, 39.2], [-37.4, 38.7], [-41.5, 37.6], [-45.3, 36.1], [-48.8, 34.0],
      [-51.9, 31.6], [-54.4, 28.8], [-56.5, 25.7], [-57.9, 22.3], [-58.6, 18.9],
      [-56.9, 20.8], [-56.0, 23.8], [-54.4, 26.6], [-52.1, 29.1], [-49.2, 31.4],
      [-45.8, 33.3], [-41.9, 34.8], [-37.7, 35.8], [-33.2, 36.3], [-28.8, 36.3],
      [-24.3, 35.8], [-20.1, 34.8], [-16.2, 33.3], [-12.8, 31.4], [-9.9, 29.1],
      [-7.6, 26.6], [-6.0, 23.8], [-5.1, 20.8]
    ] height=3.0
веко_левый = translate [веко_левый] offset=[0, 0, 17.6]

# НОС: короткая чёрточка
нос = extrude profile=[
      [-2.0, 0.0], [4.0, -2.0], [2.5, -6.0], [-1.5, -5.0]
    ] height=2.2
нос = translate [нос] offset=[0, 0, 13.6]

# РОТ: лёгкая улыбка
рот = extrude profile=[
      [-12.2, -18.4], [-11.3, -19.4], [-10.2, -20.4], [-8.7, -21.2], [-7.0, -21.9],
      [-5.1, -22.4], [-3.1, -22.8], [-1.1, -23.0], [1.1, -23.0], [3.1, -22.8],
      [5.1, -22.4], [7.0, -21.9], [8.7, -21.2], [10.2, -20.4], [11.3, -19.4],
      [12.2, -18.4], [12.2, -16.1], [11.3, -16.9], [10.2, -17.7], [8.7, -18.5],
      [7.0, -19.1], [5.1, -19.5], [3.1, -19.8], [1.1, -20.0], [-1.1, -20.0],
      [-3.1, -19.8], [-5.1, -19.5], [-7.0, -19.1], [-8.7, -18.5], [-10.2, -17.7],
      [-11.3, -16.9], [-12.2, -16.1]
    ] height=2.2
рот = translate [рот] offset=[0, 0, 13.6]

# ЗАКОЛКА (1): перекрещенная полоска у виска
заколка_1 = extrude profile=[
      [-89.6, 30.6], [-62.0, 53.7], [-58.4, 49.4], [-86.0, 26.3]
    ] height=2.6
заколка_1 = translate [заколка_1] offset=[0, 0, 15.0]

# ЗАКОЛКА (2): перекрещенная полоска у виска
заколка_2 = extrude profile=[
      [-86.0, 53.7], [-58.4, 30.6], [-62.0, 26.3], [-89.6, 49.4]
    ] height=2.6
заколка_2 = translate [заколка_2] offset=[0, 0, 15.0]

# ВОРОТНИК: матросский, углом к груди
воротник = extrude profile=[
      [-98.0, -84.0], [-64.0, -66.0], [-20.0, -74.0], [0.0, -104.0], [20.0, -74.0],
      [64.0, -66.0], [98.0, -84.0], [86.0, -128.0], [-86.0, -128.0]
    ] height=3.0
воротник = translate [воротник] offset=[0, 0, 12.6]

# КАНТ (1): полоска на воротнике
кант_1 = extrude profile=[
      [-80.0, -92.0], [-36.0, -92.0], [-41.0, -100.0], [-75.0, -100.0]
    ] height=1.6
кант_1 = translate [кант_1] offset=[0, 0, 15.6]

# КАНТ (2): полоска на воротнике
кант_2 = extrude profile=[
      [36.0, -92.0], [80.0, -92.0], [75.0, -100.0], [41.0, -100.0]
    ] height=1.6
кант_2 = translate [кант_2] offset=[0, 0, 15.6]

# БАНТ: левая петля
бант_левый = extrude profile=[
      [-3.0, -104.0], [-16.0, -84.0], [-44.0, -80.0], [-56.0, -94.0], [-52.0, -114.0],
      [-26.0, -120.0], [-6.0, -113.0]
    ] height=3.0
бант_левый = translate [бант_левый] offset=[0, 0, 15.6]

# БАНТ: правая петля
бант_правый = extrude profile=[
      [3.0, -104.0], [16.0, -84.0], [44.0, -80.0], [56.0, -94.0], [52.0, -114.0],
      [26.0, -120.0], [6.0, -113.0]
    ] height=3.0
бант_правый = translate [бант_правый] offset=[0, 0, 15.6]

# БАНТ: узел
бант_узел = extrude profile=[
      [14.0, -104.0], [13.2, -99.5], [11.0, -95.4], [7.7, -92.3], [3.4, -90.4],
      [-1.2, -90.0], [-5.6, -91.2], [-9.5, -93.7], [-12.3, -97.3], [-13.8, -101.7],
      [-13.8, -106.3], [-12.3, -110.7], [-9.5, -114.3], [-5.6, -116.8], [-1.2, -118.0],
      [3.4, -117.6], [7.7, -115.7], [11.0, -112.6], [13.2, -108.5], [14.0, -104.0]
    ] height=3.4
бант_узел = translate [бант_узел] offset=[0, 0, 16.6]

# БАНТ: хвост
бант_хвост_л = extrude profile=[
      [-11.0, -112.0], [-18.0, -146.0], [2.0, -132.0], [4.0, -114.0]
    ] height=2.4
бант_хвост_л = translate [бант_хвост_л] offset=[0, 0, 15.2]

# БАНТ: хвост
бант_хвост_п = extrude profile=[
      [11.0, -112.0], [18.0, -146.0], [-2.0, -132.0], [-4.0, -114.0]
    ] height=2.4
бант_хвост_п = translate [бант_хвост_п] offset=[0, 0, 15.2]

# ---------- 2. ОДИН ОБЪЁМ ----------
#  Крупные массы сплавляем сразу: панель, волосы, шея, плечи, лицо, чёлка.
портрет = union [панель, волосы, шея, плечи, лицо, чёлка]

#  Мелкий рельеф — глаза, брови, рот, заколки, воротник, бант —
#  тоже одним телом, но собираем его списком, чтобы строка читалась.
детали = union [прядь_правая, прядь_левая,
                белок_правый, белок_левый, радужка_правый, радужка_левый,
                блик_правый, блик_левый,
                веко_правый, веко_левый,
                нос, рот, заколка_1, заколка_2,
                воротник, кант_1, кант_2,
                бант_левый, бант_правый, бант_узел, бант_хвост_л, бант_хвост_п]
портрет = union [портрет, детали]

# ---------- 3. ПОДАЧА ----------
#  Один проход polish снимает фаску с наплывов слоёв: на рисунке
#  остаются линии, но нет ступенек от печати.
портрет = polish [портрет] passes=1 strength=0.15

color портрет #f2ece0
scene bg=#f7f3e9 shadows=да
anime mode=скетч line=1.4 hatch=0.5 hatch_step=7 paper_tex=0.45
light preset=студия strength=1.1
