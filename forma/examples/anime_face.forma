      [-38.6, 100.3], [-32.3, 107.6], [-25.3, 113.4], [-17.9, 117.9], [-10.0, 120.7],
      [-2.0, 122.0]
    ] height=5.6
лицо = translate [лицо] offset=[0, 0, 8.0]

# ЧЁЛКА: зубчатый край, пряди разной длины
чёлка = extrude profile=[
