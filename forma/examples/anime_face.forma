# ============================================================================
#  АНИМЕ-БЮСТ — объёмный портрет: голова, шея, плечи, волосы
# ----------------------------------------------------------------------------
#  Это не плоская панель с рельефом, а настоящий бюст: у него есть затылок,
#  подбородок, нос, уши и шея, его можно обойти кругом.
#
#  Как устроено:
#   1) череп — одно поле SDF из пяти эллипсоидов, сваренных smin: лоб,
#      скулы, челюсть и подбородок переходят друг в друга без стыков;
#   2) нос и уши — отдельные небольшие поля, приваренные к черепу union;
#   3) шея и плечи — тоже SDF: капсула шеи входит в грудь, силуэт плеч
#      задают эллипсоид и перекладина-капсула со smin, низ срезан в пол;
#   4) лицо — инструменты `глаз`, `бровь`, `губы` (тёмная обводка глаза
#      и есть та самая «подводка» из аниме);
#   5) волосы — объёмная масса-боб с вырезанным окном для лица, снизу
#      косой срез; чёлка — вторая оболочка черепа, обрезанная волной,
#      поэтому её нижний край рваный, а не по линейке.
#
#  Голова и туловище сварены в один объём `фигура`; волосы и чёлка —
#  отдельные тела своего цвета (их видно в списке деталей).
# ============================================================================

череп = from_sdf bounds=[-105,-120,150,105,120,370] resolution=1.9 expression="smin(smin(smin(smin(sd_ellipsoid(x,y-2,z-282,70,72,72), sd_ellipsoid(x,y-14,z-244,62,64,58),15), sd_ellipsoid(x,y-20,z-218,52,56,42),12), sd_ellipsoid(x,y-26,z-198,38,42,28),10), sd_ellipsoid(x,y-30,z-184,22,26,18),10)"
нос = from_sdf bounds=[-24,-120,220,24,-20,265] resolution=1.2 expression="smin(sd_ellipsoid(x,y+54,z-242,5.5,9,11), sd_ellipsoid(x,y+57,z-236,3.6,5.5,5.5),7)"
ухо_п = from_sdf bounds=[54,-40,220,84,30,295] resolution=1.0 expression="smin(smin(sd_ellipsoid(x-64,y+2,z-254,8,4,19), sd_ellipsoid(x-65,y-2,z-264,6,3,8),5), sd_ellipsoid(x-64,y-2,z-245,5,3,6),5)"
ухо_л = from_sdf bounds=[-84,-40,220,-54,30,295] resolution=1.0 expression="smin(smin(sd_ellipsoid(x+64,y+2,z-254,8,4,19), sd_ellipsoid(x+65,y-2,z-264,6,3,8),5), sd_ellipsoid(x+64,y-2,z-245,5,3,6),5)"
голова = union [череп, нос, ухо_п, ухо_л]
color голова color=#f4d6c3

шея = from_sdf bounds=[-80,-90,120,80,90,300] resolution=1.7 expression="sd_capsule(x,y-2,z,0,6,120,0,-12,240,35)"
плечи = from_sdf bounds=[-215,-140,-20,215,140,190] resolution=2.2 expression="smin(smin(sd_ellipsoid(x,y-4,z-46,150,66,88), sd_ellipsoid(x,y-2,z-112,104,54,56),34), sd_capsule(x,y-6,z,-120,-10,104,120,-10,104,44),30)"
тело = union [шея, плечи]
тело = slice [тело] axis=z at=0 keep=top
фигура = union [голова, тело]
color фигура color=#f4d6c3

глаз_п = глаз width=44 height=30 at=[32,-62,252] iris=#8fa48f lash=2.2 depth=0.35
глаз_л = глаз width=44 height=30 at=[-32,-62,252] iris=#8fa48f lash=2.2 depth=0.35 tilt=-1
бровь_п = бровь width=36 at=[31,-66,294] tilt=0.12 arch=5 thick=2.6 color=#4a3a32
бровь_л = бровь width=36 at=[-31,-66,294] tilt=-0.12 arch=5 thick=2.6 color=#4a3a32
губы = губы width=28 at=[0,-40,208] smile=0.3 open=0.22 thick=3

окно = extrude profile=[[70.00,258.00],[69.73,262.88],[68.94,267.72],[67.61,272.49],[65.78,277.15],[63.44,281.67],[60.62,286.00],[57.34,290.12],[53.62,294.00],[49.50,297.60],[45.00,300.90],[40.15,303.87],[35.00,306.50],[29.58,308.75],[23.94,310.62],[18.12,312.09],[12.16,313.15],[6.10,313.79],[0.00,314.00],[-6.10,313.79],[-12.16,313.15],[-18.12,312.09],[-23.94,310.62],[-29.58,308.75],[-35.00,306.50],[-40.15,303.87],[-45.00,300.90],[-49.50,297.60],[-53.62,294.00],[-57.34,290.12],[-60.62,286.00],[-63.44,281.67],[-65.78,277.15],[-67.61,272.49],[-68.94,267.72],[-69.73,262.88],[-70.00,258.00],[-69.73,253.12],[-68.94,248.28],[-67.61,243.51],[-65.78,238.85],[-63.44,234.33],[-60.62,230.00],[-57.34,225.88],[-53.62,222.00],[-49.50,218.40],[-45.00,215.10],[-40.15,212.13],[-35.00,209.50],[-29.58,207.25],[-23.94,205.38],[-18.12,203.91],[-12.16,202.85],[-6.10,202.21],[-0.00,202.00],[6.10,202.21],[12.16,202.85],[18.12,203.91],[23.94,205.38],[29.58,207.25],[35.00,209.50],[40.15,212.13],[45.00,215.10],[49.50,218.40],[53.62,222.00],[57.34,225.88],[60.62,230.00],[63.44,234.33],[65.78,238.85],[67.61,243.51],[68.94,248.28],[69.73,253.12]] height=320
окно = rotate [окно] angle=90 axis=x
окно = translate [окно] offset=[0,55,0]
затылок = from_sdf bounds=[-130,-100,140,130,140,360] resolution=2.6 expression="smin(sd_ellipsoid(x,y-14,z-262,96,94,102), sd_ellipsoid(x,y-2,z-206,80,70,58),26)"
волосы = difference [затылок, окно]
срез = box size=[600,600,400] at=[0,0,-196]
срез = rotate [срез] angle=-8 axis=x
волосы = difference [волосы, срез]
наружу2 = from_sdf bounds=[-125,-140,130,125,140,390] resolution=2.2 expression="smin(smin(smin(smin(sd_ellipsoid(x,y-2,z-282,85,87,87), sd_ellipsoid(x,y-14,z-244,77,79,73),15), sd_ellipsoid(x,y-20,z-218,67,71,57),12), sd_ellipsoid(x,y-26,z-198,53,57,43),10), sd_ellipsoid(x,y-30,z-184,37,41,33),10)"
внутрь2 = from_sdf bounds=[-110,-125,140,110,125,375] resolution=2.0 expression="smin(smin(smin(smin(sd_ellipsoid(x,y-2,z-282,73,75,75), sd_ellipsoid(x,y-14,z-244,65,67,61),15), sd_ellipsoid(x,y-20,z-218,55,59,45),12), sd_ellipsoid(x,y-26,z-198,41,45,31),10), sd_ellipsoid(x,y-30,z-184,25,29,21),10)"
чёлка = difference [наружу2, внутрь2]
кусок = box size=[190,200,120] at=[0,-140,238]
чёлка = intersect [чёлка, кусок]
волна = from_sdf bounds=[-120,-150,200,120,-20,400] resolution=1.1 expression="z - (306 + 10*cos(x/9) + 4*cos(y/14))"
чёлка = difference [чёлка, волна]
# боковые пряди делает сама масса волос-боб: окно для лица вырезано
# внутри неё, поэтому волосы спускаются вдоль щёк до самой челюсти
color чёлка color=#ece4da
color волосы color=#ece4da

серьга = torus major=8 minor=1.5 at=[0,0,0]
серьга = rotate [серьга] angle=90 axis=x
серьга = translate [серьга] offset=[73,-16,232]
пирсинг_1 = sphere radius=2.2 at=[71,-14,272]
пирсинг_2 = sphere radius=1.8 at=[68,-18,254]
color серьга color=#c9ccd2
color пирсинг_1 color=#c9ccd2
color пирсинг_2 color=#c9ccd2

# ---------- подача ----------
scene bg=#f7f3e9 shadows=да
anime mode=скетч line=1.4 hatch=0.45 hatch_step=8 paper_tex=0.4
light preset=студия strength=1.1
