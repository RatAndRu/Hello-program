# ============================================================================
#  АНИМЕ-ПОРТРЕТ НА ПЛОСКОСТИ — контуры лица, собранные слоями
# ----------------------------------------------------------------------------
#  Рисунок повторяется в одной плоскости: панель внизу, дальше слои
#  толщиной 2–5 мм — волосы, лицо, чёлка, глаза, воротник, бант.
#  Слои сплавлены в один объём (union), поэтому это не набор деталей
#  рядом, а цельная плита с рельефом. Другие ракурсы не важны —
#  композиция рассчитана на вид спереди.
# ============================================================================

# ---------- 1. ПАНЕЛЬ ----------
панель = box size=[220, 300, 8] round=3
панель = chamfer [панель] width=1.2

# ВОЛОСЫ: масса с рваными кончиками ниже подбородка
волосы = extrude profile=[
      [0.0, 128.0], [10.7, 127.4], [21.3, 125.6], [31.5, 122.6], [41.4, 118.4],
      [50.7, 113.1], [59.4, 106.8], [67.3, 99.6], [74.3, 91.5], [80.4, 82.7],
      [85.4, 73.2], [89.3, 63.3], [92.1, 52.9], [93.6, 42.3], [94.0, 31.6],
      [93.1, 20.9], [97.0, -22.0], [92.0, -34.0], [95.0, -52.0], [85.0, -50.0],
