      [-72.0, -82.0], [-74.0, -62.0], [-86.0, -70.0], [-85.0, -50.0], [-95.0, -52.0],
      [-92.0, -34.0], [-97.0, -22.0], [-93.1, 20.9], [-94.0, 31.6], [-93.6, 42.3],
      [-92.1, 52.9], [-89.3, 63.3], [-85.4, 73.2], [-80.4, 82.7], [-74.3, 91.5],
      [-67.3, 99.6], [-59.4, 106.8], [-50.7, 113.1], [-41.4, 118.4], [-31.5, 122.6],
      [-21.3, 125.6], [-10.7, 127.4], [0.0, 128.0]
    ] height=4.0
волосы = translate [волосы] offset=[0, 0, 8.0]

# ШЕЯ: короткая стойка, её закроет воротник
шея = extrude profile=[
      [-12.0, -36.0], [12.0, -36.0], [14.0, -68.0], [-14.0, -68.0]
    ] height=6.0
шея = translate [шея] offset=[0, 0, 8.0]

# ПЛЕЧИ: корпус под портретом
плечи = extrude profile=[
      [-104.0, -148.0], [104.0, -148.0], [98.0, -108.0], [86.0, -78.0], [34.0, -64.0],
      [14.0, -70.0], [0.0, -76.0], [-14.0, -70.0], [-34.0, -64.0], [-86.0, -78.0],
      [-98.0, -108.0]
    ] height=4.6
плечи = translate [плечи] offset=[0, 0, 8.0]

# ЛИЦО: овал с мягким подбородком
лицо = extrude profile=[
      [2.0, 122.0], [10.0, 120.7], [17.9, 117.9], [25.3, 113.4], [32.3, 107.6],
