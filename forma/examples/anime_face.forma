чёлка = translate [чёлка] offset=[0, 0, 13.6]

# ПРЯДЬ (правая): локон у щеки, обрамляет лицо
прядь_правая = extrude profile=[
      [46.0, 74.0], [60.0, 30.0], [54.0, -18.0], [44.0, 20.0], [40.0, 56.0]
    ] height=4.2
прядь_правая = translate [прядь_правая] offset=[0, 0, 14.0]

# ПРЯДЬ (левая): локон у щеки, обрамляет лицо
прядь_левая = extrude profile=[
      [-46.0, 74.0], [-60.0, 30.0], [-54.0, -18.0], [-44.0, 20.0], [-40.0, 56.0]
    ] height=4.2
прядь_левая = translate [прядь_левая] offset=[0, 0, 14.0]

# ГЛАЗ (правый): белок
белок_правый = extrude profile=[
      [57.2, 19.3], [55.9, 22.6], [53.9, 25.6], [51.4, 28.4], [48.4, 30.8],
