# Четырёхлистный клевер — тест стандартного цветного 3MF.
# Размеры в мм, лежит на столе: нижняя плоскость Z=0, лицо +Z.
# Основа толщиной 3 мм, четыре вставки утоплены на 1,2 мм и лежат заподлицо.
# До внешнего контура вокруг вставок в сечении остаётся не менее 1,2 мм.
# Ушко объединено с основой; сквозное отверстие диаметром 5 мм по оси Z.
# Вставки — отдельные замкнутые детали; пересечения объёмов не задуманы.
# Пять цветов — пример: в слайсере можно назначить меньше реальных пластиков.
# 3MF содержит модель и цвета, НЕ настройки принтера и НЕ готовый G-code.

# Четыре сердцевидных листа и центральный диск образуют единую основу.
верх_контур = heart width=22 depth=3 plane=flat at=[0,10,0]
право_заг = heart width=22 depth=3 plane=flat at=[0,10,0]
право_контур = rotate [право_заг] angle=-90 axis=z
низ_заг = heart width=22 depth=3 plane=flat at=[0,10,0]
низ_контур = rotate [низ_заг] angle=180 axis=z
лево_заг = heart width=22 depth=3 plane=flat at=[0,10,0]
лево_контур = rotate [лево_заг] angle=90 axis=z
центр = cylinder radius=5 height=3 segments=64 at=[0,0,0]
мостик = box size=[6,13,3] at=[0,18,0]
ушко_наружное = cylinder radius=5 height=3 segments=64 at=[0,24,0]
заготовка = union [верх_контур, право_контур, низ_контур, лево_контур, центр, мостик, ушко_наружное]
отверстие = cylinder radius=2.5 height=5 segments=64 at=[0,24,-1]
с_ушком = difference [заготовка, отверстие]

# Пять отдельных видимых объектов: основа и четыре цветных лепестка.
# Режущие копии выступают вверх, чтобы сверху не было совпадающих срезов.
рез_верх = heart width=14 depth=1.4 plane=flat at=[0,9,1.8]
рез_право_заг = heart width=14 depth=1.4 plane=flat at=[0,9,1.8]
рез_право = rotate [рез_право_заг] angle=-90 axis=z
рез_низ_заг = heart width=14 depth=1.4 plane=flat at=[0,9,1.8]
рез_низ = rotate [рез_низ_заг] angle=180 axis=z
рез_лево_заг = heart width=14 depth=1.4 plane=flat at=[0,9,1.8]
рез_лево = rotate [рез_лево_заг] angle=90 axis=z
основа = difference [с_ушком, рез_верх, рез_право, рез_низ, рез_лево]
color основа #185b3a

вставка_верх = heart width=14 depth=1.2 plane=flat at=[0,9,1.8]
color вставка_верх #66d976
вставка_право_заг = heart width=14 depth=1.2 plane=flat at=[0,9,1.8]
вставка_право = rotate [вставка_право_заг] angle=-90 axis=z
color вставка_право #f5c84c
вставка_низ_заг = heart width=14 depth=1.2 plane=flat at=[0,9,1.8]
вставка_низ = rotate [вставка_низ_заг] angle=180 axis=z
color вставка_низ #eb6b83
вставка_лево_заг = heart width=14 depth=1.2 plane=flat at=[0,9,1.8]
вставка_лево = rotate [вставка_лево_заг] angle=90 axis=z
color вставка_лево #41bfd0

check основа topology
check вставка_верх topology
check вставка_право topology
check вставка_низ topology
check вставка_лево topology
