# 0.22: тарелка каши, горка гальки, яйцо и капля — новые инструменты.
# Тот же сценарий строит всё сразу и сам себя проверяет.

тарелка = plate diameter=190 depth=52 wall=4 at=[-140,0,0]
каша = fill [тарелка] grain=зерно size=8 level=0.8 density=0.75 seed=7
color каша #b98a4a

горка = pile radius=95 height=44 grain=галька size=15 seed=5 at=[130,0,0]
color горка #8f949c

яйцо = egg height=70 diameter=48 proportion=0.55 at=[0,150,0]
color яйцо #efe7d6

капля = drop radius=16 height=42 tip=0.6 at=[0,-150,0]
color капля #7fb3d5

колонна = cylinder radius=6 height=70 at=[-330,0,0]
кольцо = array [колонна] count=8 mode=radial radius=70 at=[-330,0,0]
color кольцо #b9c2cf

check тарелка watertight
check каша watertight
check горка watertight
check яйцо watertight
check яйцо height 69..71
check капля watertight
check кольцо watertight
check кольцо width 150..155

check каша volume 60..120
check горка volume 150..260
