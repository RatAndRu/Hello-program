color анод_контакт #c7d2d1 metal=0.5
color катод_контакт #c7d2d1 metal=0.5
# Схематическая термоусадка; реальные открытые токоведущие части изолировать.
термо_плюс_местная = sweep path=[[-6.2,8,-2.4],[-6.2,9.5,-2.4]] radius=0.48 sides=12
термо_анод_местная = sweep path=[[-6.2,3,-2.4],[-6.2,2,-2.4],[-5.5,1,-2.4],[-4,0,-2.4],[-1.27,0,-2.4],[-1.27,0,-1.05]] radius=0.43 sides=12 smooth=3
термо_катод_местная = sweep path=[[1.27,0,-2.4],[1.27,0,-1.05]] radius=0.43 sides=12
термо_плюс = rotate [термо_плюс_местная] angle=45 axis=z
термо_анод = rotate [термо_анод_местная] angle=45 axis=z
термо_катод = rotate [термо_катод_местная] angle=45 axis=z
color термо_плюс #ab3430
color термо_анод #8e4337
color термо_катод #303c4b

