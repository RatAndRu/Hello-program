плюс_контакт_местный = sweep path=[[-6.2,7.5,-2.4],[-6.2,9,-2.4]] radius=0.25 sides=12
анод_контакт_местный = sweep path=[[-6.2,3,-2.4],[-6.2,2,-2.4],[-5.5,1,-2.4],[-4,0,-2.4],[-1.27,0,-2.4],[-1.27,0,-1]] radius=0.25 sides=12 smooth=3
катод_контакт_местный = sweep path=[[1.27,0,-2.4],[1.27,0,-1]] radius=0.25 sides=12
плюс_контакт = rotate [плюс_контакт_местный] angle=45 axis=z
анод_контакт = rotate [анод_контакт_местный] angle=45 axis=z
катод_контакт = rotate [катод_контакт_местный] angle=45 axis=z
