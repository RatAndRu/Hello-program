крышка_отсека_круг = cylinder radius=11.5 height=0.15 segments=96 at=[0,-7,-11.35]
крышка_отсека_блок = box size=[23,13.5,0.15] at=[0,-0.25,-11.35]
крышка_отсека_местная = union [крышка_отсека_круг,крышка_отсека_блок]
макет_крышки_отсека = rotate [крышка_отсека_местная] angle=45 axis=z
color макет_крышки_отсека #424b47 rough=0.65

ползунок_отсека_местный = box size=[1,2.5,1.3] at=[0,13.75,-9]
макет_ползунка_отсека = rotate [ползунок_отсека_местный] angle=45 axis=z
color макет_ползунка_отсека #a5b2aa rough=0.5

