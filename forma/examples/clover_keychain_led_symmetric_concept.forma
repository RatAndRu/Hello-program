полоса1_местная = sweep path=[[-6.2,4.0,-2.4],[-6.2,4.3,-2.4]] radius=1.13 sides=24
полоса2_местная = sweep path=[[-6.2,4.8,-2.4],[-6.2,5.1,-2.4]] radius=1.13 sides=24
полоса3_местная = sweep path=[[-6.2,5.6,-2.4],[-6.2,5.9,-2.4]] radius=1.13 sides=24
