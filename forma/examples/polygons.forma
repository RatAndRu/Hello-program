# ============================================================================
#  РУЧНАЯ РИСОВКА ПОЛИГОНАМИ — всё контуром, без готовых фигур
# ============================================================================
#  Так моделируют, когда форма своя: рисуешь замкнутый контур точками
#  [[x, y], …], выдавливаешь его в толщину, вырезаешь окна и отверстия,
#  а объёмные скругления делаешь оболочкой по точкам.
#
#  Все контуры ниже обведены против часовой стрелки — так ядро строит
#  тело без выворотов. Отверстия идут вторым контуром в holes=…
# ----------------------------------------------------------------------------

scene bg=#171a21 env=studio shadows=да grid=нет
light preset=студия strength=1.15

# ---------- 1. ЗНАК: свой контур дома + окно и дверь ----------
#  7 точек: стены, скаты крыши, конёк. Ничего не скруглено — это чистый
#  полигон, каким его рисуют в 2D-редакторе.
знак = extrude profile=[
    [-70, 0], [70, 0], [70, 90], [34, 122], [0, 136], [-34, 122], [-70, 90]
  ] holes=[
    [[-52, 26], [-14, 26], [-14, 58], [-52, 58]],
    [[14, 26], [52, 26], [52, 70], [14, 70]]
  ] height=10 fillet=1.2
знак = rotate [знак] angle=90 axis=x
знак = translate [знак] offset=[0, 0, 0]

# ---------- 2. РАМКА: контур в контуре ----------
#  Внешний контур — восьмиугольник, внутренний — тоже восьмиугольник,
#  но повёрнутый на 22.5°: получается «звезда-рамка» одним выдавливанием.
рамка = extrude profile=[
    [-80, -40], [-40, -80], [40, -80], [80, -40],
    [80, 40], [40, 80], [-40, 80], [-80, 40]
  ] holes=[[
    [-58, -14], [-58, 14], [-14, 58], [14, 58],
    [58, 14], [58, -14], [14, -58], [-14, -58]
  ]] height=6
рамка = rotate [рамка] angle=90 axis=x
рамка = rotate [рамка] angle=18 axis=y
рамка = translate [рамка] offset=[190, 0, 92]

# ---------- 3. КРИСТАЛЛ: объём по точкам оболочкой ----------
#  Если нужен не плоский контур, а гранёный объём — задаём вершины в 3D.
кристалл = hull points=[
    [0, 0, 0], [26, 0, 34], [8, 22, 34], [-21, 13, 34], [-26, -13, 34],
    [-8, -22, 34], [21, -13, 34], [0, 0, 96], [10, 5, 60]
  ]
кристалл = translate [кристалл] offset=[-190, 0, 0]

# ---------- 4. КОСЫНКА: ручной треугольник с впадиной ----------
косынка = extrude profile=[
    [0, 0], [96, 0], [96, 10], [44, 10], [30, 46], [0, 46]
  ] height=8
косынка = rotate [косынка] angle=90 axis=x
косынка = translate [косынка] offset=[0, 150, 0]

# ---------- 5. КИСТЬ И ЛАСТИК ----------
#  Роспись хранится отдельными мазками (не материал!): кисть кладёт цвет,
#  ластик возвращает то, что было под мазком, не трогая материал знака.
color знак #e8e2d4 rough=0.55
#  лицо знака после поворота — плоскость y = −10, поэтому мазки идут по ней
кисть знак #2f6fb0 radius=10 path=[[-62, -10, 22], [-50, -10, 44], [-36, -10, 22]]
кисть знак #d94a3d radius=8 path=[[34, -10, 112], [52, -10, 100], [40, -10, 92]]
ластик знак radius=6 point=[-50, -10, 44]

# ---------- 6. АНИМАЦИЯ: своя заготовка ----------
заготовка осмотр, знак_крутится
animate рамка turn angle=18 axis=z pivot=[190, 0, 92] seconds=3 scene=осмотр
animate рамка turn angle=-18 axis=z pivot=[190, 0, 92] seconds=3 scene=осмотр
animate знак turn angle=360 axis=z pivot=[0, 0, 0] seconds=6 loop=да scene=знак_крутится

# ---------- МАТЕРИАЛ ----------
color рамка #8b949e metal=0.75 rough=0.35
color кристалл #7fc7e8 metal=0.1 rough=0.15
color косынка #6d7480 metal=0.85 rough=0.4

# ---------- ПРОВЕРКИ ----------
check знак watertight
check знак parts 1
check знак size 138..142 8..12 134..138
check рамка watertight
check кристалл watertight
check кристалл parts 1
check кристалл height 94..98
check косынка watertight
check косынка size 94..98 6..10 44..48
