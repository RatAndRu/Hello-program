hind_rest_L = rock size=[64,62,12] seed=56 rough=0.5 points=40 at=[-45,-66,18] color=#505856
color hind_rest_L #505856 rough=0.9
base = union [plinth, rock_main, rock_0, rock_1, rock_2, rock_3, rock_4, hind_rest_R, hind_rest_L]
check dragon watertight
check dragon parts 1
check base watertight
check base parts 1
