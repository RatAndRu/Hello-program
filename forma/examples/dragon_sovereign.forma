# Финальная чешуя: ray-cast по skin_origin, safe по всему dragon.
# После этой операции в dragon уже не добавляются детали с неучтёнными контактами.
skull_bed = spikes [skull_bed] surface=вся density=32 height=3.2 base_d=3.4 tip_d=0.35 sides=12 seed=9 safe=да
dragon = union [body_core, skull_bed, skin_origin, wings]
scales dragon on=skin_origin kind=дракон paths=[[[0,25,82],[0,8,150],[0,-4,194],[0,6,229],[0,5,253],[0,-15,276]],[[40,-8,204],[57,-25,153],[63,-52,91],[63,-61,69]],[[-40,-8,204],[-57,-25,153],[-63,-52,91],[-63,-61,69]],[[34,24,124],[50,4,84],[45,-22,51]],[[-34,24,124],[-50,4,84],[-45,-22,51]],[[0,68,120],[15,65,94],[40,105,67],[75,140,52],[108,151,68],[128,143,96],[127,127,122],[118,118,133]]] pitch=9 per_row=18 length=8 thick=0.75 tilt=22 safe=да seed=2

# Финальная сварка основных органических переходов.

# Круглое основание и связанный каменный рельеф.
plinth = cylinder radius=122 height=12 segments=160 round=2 at=[0,0,0] color=#505856 rough=0.86
rock_main = rock size=[200,180,22] seed=33 rough=0.42 points=72 at=[0,5,10] color=#505856
color rock_main #505856 rough=0.9
rock_0 = rock size=[45,42,18] seed=41 rough=0.48 points=40 at=[-72,-18,16] color=#505856
color rock_0 #505856 rough=0.9
rock_1 = rock size=[52,40,20] seed=42 rough=0.48 points=40 at=[68,-5,16] color=#505856
color rock_1 #505856 rough=0.9
rock_2 = rock size=[55,46,24] seed=43 rough=0.48 points=40 at=[-62,66,16] color=#505856
color rock_2 #505856 rough=0.9
rock_3 = rock size=[48,50,19] seed=44 rough=0.48 points=40 at=[57,76,16] color=#505856
color rock_3 #505856 rough=0.9
rock_4 = rock size=[65,38,15] seed=45 rough=0.48 points=40 at=[0,-48,16] color=#505856
color rock_4 #505856 rough=0.9
hind_rest_R = rock size=[64,62,12] seed=55 rough=0.5 points=40 at=[45,-66,18] color=#505856
