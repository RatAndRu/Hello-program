# Финальная чешуя на цельном драконе: safe учитывает все сочленения и экспорт.
# Ray-cast по неизменной skin_origin; никаких ручных мелких пластин.
dragon = union [body_core, skull_bed, skin_origin, wings]
# Торс и шея
scales dragon on=skin_origin kind=дракон paths=[[[0,28,82],[0,10,150],[0,-2,194],[0,6,229],[0,5,253],[0,-15,276]]] pitch=9 per_row=16 length=11 thick=0.7 tilt=10 safe=да seed=2
