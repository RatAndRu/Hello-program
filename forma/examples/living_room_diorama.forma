# --- Дверь 0.52: коробка, филёнки, петли, ручка и замок раздельны ---
entry = door width=70 height=114 thickness=3.5 frame=4 frame_depth=8 gap=0.5 panels=2 columns=1 panel_margin=7 panel_depth=0.35 hinges=3 lock=да handle_height=57 handle_offset=9 handle_length=8 handle_radius=0.7 backset=3
