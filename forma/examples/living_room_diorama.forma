coffee = table [coffee_top_proto] leg_object=coffee_leg_proto height=28 shape=ellipse legs=3 layout=circle inset=10 splay=0 at=[5,-5,1.6]

# --- Пульт перемещается группой; чашка имеет полость и sweep-ручку ---
remote_body = box size=[8, 24, 2.2] center=да at=[0, 0, 1.1] round=0.8 color=#20262b
