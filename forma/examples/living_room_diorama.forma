# --- Часы на свободном участке задней стены ---
clock_body = cylinder radius=10 height=3 segments=64 center=да
rotate [clock_body] angle=90 axis=x
translate [clock_body] offset=[140,118.5,124]
color clock_body #b89459
clock_face = cylinder radius=8.7 height=0.5 segments=64 center=да
rotate [clock_face] angle=90 axis=x
translate [clock_face] offset=[140,116.75,124]
color clock_face #eee6d4
clock_hand_hour = box size=[0.8, 0.4, 5] center=да at=[140, 116.3, 126.5] round=0.18 color=#344044
clock_hand_minute = box size=[6, 0.4, 0.8] center=да at=[143, 116.3, 124] round=0.18 color=#344044
clock_mark_0 = sphere radius=0.6 segments=16 at=[140,115.9,131.5] color=#7d684b
clock_mark_1 = sphere radius=0.6 segments=16 at=[140,115.9,116.5] color=#7d684b
clock_mark_2 = sphere radius=0.6 segments=16 at=[132.5,115.9,124] color=#7d684b
clock_mark_3 = sphere radius=0.6 segments=16 at=[147.5,115.9,124] color=#7d684b

check wall_back watertight
check wall_left watertight
check entry.leaf watertight
check living_rug watertight
check coffee watertight
