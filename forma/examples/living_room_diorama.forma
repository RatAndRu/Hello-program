# --- Две объёмные шторы 0.52; карниз и кольца — отдельные копии ---
curtain_left = curtain width=28 height=63 folds=4 fold_depth=2.2 thickness=0.12 wave=0.45 billow=0.5 detail=8 rows=24 rod=нет rings=нет at=[-66,104,69] color=#c98568
