# --- Ковёр 0.52 и овальный стол с пользовательскими прототипами ---
living_rug = rug width=180 length=110 shape=rounded corner=10 thickness=1.2 pad=0.25 border=7 pattern=полосы pattern_size=2.5 pattern_step=12 wave=0.12 lift=2.5 lift_corner=front_right binding=0.25 stitches=да fringe=ends fringe_length=6 fringe_count=20 detail=64 rings=8 at=[0,-5,1.49] color=#a95f4b border_color=#dfc39f
