# Porsche 911 Turbo (930) по заводскому чертежу — тип 930, 3.3 л.
# Габариты взяты с листа: 4291 x 1775 x 1310 мм, база 2272 мм,
# колея 1432 спереди и 1492 сзади. Ось X — вдоль машины
# (перед слева, -X), ось Y — поперёк, Z — вверх, пол на Z=0.
# Файл собран скриптом docs/make_porsche_930.py: сечения считаются из этих чисел.
# Чего на чертеже нет: размеров шин (взяты штатные 632/650 мм)
# и просвета (150 мм) — они помечены как допущения.

# ------------------------------------------------------------------ 1. кузов
# Двадцать четыре сечения сняты с трёх видов чертежа: верх — с вида сбоку,
# полуширина — с вида сверху. Лофт соединяет их и сглаживает по длине.
сечения = [
  [[0,330],[359.26,332.7],[624.8,348.9],[749.76,394.8],[781,470.4],[757.57,529.8],[798.75,583.8],[479.25,600],[0,600],[-479.25,600],[-798.75,583.8],[-757.57,529.8],[-781,470.4],[-749.76,394.8],[-624.8,348.9],[-359.26,332.7]],
  [[0,260],[375.59,264],[653.2,288],[783.84,356],[816.5,468],[792,556],[816.5,636],[489.9,660],[0,660],[-489.9,660],[-816.5,636],[-792,556],[-816.5,468],[-783.84,356],[-653.2,288],[-375.59,264]],
  [[0,205],[383.75,210.07],[667.4,240.49],[800.88,326.68],[834.25,468.64],[809.22,580.18],[798.75,681.58],[479.25,712],[0,712],[-479.25,712],[-798.75,681.58],[-809.22,580.18],[-834.25,468.64],[-800.88,326.68],[-667.4,240.49],[-383.75,210.07]],
  [[0,175],[379.67,180.67],[660.3,214.69],[792.36,311.08],[825.38,469.84],[800.61,594.58],[781,707.98],[468.6,742],[0,742],[-468.6,742],[-781,707.98],[-800.61,594.58],[-825.38,469.84],[-792.36,311.08],[-660.3,214.69],[-379.67,180.67]],
  [[0,160],[387.84,166],[674.5,202],[809.4,304],[843.12,472],[817.83,604],[763.25,724],[457.95,760],[0,760],[-457.95,760],[-763.25,724],[-817.83,604],[-843.12,472],[-809.4,304],[-674.5,202],[-387.84,166]],
  [[0,152],[391.92,158.16],[681.6,195.12],[817.92,299.84],[852,472.32],[826.44,607.84],[763.25,731.04],[457.95,768],[0,768],[-457.95,768],[-763.25,731.04],[-826.44,607.84],[-852,472.32],[-817.92,299.84],[-681.6,195.12],[-391.92,158.16]],
  [[0,150],[396,156.4],[688.7,194.8],[826.44,303.6],[860.88,482.8],[835.05,623.6],[745.5,751.6],[447.3,790],[0,790],[-447.3,790],[-745.5,751.6],[-835.05,623.6],[-860.88,482.8],[-826.44,303.6],[-688.7,194.8],[-396,156.4]],
  [[0,150],[396,157.1],[688.7,199.7],[826.44,320.4],[860.88,519.2],[835.05,675.4],[710,817.4],[426,860],[0,860],[-426,860],[-710,817.4],[-835.05,675.4],[-860.88,519.2],[-826.44,320.4],[-688.7,199.7],[-396,157.1]],
  [[0,150],[400.09,158.35],[695.8,208.45],[834.96,350.4],[869.75,584.2],[843.66,767.9],[639,934.9],[383.4,985],[0,985],[-383.4,985],[-639,934.9],[-843.66,767.9],[-869.75,584.2],[-834.96,350.4],[-695.8,208.45],[-400.09,158.35]],
  [[0,150],[400.09,159.7],[695.8,217.9],[834.96,382.8],[869.75,654.4],[843.66,867.8],[585.75,1061.8],[351.45,1120],[0,1120],[-351.45,1120],[-585.75,1061.8],[-843.66,867.8],[-869.75,654.4],[-834.96,382.8],[-695.8,217.9],[-400.09,159.7]],
  [[0,150],[402.13,160.8],[699.35,225.6],[839.22,409.2],[874.19,711.6],[847.96,949.2],[550.25,1165.2],[330.15,1230],[0,1230],[-330.15,1230],[-550.25,1165.2],[-847.96,949.2],[-874.19,711.6],[-839.22,409.2],[-699.35,225.6],[-402.13,160.8]],
  [[0,150],[404.17,161.4],[702.9,229.8],[843.48,423.6],[878.62,742.8],[852.27,993.6],[544.75,1221.6],[319.5,1290],[0,1290],[-319.5,1290],[-544.75,1221.6],[-852.27,993.6],[-878.62,742.8],[-843.48,423.6],[-702.9,229.8],[-404.17,161.4]],
  [[0,150],[407.68,161.57],[709.01,230.99],[850.81,427.68],[886.26,751.64],[859.67,1006.18],[549.48,1237.58],[319.5,1307],[0,1307],[-319.5,1307],[-549.48,1237.58],[-859.67,1006.18],[-886.26,751.64],[-850.81,427.68],[-709.01,230.99],[-407.68,161.57]],
  [[0,150],[407.68,161.57],[709.01,230.99],[850.81,427.68],[886.26,751.64],[859.67,1006.18],[549.48,1237.58],[319.5,1307],[0,1307],[-319.5,1307],[-549.48,1237.58],[-859.67,1006.18],[-886.26,751.64],[-850.81,427.68],[-709.01,230.99],[-407.68,161.57]],
  [[0,150],[408.25,161.45],[710,230.15],[852,424.8],[887.5,745.4],[860.88,997.3],[550.25,1226.3],[330.15,1295],[0,1295],[-330.15,1295],[-550.25,1226.3],[-860.88,997.3],[-887.5,745.4],[-852,424.8],[-710,230.15],[-408.25,161.45]],
  [[0,150],[408.25,160.65],[710,224.55],[852,405.6],[887.5,703.8],[860.88,938.1],[639,1151.1],[383.4,1215],[0,1215],[-383.4,1215],[-639,1151.1],[-860.88,938.1],[-887.5,703.8],[-852,405.6],[-710,224.55],[-408.25,160.65]],
  [[0,152],[408.25,161.53],[710,218.71],[852,380.72],[887.5,647.56],[860.88,857.22],[727.75,1047.82],[436.65,1105],[0,1105],[-436.65,1105],[-727.75,1047.82],[-860.88,857.22],[-887.5,647.56],[-852,380.72],[-710,218.71],[-408.25,161.53]],
  [[0,158],[408.25,166.72],[710,219.04],[852,367.28],[887.5,611.44],[860.88,803.28],[781,977.68],[468.6,1030],[0,1030],[-468.6,1030],[-781,977.68],[-860.88,803.28],[-887.5,611.44],[-852,367.28],[-710,219.04],[-408.25,166.72]],
  [[0,165],[408.25,173.45],[710,224.15],[852,367.8],[887.5,604.4],[860.88,790.3],[798.75,959.3],[479.25,1010],[0,1010],[-479.25,1010],[-798.75,959.3],[-860.88,790.3],[-887.5,604.4],[-852,367.8],[-710,224.15],[-408.25,173.45]],
  [[0,172],[408.25,180.33],[710,230.31],[852,371.92],[887.5,605.16],[860.88,788.42],[798.75,955.02],[479.25,1005],[0,1005],[-479.25,1005],[-798.75,955.02],[-860.88,788.42],[-887.5,605.16],[-852,371.92],[-710,230.31],[-408.25,180.33]],
  [[0,185],[404.17,193.1],[702.9,241.7],[843.48,379.4],[878.62,606.2],[852.27,784.4],[798.75,946.4],[479.25,995],[0,995],[-479.25,995],[-798.75,946.4],[-852.27,784.4],[-878.62,606.2],[-843.48,379.4],[-702.9,241.7],[-404.17,193.1]],
  [[0,205],[396,212.55],[688.7,257.85],[826.44,386.2],[860.88,597.6],[835.05,763.7],[798.75,914.7],[479.25,960],[0,960],[-479.25,960],[-798.75,914.7],[-835.05,763.7],[-860.88,597.6],[-826.44,386.2],[-688.7,257.85],[-396,212.55]],
  [[0,240],[379.67,246.75],[660.3,287.25],[792.36,402],[825.38,591],[800.61,739.5],[798.75,874.5],[479.25,915],[0,915],[-479.25,915],[-798.75,874.5],[-800.61,739.5],[-825.38,591],[-792.36,402],[-660.3,287.25],[-379.67,246.75]],
  [[0,300],[359.26,305.6],[624.8,339.2],[749.76,434.4],[781,591.2],[757.57,714.4],[798.75,826.4],[479.25,860],[0,860],[-479.25,860],[-798.75,826.4],[-757.57,714.4],[-781,591.2],[-749.76,434.4],[-624.8,339.2],[-359.26,305.6]],
]

# `кузов` — алиас команды loft, поэтому сама основа называется иначе:
# в языке имя объекта не должно совпадать с названием команды.
кузов_база = loft sections=сечения positions=[-2145.5, -2025.5, -1845.5, -1585.5, -1245.5, -895.5, -645.5, -465.5, -330.5, -215.5, -125.5, -60.5, 14.5, 204.5, 374.5, 554.5, 754.5, 954.5, 1154.5, 1404.5, 1654.5, 1854.5, 1994.5, 2145.5] axis=x smooth=4 profile_smooth=2

# ------------------------------------------------------------- 2. остекление
# Приём со сборочного чертежа: сначала проём, потом стекло в проём.
# Объёмный «клин» из кузова — это стекло по обводу; проём вырезается таким же
# клином, но на 4 мм шире, поэтому по краю видна кромка (шов).
# Наклоны подобраны под обвод: лобовое ~40°, заднее ~25°, борт ~20°.
лоб_плита = box size=[1000,1400,240]
лоб_плита = rotate [лоб_плита] angle=-40 axis=y
лоб_плита = place [лоб_плита] at=[-315.5,0,1055] align=center
лоб_паз = box size=[1008,1404,244]
лоб_паз = rotate [лоб_паз] angle=-40 axis=y
лоб_паз = place [лоб_паз] at=[-315.5,0,1055] align=center

зад_плита = box size=[620,1330,200]
зад_плита = rotate [зад_плита] angle=25 axis=y
зад_плита = place [зад_плита] at=[614.5,0,1165] align=center
зад_паз = box size=[628,1334,204]
зад_паз = rotate [зад_паз] angle=25 axis=y
зад_паз = place [зад_паз] at=[614.5,0,1165] align=center

# Борт сужается к крыше (tumblehome): панель стекла наклонена на 20° и стоит
# вплотную к борту; проём шире стекла на 4 мм.
бок_плита_п = box size=[760,120,250]
бок_плита_п = rotate [бок_плита_п] angle=-20 axis=x
бок_плита_п = place [бок_плита_п] at=[34.5,-797,1040] align=center
бок_паз_п = box size=[764,124,254]
бок_паз_п = rotate [бок_паз_п] angle=-20 axis=x
бок_паз_п = place [бок_паз_п] at=[34.5,-797,1040] align=center
бок_плита_з = box size=[760,120,250]
бок_плита_з = rotate [бок_плита_з] angle=20 axis=x
бок_плита_з = place [бок_плита_з] at=[34.5,797,1040] align=center
бок_паз_з = box size=[764,124,254]
бок_паз_з = rotate [бок_паз_з] angle=20 axis=x
бок_паз_з = place [бок_паз_з] at=[34.5,797,1040] align=center

лобовое = intersect [кузов_база, лоб_плита]
заднее = intersect [кузов_база, зад_плита]
стекло_п = intersect [кузов_база, бок_плита_п]
стекло_з = intersect [кузов_база, бок_плита_з]
color лобовое #0f1620 metal=0.7 rough=0.06
color заднее #0f1620 metal=0.7 rough=0.06
color стекло_п #0f1620 metal=0.7 rough=0.06
color стекло_з #0f1620 metal=0.7 rough=0.06

# Проёмы: те же плиты, но на 4 мм шире — стекло утоплено в кузов, по краю
# остаётся кромка, как на разрезе кузова в чертеже.
кузов = difference [кузов_база, лоб_паз, зад_паз, бок_паз_п, бок_паз_з]
hide кузов_база

# --------------------------------------------------------- 3. колёсные арки
# Арка — цилиндр поперёк машины: он срезает только борт, не проходя кузов
# насквозь. Радиус = радиус шины + зазор.
арка_пп = cylinder radius=361 height=280 segments=72
арка_пп = rotate [арка_пп] angle=90 axis=x
арка_пп = place [арка_пп] at=[-1136,-756,316] align=center
кузов = difference [кузов, арка_пп]
арка_пз = cylinder radius=361 height=280 segments=72
арка_пз = rotate [арка_пз] angle=90 axis=x
арка_пз = place [арка_пз] at=[-1136,756,316] align=center
кузов = difference [кузов, арка_пз]
арка_зп = cylinder radius=370 height=300 segments=72
арка_зп = rotate [арка_зп] angle=90 axis=x
арка_зп = place [арка_зп] at=[1136,-786,325] align=center
кузов = difference [кузов, арка_зп]
арка_зз = cylinder radius=370 height=300 segments=72
арка_зз = rotate [арка_зз] angle=90 axis=x
арка_зз = place [арка_зз] at=[1136,786,325] align=center
кузов = difference [кузов, арка_зз]

# ------------------------------------------------ 4. «китовый хвост» и решётка
# Спойлер 930-го: плоская полка на моторном отсеке с двумя приподнятыми
# бортиками. Ставится по месту командой place, зазор отсчитывается от кузова.
полка = box size=[560,1210,34] round=14
полка = place [полка] at=[1334.5,0,1060] align=center
бортик_п = box size=[560,32,80] round=10
бортик_п = place [бортик_п] at=[1334.5,-590,1100] align=center
бортик_з = box size=[560,32,80] round=10
бортик_з = place [бортик_з] at=[1334.5,590,1100] align=center
стойка_п = cylinder radius=22 height=110 segments=24
стойка_п = place [стойка_п] at=[1334.5,-600,1000] align=center
стойка_з = cylinder radius=22 height=110 segments=24
стойка_з = place [стойка_з] at=[1334.5,600,1000] align=center
хвост = union [полка, бортик_п, бортик_з, стойка_п, стойка_з]
color хвост #14171c material=rubber

# Решётка моторного отсека: пятнадцать ламелей в ряд — та же геометрия, что
# в разрезе «Г—Г» на чертеже.
ламель = box size=[300,20,10] round=4
решётка = array [ламель] count=15 mode=linear offset=[0,88,0]
решётка = place [решётка] at=[1484.5,0,1012] align=center
color решётка #101317 metal=0.6 rough=0.35

# ------------------------------------------------------- 5. бамперы и оптика
бампер_п = cylinder radius=105 height=1470 segments=48
бампер_п = rotate [бампер_п] angle=90 axis=x
бампер_п = place [бампер_п] at=[-1975.5,0,345] align=center
бампер_з = cylinder radius=100 height=1520 segments=48
бампер_з = rotate [бампер_з] angle=90 axis=x
бампер_з = place [бампер_з] at=[1995.5,0,380] align=center
color бампер_п #16181c material=rubber
color бампер_з #16181c material=rubber

# Фары 911-го стоят на крыльях и чуть выступают над капотом.
фара_п = sphere radius=118 segments=40
фара_п = scale [фара_п] factor=[0.62,1.0,1.0]
фара_п = place [фара_п] at=[-1455.5,-560,742] align=center
фара_з = sphere radius=118 segments=40
фара_з = scale [фара_з] factor=[0.62,1.0,1.0]
фара_з = place [фара_з] at=[-1455.5,560,742] align=center
color фара_п #f7f3e6 metal=0.4 rough=0.05
color фара_з #f7f3e6 metal=0.4 rough=0.05

фонарь = box size=[44,1290,120] round=18
фонарь = place [фонарь] at=[2123.5,0,742] align=center
color фонарь #8c1210 metal=0.3 rough=0.25

# Надпись на задней панели: плоскость yz ставит буквы лицом в +X.
надпись = text text="PORSCHE" size=58 depth=6 weight=6 plane=yz at=[2139.5,0,626]
color надпись #d8dde5 metal=0.8 rough=0.2

# Зеркала и дверные ручки — по одному на борт, второй борт зеркалом.
ножка_зеркала = cylinder radius=16 height=90 segments=20
ножка_зеркала = rotate [ножка_зеркала] angle=90 axis=y
ножка_зеркала = place [ножка_зеркала] at=[-555.5,-800,948] align=center
зеркало = box size=[120,96,84] round=26
зеркало = place [зеркало] at=[-555.5,-832,1000] align=center
зеркала = union [ножка_зеркала, зеркало]
зеркала = mirror [зеркала] plane=y keep=да
ручка = box size=[170,18,34] round=8
ручка = place [ручка] at=[304.5,-815,830] align=center
ручки = mirror [ручка] plane=y keep=да
color зеркала #b8332f metal=0.45 rough=0.2
color ручки #d8dde5 metal=0.85 rough=0.16

# --------------------------------------------------------------- 6. колёса
# Ширина шины и вылет подобраны так, чтобы наружная плоскость колеса не
# выходила за габарит 1775 мм: 828.5 и 868.5 < 887.5.
колесо_пп = wheel diameter=632 width=225 rim=30 spokes=5 hub=96 tire=46 segments=64 at=[-1136,-716,0]
колесо_пз = wheel diameter=632 width=225 rim=30 spokes=5 hub=96 tire=46 segments=64 at=[-1136,716,0]
колесо_зп = wheel diameter=650 width=245 rim=32 spokes=5 hub=100 tire=48 segments=64 at=[1136,-746,0]
колесо_зз = wheel diameter=650 width=245 rim=32 spokes=5 hub=100 tire=48 segments=64 at=[1136,746,0]
color колесо_пп #191b1f material=rubber
color колесо_пз #191b1f material=rubber
color колесо_зп #191b1f material=rubber
color колесо_зз #191b1f material=rubber
color кузов #d8b400 metal=0.5 rough=0.22

# ----------------------------------------------------------------- 8. проверки
# Числа проверок — прямо с чертежа: база, колея, габарит.
check колесо_пп center -1136..-1136 -716..-716 316..316
check колесо_пз center -1136..-1136 716..716 316..316
check колесо_зп center 1136..1136 -746..-746 325..325
check колесо_зз center 1136..1136 746..746 325..325
check кузов width 4290..4292
# Высота кузова считается от его нижней точки: 1310 − 150 (просвет) = 1160.
# Полная высота 1310 получается вместе с колёсами — они и держат пол на Z=0.
check кузов height 1159..1163
check колесо_пп watertight
check колесо_зп parts 1
check надпись inside кузов
# Пересечения здесь — не ошибка, а конструкция: бамперы, фары и фонари
# посажены в кузов, стёкла утоплены в проёмы, спойлер стоит на кузове.
# Поэтому пары перечислены явно: отчёт `interference` покажет всё остальное.
interference tolerance=1 allow="хвост:решётка,решётка:хвост,кузов:бампер_*,бампер_*:кузов,кузов:фонарь,фонарь:кузов,фонарь:надпись,надпись:фонарь,кузов:фара_*,фара_*:кузов,кузов:лобовое,лобовое:кузов,кузов:заднее,заднее:кузов,кузов:стекло_*,стекло_*:кузов,кузов:решётка,решётка:кузов,кузов:надпись,надпись:кузов,кузов:хвост,хвост:кузов,кузов:зеркала,зеркала:кузов,кузов:ручки,ручки:кузов,кузов:колесо_*,колесо_*:кузов"
passport кузов
