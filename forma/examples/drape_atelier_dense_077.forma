# ФОРМА 3D 0.77 — более плотная испытательная сцена: те же четыре случая.
# Это не ускоренный пресет: расчёт может занимать несколько минут.
# Плотный рукав намеренно оставлен с коротким лимитом шагов: равновесие не доказано.
# +Z — вверх; все размеры — в мм. Никакой анимации: команда выдаёт одну позу.
# В журнале проверяйте равновесие, изменение рёбер и пересечения; расчёт приближённый.

пол = box size=[620,200,6] at=[0,0,-6] color=#d8d8d0

# Две плоскости БЕЗ спрятанного выступа: верхний лист ложится на нижний.
# Между поверхностями оставлен зазор 0.12 мм, чтобы было видно границу слоёв.
нижний_лист = box size=[72,60,0.6] at=[-235,0,30] color=#438eac
верхний_лист = box size=[60,48,0.6] at=[-234,0,38] color=#eecb91
слои = drape [нижний_лист,верхний_лист] on=пол mesh=4 particles=5000 steps=150 constraints=24 bend=0.25 damping=0.4 g=0.08 self=да self_gap=0.12

# Полый деформируемый рукав, а не сплошной цилиндр. Исходный диаметр — 22 мм.
рукав = pipe length=70 diameter=22 wall=0.6 sides=64 at=[-115,0,40] color=#ad6e83
упавший_рукав = drape рукав on=пол mesh=6 particles=5000 steps=60 constraints=24 bend=0.35 damping=0.2 friction=0.9 g=0.02 self=да self_gap=0.25

# Шар — отдельная падающая фигура. Автожёсткость сохраняет его как твёрдое тело.
шар = sphere radius=18 segments=96 detail=5 at=[-15,0,55] color=#d77d48
упавший_шар = drape шар on=пол mesh=5 particles=5000 steps=100 constraints=20 g=0.05 damping=0.3

# Столешница со скруглённой кромкой и четырьмя отдельными ножками.
# Нижнюю часть болванки срезаем, чтобы осталась видна подстольная область.
болванка_стола = box size=[80,80,40] round=12 at=[150,0,0] color=#9a765f
срез_под_столом = box size=[100,100,21] at=[150,0,-1]
столешница = difference [болванка_стола,срез_под_столом]
ножка_левая_передняя = box size=[7,7,20] at=[122,-28,0] color=#7b5b49
ножка_правая_передняя = box size=[7,7,20] at=[178,-28,0] color=#7b5b49
ножка_левая_задняя = box size=[7,7,20] at=[122,28,0] color=#7b5b49
ножка_правая_задняя = box size=[7,7,20] at=[178,28,0] color=#7b5b49

# Лист шире стола, поэтому края могут свисать. Зазор до опор 0.7 мм указан
# явно: это не идеальное касание, а проверяемый компромисс данной сцены.
лист_скатерти = box size=[120,120,0.6] at=[150,0,70] color=#94a788
скатерть = drape лист_скатерти on=[столешница,ножка_левая_передняя,ножка_правая_передняя,ножка_левая_задняя,ножка_правая_задняя,пол] mesh=5.4 particles=5000 steps=140 constraints=20 bend=0.2 damping=0.2 friction=0.2 g=0.06 self_gap=0.12 gap=0.7
