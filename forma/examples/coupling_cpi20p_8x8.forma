# Муфта разрезная INNOCONT серии CPI с зажимным кольцом, CPI-20P-8x8.
# Пластик (P = ПВХ/POM), валы 8x8, наружный диаметр 20, длина 26.
#
# Размеры взяты из заводской таблицы серии (строка CPI-20P(C)):
#   D  = 20    — наружный диаметр корпуса
#   L  = 26    — полная длина
#   L1 = 7,5   — длина каждой зажимной ступицы
#   L2 = 3,75  — от торца до оси зажимного винта (= L1/2)
#   F  = 6,5   — вылет оси винта от оси муфты
#   M  = M2.5  — резьба зажимного винта
#   D1 = D2 = 8 — отверстия под валы, сквозные
# Средний упругий пояс: L − 2·L1 = 11 мм.
#
# Канон: верх +Z, низ −Z, перед −Y, право +X.

param D=20 min=10 max=40 step=0.5 label="Наружный диаметр"
param L=26 min=15 max=50 step=0.5 label="Полная длина"
param L1=7.5 min=3 max=15 step=0.25 label="Длина зажимной ступицы"
param L2=3.75 min=1 max=10 step=0.25 label="Ось винта от торца"
param d_bore=8 min=4 max=16 step=0.5 label="Отверстие под вал"

R = derive D / 2
r = derive d_bore / 2
band = derive L - 2 * L1
wall = derive R - r
# DSL не считает арифметику внутри аргументов — все суммы выносим в derive.
slot_len = derive wall + 1.6
slot_y = derive r + slot_len / 2 - 1
bore_depth = derive wall + 0.8
bore_entry = derive R + 0.8
screw_axial = derive R - 1.1
socket_axial = derive R - 0.55
screw_z_top = derive L - L2
z_top_slit = derive L - L1
z_bore_chamfer = derive r + 0.5
z_bore_r = derive r
z_top = derive L - 0.5
z_top_full = derive L + 1
lit_r = derive R - 0.5

# ------------------------------------------------------------------ корпус --
# Тело вращения с фаской 0,5 мм на наружных торцах: острых рёбер нет,
# как на фото и в разрезе чертежа.
заготовка = lathe points=[
    [0, 0], [lit_r, 0], [R, 0.5], [R, z_top], [lit_r, L], [0, L]
  ] segments=144

# Сквозное отверстие под вал: цилиндр с конической зенковкой на обоих торцах
# (0,5 × 45°), чтобы вал заходил без задиров и кромка не была острой.
отверстие = lathe points=[
    [0, -1], [z_bore_chamfer, -1], [z_bore_chamfer, 0], [z_bore_r, 0.5],
    [z_bore_r, z_top], [z_bore_chamfer, L], [z_bore_chamfer, z_top_full], [0, z_top_full]
  ] segments=144
корпус = difference [заготовка, отверстие]

# -------------------------------------------------- упругий винтовой пояс --
# Восемь винтовых прорезей шириной 1,3 мм, прорезанных насквозь до отверстия
# и закрученных на 180° по всей длине пояса. Именно так устроена разрезная
# муфта: каждая прорезь — половина оборота, соседние сдвинуты на 45°, поэтому
# они не пересекаются, тело остаётся связным, а пояс работает как пружина
# (2° угла и 0,10 мм радиального смещения из таблицы).
ширина_прорези = 1.3
закрутка = 180
# Резак не доходит до оси: прорезь идёт хордой и открывается на наружной
# поверхности чисто, без «клювиков» в том месте, где круг касается плоскости.
полу_R = derive R + 1
хорда = derive r - 1
прорезь = box size=[ширина_прорези, полу_R - хорда, band] at=[0, хорда + (полу_R - хорда) / 2, L1]
прорезь = twist [прорезь] angle=закрутка axis=z
прорезь_2 = rotate [прорезь] angle=45 axis=z
прорезь_3 = rotate [прорезь] angle=90 axis=z
прорезь_4 = rotate [прорезь] angle=135 axis=z
прорезь_5 = rotate [прорезь] angle=180 axis=z
прорезь_6 = rotate [прорезь] angle=225 axis=z
прорезь_7 = rotate [прорезь] angle=270 axis=z
прорезь_8 = rotate [прорезь] angle=315 axis=z
корпус = difference [корпус, прорезь, прорезь_2, прорезь_3, прорезь_4, прорезь_5, прорезь_6, прорезь_7, прорезь_8]

# ------------------------------------------------------ разрезные ступицы --
# Продольная прорезь 1 мм от наружной поверхности до отверстия на всю длину
# ступицы: стягивая её винтом, кольцо обжимает вал. Обе ступицы разрезаны
# с одной стороны (+Y), как на фотографиях.
прорезь_низ = box size=[1, slot_len, L1] at=[0, slot_y, 0]
прорезь_верх = box size=[1, slot_len, L1] at=[0, slot_y, z_top_slit]
корпус = difference [корпус, прорезь_низ, прорезь_верх]

# Радиальные отверстия M2.5 под зажимные винты: под 90° к прорези, на L2 от
# торца, сквозь стенку в отверстие, с зенковкой 0,3 мм.
корпус = bore [корпус] at=[bore_entry, 0, L2] dir=[-1, 0, 0] diameter=2.5 depth=bore_depth countersink=0.35
корпус = bore [корпус] at=[bore_entry, 0, screw_z_top] dir=[-1, 0, 0] diameter=2.5 depth=bore_depth countersink=0.35

# Цековка под головку винта: 2,2 мм глубиной, чтобы головка сидела в теле,
# а не торчала штырём — как на фотографии.
цековка = cylinder radius=2.3 height=2.2 at=[0, 0, -2.2]
цековка = rotate [цековка] angle=-90 axis=y
цек_низ = translate [цековка] offset=[screw_axial, 0, L2]
цек_верх = translate [цековка] offset=[screw_axial, 0, screw_z_top]
корпус = difference [корпус, цек_низ, цек_верх]

# ---------------------------------------------------------------- винты ----
# Винт M2.5 с цилиндрической головкой и внутренним шестигранником.
# Собираем вдоль +Z по центру, поворачиваем на -90° вокруг Y (ось смотрит в
# +X) и сажаем в цековку. Гнездо под ключ режем отдельно уже на месте — так
# оно гарантированно оказывается на наружном торце головки.
shank_len = 5
шляпка = cylinder radius=2.2 height=2.0 at=[0, 0, -1.0]
стержень = cylinder radius=1.25 height=shank_len at=[0, 0, 1.0]
винт = union [шляпка, стержень]
винт = rotate [винт] angle=-90 axis=y
винт_низ = translate [винт] offset=[screw_axial, 0, L2]
винт_верх = translate [винт] offset=[screw_axial, 0, screw_z_top]

гнездо = prism sides=6 radius=1.25 height=1.6 at=[0, 0, -0.8]
гнездо = rotate [гнездо] angle=-90 axis=y
гнездо_низ = translate [гнездо] offset=[socket_axial, 0, L2]
гнездо_верх = translate [гнездо] offset=[socket_axial, 0, screw_z_top]
винт_низ = difference [винт_низ, гнездо_низ]
винт_верх = difference [винт_верх, гнездо_верх]

# -------------------------------------------------------------- материалы --
color корпус #b8b4ab material=plastic rough=0.45
color винт_низ #9aa1a8 metal=0.85 rough=0.3
color винт_верх #9aa1a8 metal=0.85 rough=0.3

scene bg=#eef0f2 shadows=да ground=да
light preset=студия strength=1.05

check корпус watertight
check корпус parts 1
check корпус height 25.9..26.1
check корпус tris ..90000
