# Муфта разрезная INNOCONT серии CPI с зажимным кольцом, CPI-20P-8x8.
# Пластик (P = ПВХ/POM), валы 8x8, наружный диаметр 20, длина 26.
#
# Размеры из заводской таблицы (строка CPI-20P(C)):
#   D  = 20    — наружный диаметр корпуса
#   L  = 26    — полная длина
#   L1 = 7,5   — длина каждой зажимной ступицы
#   L2 = 3,75  — от торца до оси зажимного винта (= L1/2)
#   M  = M2.5  — резьба зажимного винта
#   D1 = D2 = 8 — отверстия под валы, сквозные
# Средний упругий пояс: L − 2·L1 = 11 мм.
#
# Конструкция:
#   • 6 боковых надрезов в поясе, плоскости ⊥ оси; надрез идёт по дуге
#     (угол — параметр), снаружи внутрь, но НЕ доходит насквозь до осевого
#     отверстия: остаётся стенка; концы надреза скруглены — не прямые углы;
#   • на каждом торце — диаметральный пропил на всю длину ступицы;
#   • два отверстия на боковой стенке, ось ПЕРПЕНДИКУЛЯРНА стенке (поэтому
#     вход — ровный круг, без овала и без «ям» в сторону):
#     гнездо Ø5 (ровный круг) → узкий проход Ø2,5 с винтовой резьбой,
#     который выходит в осевое отверстие под вал;
#   • шестигранники — ОТДЕЛЬНЫЕ детали, вставленные внутрь гнёзд Ø5;
#   • третье отверстие — осевое Ø8 под вал.
#
# Канон: верх +Z, низ −Z, перед −Y, право +X.

param D=20 min=10 max=40 step=0.5 label="Наружный диаметр"
param L=26 min=15 max=50 step=0.5 label="Полная длина"
param L1=7.5 min=3 max=15 step=0.25 label="Длина ступицы"
param L2=3.75 min=1 max=10 step=0.25 label="Ось винта от торца"
param d_bore=8 min=4 max=16 step=0.5 label="Отверстие под вал"

param cut_arc=270 min=90 max=350 step=5 label="Угол боковых надрезов, °"
param cut_depth=4.5 min=0.5 max=5.5 step=0.25 label="Глубина надреза"
param cut_w=0.8 min=0.4 max=2 step=0.05 label="Ширина надреза"
param cut_round=0.35 min=0 max=1 step=0.05 label="Скругление концов надреза"

param hole_d=5 min=3 max=9 step=0.5 label="Гнездо под ключ, Ø"
param hole_depth=3.6 min=1.5 max=5 step=0.1 label="Глубина гнезда"
param thr_d=2.5 min=1.5 max=4 step=0.25 label="Винтовой проход, Ø"
param thr_pitch=0.8 min=0.3 max=2 step=0.05 label="Шаг резьбы"
param hex_r=2.35 min=1 max=4 step=0.05 label="Шестигранник, радиус по вершинам"
param hex_h=2.6 min=0.8 max=5 step=0.1 label="Высота шестигранника"

R = derive D / 2
r = derive d_bore / 2
band = derive L - 2 * L1
pitch = derive band / 6
z_top_full = derive L + 1
hole_r = derive hole_d / 2

# Точность задаётся ДО построения и без явного segments у примитивов: при
# segments=… операция всё равно режет число граней по допуску 0,06 мм, и
# отверстие Ø5 получает 16 граней. Здесь Ø5 → 104 сегмента, корпус → 200.
precision mode=ultra tolerance=0.005

# --------------------------------------------------------------- корпус -----
# Тело вращения Ø20 × 26 с фаской 0,5 × 45° на обоих наружных торцах.
lit_r = derive R - 0.5
z_top_ch = derive L - 0.5
заготовка = lathe points=[
    [0, 0], [lit_r, 0], [R, 0.5], [R, z_top_ch], [lit_r, L], [0, L]
  ]

# Сквозное отверстие под вал Ø8 с зенковкой 0,5 × 45° с двух сторон.
r_ch = derive r + 0.5
отверстие = lathe points=[
    [0, -1], [r_ch, -1], [r_ch, 0], [r, 0.5],
    [r, z_top_ch], [r_ch, L], [r_ch, z_top_full], [0, z_top_full]
  ]
корпус = difference [заготовка, отверстие]

# ------------------------------------------------- боковые надрезы ----------
# Надрез — сектор кольца шириной cut_w по дуге cut_arc: снаружи внутрь,
# глубина cut_depth, до осевого отверстия не доходит (остаётся стенка).
# fillet со радиусом половины ширины делает концы надреза полукруглыми —
# углов и «прямых срезов» на концах нет.
cut_in = derive R - cut_depth
cut_out = derive R + 2
cut_r = derive cut_w / 2
cut_mid = derive cut_in + cut_depth / 2
# Профиль резака скруглён (fillet=половина ширины): канавка выходит
# полукруглой — и на дне, и у входа, прямых углов нет.
Надрез = lathe points=[[cut_in, 0], [cut_out, 0], [cut_out, cut_w], [cut_in, cut_w]] arc=cut_arc fillet=cut_r
# Концы дуги тоже полукруглые: на каждом торце надреза лежит полуцилиндр
# радиусом в половину ширины, по всей глубине реза — торец не плоский срез.
торец = cylinder radius=cut_r height=cut_depth
торец = rotate [торец] angle=90 axis=y
торец_A = translate [торец] offset=[cut_in, 0, cut_r]
торец_B = rotate [торец_A] angle=cut_arc axis=z
Надрез = union [Надрез, торец_A, торец_B]

резак_1 = rotate [Надрез] angle=90 axis=z
резак_1 = translate [резак_1] offset=[0, 0, 8.1417]
резак_2 = rotate [Надрез] angle=270 axis=z
резак_2 = translate [резак_2] offset=[0, 0, 9.975]
резак_3 = rotate [Надрез] angle=90 axis=z
резак_3 = translate [резак_3] offset=[0, 0, 11.8083]
резак_4 = rotate [Надрез] angle=270 axis=z
резак_4 = translate [резак_4] offset=[0, 0, 13.6417]
резак_5 = rotate [Надрез] angle=90 axis=z
резак_5 = translate [резак_5] offset=[0, 0, 15.475]
резак_6 = rotate [Надрез] angle=270 axis=z
резак_6 = translate [резак_6] offset=[0, 0, 17.3083]
корпус = difference [корпус, резак_1, резак_2, резак_3, резак_4, резак_5, резак_6]

# ------------------------------------------------ диаметральные пропилы ----
# Пропил идёт через весь диаметр от торца на всю длину ступицы: на торце
# видна прямая линия через всё лицо. Ступица A разрезана в плоскости XZ,
# ступица B — в плоскости YZ (пропилы перпендикулярны).
slit_w = 0.8
slit_len = derive L1 + 1
пропил_A = box size=[24, slit_w, slit_len] at=[0, 0, -1]
пропил_B = box size=[slit_w, 24, slit_len] at=[0, 0, L1 + band]
корпус = difference [корпус, пропил_A, пропил_B]

# -------------------------------------------------------- гнёзда Ø5 ---------
# Ось отверстия перпендикулярна стенке (радиальная), поэтому вход на
# цилиндрической поверхности — ровный круг, без овала.
зев = derive hole_depth + 3
гнездо = cylinder radius=hole_r height=зев
гнездо_Y = rotate [гнездо] angle=-90 axis=x
гнездо_A = translate [гнездо_Y] offset=[0, -R - 3, L2]
гнездо_X = rotate [гнездо] angle=90 axis=y
гнездо_B = translate [гнездо_X] offset=[R + 3 - зев, 0, L - L2]
корпус = difference [корпус, гнездо_A, гнездо_B]

# ------------------------------------------- винтовой проход Ø2,5 ----------
# От дна гнезда — вниз, сквозь стенку в осевое отверстие под вал.
глух = derive R - hole_depth
ход = derive глух - r + 1.2
винт = thread diameter=thr_d length=ход depth=0.3 pitch=thr_pitch
винт_Y = rotate [винт] angle=90 axis=x
винт_A = translate [винт_Y] offset=[0, -глух + 0.6, L2]
винт_X = rotate [винт] angle=-90 axis=y
винт_B = translate [винт_X] offset=[глух - 0.6 - ход, 0, L - L2]
корпус = difference [корпус, винт_A, винт_B]

# --------------------------------------- шестигранники — отдельные детали ---
# Это не вырез в корпусе, а самостоятельная деталь-меш, вложенная в гнездо:
# шестигранная гайка со сквозным отверстием, поэтому винтовой проход виден
# насквозь.
hex_hole_h = derive hex_h + 2
гекс_отв = cylinder radius=1.25 height=hex_hole_h

шестигранник_A = prism sides=6 radius=hex_r height=hex_h
шестигранник_A = difference [шестигранник_A, гекс_отв]
шестигранник_A = rotate [шестигранник_A] angle=-90 axis=x
шестигранник_A = translate [шестигранник_A] offset=[0, -R + 0.3 + hex_h, L2]
color шестигранник_A #8e8c86 material=plastic rough=0.3

шестигранник_B = prism sides=6 radius=hex_r height=hex_h
шестигранник_B = difference [шестигранник_B, гекс_отв]
шестигранник_B = rotate [шестигранник_B] angle=90 axis=y
шестигранник_B = translate [шестигранник_B] offset=[R - 0.3 - hex_h, 0, L - L2]
color шестигранник_B #8e8c86 material=plastic rough=0.3

# ------------------------------------------------------------- материалы ---
color корпус #c8c6c0 material=plastic rough=0.45

scene bg=#eef0f2 shadows=да ground=да
light preset=студия strength=1.05

check корпус watertight
check корпус parts 1
check корпус height 25.9..26.1
check корпус tris ..200000
check шестигранник_A watertight
check шестигранник_B watertight
