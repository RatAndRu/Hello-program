# Муфта разрезная INNOCONT серии CPI с зажимным кольцом, CPI-20P-8x8.
# Пластик (P = ПВХ/POM), валы 8x8, наружный диаметр 20, длина 26.
#
# Размеры из заводской таблицы (строка CPI-20P(C)):
#   D  = 20    — наружный диаметр корпуса
#   L  = 26    — полная длина
#   L1 = 7,5   — длина каждой зажимной ступицы
#   L2 = 3,75  — от торца до оси зажимного винта (= L1/2)
#   M  = M2.5  — резьба зажимного винта
#   D1 = D2 = 8 — отверстия под валы, сквозные
# Средний упругий пояс: L − 2·L1 = 11 мм.
#
# Конструкция (согласована по превью №2):
#   • 6 поперечных надрезов в поясе, плоскости ⊥ оси; надрез идёт через весь
#     диаметр и не доходит до противоположной стенки — остаётся перемычка,
#     у соседних этажей она с другой стороны (шахматка);
#   • на каждом торце — диаметральный пропил на всю длину ступицы;
#   • два сквозных ступенчатых отверстия: шестигранное гнездо → резьба M2.5 →
#     узкий проход Ø2,2, который выходит маленьким отверстием с другой стороны;
#   • плоскости этих двух отверстий перпендикулярны друг другу;
#   • третье отверстие — осевое Ø8 под вал.
#
# Канон: верх +Z, низ −Z, перед −Y, право +X.

param D=20 min=10 max=40 step=0.5 label="Наружный диаметр"
param L=26 min=15 max=50 step=0.5 label="Полная длина"
param L1=7.5 min=3 max=15 step=0.25 label="Длина ступицы"
param L2=3.75 min=1 max=10 step=0.25 label="Ось винта от торца"
param d_bore=8 min=4 max=16 step=0.5 label="Отверстие под вал"

R = derive D / 2
big = derive R + 2
r = derive d_bore / 2
band = derive L - 2 * L1
pitch = derive band / 6
z_top_full = derive L + 1

# Точность задаётся ДО построения и только в такой форме: при ЯВНОМ
# segments=… операция режет число сегментов по допуску 0,06 мм, и мелкие
# отверстия (Ø5, Ø2,5) получают 14–16 граней — кромки выглядят гранёными.
# Без явного segments работает глобальная точность: Ø5 → 104 сегмента.
precision mode=ultra tolerance=0.005

# --------------------------------------------------------------- корпус -----
# Тело вращения Ø20 × 26 с фаской 0,5 × 45° на обоих наружных торцах.
lit_r = derive R - 0.5
z_top_ch = derive L - 0.5
заготовка = lathe points=[
    [0, 0], [lit_r, 0], [R, 0.5], [R, z_top_ch], [lit_r, L], [0, L]
  ]

# Сквозное отверстие под вал Ø8 с зенковкой 0,5 × 45° с двух сторон.
r_ch = derive r + 0.5
отверстие = lathe points=[
    [0, -1], [r_ch, -1], [r_ch, 0], [r, 0.5],
    [r, z_top_ch], [r_ch, L], [r_ch, z_top_full], [0, z_top_full]
  ]
корпус = difference [заготовка, отверстие]

# ------------------------------------------------- поперечные надрезы ------
# Надрез прорезает стенку насквозь — от наружной поверхности до отверстия
# под вал — и идёт по окружности 270°: остаётся перемычка 90°, поэтому деталь
# не распадается. У соседних этажей перемычка с противоположной стороны.
cut_w = 0.55
cut_in = derive r - 1
cut_out = derive R + 2
Надрез = lathe points=[[cut_in, 0], [cut_out, 0], [cut_out, cut_w], [cut_in, cut_w]] arc=270
резак_1 = rotate [Надрез] angle=90 axis=z
резак_1 = translate [резак_1] offset=[0, 0, 8.1417]
резак_2 = rotate [Надрез] angle=270 axis=z
резак_2 = translate [резак_2] offset=[0, 0, 9.975]
резак_3 = rotate [Надрез] angle=90 axis=z
резак_3 = translate [резак_3] offset=[0, 0, 11.8083]
резак_4 = rotate [Надрез] angle=270 axis=z
резак_4 = translate [резак_4] offset=[0, 0, 13.6417]
резак_5 = rotate [Надрез] angle=90 axis=z
резак_5 = translate [резак_5] offset=[0, 0, 15.475]
резак_6 = rotate [Надрез] angle=270 axis=z
резак_6 = translate [резак_6] offset=[0, 0, 17.3083]
корпус = difference [корпус, резак_1, резак_2, резак_3, резак_4, резак_5, резак_6]

# ------------------------------------------------ диаметральные пропилы ----
# Пропил идёт через весь диаметр от торца на всю длину ступицы: на торце
# видна прямая линия через всё лицо, как на фото. Ступица A разрезана в
# плоскости XZ, ступица B — в плоскости YZ (пропилы перпендикулярны).
slit_w = 0.8
slit_half = 0.4
slit_len = derive L1 + 1
пропил_A = box size=[24, slit_w, slit_len] at=[0, 0, -1]
пропил_B = box size=[slit_w, 24, slit_len] at=[0, 0, L1 + band]
корпус = difference [корпус, пропил_A, пропил_B]

# ------------------------------------------- сквозные ступенчатые отверстия -
# Отверстий всего два (третье — осевое Ø8). Каждое идёт ХОРДОЙ: ось смещена
# от оси детали на chord, поэтому сверло проходит мимо вала, а не через
# центр. Вход — круглое отверстие Ø5 (без фаски: на смещённом входе фаска
# ложится клином и даёт «скол», поэтому кромка оставлена ровной), в него
# ВПИСАН шестигранник гнезда под ключ, глубже — туннель с настоящей винтовой
# резьбой по всей длине и узким выходом на противоположной стороне.
# Плоскости двух отверстий перпендикулярны: A вдоль Y, B вдоль X.
chord = 6.6            # смещение оси отверстия от оси детали
round_r = 2.5          # круглая дырка Ø5
hex_r = 2.5            # шестигранник ровно вписан: его вершины лежат на окружности дырки
hole_in = derive R - 1.8
d_round = 3.4          # цилиндрическая часть круглой дырки
d_hex = 3.0            # глубина шестигранного гнезда
d_thr = 8.0            # резьбовой участок туннеля
d_out = 2.6            # гладкая заходная часть у выхода (кромка остаётся круглой)

# --- круглая дырка Ø5
круглое = cylinder radius=round_r height=d_round
круглое_Y = rotate [круглое] angle=-90 axis=x
круглое_A = translate [круглое_Y] offset=[chord, -hole_in, L2]
круглое_X = rotate [круглое] angle=-90 axis=y
круглое_B = translate [круглое_X] offset=[hole_in, -chord, L - L2]
корпус = difference [корпус, круглое_A, круглое_B]

# --- шестигранное гнездо, вписанное в круглую дырку
гнездо = prism sides=6 radius=hex_r height=d_hex
гнездо_Y = rotate [гнездо] angle=-90 axis=x
гнездо_A = translate [гнездо_Y] offset=[chord, -hole_in + d_round, L2]
гнездо_X = rotate [гнездо] angle=-90 axis=y
гнездо_B = translate [гнездо_X] offset=[hole_in - d_round, -chord, L - L2]
корпус = difference [корпус, гнездо_A, гнездо_B]

# --- резьба по всему туннелю: винтовой стержень Ø2,5, шаг 0,9, глубина 0,32.
#     Вычитание стержня оставляет в стенке винтовую канавку по всей длине
#     туннеля — от гнезда до выхода на противоположной стороне.
виток = thread diameter=2.5 length=d_thr depth=0.32 pitch=0.9 right=true
виток_Y = rotate [виток] angle=-90 axis=x
виток_A = translate [виток_Y] offset=[chord, -hole_in + d_round + d_hex, L2]
виток_X = rotate [виток] angle=-90 axis=y
виток_B = translate [виток_X] offset=[hole_in - d_round - d_hex, -chord, L - L2]
корпус = difference [корпус, виток_A, виток_B]

# --- заходная часть у выхода: гладкая Ø2,5. Резьба, доведённая до самой
#     кромки, при выходе на кривую стенку под 41° оставляла тонкие лепестки-
#     сколы; гладкий участок 1 мм убирает их, кромка выхода ровная.
выход = cylinder radius=2.5 height=d_out
выход_Y = rotate [выход] angle=-90 axis=x
выход_A = translate [выход_Y] offset=[chord, -hole_in + d_round + d_hex + d_thr, L2]
выход_X = rotate [выход] angle=-90 axis=y
выход_B = translate [выход_X] offset=[hole_in - d_round - d_hex - d_thr, -chord, L - L2]
корпус = difference [корпус, выход_A, выход_B]

# ------------------------------------------------------------- материалы ---
color корпус #c8c6c0 material=plastic rough=0.45

scene bg=#eef0f2 shadows=да ground=да
light preset=студия strength=1.05

check корпус watertight
check корпус parts 1
check корпус height 25.9..26.1
check корпус tris ..120000
