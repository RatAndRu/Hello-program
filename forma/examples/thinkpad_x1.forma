animate key_j_assembly move dz=-0.55 seconds=0.18 start=0.5 scene=клавиши
animate key_j_assembly move dz=0.55 seconds=0.22 start=0.7 scene=клавиши
animate key_k_assembly move dz=-0.55 seconds=0.18 start=1 scene=клавиши
animate key_k_assembly move dz=0.55 seconds=0.22 start=1.2 scene=клавиши
animate key_space_assembly move dz=-0.55 seconds=0.18 start=1.5 scene=клавиши
animate key_space_assembly move dz=0.55 seconds=0.22 start=1.7 scene=клавиши
animate trackpad_assembly move dz=-0.3 seconds=0.2 start=2.0 scene=клавиши
animate trackpad_assembly move dz=0.3 seconds=0.25 start=2.2 scene=клавиши

