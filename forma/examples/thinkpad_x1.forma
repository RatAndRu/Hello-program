color track_mid_rib_5 #353c42 rough=0.55
track_mid_rib_6 = box size=[0.65,5.5,0.18] at=[4.5,-43.5,11.1] round=0.08 detail=1
color track_mid_rib_6 #353c42 rough=0.55
power_button = ingot length=25 width=6.5 height=0.65 taper=0 round=1.4 smooth=0 at=[0,84.5,10.65]
color power_button #020304 metal=0.0 rough=0.6
power_led = cylinder radius=0.55 height=0.2 segments=16 at=[-8.5,84.5,11.3]
color power_led #b9d7d0 emissive=#8adfce emissive_strength=0.5 rough=0.3

# ---------- Петли и резиновые ножки ----------
hinge_left_raw = cylinder radius=2.8 height=45 segments=48 at=[0,0,0]
hinge_left_raw = rotate [hinge_left_raw] angle=90 axis=y
hinge_left = translate [hinge_left_raw] offset=[-130,96,12.4]
color hinge_left #101418 metal=0.35 rough=0.5
hinge_right_raw = cylinder radius=2.8 height=45 segments=48 at=[0,0,0]
hinge_right_raw = rotate [hinge_right_raw] angle=90 axis=y
hinge_right = translate [hinge_right_raw] offset=[85,96,12.4]
color hinge_right #101418 metal=0.35 rough=0.5
foot_front_left = ingot length=44 width=7 height=1.15 taper=0 round=1.0 smooth=0 at=[-112,-94,0]
color foot_front_left #020304 rough=0.86
foot_front_right = ingot length=44 width=7 height=1.15 taper=0 round=1.0 smooth=0 at=[112,-94,0]
color foot_front_right #020304 rough=0.86
foot_rear_left = ingot length=38 width=7 height=1.15 taper=0 round=1.0 smooth=0 at=[-112,86,0]
color foot_rear_left #020304 rough=0.86
foot_rear_right = ingot length=38 width=7 height=1.15 taper=0 round=1.0 smooth=0 at=[112,86,0]
color foot_rear_right #020304 rough=0.86

