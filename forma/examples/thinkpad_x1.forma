# Lenovo ThinkPad X1 Carbon Gen 11 — цельный ноутбук с рабочими анимациями.
# Референс: Lenovo PSREF, 315.6×222.5×15.36 мм, 14 дюймов, 16:10.
# https://psref.lenovo.com/product/ThinkPad/ThinkPad_X1_Carbon_Gen_11
# Активная матрица 14″ 16:10: 301.7×188.6 мм; боковые рамки около 7 мм.
# Все размеры в мм. Перёд −Y, шарниры на +Y, верх +Z.
scene bg=#11161d env=studio exposure=0.9 shadows=да grid=нет ground=да axes=нет poly=нет bloom=0.2

# ---------- Нижний корпус: алюминий, настоящие углубления портов и вентиляции ----------
base_blank = box size=[315.6,222.5,8.1] at=[0,0,1] round=3 detail=3
usb_c_1_cut = box size=[7,9,3.4] at=[-157,70,4.1] round=0.65 detail=1
usb_c_2_cut = box size=[7,9,3.4] at=[-157,48,4.1] round=0.65 detail=1
usb_a_left_cut = box size=[7,13.5,5] at=[-157,18,4.1] round=0.65 detail=1
hdmi_cut = box size=[7,15,5.2] at=[-157,-12,4.1] round=0.65 detail=1
usb_a_right_cut = box size=[7,13.5,5] at=[157,28,4.1] round=0.65 detail=1
nano_sim_cut = box size=[7,12,1.8] at=[157,2,5] round=0.45 detail=1
kensington_cut = box size=[7,8,3.2] at=[157,-22,4.5] round=0.55 detail=1
audio_cut_raw = cylinder radius=1.75 height=8 segments=32 at=[0,0,0]
audio_cut_raw = rotate [audio_cut_raw] angle=90 axis=y
audio_cut = translate [audio_cut_raw] offset=[154,60,5.9]
rear_vent_seed = box size=[4.5,6,3.4] at=[-67.5,109,4] round=0.55 detail=1
rear_vents = array [rear_vent_seed] count=16 mode=linear offset=[9,0,0]
bottom_vent_seed = box size=[3.2,14,2] at=[-44,-27,0.5] round=0.7 detail=1
bottom_vents = array [bottom_vent_seed] mode=grid counts=[12,4,1] spacing=[8,18,0]
port_cutters = union [
    usb_c_1_cut, usb_c_2_cut, usb_a_left_cut, hdmi_cut, usb_a_right_cut, nano_sim_cut, kensington_cut, audio_cut,
    rear_vents, bottom_vents]
base_lower = difference [base_blank, port_cutters]
color base_lower #010202 metal=0.0 rough=0.68

# ---------- Верхняя дека, клавиатурный колодец, тачпад и динамики ----------
deck_blank = ingot length=313.6 width=220.5 height=1.75 taper=0 round=2.2 smooth=0 at=[0,0,8.95]
keyboard_recess = ingot length=276 width=110 height=1.9 taper=0 round=1.4 smooth=0 at=[0,18,9.35]
trackpad_recess = ingot length=112 width=58 height=1.55 taper=0 round=1.6 smooth=0 at=[0,-79,9.7]
speaker_hole_seed = cylinder radius=0.65 height=1.4 segments=8 at=[-148.2,-22,10]
speaker_left_holes = array [speaker_hole_seed] mode=grid counts=[3,14,1] spacing=[3.2,4.8,0]
speaker_hole_seed_r = cylinder radius=0.65 height=1.4 segments=8 at=[141.8,-22,10]
speaker_right_holes = array [speaker_hole_seed_r] mode=grid counts=[3,14,1] spacing=[3.2,4.8,0]
deck = difference [deck_blank, keyboard_recess, trackpad_recess, speaker_left_holes, speaker_right_holes]
color deck #020304 metal=0.0 rough=0.66
keyboard_bed = box size=[274,108,0.3] at=[0,18,9.35] round=0.135 detail=1
color keyboard_bed #010202 rough=0.74
trackpad = ingot length=110 width=56 height=0.5 taper=0 round=1.5 smooth=0 at=[0,-79,10.2]
color trackpad #080b0e metal=0.0 rough=0.62
track_btn_left = ingot length=44 width=10 height=0.65 taper=0 round=0.65 smooth=0 at=[-32,-43.5,10.45]
color track_btn_left #020304 rough=0.66
track_btn_mid = ingot length=18 width=10 height=0.65 taper=0 round=0.65 smooth=0 at=[0,-43.5,10.45]
color track_btn_mid #020304 rough=0.66
track_btn_right = ingot length=44 width=10 height=0.65 taper=0 round=0.65 smooth=0 at=[32,-43.5,10.45]
color track_btn_right #020304 rough=0.66
track_btn_accent = box size=[108,0.55,0.25] at=[0,-49,10.47] round=0.1 detail=1
color track_btn_accent #a92432 rough=0.5
track_mid_rib_0 = box size=[0.65,5.5,0.18] at=[-4.5,-43.5,11.1] round=0.08 detail=1
color track_mid_rib_0 #353c42 rough=0.55
track_mid_rib_1 = box size=[0.65,5.5,0.18] at=[-3,-43.5,11.1] round=0.08 detail=1
