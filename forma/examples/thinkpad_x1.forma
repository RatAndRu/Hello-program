# ---------- Рабочие анимации: петли, клавиши и тачпад ----------
lid_assembly = group [lid_shell, lid_inner, screen_active, windows_0, windows_1, windows_2, windows_3, screen_taskbar, task_icon_0, task_icon_1, task_icon_2, task_icon_3, task_icon_4, desktop_icon_0, desktop_icon_1, desktop_icon_2, screen_caption, screen_clock, desktop_label_0, desktop_label_1, desktop_label_2, camera_module, camera_lens, camera_ir, think_shutter, bezel_label, lid_logo, lid_x1, lid_red_dot]
key_h_assembly = group [key_h, key_h_text]
key_j_assembly = group [key_j, key_j_text]
key_k_assembly = group [key_k, key_k_text]
key_space_assembly = group [key_space, key_space_text]
trackpad_assembly = group [trackpad]
заготовка крышка, клавиши
animate lid_assembly wait seconds=0.5 scene=крышка
animate lid_assembly turn angle=110 axis=x pivot=[0,96,12.4] seconds=2.4 scene=крышка
animate lid_assembly wait seconds=0.5 scene=крышка
animate lid_assembly turn angle=-110 axis=x pivot=[0,96,12.4] seconds=2.4 scene=крышка
animate lid_assembly wait seconds=0.5 scene=крышка
animate key_h_assembly move dz=-0.55 seconds=0.18 start=0 scene=клавиши
