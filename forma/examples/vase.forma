# Ваза с плавным профилем и толстым дном.
# Форма задаётся точками профиля (радиус, высота) и сглаживается сплайном.

высота = 220

ваза = lathe points=[
    [0, 0],
    [46, 0],
    [55, 10],
    [62, 40],
    [64, 90],
    [52, 150],
    [58, 185],
    [66, высота - 15],
    [66, высота],
    [59, высота],
    [51, высота - 16],
    [43, 180],
    [37, 140],
    [49, 85],
    [49, 30],
    [0, 24]
  ] segments=160 smooth=3 fillet=0.8 thickness=4 open=top

color ваза #cfd8e6 material=ceramic

check ваза watertight
check ваза height 215..225
check ваза width 125..140
check ваза wall 3..5
check ваза flat_bottom 1..
