# Крюк — одна деталь, а не «палка + тор»: хвост, дуга загиба и ушко.
# Угол загиба решает, что это: 90° — кронштейн, 240° — крючок для сумки,
# 270° — вешалка. Пруток круглый, торец скруглён, поэтому деталь печатается.

вешалка = крюк wire=8 radius=30 length=90 open=270 eye=да
крючок = крюк wire=6 radius=22 length=70 open=240 eye=да at=[-120,0,0]
кронштейн = крюк wire=10 radius=18 length=40 open=90 eye=нет at=[120,0,0]

# металл у каждого свой: у вешалки полированный, у крючка латунный
color вешалка color=#c9ccd2 metal=0.8 rough=0.3
color крючок color=#d8b06a metal=0.6 rough=0.35
color кронштейн color=#9aa3ad metal=0.4 rough=0.5
