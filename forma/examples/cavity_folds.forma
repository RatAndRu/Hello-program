# 0.45 — рамки с полостями, рельефные грани, срезы углов и сгибаемый лист.
# 16 отдельных тел; миллиметры, верх +Z, перёд −Y.
scene bg=#10121f grid=нет

# Три рамки: Г-канал, круглое угловое окно и прямая овальная щель.
г_рамка = cavity_frame size=[120,100] depth=8 cavity=Г cavity_size=[60,50] line_width=6 margin=9 round=1 at=[-270,210,0] color=gold
круглое_окно = cavity_frame outer=круг size=[120,120] depth=8 cavity=квадрат cavity_size=[22,22] margin=10 round=1 at=[-90,210,0] color=cyan
овальная_щель = cavity_frame outer=круг size=[120,120] depth=8 cavity=линия cavity_size=[70,6] round=1 at=[90,210,0] color=orange
прямой_овал = cavity_frame size=[120,100] depth=8 cavity=овал cavity_size=[70,16] round=1 at=[270,210,0] color=violet

# Независимый рельеф граней и точные плоские срезы углов.
выпуклый_куб = face_box size=[80,80,70] mode=выпуклый profile=линза relief=6 margin=7 at=[-270,70,0] color=steel
вогнутый_куб = face_box size=[80,80,70] mode=вогнутый profile=трапеция relief=5 margin=8 taper=0.4 at=[-90,70,0] color=mint
срезанный_угол = face_box size=[80,80,80] corner_cut=18 corners=один corner=перед_право_верх at=[90,70,0] color=green
восемь_срезов = face_box size=[80,80,80] corner_cut=12 corners=все at=[270,70,0] color=red

# Три независимых отверстия и три режима нового сгибаемого листа.
три_отверстия = cube_hole size=[70,60,50] round=0 hole_x=12 hole_x_shape=круг hole_y=12 hole_y_shape=квадрат hole_z=18 hole_z_shape=овал oval_aspect=2 at=[-270,-70,0] color=copper
один_сгиб = fold_sheet width=100 length=120 thickness=1.2 parts=2 angle=105 gap=1 sharp=0.2 at=[-90,-70,0] color=blue
гармошка = fold_sheet width=100 length=140 thickness=1.2 parts=5 angle=120 gap=1 sharp=0.35 at=[90,-70,0] color=pink
диагональный_сгиб = fold_sheet width=100 length=120 thickness=1.2 parts=2 axis=диагональ angle=90 gap=1 at=[270,-70,0] color=gold

# Плоские формочки и доработанные ветви/пила.
яичная_формочка = egg height=70 diameter=50 flat=да depth=6 wall=3 plane=плашмя at=[-270,-210,0] color=cyan
капельная_формочка = drop radius=18 height=55 flat=да depth=6 wall=2.5 plane=плашмя at=[-90,-210,0] color=orange
тавр_капсулы = tee arm=100 bar=20 stem=20 leg=60 depth=12 shape=капсулы round=1 at=[90,-210,0] color=violet
пила_без_оси = saw diameter=120 teeth=24 thickness=2.5 hole=0 at=[270,-210,0] color=steel

check г_рамка watertight
check круглое_окно watertight
check овальная_щель watertight
check прямой_овал watertight
check выпуклый_куб watertight
check вогнутый_куб watertight
check срезанный_угол watertight
check восемь_срезов watertight
check три_отверстия watertight
check один_сгиб watertight
check гармошка watertight
check диагональный_сгиб watertight
check яичная_формочка watertight
check капельная_формочка watertight
check тавр_капсулы watertight
check пила_без_оси watertight
