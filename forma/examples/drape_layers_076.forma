# ФОРМА 3D 0.76 — два слоя ткани и полый рукав.
# ВНИМАНИЕ: испытательный пример, не готовая деталь для экспорта. В нём
# обнаружено проникновение нижнего слоя в сферическую опору; см. журнал.
# Ось +Z направлена вверх, размеры в миллиметрах. Анимации нет.
# Исходные детали и все опоры можно заменить собственными объектами.

# Одна плоскость и отдельный округлый выступ — две опоры для слоёв.
площадка = box size=[250,130,6] at=[0,0,-6] color=#d8d6ce
бугор = sphere radius=8 segments=16 at=[-60,0,0] color=#8b9b91

# Голубое нижнее полотнище и меньшее светлое верхнее: одна общая драпировка.
низ = box size=[72,60,0.6] at=[-60,0,42] color=#438eac
верх = box size=[60,48,0.6] at=[-59,0,54] color=#eecb91
слои = drape [низ, верх] on=[площадка, бугор] gravity=z- mesh=7 particles=1200 steps=55 bend=0.15 self=да

# Полая трубка — не жёсткий цилиндр: стенки могут сблизиться и сложиться.
рукав = pipe length=70 diameter=22 wall=0.6 sides=16 at=[65,0,40] color=#ad6e83
уложенный_рукав = drape [рукав] on=площадка gravity=z- mesh=7 particles=1200 steps=120 bend=0.15 damping=0.4 friction=0.9 g=0.1 self=да
