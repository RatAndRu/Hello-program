# ФОРМА 3D 0.76.1 — облегчённая самостоятельная сцена со скатертью.
# В миллиметрах; +Z вверх. Это одна рассчитанная поза, не анимация.
# При вставке текста в редактор снимите галочку «авто» и нажмите «Собрать» один раз.
# Расчёт приближённый: равновесие и абсолютная нерастяжимость не гарантированы.
# Перед экспортом проверяйте предупреждения и возможные пересечения.

# Столешница 80×80 мм с закруглённой кромкой и четыре отдельные ножки.
пол = box size=[210,210,6] at=[0,0,-6] color=#d8d8d0
болванка_стола = box size=[80,80,40] round=12 at=[0,0,0] color=#9a765f
срез_под_столом = box size=[100,100,21] at=[0,0,-1]
столешница = difference [болванка_стола,срез_под_столом]
ножка_левая_передняя = box size=[7,7,20] at=[-28,-28,0] color=#7b5b49
ножка_правая_передняя = box size=[7,7,20] at=[28,-28,0] color=#7b5b49
ножка_левая_задняя = box size=[7,7,20] at=[-28,28,0] color=#7b5b49
ножка_правая_задняя = box size=[7,7,20] at=[28,28,0] color=#7b5b49

# Лист 120×120 мм шире стола на 20 мм с каждой стороны.
# gap=0.7 мм — искусственный зазор до опор, а не идеальное касание.
лист_скатерти = box size=[120,120,0.6] at=[0,0,70] color=#94a788
скатерть = drape лист_скатерти on=[столешница,ножка_левая_передняя,ножка_правая_передняя,ножка_левая_задняя,ножка_правая_задняя,пол] gravity=z- mesh=8 particles=2200 steps=70 constraints=16 bend=0.2 damping=0.2 friction=0.2 g=0.15 self=да self_gap=0.12 gap=0.7
