# ============================================================================
#  МОТОЦИКЛ «ФОРМА-900» — колёсная база 1400 мм, колёса Ø600
# ============================================================================
#  Ось X — вперёд, Y — влево, Z — вверх. Каждая деталь строится в своём
#  начале координат, затем ставится на место: так поворот вилки, качение
#  колёс и ход подвески считаются вокруг настоящих осей.
#
#  Геометрия сцепки (все стыки перекрываются, ничего не висит):
#    ось заднего колеса ............ (0, 0, 300)
#    ось переднего колеса .......... (1400, 0, 300)
#    рулевая колонка ............... (1090, 0, 830)   наклон вилки 30,3°
#    маятник: (300, ±115, 470) → ось заднего колеса, длина 345
#    амортизатор: маятник (150, 385) → рама (300, 690)
#  Сцены: «езда» (колёса, подвеска, руль), «прыжок» (упругий прыжок).
# ----------------------------------------------------------------------------

scene bg=#e9edf2 env=studio shadows=да grid=нет
light preset=студия strength=1.35

# ---------- КОЛЁСА ----------
колесо_зад = wheel diameter=600 width=180 rim=32 spokes=5 hub=70 tire=25 segments=96 center=да
колесо_зад = translate [колесо_зад] offset=[0, 0, 300]
колесо_перед = wheel diameter=600 width=150 rim=30 spokes=5 hub=62 tire=24 segments=96 center=да
колесо_перед = translate [колесо_перед] offset=[1400, 0, 300]
ступица_зад = cylinder radius=32 height=280 segments=48 center=да
ступица_зад = rotate [ступица_зад] angle=90 axis=x
ступица_зад = translate [ступица_зад] offset=[0, 0, 300]
ступица_перед = cylinder radius=30 height=240 segments=48 center=да
ступица_перед = rotate [ступица_перед] angle=90 axis=x
ступица_перед = translate [ступица_перед] offset=[1400, 0, 300]

# ---------- МАЯТНИК (качается на оси 300, 470) ----------
маятник_л = cylinder radius=22 height=380 segments=40 center=да
маятник_л = rotate [маятник_л] angle=60.46 axis=y
маятник_л = translate [маятник_л] offset=[150, -115, 385]
маятники = mirror_copy [маятник_л] plane=y
ось_маятника = cylinder radius=18 height=300 segments=32 center=да
ось_маятника = rotate [ось_маятника] angle=90 axis=x
ось_маятника = translate [ось_маятника] offset=[300, 0, 470]

# ---------- РАМА ----------
рама_верх = pipe path=[[0, 0, 0], [-224, 0, 29], [-464, 0, 49], [-704, 0, 49]] diameter=44 wall=5
рама_верх = translate [рама_верх] offset=[732, 0, 819]
рама_низ = pipe path=[[0, 0, 0], [-100, 0, -170], [-180, 0, -330], [-220, 0, -410]] diameter=40 wall=4
рама_низ = translate [рама_низ] offset=[970, 0, 380]
рама_пояс = pipe path=[[0, 0, 0], [-240, 0, -50], [-510, 0, -50]] diameter=40 wall=4
рама_пояс = translate [рама_пояс] offset=[605, 0, 330]
подседельная = pipe path=[[0, 0, 0], [-20, 0, -250], [-35, 0, -470], [-30, 0, -540]] diameter=42 wall=4
подседельная = translate [подседельная] offset=[362, 0, 329]
перемычка = box size=[90, 240, 40] round=8 center=да at=[350, 0, 360]
кронштейн_двигателя = box size=[70, 340, 60] round=8 center=да at=[860, 0, 430]

# ---------- ВИЛКА И РУЛЬ ----------
перо_л = cylinder radius=26 height=640 segments=48 center=да
перо_л = rotate [перо_л] angle=-30.32 axis=y
перо_л = translate [перо_л] offset=[1245, -110, 565]
перья = mirror_copy [перо_л] plane=y
нижняя_траверса = box size=[150, 300, 44] round=10 center=да at=[1092, 0, 806]
нижняя_траверса = rotate [нижняя_траверса] angle=-30.32 axis=y pivot=[1092, 0, 806]
верхняя_траверса = box size=[150, 300, 44] round=10 center=да at=[1074, 0, 866]
верхняя_траверса = rotate [верхняя_траверса] angle=-30.32 axis=y pivot=[1074, 0, 866]
рулевой_вал = cylinder radius=28 height=150 segments=32 center=да
рулевой_вал = rotate [рулевой_вал] angle=-30.32 axis=y
рулевой_вал = translate [рулевой_вал] offset=[1083, 0, 836]
руль = pipe path=[[-12, -340, 34], [0, -170, 10], [6, 0, 0], [0, 170, 10], [-12, 340, 34]] diameter=26 wall=4
руль = translate [руль] offset=[1077, 0, 871]
грипс_л = cylinder radius=20 height=110 segments=32 center=да
грипс_л = rotate [грипс_л] angle=90 axis=x
грипс_л = translate [грипс_л] offset=[1068, -302, 902]
грипсы = mirror_copy [грипс_л] plane=y
рычаг_л = box size=[130, 16, 16] round=7 center=да at=[1010, -270, 896]
рычаги = mirror_copy [рычаг_л] plane=y

# ---------- ТОПЛИВНЫЙ БАК И СЕДЛО ----------
бак_низ = box size=[400, 310, 150] round=48 center=да at=[760, 0, 862]
бак_верх = box size=[280, 250, 96] round=40 center=да at=[706, 0, 932]
бак = hull objects=[бак_низ, бак_верх]
седло = box size=[420, 260, 78] round=34 center=да at=[330, 0, 900]
хвост = box size=[260, 200, 96] round=26 center=да at=[60, 0, 888]
подрамник = pipe path=[[0, 0, 0], [-420, 0, 90]] diameter=34 wall=4
подрамник = translate [подрамник] offset=[130, 0, 743]
электрика = box size=[190, 170, 110] round=14 center=да at=[330, 0, 780]

# ---------- ДВИГАТЕЛЬ ----------
блок = box size=[400, 300, 300] round=54 center=да at=[700, 0, 490]
поддон = box size=[330, 250, 66] round=16 center=да at=[690, 0, 340]
головка = heatsink size=[330, 270, 130] fins=7 center=да at=[720, 0, 700]
цилиндр_л = cylinder radius=58 height=140 segments=48 center=да at=[742, -112, 800]
цилиндры = mirror_copy [цилиндр_л] plane=y
крышка_цилиндра = box size=[210, 260, 46] round=14 center=да at=[742, 0, 872]
тормоз_диск = cylinder radius=140 height=8 segments=64 center=да
тормоз_диск = rotate [тормоз_диск] angle=90 axis=x
тормоз_диск = translate [тормоз_диск] offset=[1400, -96, 300]
суппорт = box size=[70, 64, 130] round=18 center=да at=[1290, -110, 408]
подножка_л = cylinder radius=12 height=170 segments=32 center=да
подножка_л = rotate [подножка_л] angle=90 axis=x
подножка_л = translate [подножка_л] offset=[610, -215, 380]
подножки = mirror_copy [подножка_л] plane=y
звезда = cylinder radius=105 height=14 segments=64 center=да
звезда = rotate [звезда] angle=90 axis=x
звезда = translate [звезда] offset=[0, -95, 300]
ведущая_звезда = cylinder radius=55 height=16 segments=48 center=да
ведущая_звезда = rotate [ведущая_звезда] angle=90 axis=x
ведущая_звезда = translate [ведущая_звезда] offset=[600, -95, 355]

# ---------- ЦЕПЬ ----------
цепь_верх = box size=[600, 12, 16] round=5 center=да at=[300, -95, 410]
цепь_низ = box size=[600, 12, 16] round=5 center=да at=[300, -95, 232]

# ---------- ВЫПУСК ----------
выпуск = pipe path=[[0, 0, 0], [-70, -20, -150], [-190, 0, -330], [-640, 4, -352]] diameter=52 wall=4
выпуск = translate [выпуск] offset=[440, -158, 322]
глушитель = cylinder radius=46 height=270 segments=48 center=да
глушитель = rotate [глушитель] angle=90 axis=y
глушитель = translate [глушитель] offset=[200, -196, 348]
наконечник = cylinder radius=34 height=26 segments=40 center=да
наконечник = rotate [наконечник] angle=90 axis=y
наконечник = translate [наконечник] offset=[52, -196, 348]

# ---------- КРЫЛЬЯ ----------
зад_внеш = cylinder radius=332 height=230 segments=96 center=да
зад_внеш = rotate [зад_внеш] angle=90 axis=x
зад_внутр = cylinder radius=310 height=240 segments=96 center=да
зад_внутр = rotate [зад_внутр] angle=90 axis=x
зад_срез = box size=[1000, 300, 620] round=10 center=да at=[0, 0, -150]
зад_крыло = difference [зад_внеш, зад_внутр, зад_срез]
зад_крыло = translate [зад_крыло] offset=[0, 0, 300]
зад_стойка_л = box size=[54, 22, 130] round=6 center=да at=[300, -110, 421]
зад_стойки = mirror_copy [зад_стойка_л] plane=y

перед_внеш = cylinder radius=332 height=200 segments=96 center=да
перед_внеш = rotate [перед_внеш] angle=90 axis=x
перед_внутр = cylinder radius=310 height=210 segments=96 center=да
перед_внутр = rotate [перед_внутр] angle=90 axis=x
перед_срез = box size=[1000, 260, 620] round=10 center=да at=[0, 0, -150]
перед_крыло = difference [перед_внеш, перед_внутр, перед_срез]
перед_крыло = translate [перед_крыло] offset=[1400, 0, 300]
перед_стойка = box size=[80, 250, 26] round=8 center=да at=[1250, 0, 585]

# ---------- АМОРТИЗАТОР ----------
амортизатор = spring diameter=54 wire=8 turns=9 pitch=32 center=да
амортизатор = rotate [амортизатор] angle=26.19 axis=y
амортизатор = translate [амортизатор] offset=[225, 0, 537]
шток = cylinder radius=13 height=330 segments=24 center=да
шток = rotate [шток] angle=26.19 axis=y
шток = translate [шток] offset=[225, 0, 537]

# ---------- ФАРА, ЗЕРКАЛА ----------
фара_скоба = box size=[90, 240, 30] round=8 center=да at=[1136, 0, 790]
фара_корпус = cylinder radius=95 height=110 segments=64 center=да
фара_корпус = rotate [фара_корпус] angle=90 axis=y
фара_корпус = translate [фара_корпус] offset=[1195, 0, 790]
фара_стекло = cylinder radius=80 height=14 segments=64 center=да
фара_стекло = rotate [фара_стекло] angle=90 axis=y
фара_стекло = translate [фара_стекло] offset=[1256, 0, 790]
зеркало_стойка_л = pipe path=[[0, 0, 0], [-6, -40, 70], [-14, -70, 120]] diameter=14 wall=2
зеркало_стойка_л = translate [зеркало_стойка_л] offset=[1071, -335, 901]
зеркало_стойки = mirror_copy [зеркало_стойка_л] plane=y
зеркало_л = cylinder radius=42 height=14 segments=48 center=да
зеркало_л = rotate [зеркало_л] angle=90 axis=y
зеркало_л = translate [зеркало_л] offset=[1056, -372, 1030]
зеркала = mirror_copy [зеркало_л] plane=y

# ---------- СБОРКИ ----------
рама = group [рама_верх, рама_низ, рама_пояс, подседельная, подрамник, перемычка,
              кронштейн_двигателя, бак, седло, хвост, электрика,
              зад_крыло, зад_стойки, перед_крыло, перед_стойка]
двигатель = group [блок, поддон, головка, цилиндры, крышка_цилиндра, суппорт,
                   подножки, выпуск, глушитель, наконечник,
                   ведущая_звезда, цепь_верх, цепь_низ, амортизатор, шток]
вилка = group [перья, тормоз_диск, нижняя_траверса, верхняя_траверса, рулевой_вал,
               руль, грипсы, рычаги, фара_скоба, фара_корпус, фара_стекло,
               зеркало_стойки, зеркала]

# ---------- АНИМАЦИЯ ----------
animate колесо_зад roll distance=3400 radius=300 axis=y seconds=6 track=1 scene=езда
animate колесо_зад wait seconds=1 track=1 scene=езда
animate колесо_зад roll distance=3400 radius=300 axis=y seconds=6 track=1 scene=езда
animate колесо_перед roll distance=3400 radius=300 axis=y seconds=6 track=1 scene=езда
animate колесо_перед wait seconds=1 track=1 scene=езда
animate колесо_перед roll distance=3400 radius=300 axis=y seconds=6 track=1 scene=езда

animate рама move dz=10 seconds=0.55 track=2 scene=езда
animate рама move dz=-10 seconds=0.55 track=2 scene=езда
animate рама move dz=6 seconds=0.45 track=2 scene=езда
animate рама move dz=-6 seconds=0.45 track=2 scene=езда
animate рама wait seconds=4.1 track=2 scene=езда
animate двигатель move dz=-6 seconds=0.55 track=2 scene=езда
animate двигатель move dz=6 seconds=0.55 track=2 scene=езда
animate двигатель move dz=-4 seconds=0.45 track=2 scene=езда
animate двигатель move dz=4 seconds=0.45 track=2 scene=езда
animate двигатель wait seconds=4.1 track=2 scene=езда

animate вилка turn angle=7 axis=z pivot=[1090, 0, 830] seconds=1.4 track=3 scene=езда
animate вилка turn angle=-14 axis=z pivot=[1090, 0, 830] seconds=2.4 track=3 scene=езда
animate вилка turn angle=7 axis=z pivot=[1090, 0, 830] seconds=1.4 track=3 scene=езда
animate вилка wait seconds=2.8 track=3 scene=езда

animate колесо_зад roll distance=2200 radius=300 axis=y seconds=1.2 track=1 scene=прыжок
animate колесо_перед roll distance=2200 radius=300 axis=y seconds=1.2 track=1 scene=прыжок
animate jump height=280 elastic=да seconds=1.7 track=2 scene=прыжок
animate wait seconds=0.6 track=2 scene=прыжок
animate fall height=280 elastic=да seconds=1.5 track=2 scene=прыжок
animate двигатель move dz=-18 seconds=0.9 track=3 scene=прыжок
animate двигатель move dz=18 seconds=1.3 track=3 scene=прыжок

# ---------- ПРОВЕРКИ ----------
check колесо_зад watertight
check колесо_зад parts 1
check колесо_зад height 596..604
check колесо_перед height 596..604
check колесо_перед gap колесо_зад 799..801
check зад_крыло parts 1
check перед_крыло parts 1
check бак watertight
check бак parts 1
check седло height 78..86
check глушитель height 88..94
check фара_корпус height 188..194
check бак height 190..196
check рама_верх watertight
check рама_низ watertight
check рама_пояс watertight
check подседельная watertight
check перья parts 2
check маятники parts 2
check колесо_перед gap ступица_перед 0..4

# ---------- МАТЕРИАЛ ----------
color колесо_зад #17181c rough=0.82
color колесо_перед #17181c rough=0.82
color ступица_зад #4a4f56 metal=0.85 rough=0.3
color ступица_перед #4a4f56 metal=0.85 rough=0.3
color рама_верх #b8452f rough=0.32 metal=0.25
color рама_низ #b8452f rough=0.32 metal=0.25
color рама_пояс #b8452f rough=0.32 metal=0.25
color подседельная #b8452f rough=0.32 metal=0.25
color перемычка #3a3e45 metal=0.7 rough=0.3
color кронштейн_двигателя #3a3e45 metal=0.7 rough=0.3
color маятники #3a3e45 metal=0.7 rough=0.3
color ось_маятника #c8ccd2 metal=0.95 rough=0.18
color бак #c04a2f rough=0.24 metal=0.35
color седло #23252a rough=0.9
color хвост #b8452f rough=0.32 metal=0.25
color подрамник #b8452f rough=0.32 metal=0.25
color электрика #2f3238 rough=0.7
color зад_крыло #c04a2f rough=0.3 metal=0.3
color зад_стойки #3a3e45 metal=0.7 rough=0.3
color перед_крыло #c04a2f rough=0.3 metal=0.3
color перед_стойка #3a3e45 metal=0.7 rough=0.3
color блок #6e747c metal=0.9 rough=0.3
color поддон #5e646c metal=0.85 rough=0.35
color головка #9aa1a9 metal=0.9 rough=0.26
color цилиндры #7d848c metal=0.9 rough=0.3
color крышка_цилиндра #9aa1a9 metal=0.9 rough=0.26
color выпуск #c9ccd0 metal=0.95 rough=0.2
color глушитель #cfd3d7 metal=0.95 rough=0.18
color наконечник #3a3d42 metal=0.85 rough=0.3
color цепь_верх #3a3d42 metal=0.8 rough=0.35
color цепь_низ #3a3d42 metal=0.8 rough=0.35
color подножки #4a4f56 metal=0.8 rough=0.3
color амортизатор #e0b64a metal=0.85 rough=0.28
color шток #cfd3d7 metal=0.95 rough=0.16
color тормоз_диск #b6bcc4 metal=0.95 rough=0.28
color суппорт #d8a33a metal=0.85 rough=0.3
color звезда #5a6068 metal=0.9 rough=0.3
color ведущая_звезда #5a6068 metal=0.9 rough=0.3
color перья #c8ccd2 metal=0.95 rough=0.16
color нижняя_траверса #3c4148 metal=0.8 rough=0.28
color верхняя_траверса #3c4148 metal=0.8 rough=0.28
color рулевой_вал #c8ccd2 metal=0.95 rough=0.16
color руль #2f3238 metal=0.85 rough=0.25
color грипсы #1c1e22 rough=0.85
color рычаги #b9bec4 metal=0.9 rough=0.2
color фара_скоба #3c4148 metal=0.8 rough=0.28
color фара_корпус #d8dce1 metal=0.9 rough=0.2
color фара_стекло #eaf2f8 rough=0.08 metal=0.1
color зеркало_стойки #2a2c31 metal=0.8 rough=0.25
color зеркала #2a2c31 metal=0.8 rough=0.25
