# Форма 3D 0.76.4 — готовый пример FastNoiseLite и Poisson-disk.
# Миллиметры, +Z вверх. Все детали можно редактировать отдельно.
# 3D-рельеф и 2D-узор используют один движок, но не совпадают пиксель-в-пиксель:
# развёртка текстуры и 3D-координаты поверхности различаются.

плита_основа = box size=[240,100,4] at=[0,0,-4] color=#d6d4cb

# Подлинный рельеф геометрии, без Blender.
камень = sphere radius=18 segments=24 at=[-85,0,18] color=#88735b
камень = wrinkle [камень] mode=шум engine=fastnoise noise_kind=simplex amp=1 freq=5 seed=7 detail=2 surface=вся

# F2-F1 даёт клеточный рисунок/впадины, но не готовую пену или чешую.
пластина = box size=[55,42,8] at=[-5,0,0] color=#8ab0a0
пластина = wrinkle [пластина] mode=шум engine=fastnoise noise_kind=cellular amp=0.6 freq=5 seed=8 detail=2 surface=вся
texture пластина kind=своя pattern=вороной color1=#397661 color2=#c8d8bd scale=1 seed=8 relief=0.5

# Минимальное расстояние 11 мм между центрами; gap также учитывает габариты.
# Это распределение в плоскости XY, не по кривой поверхности.
образец = sphere radius=2 segments=12 color=#81674d
камешки = scatter [образец] count=18 area=[75,65] at=[83,0,0] z=0 seed=4 scale=[0.8,1.2] distribution=poisson distance=11 gap=0.5 as=objects
