# ============================================================================
#  ШКАФ-ВИТРИНА 1000 × 450 × 1200 мм — ЛДСП 18 мм, задняя стенка ХДФ 4 мм
# ============================================================================
#  Фасад смотрит в −Y (как «спереди» в окне просмотра и отчёте).
#  Дверь открывается вокруг петли, ящик выезжает по рейкам, колёсики катятся,
#  а кронштейны и оси колёс остаются неподвижными — крутится только диск.
#  Анимации раздельные: «дверь» и «ящик» — две независимые заготовки.
# ----------------------------------------------------------------------------

scene bg=#1b1e25 env=studio shadows=да grid=нет
light preset=студия strength=1.2

# ---------- ЦОКОЛЬ (утоплен на 35 мм) ----------
цоколь_перед = box size=[964, 25, 72] center=да at=[0, -177.5, 36]
цоколь_зад = box size=[964, 25, 72] center=да at=[0, 194.5, 36]
цоколь_л = box size=[25, 372, 72] center=да at=[-487.5, 7, 36]
цоколь_п = mirror_copy [цоколь_л] plane=x
цоколь = union [цоколь_перед, цоколь_зад, цоколь_л, цоколь_п]

# ---------- КОРПУС: глубина 414, двери накладные 18 мм ----------
боковина_л = box size=[18, 414, 1130] center=да at=[-491, 0, 635]
боковина_п = mirror_copy [боковина_л] plane=x
дно = box size=[970, 414, 18] center=да at=[0, 0, 79]
верх = box size=[970, 414, 18] center=да at=[0, 0, 1191]
разделитель = box size=[970, 410, 18] center=да at=[0, -2, 317]
полка = box size=[966, 380, 18] center=да at=[0, 0, 665]

# ---------- ЗАДНЯЯ СТЕНКА: ХДФ 4 мм, прибита гвоздями ----------
#  Стенка лежит на задних кромках боковин, верха, дна и разделителя —
#  снаружи видны только шляпки гвоздей, как у настоящего шкафа.
задняя_стенка = box size=[970, 4, 1130] center=да at=[0, 208.5, 635]

# ---------- ПОЛКОДЕРЖАТЕЛИ (штифты 5 мм в боковины) ----------
полкодержатель_1 = cylinder radius=2.5 height=30 segments=24 center=да at=[0, 0, 0]
полкодержатель_1 = rotate [полкодержатель_1] angle=90 axis=y
полкодержатель_1 = translate [полкодержатель_1] offset=[-467, -150, 654]
полкодержатель_2 = cylinder radius=2.5 height=30 segments=24 center=да at=[0, 0, 0]
полкодержатель_2 = rotate [полкодержатель_2] angle=90 axis=y
полкодержатель_2 = translate [полкодержатель_2] offset=[-467, 150, 654]
полкодержатель_3 = cylinder radius=2.5 height=30 segments=24 center=да at=[0, 0, 0]
полкодержатель_3 = rotate [полкодержатель_3] angle=90 axis=y
полкодержатель_3 = translate [полкодержатель_3] offset=[467, -150, 654]
полкодержатель_4 = cylinder radius=2.5 height=30 segments=24 center=да at=[0, 0, 0]
полкодержатель_4 = rotate [полкодержатель_4] angle=90 axis=y
полкодержатель_4 = translate [полкодержатель_4] offset=[467, 150, 654]

# ---------- НАПРАВЛЯЮЩИЕ ЯЩИКА ----------
направ_л = box size=[10, 397, 40] center=да at=[-477, -1.5, 120]
направ_п = mirror_copy [направ_л] plane=x

# ---------- РЕЙКИ: по ним катятся колёсики ----------
рейка_л = box size=[64, 409, 11] center=да at=[-450, -1.5, 94.5]
рейка_п = mirror_copy [рейка_л] plane=x
рейки = union [рейка_л, рейка_п]

# ---------- ПРАВАЯ ДВЕРЬ (накладная, закрыта — на петлях и с крепежом) ----------
фасад_п = box size=[479.5, 18, 854] round=2 center=да at=[241.25, -216, 754]
филёнка_п = box size=[359.5, 8, 734] round=1.5 center=да at=[241.25, -221, 754]
фасад_п = difference [фасад_п, филёнка_п]
ручка_п_штанга = capsule radius=5 height=200 center=да at=[0, 0, 0]
ручка_п_штанга = translate [ручка_п_штанга] offset=[55, -233, 784]
ручка_п_стойка1 = cylinder radius=4 height=14 segments=24 center=да at=[0, 0, 0]
ручка_п_стойка1 = rotate [ручка_п_стойка1] angle=90 axis=x
ручка_п_стойка1 = translate [ручка_п_стойка1] offset=[55, -230, 704]
ручка_п_стойка2 = cylinder radius=4 height=14 segments=24 center=да at=[0, 0, 0]
ручка_п_стойка2 = rotate [ручка_п_стойка2] angle=90 axis=x
ручка_п_стойка2 = translate [ручка_п_стойка2] offset=[55, -230, 864]
ручка_правая = union [ручка_п_штанга, ручка_п_стойка1, ручка_п_стойка2]

#  Петли правой двери: чашка в фасаде, ответная планка на боковине.
#  Правая дверь не открывается, но висит на двух петлях, как и левая.
петля_3_шарнир = cylinder radius=7 height=70 segments=28 center=да
петля_3_шарнир = translate [петля_3_шарнир] offset=[486, -212, 350]
петля_3_дверь = box size=[28, 16, 70] round=2 center=да at=[470, -214, 350]
петля_3_корпус = box size=[28, 16, 70] round=2 center=да at=[492, -198, 350]
петля_3 = union [петля_3_шарнир, петля_3_дверь]
петля_4_шарнир = cylinder radius=7 height=70 segments=28 center=да
петля_4_шарнир = translate [петля_4_шарнир] offset=[486, -212, 1055]
петля_4_дверь = box size=[28, 16, 70] round=2 center=да at=[470, -214, 1055]
петля_4_корпус = box size=[28, 16, 70] round=2 center=да at=[492, -198, 1055]
петля_4 = union [петля_4_шарнир, петля_4_дверь]
петли_правой = union [петля_3_корпус, петля_4_корпус]

# ---------- ЛЕВАЯ ДВЕРЬ (петли слева, открывается) ----------
фасад_л = box size=[479.5, 18, 854] round=2 center=да at=[-241.25, -216, 754]
филёнка_л = box size=[359.5, 8, 734] round=1.5 center=да at=[-241.25, -221, 754]
фасад_л = difference [фасад_л, филёнка_л]
ручка_л_штанга = capsule radius=5 height=200 center=да at=[0, 0, 0]
ручка_л_штанга = translate [ручка_л_штанга] offset=[-55, -233, 784]
ручка_л_стойка1 = cylinder radius=4 height=14 segments=24 center=да at=[0, 0, 0]
ручка_л_стойка1 = rotate [ручка_л_стойка1] angle=90 axis=x
ручка_л_стойка1 = translate [ручка_л_стойка1] offset=[-55, -230, 704]
ручка_л_стойка2 = cylinder radius=4 height=14 segments=24 center=да at=[0, 0, 0]
ручка_л_стойка2 = rotate [ручка_л_стойка2] angle=90 axis=x
ручка_л_стойка2 = translate [ручка_л_стойка2] offset=[-55, -230, 864]
ручка_левая = union [ручка_л_штанга, ручка_л_стойка1, ручка_л_стойка2]

# ---------- ПЕТЛИ ЛЕВОЙ ДВЕРИ ----------
петля_шарнир_1 = cylinder radius=7 height=70 segments=28 center=да
петля_шарнир_1 = translate [петля_шарнир_1] offset=[-486, -212, 350]
петля_дверь_1 = box size=[28, 16, 70] round=2 center=да at=[-470, -214, 350]
петля_корпус_1 = box size=[28, 16, 70] round=2 center=да at=[-492, -198, 350]
петля_1 = union [петля_шарнир_1, петля_дверь_1]
петля_шарнир_2 = cylinder radius=7 height=70 segments=28 center=да
петля_шарнир_2 = translate [петля_шарнир_2] offset=[-486, -212, 1055]
петля_дверь_2 = box size=[28, 16, 70] round=2 center=да at=[-470, -214, 1055]
петля_корпус_2 = box size=[28, 16, 70] round=2 center=да at=[-492, -198, 1055]
петля_2 = union [петля_шарнир_2, петля_дверь_2]
петли_корпуса = union [петля_корпус_1, петля_корпус_2]

# ---------- ЯЩИК ----------
ящик_фасад = box size=[960, 18, 216] round=2 center=да at=[0, -216, 198]
ящик_окно = box size=[820, 8, 116] round=1.5 center=да at=[0, -221, 198]
ящик_фасад = difference [ящик_фасад, ящик_окно]
ящик_бок_л = box size=[15, 390, 181] center=да at=[-442.5, -12, 214.5]
ящик_бок_п = mirror_copy [ящик_бок_л] plane=x
ящик_зад = box size=[870, 15, 181] center=да at=[0, 175.5, 214.5]
ящик_дно = box size=[900, 390, 4] center=да at=[0, -12, 128]
ручка_ящ_штанга = capsule radius=4.5 height=140 center=да at=[0, 0, 0]
ручка_ящ_штанга = rotate [ручка_ящ_штанга] angle=90 axis=y
ручка_ящ_штанга = translate [ручка_ящ_штанга] offset=[0, -243, 198]
ручка_ящ_стойка1 = cylinder radius=4 height=16 segments=24 center=да at=[0, 0, 0]
ручка_ящ_стойка1 = rotate [ручка_ящ_стойка1] angle=90 axis=x
ручка_ящ_стойка1 = translate [ручка_ящ_стойка1] offset=[-56, -231, 198]
ручка_ящ_стойка2 = cylinder radius=4 height=16 segments=24 center=да at=[0, 0, 0]
ручка_ящ_стойка2 = rotate [ручка_ящ_стойка2] angle=90 axis=x
ручка_ящ_стойка2 = translate [ручка_ящ_стойка2] offset=[56, -231, 198]
ручка_ящика = union [ручка_ящ_штанга, ручка_ящ_стойка1, ручка_ящ_стойка2]
ящик = union [ящик_фасад, ящик_бок_л, ящик_бок_п, ящик_зад, ящик_дно]

# ---------- КОЛЁСИКИ: ДИСК КРУТИТСЯ, КРОНШТЕЙН СТОИТ ----------
#  Диск — отдельный объект: анимация «roll» вращает только его.
#  Кронштейн и ось — отдельный объект: они едут вместе с ящиком, но не крутятся.
колесо_1 = wheel diameter=26 width=12 rim=5 spokes=3 hub=8 tire=2 segments=48
колесо_1 = rotate [колесо_1] angle=90 axis=y
колесо_1 = translate [колесо_1] offset=[-425, 45, 111.5]
кронштейн_1 = box size=[16, 34, 18] round=2 center=да at=[-425, 45, 124]
ось_1 = cylinder radius=3 height=26 segments=16 center=да
ось_1 = rotate [ось_1] angle=90 axis=y
ось_1 = translate [ось_1] offset=[-425, 45, 113]
кронштейн_1 = union [кронштейн_1, ось_1]

колесо_2 = wheel diameter=26 width=12 rim=5 spokes=3 hub=8 tire=2 segments=48
колесо_2 = rotate [колесо_2] angle=90 axis=y
колесо_2 = translate [колесо_2] offset=[425, 45, 111.5]
кронштейн_2 = box size=[16, 34, 18] round=2 center=да at=[425, 45, 124]
ось_2 = cylinder radius=3 height=26 segments=16 center=да
ось_2 = rotate [ось_2] angle=90 axis=y
ось_2 = translate [ось_2] offset=[425, 45, 113]
кронштейн_2 = union [кронштейн_2, ось_2]

колесо_3 = wheel diameter=26 width=12 rim=5 spokes=3 hub=8 tire=2 segments=48
колесо_3 = rotate [колесо_3] angle=90 axis=y
колесо_3 = translate [колесо_3] offset=[-425, 175, 111.5]
кронштейн_3 = box size=[16, 34, 18] round=2 center=да at=[-425, 175, 124]
ось_3 = cylinder radius=3 height=26 segments=16 center=да
ось_3 = rotate [ось_3] angle=90 axis=y
ось_3 = translate [ось_3] offset=[-425, 175, 113]
кронштейн_3 = union [кронштейн_3, ось_3]

колесо_4 = wheel diameter=26 width=12 rim=5 spokes=3 hub=8 tire=2 segments=48
колесо_4 = rotate [колесо_4] angle=90 axis=y
колесо_4 = translate [колесо_4] offset=[425, 175, 111.5]
кронштейн_4 = box size=[16, 34, 18] round=2 center=да at=[425, 175, 124]
ось_4 = cylinder radius=3 height=26 segments=16 center=да
ось_4 = rotate [ось_4] angle=90 axis=y
ось_4 = translate [ось_4] offset=[425, 175, 113]
кронштейн_4 = union [кронштейн_4, ось_4]

# ---------- СБОРКА ----------
корпус = union [цоколь, боковина_л, боковина_п, дно, верх, разделитель, задняя_стенка,
                полка, полкодержатель_1, полкодержатель_2, полкодержатель_3,
                полкодержатель_4, направ_л, направ_п]

# ---------- КРЕПЁЖ: КОНФИРМАТЫ, САМОРЕЗЫ, ГВОЗДИ ----------
#  У каждого крепежа шляпка утоплена в материал: наружу ничего не торчит,
#  а остриё целиком остаётся в доске. Конфирмат идёт из внешней стенки в
#  кромку дна/разделителя/верха (ось X, шляпка в стенке), саморез — из
#  стенки в кромку полки и рейки, гвоздь — сзади через ХДФ в кромки корпуса
#  (ось Y, шляпка на задней стенке).
конфирмат = screw d=7 length=50 head=полукруг drive=шестигранник thread=нет
конфирмат = rotate [конфирмат] angle=-90 axis=y
конфирмат_1 = translate [конфирмат] offset=[-450, -160, 79]
конфирмат_2 = translate [конфирмат] offset=[-450, 160, 79]
конфирмат_3 = translate [конфирмат] offset=[-450, -160, 317]
конфирмат_4 = translate [конфирмат] offset=[-450, 160, 317]
конфирмат_5 = translate [конфирмат] offset=[-450, -160, 1191]
конфирмат_6 = translate [конфирмат] offset=[-450, 160, 1191]
конфирмат_7 = mirror_copy [конфирмат_1] plane=x
конфирмат_8 = mirror_copy [конфирмат_2] plane=x
конфирмат_9 = mirror_copy [конфирмат_3] plane=x
конфирмат_10 = mirror_copy [конфирмат_4] plane=x
конфирмат_11 = mirror_copy [конфирмат_5] plane=x
конфирмат_12 = mirror_copy [конфирмат_6] plane=x

#  Саморезы 4 × 50 с крестовой головкой в кромку полки и рейки.
саморез = screw d=4 length=50 head=потай drive=крест thread=нет
саморез = rotate [саморез] angle=-90 axis=y
полка_винт_1 = translate [саморез] offset=[-450, -150, 665]
саморез = screw d=4 length=50 head=потай drive=крест thread=нет
саморез = rotate [саморез] angle=-90 axis=y
полка_винт_2 = translate [саморез] offset=[-450, 150, 665]
полка_винт_3 = mirror_copy [полка_винт_1] plane=x
полка_винт_4 = mirror_copy [полка_винт_2] plane=x
саморез = screw d=4 length=45 head=потай drive=крест thread=нет
саморез = rotate [саморез] angle=-90 axis=y
рейка_винт_1 = translate [саморез] offset=[-455, -150, 94.5]
саморез = screw d=4 length=45 head=потай drive=крест thread=нет
саморез = rotate [саморез] angle=-90 axis=y
рейка_винт_2 = translate [саморез] offset=[-455, 150, 94.5]
рейка_винт_3 = mirror_copy [рейка_винт_1] plane=x
рейка_винт_4 = mirror_copy [рейка_винт_2] plane=x

#  Гвозди 2 × 24: шляпка на задней стенке, стержень входит в кромку
#  боковины, верха, дна и разделителя. Остриё остаётся в дереве.
гвоздь = nail d=2 length=24 head_d=5
гвоздь = rotate [гвоздь] angle=-90 axis=x
гвоздь_1 = translate [гвоздь] offset=[-484, 187, 1190]
гвоздь_2 = translate [гвоздь] offset=[-484, 187, 1100]
гвоздь_3 = translate [гвоздь] offset=[-484, 187, 635]
гвоздь_4 = translate [гвоздь] offset=[-484, 187, 317]
гвоздь_5 = translate [гвоздь] offset=[-484, 187, 150]
гвоздь_6 = translate [гвоздь] offset=[-484, 187, 80]
гвоздь_7 = translate [гвоздь] offset=[0, 187, 1190]
гвоздь_8 = translate [гвоздь] offset=[0, 187, 80]
гвоздь_9 = mirror_copy [гвоздь_1] plane=x
гвоздь_10 = mirror_copy [гвоздь_2] plane=x
гвоздь_11 = mirror_copy [гвоздь_3] plane=x
гвоздь_12 = mirror_copy [гвоздь_4] plane=x
гвоздь_13 = mirror_copy [гвоздь_5] plane=x
гвоздь_14 = mirror_copy [гвоздь_6] plane=x

#  Винты петель: 4 × 16 из чашки в фасад, шляпка в чашке (внутри двери).
винт_петли = screw d=4 length=16 head=потай drive=крест thread=нет
винт_петли = rotate [винт_петли] angle=-90 axis=x
винт_петли_1 = translate [винт_петли] offset=[-470, -222, 335]
винт_петли_2 = translate [винт_петли] offset=[-470, -222, 365]
винт_петли_3 = translate [винт_петли] offset=[-470, -222, 1040]
винт_петли_4 = translate [винт_петли] offset=[-470, -222, 1070]
винт_петли_5 = mirror_copy [винт_петли_1] plane=x
винт_петли_6 = mirror_copy [винт_петли_2] plane=x
винт_петли_7 = mirror_copy [винт_петли_3] plane=x
винт_петли_8 = mirror_copy [винт_петли_4] plane=x

#  Стяжки ручек: 4 × 26 изнутри фасада в стойку ручки, шляпка в двери.
винт_ручки = screw d=4 length=26 head=потай drive=крест thread=нет
винт_ручки = rotate [винт_ручки] angle=-90 axis=x
винт_ручки_1 = translate [винт_ручки] offset=[55, -233, 704]
винт_ручки_2 = translate [винт_ручки] offset=[55, -233, 864]
винт_ручки_3 = translate [винт_ручки] offset=[-55, -233, 704]
винт_ручки_4 = translate [винт_ручки] offset=[-55, -233, 864]
винт_ручки = screw d=1.6 length=14 head=потай drive=крест thread=нет
винт_ручки = rotate [винт_ручки] angle=-90 axis=x
винт_ручки_5 = translate [винт_ручки] offset=[-56, -233, 198]
винт_ручки = screw d=1.6 length=14 head=потай drive=крест thread=нет
винт_ручки = rotate [винт_ручки] angle=-90 axis=x
винт_ручки_6 = translate [винт_ручки] offset=[56, -233, 198]

крепёж = union [конфирмат_1, конфирмат_2, конфирмат_3, конфирмат_4,
                конфирмат_5, конфирмат_6, конфирмат_7, конфирмат_8,
                конфирмат_9, конфирмат_10, конфирмат_11, конфирмат_12,
                полка_винт_1, полка_винт_2, полка_винт_3, полка_винт_4,
                рейка_винт_1, рейка_винт_2, рейка_винт_3, рейка_винт_4,
                гвоздь_1, гвоздь_2, гвоздь_3, гвоздь_4, гвоздь_5, гвоздь_6,
                гвоздь_7, гвоздь_8, гвоздь_9, гвоздь_10, гвоздь_11,
                гвоздь_12, гвоздь_13, гвоздь_14,
                винт_петли_1, винт_петли_2, винт_петли_3, винт_петли_4,
                винт_петли_5, винт_петли_6, винт_петли_7, винт_петли_8,
                винт_ручки_1, винт_ручки_2, винт_ручки_3, винт_ручки_4,
                винт_ручки_5, винт_ручки_6]

дверь = group [фасад_л, ручка_левая, петля_1, петля_2]
ящик_сборка = group [ящик, ручка_ящика, колесо_1, колесо_2, колесо_3, колесо_4,
                     кронштейн_1, кронштейн_2, кронштейн_3, кронштейн_4]

# ---------- АНИМАЦИИ: ДВЕ НЕЗАВИСИМЫЕ ЗАГОТОВКИ ----------
#  «дверь» — ручка тянется, дверь идёт вокруг петли и возвращается.
#  «ящик»  — ящик выезжает по рейкам, колёсики катятся, кронштейны стоят.
заготовка дверь, ящик
animate ручка_левая move dy=4 seconds=0.25 scene=дверь
animate ручка_левая move dy=-4 seconds=0.3 scene=дверь
animate ручка_левая move dy=-9 seconds=0.4 scene=дверь
animate ручка_левая move dy=9 seconds=0.4 scene=дверь
animate дверь turn angle=-100 axis=z pivot=[-486, -212, 0] seconds=2 scene=дверь
animate дверь wait seconds=1 scene=дверь
animate дверь turn angle=100 axis=z pivot=[-486, -212, 0] seconds=2 scene=дверь

