#  Заготовки, с которых печатались копии, больше не нужны: убираем их из сцены.
delete конфирмат
delete саморез
delete гвоздь
delete винт_петли
delete винт_ручки

# ---------- ПРОВЕРКИ ----------
check корпус watertight
check корпус parts 1
check корпус size 998..1002 416..420 1198..1202
check фасад_л size 478..481 16..20 852..856
check фасад_л watertight
check фасад_л parts 1
check ящик watertight
check ящик parts 1
check рейки height 9..13
check колесо_1 height 24..28
check кронштейн_1 height 20..26
check ручка_левая height 198..202
check гвоздь_1 gap задняя_стенка 0
check конфирмат_1 gap боковина_л 0
check полка_винт_1 gap боковина_л 0
check рейка_л gap боковина_л -1..1
check колесо_1 gap рейка_л 0

