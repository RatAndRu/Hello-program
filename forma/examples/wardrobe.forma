# ============================================================================
#  ШКАФ-ВИТРИНА 1000 × 450 × 1200 мм — ЛДСП 18 мм
# ============================================================================
#  Фасад смотрит в −Y (как «спереди» в окне просмотра и отчёте).
#  Дверь открывается вокруг петли, ящик выезжает по направляющим,
#  колёсики катятся по рейкам. Клипы привязаны к объектам, поэтому
#  дверь, ящик и колёса двигаются одновременно, в одном клипе.
# ----------------------------------------------------------------------------

scene bg=#1b1e25 env=studio shadows=да grid=нет
light preset=студия strength=1.2

# ---------- ЦОКОЛЬ (утоплен на 35 мм) ----------
цоколь_перед = box size=[964, 25, 72] center=да at=[0, -177.5, 36]
цоколь_зад = box size=[964, 25, 72] center=да at=[0, 194.5, 36]
цоколь_л = box size=[25, 372, 72] center=да at=[-487.5, 7, 36]
цоколь_п = mirror_copy [цоколь_л] plane=x
цоколь = union [цоколь_перед, цоколь_зад, цоколь_л, цоколь_п]

# ---------- КОРПУС: глубина 414, двери накладные 18 мм ----------
боковина_л = box size=[18, 414, 1130] center=да at=[-491, 0, 635]
боковина_п = mirror_copy [боковина_л] plane=x
дно = box size=[970, 414, 18] center=да at=[0, 0, 79]
верх = box size=[970, 414, 18] center=да at=[0, 0, 1191]
разделитель = box size=[970, 410, 18] center=да at=[0, -2, 317]
задняя_стенка = box size=[970, 4, 1092] center=да at=[0, 205, 634]
полка = box size=[966, 380, 18] center=да at=[0, 0, 665]

# ---------- ПОЛКОДЕРЖАТЕЛИ (штифты 5 мм в боковины) ----------
полкодержатель_1 = cylinder radius=2.5 height=30 segments=24 center=да at=[0, 0, 0]
полкодержатель_1 = rotate [полкодержатель_1] angle=90 axis=y
полкодержатель_1 = translate [полкодержатель_1] offset=[-467, -150, 654]
полкодержатель_2 = cylinder radius=2.5 height=30 segments=24 center=да at=[0, 0, 0]
полкодержатель_2 = rotate [полкодержатель_2] angle=90 axis=y
полкодержатель_2 = translate [полкодержатель_2] offset=[-467, 150, 654]
полкодержатель_3 = cylinder radius=2.5 height=30 segments=24 center=да at=[0, 0, 0]
полкодержатель_3 = rotate [полкодержатель_3] angle=90 axis=y
полкодержатель_3 = translate [полкодержатель_3] offset=[467, -150, 654]
полкодержатель_4 = cylinder radius=2.5 height=30 segments=24 center=да at=[0, 0, 0]
полкодержатель_4 = rotate [полкодержатель_4] angle=90 axis=y
полкодержатель_4 = translate [полкодержатель_4] offset=[467, 150, 654]

# ---------- НАПРАВЛЯЮЩИЕ ЯЩИКА ----------
#  Корпусная часть телескопа: прижата к боковине (x = −482, внутренняя грань)
#  и упирается в заднюю стенку (y = 203). Наружу и в стенку не заходит.
направ_л = box size=[10, 397, 40] center=да at=[-477, -1.5, 120]
направ_п = mirror_copy [направ_л] plane=x

# ---------- ПРАВАЯ ДВЕРЬ (накладная, закрыта) ----------
фасад_п = box size=[479.5, 18, 854] round=2 center=да at=[241.25, -216, 754]
филёнка_п = box size=[359.5, 8, 734] round=1.5 center=да at=[241.25, -221, 754]
фасад_п = difference [фасад_п, филёнка_п]
ручка_п_штанга = capsule radius=5 height=200 center=да at=[0, 0, 0]
ручка_п_штанга = translate [ручка_п_штанга] offset=[55, -233, 784]
ручка_п_стойка1 = cylinder radius=4 height=14 segments=24 center=да at=[0, 0, 0]
ручка_п_стойка1 = rotate [ручка_п_стойка1] angle=90 axis=x
ручка_п_стойка1 = translate [ручка_п_стойка1] offset=[55, -230, 704]
ручка_п_стойка2 = cylinder radius=4 height=14 segments=24 center=да at=[0, 0, 0]
ручка_п_стойка2 = rotate [ручка_п_стойка2] angle=90 axis=x
ручка_п_стойка2 = translate [ручка_п_стойка2] offset=[55, -230, 864]
ручка_правая = union [ручка_п_штанга, ручка_п_стойка1, ручка_п_стойка2]

# ---------- ЛЕВАЯ ДВЕРЬ (петли слева, открывается) ----------
фасад_л = box size=[479.5, 18, 854] round=2 center=да at=[-241.25, -216, 754]
филёнка_л = box size=[359.5, 8, 734] round=1.5 center=да at=[-241.25, -221, 754]
фасад_л = difference [фасад_л, филёнка_л]
ручка_л_штанга = capsule radius=5 height=200 center=да at=[0, 0, 0]
ручка_л_штанга = translate [ручка_л_штанга] offset=[-55, -233, 784]
ручка_л_стойка1 = cylinder radius=4 height=14 segments=24 center=да at=[0, 0, 0]
ручка_л_стойка1 = rotate [ручка_л_стойка1] angle=90 axis=x
ручка_л_стойка1 = translate [ручка_л_стойка1] offset=[-55, -230, 704]
ручка_л_стойка2 = cylinder radius=4 height=14 segments=24 center=да at=[0, 0, 0]
ручка_л_стойка2 = rotate [ручка_л_стойка2] angle=90 axis=x
ручка_л_стойка2 = translate [ручка_л_стойка2] offset=[-55, -230, 864]
ручка_левая = union [ручка_л_штанга, ручка_л_стойка1, ручка_л_стойка2]

# ---------- РЕЙКИ ЯЩИКА (колёсики катятся по ним) ----------
#  Рейка прижата к боковине и задней стенке: x −482…−428, y −206…203.
#  Раньше она была шире корпуса и торчала сквозь стенку — теперь заподлицо.
рейка_л = box size=[64, 409, 11] center=да at=[-450, -1.5, 94.5]
рейка_п = mirror_copy [рейка_л] plane=x
рейки = union [рейка_л, рейка_п]

# ---------- ЯЩИК ----------
ящик_фасад = box size=[960, 18, 216] round=2 center=да at=[0, -216, 198]
ящик_окно = box size=[820, 8, 116] round=1.5 center=да at=[0, -221, 198]
ящик_фасад = difference [ящик_фасад, ящик_окно]
ящик_бок_л = box size=[15, 390, 181] center=да at=[-442.5, -12, 214.5]
ящик_бок_п = mirror_copy [ящик_бок_л] plane=x
ящик_зад = box size=[870, 15, 181] center=да at=[0, 175.5, 214.5]
ящик_дно = box size=[900, 390, 4] center=да at=[0, -12, 128]
ручка_ящ_штанга = capsule radius=4.5 height=140 center=да at=[0, 0, 0]
ручка_ящ_штанга = rotate [ручка_ящ_штанга] angle=90 axis=y
ручка_ящ_штанга = translate [ручка_ящ_штанга] offset=[0, -243, 198]
ручка_ящ_стойка1 = cylinder radius=4 height=16 segments=24 center=да at=[0, 0, 0]
ручка_ящ_стойка1 = rotate [ручка_ящ_стойка1] angle=90 axis=x
ручка_ящ_стойка1 = translate [ручка_ящ_стойка1] offset=[-56, -231, 198]
ручка_ящ_стойка2 = cylinder radius=4 height=16 segments=24 center=да at=[0, 0, 0]
ручка_ящ_стойка2 = rotate [ручка_ящ_стойка2] angle=90 axis=x
ручка_ящ_стойка2 = translate [ручка_ящ_стойка2] offset=[56, -231, 198]
ручка_ящика = union [ручка_ящ_штанга, ручка_ящ_стойка1, ручка_ящ_стойка2]
ящик = union [ящик_фасад, ящик_бок_л, ящик_бок_п, ящик_зад, ящик_дно]

# ---------- КОЛЁСИКИ (ось X, катятся по рейкам) ----------
#  Колесо стоит на рейке (верх рейки z = 100), кронштейн входит в дно ящика
#  (z 126…130) — колесо закреплено на ящике, а не висит в воздухе.
#  Ось колеса вдоль X: ящик едет по Y, колесо катится, а не скользит.
колесо_1_диск = wheel diameter=26 width=12 rim=5 spokes=3 hub=8 tire=2 segments=48
колесо_1_диск = rotate [колесо_1_диск] angle=90 axis=y
колесо_1_диск = translate [колесо_1_диск] offset=[-425, 45, 111.5]
колесо_1_кронштейн = box size=[16, 34, 18] round=2 center=да at=[-425, 45, 124]
колесо_1_ось = cylinder radius=3 height=26 segments=16 center=да
колесо_1_ось = rotate [колесо_1_ось] angle=90 axis=y
колесо_1_ось = translate [колесо_1_ось] offset=[-425, 45, 113]
колесо_1 = union [колесо_1_диск, колесо_1_кронштейн, колесо_1_ось]

колесо_2_диск = wheel diameter=26 width=12 rim=5 spokes=3 hub=8 tire=2 segments=48
колесо_2_диск = rotate [колесо_2_диск] angle=90 axis=y
колесо_2_диск = translate [колесо_2_диск] offset=[425, 45, 111.5]
колесо_2_кронштейн = box size=[16, 34, 18] round=2 center=да at=[425, 45, 124]
колесо_2_ось = cylinder radius=3 height=26 segments=16 center=да
колесо_2_ось = rotate [колесо_2_ось] angle=90 axis=y
колесо_2_ось = translate [колесо_2_ось] offset=[425, 45, 113]
колесо_2 = union [колесо_2_диск, колесо_2_кронштейн, колесо_2_ось]

колесо_3_диск = wheel diameter=26 width=12 rim=5 spokes=3 hub=8 tire=2 segments=48
колесо_3_диск = rotate [колесо_3_диск] angle=90 axis=y
колесо_3_диск = translate [колесо_3_диск] offset=[-425, 175, 111.5]
колесо_3_кронштейн = box size=[16, 34, 18] round=2 center=да at=[-425, 175, 124]
колесо_3_ось = cylinder radius=3 height=26 segments=16 center=да
колесо_3_ось = rotate [колесо_3_ось] angle=90 axis=y
колесо_3_ось = translate [колесо_3_ось] offset=[-425, 175, 113]
колесо_3 = union [колесо_3_диск, колесо_3_кронштейн, колесо_3_ось]

колесо_4_диск = wheel diameter=26 width=12 rim=5 spokes=3 hub=8 tire=2 segments=48
колесо_4_диск = rotate [колесо_4_диск] angle=90 axis=y
колесо_4_диск = translate [колесо_4_диск] offset=[425, 175, 111.5]
колесо_4_кронштейн = box size=[16, 34, 18] round=2 center=да at=[425, 175, 124]
колесо_4_ось = cylinder radius=3 height=26 segments=16 center=да
колесо_4_ось = rotate [колесо_4_ось] angle=90 axis=y
колесо_4_ось = translate [колесо_4_ось] offset=[425, 175, 113]
колесо_4 = union [колесо_4_диск, колесо_4_кронштейн, колесо_4_ось]

# ---------- СБОРКА ----------
корпус = union [цоколь, боковина_л, боковина_п, дно, верх, разделитель, задняя_стенка,
                полка, полкодержатель_1, полкодержатель_2, полкодержатель_3,
                полкодержатель_4, направ_л, направ_п]

# ---------- КРЕПЁЖ КОРПУСА ----------
#  Конфирматы 7×50: входят в боковину и в горизонтальные детали (дно, верх,
#  разделитель, полка). Шляпки видны на боковине снаружи — как в настоящем
#  шкафу, а не «склеенные» доски.
конфирмат = cylinder radius=3.5 height=50 segments=16 center=да
конфирмат = rotate [конфирмат] angle=90 axis=y
конфирмат_1 = translate [конфирмат] offset=[-491, -160, 79]
конфирмат_2 = translate [конфирмат] offset=[-491, 160, 79]
конфирмат_3 = translate [конфирмат] offset=[-491, -160, 317]
конфирмат_4 = translate [конфирмат] offset=[-491, 160, 1191]
конфирмат_5 = mirror_copy [конфирмат_1] plane=x
конфирмат_6 = mirror_copy [конфирмат_2] plane=x
конфирмат_7 = mirror_copy [конфирмат_3] plane=x
конфирмат_8 = mirror_copy [конфирмат_4] plane=x

#  Винты задней стенки 4×16: шляпка снаружи, стержень входит в дно/верх и
#  боковины. Восемь штук по периметру — задняя стенка держится не «на честном
#  слове».
винт_зад = cylinder radius=2 height=16 segments=16 center=да
винт_зад = rotate [винт_зад] angle=90 axis=x
винт_зад_1 = translate [винт_зад] offset=[-455, 207, 1100]
винт_зад_2 = translate [винт_зад] offset=[455, 207, 1100]
винт_зад_3 = translate [винт_зад] offset=[-455, 207, 120]
винт_зад_4 = translate [винт_зад] offset=[455, 207, 120]
винт_зад_5 = translate [винт_зад] offset=[-230, 207, 1150]
винт_зад_6 = translate [винт_зад] offset=[230, 207, 1150]
винт_зад_7 = translate [винт_зад] offset=[-230, 207, 95]
винт_зад_8 = translate [винт_зад] offset=[230, 207, 95]

# ---------- ПЕТЛИ (крепления двери к корпусу) ----------
#  Петля собрана из трёх частей: чашка на корпусе, чашка на двери и шарнир
#  ровно на оси открывания (x = −486, y = −212). Чашка корпуса остаётся в
#  корпусе, чашка двери и шарнир входят в группу «дверь».
петля_шарнир_1 = cylinder radius=7 height=70 segments=28 center=да
петля_шарнир_1 = translate [петля_шарнир_1] offset=[-486, -212, 350]
петля_дверь_1 = box size=[28, 16, 70] round=2 center=да at=[-470, -214, 350]
петля_корпус_1 = box size=[28, 16, 70] round=2 center=да at=[-492, -198, 350]
петля_1 = union [петля_шарнир_1, петля_дверь_1]
петля_шарнир_2 = cylinder radius=7 height=70 segments=28 center=да
петля_шарнир_2 = translate [петля_шарнир_2] offset=[-486, -212, 1055]
петля_дверь_2 = box size=[28, 16, 70] round=2 center=да at=[-470, -214, 1055]
петля_корпус_2 = box size=[28, 16, 70] round=2 center=да at=[-492, -198, 1055]
петля_2 = union [петля_шарнир_2, петля_дверь_2]
петли_корпуса = union [петля_корпус_1, петля_корпус_2]

#  Винты петли: по два на чашку, вворачиваются в фасад с внутренней стороны.
винт_петли = cylinder radius=1.8 height=14 segments=14 center=да
винт_петли = rotate [винт_петли] angle=90 axis=x
винт_петли_1 = translate [винт_петли] offset=[-462, -214, 338]
винт_петли_2 = translate [винт_петли] offset=[-462, -214, 362]
винт_петли_3 = translate [винт_петли] offset=[-462, -214, 1043]
винт_петли_4 = translate [винт_петли] offset=[-462, -214, 1067]

#  Стяжки ручек: видны как небольшие шляпки на внутренней стороне фасада.
винт_ручки = cylinder radius=1.6 height=10 segments=14 center=да
винт_ручки = rotate [винт_ручки] angle=90 axis=x
винт_ручки_1 = translate [винт_ручки] offset=[55, -222, 704]
винт_ручки_2 = translate [винт_ручки] offset=[55, -222, 864]
винт_ручки_3 = translate [винт_ручки] offset=[-55, -222, 704]
винт_ручки_4 = translate [винт_ручки] offset=[-55, -222, 864]
винт_ручки_5 = translate [винт_ручки] offset=[-56, -222, 198]
винт_ручки_6 = translate [винт_ручки] offset=[56, -222, 198]

крепёж = union [конфирмат_1, конфирмат_2, конфирмат_3, конфирмат_4,
                конфирмат_5, конфирмат_6, конфирмат_7, конфирмат_8,
                винт_зад_1, винт_зад_2, винт_зад_3, винт_зад_4,
                винт_зад_5, винт_зад_6, винт_зад_7, винт_зад_8,
                винт_петли_1, винт_петли_2, винт_петли_3, винт_петли_4,
                винт_ручки_1, винт_ручки_2, винт_ручки_3, винт_ручки_4,
                винт_ручки_5, винт_ручки_6]

дверь = group [фасад_л, ручка_левая, петля_1, петля_2]
ящик_сборка = group [ящик, ручка_ящика, колесо_1, колесо_2, колесо_3, колесо_4]

# ---------- АНИМАЦИЯ: сцены-варианты + параллельные движения ----------
#  scene=… — заготовка для просмотра: «дверь», «ящик». В окне их можно
#  переключать, не трогая сценарий; «все сцены» показывает всё сразу.
animate ручка_левая move dy=4 seconds=0.25 scene=дверь
animate ручка_левая move dy=-4 seconds=0.3 scene=дверь
animate ручка_левая move dy=-9 seconds=0.4 scene=дверь
animate ручка_левая move dy=9 seconds=0.4 scene=дверь
animate дверь turn angle=-100 axis=z pivot=[-486, -212, 0] seconds=2 scene=дверь
animate дверь wait seconds=1 scene=дверь
animate дверь turn angle=100 axis=z pivot=[-486, -212, 0] seconds=2 scene=дверь

animate ящик_сборка move dy=-250 seconds=2 scene=ящик
animate ручка_ящика move dy=6 seconds=0.25 scene=ящик
animate ручка_ящика move dy=-6 seconds=0.25 scene=ящик
animate ящик_сборка wait seconds=1 scene=ящик
animate ящик_сборка move dy=250 seconds=2 scene=ящик
animate колесо_1 roll distance=250 radius=13 axis=x seconds=2 scene=ящик
animate колесо_1 wait seconds=1 scene=ящик
animate колесо_1 roll distance=250 radius=13 axis=-x seconds=2 scene=ящик
animate колесо_2 roll distance=250 radius=13 axis=x seconds=2 scene=ящик
animate колесо_2 wait seconds=1 scene=ящик
animate колесо_2 roll distance=250 radius=13 axis=-x seconds=2 scene=ящик
animate колесо_3 roll distance=250 radius=13 axis=x seconds=2 scene=ящик
animate колесо_3 wait seconds=1 scene=ящик
animate колесо_3 roll distance=250 radius=13 axis=-x seconds=2 scene=ящик
animate колесо_4 roll distance=250 radius=13 axis=x seconds=2 scene=ящик
animate колесо_4 wait seconds=1 scene=ящик
animate колесо_4 roll distance=250 radius=13 axis=-x seconds=2 scene=ящик

# ---------- ПРОВЕРКИ ----------
check корпус watertight
check корпус parts 1
check корпус size 998..1002 412..416 1198..1202
check фасад_л size 478..481 16..20 852..856
check фасад_л watertight
check фасад_л parts 1
check ящик watertight
check ящик parts 1
check рейки height 9..13
check колесо_1 gap рейки 0
check колесо_1_диск height 24..28
check ручка_левая height 198..202
check крепёж parts 26
check винт_зад_1 gap задняя_стенка 0
check рейка_л gap боковина_л -1..1
check колесо_1 gap рейка_л 0

# ---------- МАТЕРИАЛ ----------
color корпус #a8794a rough=0.66 density=0.72
texture корпус kind=дерево scale=0.8 uv=auto
color фасад_п #e3dccd rough=0.48 density=0.72
texture фасад_п kind=дерево scale=0.9 uv=auto
color фасад_л #e0d9c8 rough=0.48 density=0.72
texture фасад_л kind=дерево scale=0.9 uv=auto
color ручка_правая #2b2d31 metal=0.9 rough=0.24
color ручка_левая #2b2d31 metal=0.9 rough=0.24
color ручка_ящика #2b2d31 metal=0.9 rough=0.24
color ящик #ddd5c5 rough=0.52 density=0.72
color рейки #2c2f35 metal=0.85 rough=0.28
color крепёж #8d949c metal=0.9 rough=0.3
color колесо_1 #24262b metal=0.9 rough=0.22
color колесо_2 #24262b metal=0.9 rough=0.22
color колесо_3 #24262b metal=0.9 rough=0.22
color колесо_4 #24262b metal=0.9 rough=0.22
