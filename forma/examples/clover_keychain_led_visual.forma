# КЛЕВЕР С ЭЛЕКТРОНИКОЙ — НАГЛЯДНАЯ СБОРКА, НЕ ДЛЯ ПЕЧАТИ.
#
# Эта сцена показывает, как может выглядеть готовый брелок с выбранным
# отсеком 31×23×6 мм и зелёным светодиодом Ø5 мм. Чёрный отсек, батарейка,
# диод, резистор, переключатель и провода — УСЛОВНЫЕ МАКЕТЫ, не печатные
# детали. Реальную форму крышки, рычажка, проводов и ножек нужно измерить.
# Фиксаторы, открывание крышки и прочность не спроектированы и не проверены.
# Сборку нельзя отправлять на печать целиком: макеты попадут в экспорт!
#
# Исходный клевер 39,9×48,9×3 мм. Пример заднего корпуса около 34,7×26 мм
# в локальных осях отсека с учётом защитного выступа; округлый торец условный.
# Корпус повёрнут на 45°. Перед — +Z, верх — +Y. Тело от z=-11,5 до z=3:
# 3 мм лицо, 4 мм для проводки, 1,2 мм перегородка, 6,3 мм гнездо.
# Выступ LED, выключатель и металлическое кольцо в эту толщину не входят.
# Зазор вокруг условного держателя 0,3 мм на сторону, стенки 1,2 мм,
# кроме условных вырезов для выключателя, проводов и крышки.
# Радиус закругления отсека и вырезы — только догадка по фото, не обмер.
# Ø5,2 мм — пробное отверстие под LED; посадку проверяют отдельным образцом.
#
# СХЕМА: плюс отсека — резистор 1 кОм — анод LED — катод LED — минус отсека.
# Диод и пайка показаны условно. Сначала подтвердить одну CR2032 и полярность.
# Зелёный LED может работать слабо: его прямое напряжение неизвестно.
# Отсек крепится неподвижной частью; крышка и переключатель должны быть
# доступны. Детское закрывание, безопасность и реальная работа не проверены.
#
# КАК ПОСМОТРЕТЬ ВНУТРЬ: в конце сценария есть шесть команд hide.
# Уберите символ # в их начале и пересоберите: лицевая часть и перегородка
# скроются, а светодиод, резистор и оба провода останутся на своих местах.

# -------------------------- 1. Цветное лицо из исходного клевера ------------
верх_контур = heart width=22 depth=3 plane=flat at=[0,10,0]
право_заг = heart width=22 depth=3 plane=flat at=[0,10,0]
право_контур = rotate [право_заг] angle=-90 axis=z
низ_заг = heart width=22 depth=3 plane=flat at=[0,10,0]
низ_контур = rotate [низ_заг] angle=180 axis=z
лево_заг = heart width=22 depth=3 plane=flat at=[0,10,0]
лево_контур = rotate [лево_заг] angle=90 axis=z
центр = cylinder radius=5 height=3 segments=64 at=[0,0,0]
мостик = box size=[6,13,3] at=[0,18,0]
ушко_наружное = cylinder radius=5 height=3 segments=64 at=[0,24,0]
заготовка = union [верх_контур,право_контур,низ_контур,лево_контур,центр,мостик,ушко_наружное]
дыра_кольца = cylinder radius=2.5 height=5 segments=64 at=[0,24,-1]
с_ушком = difference [заготовка,дыра_кольца]

# Кольцо вокруг центрального отверстия: подрезаем цветные вставки и их пазы.
охранный_круг = cylinder radius=3.6 height=3 segments=96 at=[0,0,1]
рез_верх = heart width=14 depth=1.4 plane=flat at=[0,9,1.8]
рез_право_заг = heart width=14 depth=1.4 plane=flat at=[0,9,1.8]
рез_право = rotate [рез_право_заг] angle=-90 axis=z
рез_низ_заг = heart width=14 depth=1.4 plane=flat at=[0,9,1.8]
рез_низ = rotate [рез_низ_заг] angle=180 axis=z
рез_лево_заг = heart width=14 depth=1.4 plane=flat at=[0,9,1.8]
рез_лево = rotate [рез_лево_заг] angle=90 axis=z
рез_верх = difference [рез_верх,охранный_круг]
рез_право = difference [рез_право,охранный_круг]
рез_низ = difference [рез_низ,охранный_круг]
рез_лево = difference [рез_лево,охранный_круг]
дыра_LED = cylinder radius=2.6 height=5 segments=96 at=[0,0,-1]
лицо_основа = difference [с_ушком,рез_верх,рез_право,рез_низ,рез_лево,дыра_LED]

вставка_верх = heart width=14 depth=1.2 plane=flat at=[0,9,1.8]
вставка_право_заг = heart width=14 depth=1.2 plane=flat at=[0,9,1.8]
вставка_право = rotate [вставка_право_заг] angle=-90 axis=z
вставка_низ_заг = heart width=14 depth=1.2 plane=flat at=[0,9,1.8]
вставка_низ = rotate [вставка_низ_заг] angle=180 axis=z
вставка_лево_заг = heart width=14 depth=1.2 plane=flat at=[0,9,1.8]
вставка_лево = rotate [вставка_лево_заг] angle=90 axis=z
вставка_верх = difference [вставка_верх,охранный_круг]
вставка_право = difference [вставка_право,охранный_круг]
вставка_низ = difference [вставка_низ,охранный_круг]
вставка_лево = difference [вставка_лево,охранный_круг]
color вставка_верх #66d976
color вставка_право #f5c84c
color вставка_низ #eb6b83
color вставка_лево #41bfd0

# ------------------ 2. Передняя рамка и заднее гнездо (макет) --------------
# Все размеры корпуса ниже заданы в локальных осях отсека и затем повернуты.
# Окно на прямом торце позволяет схематически вывести провода и выключатель;
# прорезь у округлого торца — место для доступа к крышке. Это НЕ проверенные
# посадочные или удерживающие элементы.
рамка_наруж_бокс = box size=[26,21,4.1] at=[0,6.5,-4]
рамка_наруж_круг = cylinder radius=13 height=4.1 segments=96 at=[0,-4,-4]
рамка_наруж = union [рамка_наруж_бокс,рамка_наруж_круг]
рамка_внутр_бокс = box size=[23.6,19.8,4.3] at=[0,5.9,-4.1]
рамка_внутр_круг = cylinder radius=11.8 height=4.3 segments=96 at=[0,-4,-4.1]
рамка_внутр = union [рамка_внутр_бокс,рамка_внутр_круг]
доступ_провода_перед = box size=[16,5,4.4] at=[1,16.5,-4.1]
рамка_местная = difference [рамка_наруж,рамка_внутр,доступ_провода_перед]
защита_проводов_перед = box size=[6.7,1.2,4.1] at=[5.75,17.1,-4]
рамка_местная = union [рамка_местная,защита_проводов_перед]
рамка_повёрнутая = rotate [рамка_местная] angle=45 axis=z
# Тонкая нижняя лицевая пластина скрывает проводку в просветах между листьями.
# Она частично заполняет вырезы исходного клевера, но не задевает цветные вставки.
лицо_подложка_бокс = box size=[26,21,1.2] at=[0,6.5,0]
лицо_подложка_круг = cylinder radius=13 height=1.2 segments=96 at=[0,-4,0]
лицо_подложка = union [лицо_подложка_бокс,лицо_подложка_круг]
лицо_подложка = rotate [лицо_подложка] angle=45 axis=z
лицо_подложка = difference [лицо_подложка,дыра_LED]
лицо_клевера = union [лицо_основа,рамка_повёрнутая,лицо_подложка]
color лицо_клевера #185b3a

корпус_бокс = box size=[26,21,7.5] at=[0,6.5,-11.5]
корпус_круг = cylinder radius=13 height=7.5 segments=96 at=[0,-4,-11.5]
корпус_блок = union [корпус_бокс,корпус_круг]
гнездо_бокс = box size=[23.6,19.8,6.4] at=[0,5.9,-11.6]
гнездо_круг = cylinder radius=11.8 height=6.4 segments=96 at=[0,-4,-11.6]
гнездо_отсека = union [гнездо_бокс,гнездо_круг]
вырез_ползунка = box size=[16,5,8.0] at=[1,16.5,-11.6]
вырез_крышки = box size=[10,5,3.8] at=[0,-16.5,-11.6]
корпус_местный = difference [корпус_блок,гнездо_отсека,вырез_ползунка,вырез_крышки]
защита_проводов_сзади = box size=[6.7,1.2,7.5] at=[5.75,17.1,-11.5]
корпус_местный = union [корпус_местный,защита_проводов_сзади]
корпус_сзади = rotate [корпус_местный] angle=45 axis=z
color корпус_сзади #215f41

# ---------------- 3. Зелёный светодиод: 5 мм, форма условная ---------------
# Корпус-пример Ø5×9 мм с условным буртиком; не чертёж конкретного набора.
LED_стержень = cylinder radius=2.5 height=6.5 segments=64 at=[0,0,0]
LED_шар = sphere radius=2.5 segments=64 at=[0,0,6.5]
LED_верх_рез = box size=[6,6,3] at=[0,0,6.5]
LED_купол = intersect [LED_шар,LED_верх_рез]
LED_буртик = cylinder radius=3 height=1 segments=64 at=[0,0,-1]
макет_LED = union [LED_стержень,LED_купол,LED_буртик]
color макет_LED #58e968 material=plastic rough=0.18 emissive=#39d950 emissive_strength=0.65

# ------------------- 4. Батарейный отсек как на фото, условно ---------------
# Форма округлого конца и раздел крышки оценены визуально. Это не копия модели
# продавца. Сам отсек находится в гнезде; его крышка обращена назад (−Z).
отсек_прямой = box size=[23,19.5,6] at=[0,5.75,-11.2]
отсек_круглый = cylinder radius=11.5 height=6 segments=96 at=[0,-4,-11.2]
отсек_местный = union [отсек_прямой,отсек_круглый]
полость_батарейки = cylinder radius=10.2 height=3.75 segments=96 at=[0,-4,-11.25]
отсек_местный = difference [отсек_местный,полость_батарейки]
макет_отсека = rotate [отсек_местный] angle=45 axis=z
color макет_отсека #242b28 rough=0.6

# Для иллюстрации показана одна CR2032 Ø20×3,2 мм. Совместимость и число
# элементов в присланном отсеке по фотографиям окончательно не подтверждены.
батарейка_местная = cylinder radius=10 height=3.2 segments=96 at=[0,-4,-11.15]
макет_батарейки = rotate [батарейка_местная] angle=45 axis=z
color макет_батарейки #c8d3d0 material=steel rough=0.32
# Ориентация и контакты батарейки на макете не подтверждают её реальную полярность.
плюс_поперёк = box size=[3.6,0.55,0.04] at=[2.8284,-2.8284,-11.19]
плюс_вдоль = box size=[0.55,3.6,0.04] at=[2.8284,-2.8284,-11.19]
маркировка_плюс = union [плюс_поперёк,плюс_вдоль]
color маркировка_плюс #3e4d47

крышка_прямая = box size=[23,19.5,0.15] at=[0,5.75,-11.35]
крышка_круглая = cylinder radius=11.5 height=0.15 segments=96 at=[0,-4,-11.35]
крышка_вся = union [крышка_прямая,крышка_круглая]
крышка_область = box size=[24,23,0.5] at=[0,-4.5,-11.5]
крышка_местная = intersect [крышка_вся,крышка_область]
макет_крышки = rotate [крышка_местная] angle=45 axis=z
color макет_крышки #39433d rough=0.6

ползунок_местный = box size=[4,3,2] at=[-2,16.9,-9.2]
макет_ползунка = rotate [ползунок_местный] angle=45 axis=z
color макет_ползунка #7a8580 rough=0.55

# ---------------- 5. Проводка в отсеке между лицом и перегородкой -----------
# Для картинки провода укорочены и имеют условный Ø1 мм. Стыки/термоусадка
# и изгибы схематичны: проверить фактический диаметр и не зажимать провод.
# Резистор — ориентир Ø2,5×6 мм без выводов, не измеренная деталь из набора.
резистор_местный = sweep path=[[-5,-3,-2.4],[-5,3,-2.4]] radius=1.25 sides=32
макет_резистора = rotate [резистор_местный] angle=45 axis=z
color макет_резистора #e9c78b rough=0.7
полоса1_местная = sweep path=[[-5,-1.7,-2.4],[-5,-1.35,-2.4]] radius=1.28 sides=32
полоса2_местная = sweep path=[[-5,-0.7,-2.4],[-5,-0.35,-2.4]] radius=1.28 sides=32
полоса3_местная = sweep path=[[-5,0.4,-2.4],[-5,0.75,-2.4]] radius=1.28 sides=32
полоса4_местная = sweep path=[[-5,1.65,-2.4],[-5,1.95,-2.4]] radius=1.28 sides=32
полоса1 = rotate [полоса1_местная] angle=45 axis=z
полоса2 = rotate [полоса2_местная] angle=45 axis=z
полоса3 = rotate [полоса3_местная] angle=45 axis=z
полоса4 = rotate [полоса4_местная] angle=45 axis=z
color полоса1 #75452a
color полоса2 #302a25
color полоса3 #a84a3b
color полоса4 #c8a340

красный_местный = sweep path=[[4.5,15.3,-8.2],[4.5,15.8,-8.0],[4.5,15.8,-4.4],[4.2,15.3,-2.4],[2.5,13,-2.4],[-2,8,-2.4],[-5,4.7,-2.4]] radius=0.5 sides=16 smooth=3
чёрный_местный = sweep path=[[6.7,15.3,-8.2],[6.7,15.8,-8.0],[6.7,15.8,-4.4],[6.5,15.3,-2.4],[5.4,13,-2.4],[4.5,8,-2.4],[3.4,3.5,-2.4],[1.27,0,-2.4]] radius=0.5 sides=16 smooth=3
провод_плюс = rotate [красный_местный] angle=45 axis=z
провод_минус = rotate [чёрный_местный] angle=45 axis=z
color провод_плюс #e84b46 rough=0.5
color провод_минус #1d2633 rough=0.5

контакт_рез_местный = sweep path=[[-5,3,-2.4],[-5,4.7,-2.4]] radius=0.28 sides=16
контакт_анод_местный = sweep path=[[-5,-3,-2.4],[-5,-4.2,-2.4],[-3,-4.5,-2.4],[-1.27,-3,-2.4],[-1.27,0,-2.4],[-1.27,0,-1]] radius=0.28 sides=16 smooth=2
контакт_катод_местный = sweep path=[[1.27,0,-2.4],[1.27,0,-1]] radius=0.28 sides=16
контакт_рез = rotate [контакт_рез_местный] angle=45 axis=z
контакт_анод = rotate [контакт_анод_местный] angle=45 axis=z
контакт_катод = rotate [контакт_катод_местный] angle=45 axis=z
color контакт_рез #c7d2d1 metal=0.5
color контакт_анод #c7d2d1 metal=0.5
color контакт_катод #c7d2d1 metal=0.5

# Условная изоляция на местах соединения. На практике изолировать все
# оголённые выводы, исключить защемление и проверить сборку до закрывания.
термо_плюс_местная = sweep path=[[-5,3.05,-2.4],[-5,4.9,-2.4]] radius=0.55 sides=16
термо_анод_местная = sweep path=[[-5,-3.05,-2.4],[-5,-4.2,-2.4],[-3,-4.5,-2.4],[-1.27,-3,-2.4],[-1.27,0,-2.4],[-1.27,0,-1.05]] radius=0.45 sides=16 smooth=2
термо_катод_местная = sweep path=[[1.27,0,-2.4],[1.27,0,-1.05]] radius=0.43 sides=16
термо_плюс = rotate [термо_плюс_местная] angle=45 axis=z
термо_анод = rotate [термо_анод_местная] angle=45 axis=z
термо_катод = rotate [термо_катод_местная] angle=45 axis=z
color термо_плюс #ab3430 rough=0.7
color термо_анод #8e4337 rough=0.7
color термо_катод #303c4b rough=0.7

# Вид внутри: убрать # у шести строк ниже и нажать «Собрать».
# hide лицо_клевера
# hide вставка_верх
# hide вставка_право
# hide вставка_низ
# hide вставка_лево
# hide корпус_сзади
# Снять крышку на изображении (для вида сзади):
# hide макет_крышки

# Все видимые детали этой сцены — иллюстрация компоновки, НЕ печатное задание.
