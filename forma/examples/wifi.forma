# ============================================================================
#  WI-FI — значок из колец, каждое следующее больше в 1.5 раза
# ----------------------------------------------------------------------------
#  Это пример команды `ряд`: не повтор одинаковых копий, а ступени изменения.
#  Одно колесо-тор, а дальше каждая следующая копия выросла в `grow` раз —
#  ровно так рисуют значок вай-фая: точка, дуга, дуга побольше, ещё больше.
#
#  Дуги получаются честно: ряд колец разрезан плоскостью пола, остались
#  верхние половины. Центральная точка — шар.
#
#  Что попробовать: grow=1.35 — кольца плотнее, grow=1.7 — шире;
#  count=4 — четыре ступени; turn=15 — кольца ещё и поворачиваются.
# ============================================================================

кольцо = torus major=22 minor=4 segments=96 detail=4
кольцо = rotate [кольцо] angle=90 axis=x

волны = ряд [кольцо] count=3 grow=1.5

# половина плоскости: всё, что ниже пола, отрезаем
низ = box size=[400,120,220] at=[0,0,-220]
дуги = difference [волны, низ]

точка = sphere radius=8 segments=48 at=[0,0,2]

color дуги color=#dfe6ef metal=0.1 rough=0.45
color точка color=#dfe6ef metal=0.1 rough=0.45
