# Верх детали — не всегда +Z. После поворота «верх» уезжает вместе с ней,
# и ориентация показывает, куда он теперь смотрит. place осями=хозяина
# ставит деталь по этим осям: крышка садится на настоящий верх корпуса,
# а не на мировой +Z, и разворачивается вместе с ним.

корпус = box size=[140,40,40] round=3
корпус = rotate [корпус] angle=90 axis=y
корпус = place [корпус] at=[0,0,0] align=center
ориентация корпус

крышка = cylinder radius=18 height=6
крышка = place [крышка] on=корпус side=top offset=0 осями=хозяина
color крышка color=#e0a33a metal=0.7 rough=0.3

# боковая бобышка — по правому боку корпуса, тоже в его осях
бобышка = cylinder radius=5 height=14
бобышка = place [бобышка] on=корпус side=right offset=0 осями=хозяина
color бобышка color=#3ac07a metal=0.3 rough=0.5

# а это — обычная мировая посадка: слева от корпуса, вплотную.
# offset=length(корпус) отодвинул бы шайбу на целую длину корпуса.
шайба = cylinder radius=8 height=3
шайба = place [шайба] on=корпус side=left offset=0
color шайба color=#d94f3d metal=0.4 rough=0.45
