# ============================================================================
#  СКЕЛЕТОН-ЧАСЫ Ø 480 мм — открытый механизм
# ============================================================================
#  Циферблат стоит в плоскости XZ, лицом в −Y. Модуль передачи m = 2.
#  Межосевые расстояния считаются строго как a = m·(z1+z2)/2, поэтому зубья
#  входят в зацепление, а колёса не наезжают друг на друга.
#
#  Компоновка нарочно «хаотичная», как в настоящем скелетоне: минутное колесо
#  в центре, барабан уходит влево-вниз, промежуточное — вниз, секундное —
#  вправо-вниз, анкерное — вправо-вверх, баланс с волоском — наверх,
#  мотор завода — влево-вверх. Мостики идут ломаными коромыслами через камни.
#
#  Передаточное отношение (ω·z = const, соседние колёса крутятся навстречу):
#    мотор 12 → барабан 48 → минутное 30 → промежуточное 36 →
#    секундное 24 → анкерное 20.
#  Сцена «ход»: за 8 с мотор +60°, барабан −15°, минутное +24°,
#  промежуточное −20°, секундное +30°, анкерное −36° — ровно по зубьям.
# ============================================================================

scene bg=#0e1116 env=studio shadows=да grid=нет
light preset=студия strength=1.6

# ---------- КОРПУС: среднее кольцо, безель, задняя крышка ----------
корпус_внеш = cylinder radius=240 height=62 segments=132 center=да
корпус_внеш = rotate [корпус_внеш] angle=90 axis=x
корпус_внутр = cylinder radius=212 height=68 segments=132 center=да
корпус_внутр = rotate [корпус_внутр] angle=90 axis=x
корпус = difference [корпус_внеш, корпус_внутр]
корпус = translate [корпус] offset=[0, -13, 230]
безель_внеш = cylinder radius=240 height=14 segments=132 center=да
безель_внеш = rotate [безель_внеш] angle=90 axis=x
безель_внутр = cylinder radius=206 height=18 segments=132 center=да
безель_внутр = rotate [безель_внутр] angle=90 axis=x
безель = difference [безель_внеш, безель_внутр]
безель = translate [безель] offset=[0, -51, 230]
крышка_задняя = cylinder radius=212 height=12 segments=132 center=да
крышка_задняя = rotate [крышка_задняя] angle=90 axis=x
крышка_задняя = translate [крышка_задняя] offset=[0.00, 24, 230.00]
крышка_окно = cylinder radius=96 height=4 segments=96 center=да
крышка_окно = rotate [крышка_окно] angle=90 axis=x
крышка_окно = translate [крышка_окно] offset=[0.00, 20, 230.00]
крышка_пружина = ring diameter=110 width=5 thickness=2
крышка_пружина = rotate [крышка_пружина] angle=90 axis=x
крышка_пружина = translate [крышка_пружина] offset=[0, 20, 230]

# заводная головка справа (ось X)
головка = cylinder radius=17 height=24 segments=48 center=да
головка = rotate [головка] angle=90 axis=y
головка = translate [головка] offset=[252, -13, 230]
головка_вал = cylinder radius=6 height=26 segments=24 center=да
головка_вал = rotate [головка_вал] angle=90 axis=y
головка_вал = translate [головка_вал] offset=[238, -13, 230]

# ---------- ПЛАТА: скелетон с шестью большими окнами ----------
плата_болванка = cylinder radius=202 height=4 segments=132 center=да
плата_болванка = rotate [плата_болванка] angle=90 axis=x
окно_1 = cylinder radius=46 height=12 segments=72 center=да
окно_1 = rotate [окно_1] angle=90 axis=x
окно_1 = translate [окно_1] offset=[118.00, 0, 0.00]
окно_2 = cylinder radius=46 height=12 segments=72 center=да
окно_2 = rotate [окно_2] angle=90 axis=x
окно_2 = translate [окно_2] offset=[59.00, 0, 102.00]
окно_3 = cylinder radius=46 height=12 segments=72 center=да
окно_3 = rotate [окно_3] angle=90 axis=x
окно_3 = translate [окно_3] offset=[-59.00, 0, 102.00]
окно_4 = cylinder radius=46 height=12 segments=72 center=да
окно_4 = rotate [окно_4] angle=90 axis=x
окно_4 = translate [окно_4] offset=[-118.00, 0, 0.00]
окно_5 = cylinder radius=46 height=12 segments=72 center=да
окно_5 = rotate [окно_5] angle=90 axis=x
окно_5 = translate [окно_5] offset=[-59.00, 0, -102.00]
окно_6 = cylinder radius=46 height=12 segments=72 center=да
окно_6 = rotate [окно_6] angle=90 axis=x
окно_6 = translate [окно_6] offset=[59.00, 0, -102.00]
окно_центр = cylinder radius=52 height=12 segments=72 center=да
окно_центр = rotate [окно_центр] angle=90 axis=x
окно_центр = translate [окно_центр] offset=[0.00, 0, 0.00]
плата = difference [плата_болванка, окно_1, окно_2, окно_3, окно_4, окно_5, окно_6, окно_центр]
плата = translate [плата] offset=[0, 14, 230]

# ---------- СТОЙКИ: мостики опираются на плату, а не висят ----------
стойка_1 = cylinder radius=5.5 height=34 segments=24 center=да
стойка_1 = rotate [стойка_1] angle=90 axis=x
стойка_1 = translate [стойка_1] offset=[176.00, -3, 156.00]
стойка_2 = cylinder radius=5.5 height=34 segments=24 center=да
стойка_2 = rotate [стойка_2] angle=90 axis=x
стойка_2 = translate [стойка_2] offset=[-172.00, -3, 260.00]
стойка_3 = cylinder radius=5.5 height=34 segments=24 center=да
стойка_3 = rotate [стойка_3] angle=90 axis=x
стойка_3 = translate [стойка_3] offset=[128.00, -3, 366.00]

# ---------- МОСТИКИ: четыре отдельные детали, каждая на своей стойке ----------
мк_1 = box size=[44.92, 13, 8] round=3.0 center=да
мк_1 = rotate [мк_1] angle=90 axis=x
мк_1 = rotate [мк_1] angle=-175.64 axis=y
мк_1 = translate [мк_1] offset=[160.09, -16, 157.21]
мк_2 = box size=[41.60, 13, 8] round=3.0 center=да
мк_2 = rotate [мк_2] angle=90 axis=x
мк_2 = rotate [мк_2] angle=138.00 axis=y
мк_2 = translate [мк_2] offset=[133.55, -16, 148.86]
мк_3 = box size=[41.60, 13, 8] round=3.0 center=да
мк_3 = rotate [мк_3] angle=90 axis=x
мк_3 = rotate [мк_3] angle=138.00 axis=y
мк_3 = translate [мк_3] offset=[112.29, -16, 129.72]
мк_4 = box size=[52.00, 13, 8] round=3.0 center=да
мк_4 = rotate [мк_4] angle=90 axis=x
мк_4 = rotate [мк_4] angle=-158.00 axis=y
мк_4 = translate [мк_4] offset=[83.59, -16, 127.46]
мк_5 = box size=[52.00, 13, 8] round=3.0 center=да
мк_5 = rotate [мк_5] angle=90 axis=x
мк_5 = rotate [мк_5] angle=-158.00 axis=y
мк_5 = translate [мк_5] offset=[47.43, -16, 142.07]
мк_6 = box size=[98.80, 13, 8] round=3.0 center=да
мк_6 = rotate [мк_6] angle=90 axis=x
мк_6 = rotate [мк_6] angle=-110.00 axis=y
мк_6 = translate [мк_6] offset=[14.67, -16, 189.69]
манк_1 = box size=[53.00, 11, 8] round=3.0 center=да
манк_1 = rotate [манк_1] angle=90 axis=x
манк_1 = rotate [манк_1] angle=-109.67 axis=y
манк_1 = translate [манк_1] offset=[137.10, -16, 178.20]
мбар_1 = box size=[52.01, 13, 8] round=3.0 center=да
мбар_1 = rotate [мбар_1] angle=90 axis=x
мбар_1 = rotate [мбар_1] angle=-13.81 axis=y
мбар_1 = translate [мбар_1] offset=[-153.06, -16, 264.66]
мбар_2 = box size=[60.68, 13, 8] round=3.0 center=да
мбар_2 = rotate [мбар_2] angle=90 axis=x
мбар_2 = rotate [мбар_2] angle=-13.81 axis=y
мбар_2 = translate [мбар_2] offset=[-110.97, -16, 275.01]
мбар_3 = box size=[48.10, 13, 8] round=3.0 center=да
мбар_3 = rotate [мбар_3] angle=90 axis=x
мбар_3 = rotate [мбар_3] angle=-100.00 axis=y
мбар_3 = translate [мбар_3] offset=[-90.86, -16, 297.98]
мбар_4 = box size=[55.90, 13, 8] round=3.0 center=да
мбар_4 = rotate [мбар_4] angle=90 axis=x
мбар_4 = rotate [мбар_4] angle=-100.00 axis=y
мбар_4 = translate [мбар_4] offset=[-97.63, -16, 336.39]
мбал_1 = box size=[59.27, 15, 8] round=3.0 center=да
мбал_1 = rotate [мбал_1] angle=90 axis=x
мбал_1 = rotate [мбал_1] angle=108.43 axis=y
мбал_1 = translate [мбал_1] offset=[121.00, -16, 345.00]
мбал_2 = box size=[59.27, 15, 8] round=3.0 center=да
мбал_2 = rotate [мбал_2] angle=90 axis=x
мбал_2 = rotate [мбал_2] angle=108.43 axis=y
мбал_2 = translate [мбал_2] offset=[107.00, -16, 303.00]
босс_бар = cylinder radius=17 height=8 segments=40 center=да
босс_бар = rotate [босс_бар] angle=90 axis=x
босс_бар = translate [босс_бар] offset=[-87.81, -16, 280.70]
босс_мин = cylinder radius=16 height=8 segments=40 center=да
босс_мин = rotate [босс_мин] angle=90 axis=x
босс_мин = translate [босс_мин] offset=[0.00, -16, 230.00]
босс_инт = cylinder radius=15 height=8 segments=40 center=да
босс_инт = rotate [босс_инт] angle=90 axis=x
босс_инт = translate [босс_инт] offset=[29.35, -16, 149.37]
босс_сек = cylinder radius=14 height=8 segments=40 center=да
босс_сек = rotate [босс_сек] angle=90 axis=x
босс_сек = translate [босс_сек] offset=[101.67, -16, 120.16]
босс_эск = cylinder radius=13 height=8 segments=40 center=да
босс_эск = rotate [босс_эск] angle=90 axis=x
босс_эск = translate [босс_эск] offset=[144.17, -16, 158.43]
босс_анк = cylinder radius=11 height=8 segments=40 center=да
босс_анк = rotate [босс_анк] angle=90 axis=x
босс_анк = translate [босс_анк] offset=[130.04, -16, 197.98]
босс_бал = cylinder radius=17 height=8 segments=40 center=да
босс_бал = rotate [босс_бал] angle=90 axis=x
босс_бал = translate [босс_бал] offset=[100.00, -16, 282.00]
мостик_колёс = union [мк_1, мк_2, мк_3, мк_4, мк_5, мк_6, манк_1, босс_мин, босс_инт, босс_сек, босс_эск, босс_анк]
мостик_барабана = union [мбар_1, мбар_2, мбар_3, мбар_4, босс_бар]
мостик_баланса = union [мбал_1, мбал_2, босс_бал]

# ---------- КОЛЁСА (m = 2, ось Y) ----------
барабан = gear teeth=48 module=2.6 thickness=14 bore=8
барабан = rotate [барабан] angle=90 axis=x
барабан = translate [барабан] offset=[-87.81, 0, 280.70]
барабан_стенка = cylinder radius=44 height=18 segments=96 center=да
барабан_стенка = rotate [барабан_стенка] angle=90 axis=x
барабан_стенка = translate [барабан_стенка] offset=[-87.81, 0, 280.70]
барабан_крышка = cylinder radius=40 height=3 segments=96 center=да
барабан_крышка = rotate [барабан_крышка] angle=90 axis=x
барабан_крышка = translate [барабан_крышка] offset=[-87.81, -10.5, 280.70]
ось_барабана = cylinder radius=4 height=36 segments=24 center=да
ось_барабана = rotate [ось_барабана] angle=90 axis=x
ось_барабана = translate [ось_барабана] offset=[-87.81, -4, 280.70]
храповик = gear teeth=26 module=1.6 thickness=3.5 bore=9
храповик = rotate [храповик] angle=90 axis=x
храповик = translate [храповик] offset=[-87.81, -24, 280.70]
храповик_втулка = cylinder radius=9 height=12 segments=32 center=да
храповик_втулка = rotate [храповик_втулка] angle=90 axis=x
храповик_втулка = translate [храповик_втулка] offset=[-87.81, -24, 280.70]
минутное = gear teeth=30 module=2.6 thickness=10 bore=6 hub=14
минутное = rotate [минутное] angle=90 axis=x
минутное = translate [минутное] offset=[0.00, 0, 230.00]
ось_минутного = cylinder radius=3.5 height=36 segments=24 center=да
ось_минутного = rotate [ось_минутного] angle=90 axis=x
ось_минутного = translate [ось_минутного] offset=[0.00, -4, 230.00]
часовое = gear teeth=60 module=1.4 thickness=2.5 bore=14
часовое = rotate [часовое] angle=90 axis=x
часовое = translate [часовое] offset=[0.00, -11, 230.00]
трубка_часовая = cylinder radius=9 height=5 segments=32 center=да
трубка_часовая = rotate [трубка_часовая] angle=90 axis=x
трубка_часовая = translate [трубка_часовая] offset=[0.00, -9, 230.00]
промежуточное = gear teeth=36 module=2.6 thickness=8 bore=5 hub=12
промежуточное = rotate [промежуточное] angle=90 axis=x
промежуточное = translate [промежуточное] offset=[29.35, 0, 149.37]
ось_промежуточного = cylinder radius=3 height=36 segments=24 center=да
ось_промежуточного = rotate [ось_промежуточного] angle=90 axis=x
ось_промежуточного = translate [ось_промежуточного] offset=[29.35, -4, 149.37]
секундное = gear teeth=24 module=2.6 thickness=8 bore=5
секундное = rotate [секундное] angle=90 axis=x
секундное = translate [секундное] offset=[101.67, 0, 120.16]
ось_секундного = cylinder radius=3 height=36 segments=24 center=да
ось_секундного = rotate [ось_секундного] angle=90 axis=x
ось_секундного = translate [ось_секундного] offset=[101.67, -4, 120.16]
анкерное = gear teeth=20 module=2.6 thickness=6 bore=4
анкерное = rotate [анкерное] angle=90 axis=x
анкерное = translate [анкерное] offset=[144.17, 0, 158.43]
ось_анкерного = cylinder radius=2.5 height=36 segments=24 center=да
ось_анкерного = rotate [ось_анкерного] angle=90 axis=x
ось_анкерного = translate [ось_анкерного] offset=[144.17, -4, 158.43]

# ---------- МОТОР ЗАВОДА: фланец привинчен к мостику барабана ----------
мотор_шестерня = gear teeth=12 module=2.6 thickness=8 bore=5
мотор_шестерня = rotate [мотор_шестерня] angle=90 axis=x
мотор_шестерня = translate [мотор_шестерня] offset=[-101.36, 0, 357.52]
мотор_вал = cylinder radius=4.5 height=30 segments=32 center=да
мотор_вал = rotate [мотор_вал] angle=90 axis=x
мотор_вал = translate [мотор_вал] offset=[-101.36, -9, 357.52]
мотор_фланец = cylinder radius=23 height=2.6 segments=56 center=да
мотор_фланец = rotate [мотор_фланец] angle=90 axis=x
мотор_фланец = translate [мотор_фланец] offset=[-101.36, -21.2, 357.52]
мотор_корпус = cylinder radius=19 height=20 segments=64 center=да
мотор_корпус = rotate [мотор_корпус] angle=90 axis=x
мотор_корпус = translate [мотор_корпус] offset=[-101.36, -33, 357.52]
мотор_торец = cylinder radius=16 height=8 segments=64 center=да
мотор_торец = rotate [мотор_торец] angle=90 axis=x
мотор_торец = translate [мотор_торец] offset=[-101.36, -44, 357.52]

# ---------- БАЛАНС, ВОЛОСОК, ВИЛКА ----------
баланс_обод = torus major=52 minor=5 segments=96 minor_segments=16 at=[0, 0, 0]
спица_1 = box size=[104, 5, 7] round=2 center=да at=[0, 0, 0]
спица_2 = box size=[104, 5, 7] round=2 center=да at=[0, 0, 0]
спица_2 = rotate [спица_2] angle=60 axis=z
спица_3 = box size=[104, 5, 7] round=2 center=да at=[0, 0, 0]
спица_3 = rotate [спица_3] angle=120 axis=z
баланс_втулка = cylinder radius=10 height=14 segments=32 center=да
баланс_втулка = rotate [баланс_втулка] angle=90 axis=x
баланс = union [баланс_обод, спица_1, спица_2, спица_3, баланс_втулка]
баланс = rotate [баланс] angle=90 axis=x
баланс = translate [баланс] offset=[100.00, 0, 282.00]
ось_баланса = cylinder radius=3 height=36 segments=24 center=да
ось_баланса = rotate [ось_баланса] angle=90 axis=x
ось_баланса = translate [ось_баланса] offset=[100.00, -4, 282.00]
волосок = spring diameter=42 wire=1.4 turns=5 pitch=1.5
волосок = rotate [волосок] angle=90 axis=x
волосок = translate [волосок] offset=[100.00, -12, 282.00]
# вилка: короткое плечо с камнями к анкерному колесу, длинный рог к балансу
вилка_плечо = box size=[24.00, 9, 6] round=2 center=да
вилка_плечо = rotate [вилка_плечо] angle=90 axis=x
вилка_плечо = rotate [вилка_плечо] angle=70.33 axis=y
вилка_плечо = translate [вилка_плечо] offset=[132.56, 0, 190.92]
вилка_рог = box size=[50.00, 8, 6] round=2 center=да
вилка_рог = rotate [вилка_рог] angle=90 axis=x
вилка_рог = rotate [вилка_рог] angle=-109.67 axis=y
вилка_рог = translate [вилка_рог] offset=[122.97, 0, 217.75]
вилка_втулка = cylinder radius=7 height=8 segments=32 center=да
вилка_втулка = rotate [вилка_втулка] angle=90 axis=x
вилка_втулка = translate [вилка_втулка] offset=[130.04, 0, 197.98]
вилка_ось = cylinder radius=2.5 height=36 segments=24 center=да
вилка_ось = rotate [вилка_ось] angle=90 axis=x
вилка_ось = translate [вилка_ось] offset=[130.04, -4, 197.98]
вилка = union [вилка_плечо, вилка_рог, вилка_втулка]

# ---------- СТРЕЛКИ 10 : 10 : 35 ----------
трубка_центральная = cylinder radius=6.5 height=56 segments=32 center=да
трубка_центральная = rotate [трубка_центральная] angle=90 axis=x
трубка_центральная = translate [трубка_центральная] offset=[0, -20, 230]
часовая = box size=[16, 6, 118] round=3 center=да at=[0, 0, 59]
часовая = rotate [часовая] angle=305 axis=y pivot=[0, 0, 0]
часовая = translate [часовая] offset=[0, -35, 230]
минутная = box size=[11, 5, 162] round=2.4 center=да at=[0, 0, 81]
минутная = rotate [минутная] angle=60 axis=y pivot=[0, 0, 0]
минутная = translate [минутная] offset=[0, -41, 230]
секундная = box size=[5, 4, 186] round=2 center=да at=[0, 0, 82]
секундная = rotate [секундная] angle=210 axis=y pivot=[0, 0, 0]
секундная = translate [секундная] offset=[0, -47, 230]
противовес = cylinder radius=10 height=4 segments=32 center=да
противовес = rotate [противовес] angle=90 axis=x
противовес = translate [противовес] offset=[0, -47, 214]

# ---------- МЕТКИ НА ВНУТРЕННЕМ КОЛЬЦЕ КОРПУСА ----------
метка = box size=[7, 32, 6] round=2 center=да at=[0, 196, 0]
метки = array [метка] count=12 mode=radial around=z
метки = rotate [метки] angle=90 axis=x
метки = translate [метки] offset=[0, -44, 230]

# ---------- ГРАВИРОВКА НА ПЛАТЕ ----------
клеймо = text "FORMA" size=17 depth=2 weight=1.6 align=center plane=xz at=[0, 0, 0]
клеймо = translate [клеймо] offset=[0, 11.5, 62]

# ---------- КАМНИ И ВИНТЫ ----------
камень_бар = cylinder radius=6.5 height=2.4 segments=32 center=да
камень_бар = rotate [камень_бар] angle=90 axis=x
камень_бар = translate [камень_бар] offset=[-87.81, -21.2, 280.70]
камень_мин = cylinder radius=6.5 height=2.4 segments=32 center=да
камень_мин = rotate [камень_мин] angle=90 axis=x
камень_мин = translate [камень_мин] offset=[0.00, -21.2, 230.00]
камень_инт = cylinder radius=6.5 height=2.4 segments=32 center=да
камень_инт = rotate [камень_инт] angle=90 axis=x
камень_инт = translate [камень_инт] offset=[29.35, -21.2, 149.37]
камень_сек = cylinder radius=6.5 height=2.4 segments=32 center=да
камень_сек = rotate [камень_сек] angle=90 axis=x
камень_сек = translate [камень_сек] offset=[101.67, -21.2, 120.16]
камень_эск = cylinder radius=6.5 height=2.4 segments=32 center=да
камень_эск = rotate [камень_эск] angle=90 axis=x
камень_эск = translate [камень_эск] offset=[144.17, -21.2, 158.43]
камень_анк = cylinder radius=6.5 height=2.4 segments=32 center=да
