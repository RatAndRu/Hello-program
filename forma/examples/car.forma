кузов = loft sections=[с1, с2, с3, с4, с5, с6, с7, с8, с9, с10, с11, с12] positions=[-2100, -1750, -1300, -950, -700, -350, 150, 700, 1150, 1600, 2000, 2150] axis=x smooth=4 profile_smooth=3

# --- окна: вырезаем полосу по периметру кабины и вставляем тёмное стекло ---
зона_стекла = box size=[1560,2000,230] round=40 at=[-250,0,950]
стекло = intersect [кузов, зона_стекла]
кузов = difference [кузов, стекло]
color стекло #16222f metal=0.75 rough=0.12
color кузов #b8332f metal=0.45 rough=0.25

# --- колёсные арки ---
арка = cylinder radius=395 height=1700 segments=64 at=[0,0,-850]
арка = rotate [арка] angle=90 axis=x
арка = place [арка] at=[-1350,0,330] align=center
арки = array [арка] count=2 mode=linear offset=[2700,0,0]
кузов = difference [кузов, арки]

# --- колёса ---
шина = cylinder radius=330 height=250 segments=72 round=45 at=[0,0,-125]
шина = rotate [шина] angle=90 axis=x
шина = place [шина] at=[-1350,0,330] align=center
шины = array [шина] count=2 mode=linear offset=[2700,0,0]
color шины #1b1d21 material=rubber

диск = cylinder radius=205 height=255 segments=48 round=12 at=[0,0,-127]
диск = rotate [диск] angle=90 axis=x
диск = place [диск] at=[-1350,0,330] align=center
диски = array [диск] count=2 mode=linear offset=[2700,0,0]
color диски #c3cad4 material=steel

# --- фары и фонари ---
фара = sphere radius=95 at=[-2060,-480,545]
фара = scale [фара] factor=[0.45,1.0,0.75]
фары = array [фара] count=2 mode=linear offset=[0,960,0]
color фары #fff4d4 metal=0.3 rough=0.08
фонарь = box size=[60,360,90] round=28 at=[2120,-520,585]
фонари = array [фонарь] count=2 mode=linear offset=[0,1040,0]
color фонари #a8201c metal=0.3 rough=0.15

check кузов watertight
check кузов width 4150..4300
check кузов depth 1780..1860
check кузов height 1130..1180
check кузов parts 1
check стекло watertight
check шина watertight
check шина height 660..690
check шины parts 2
