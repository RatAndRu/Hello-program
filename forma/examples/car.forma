кузов = loft sections=сечения positions=[-2200, -2050, -1800, -1450, -1100, -850, -700, -560, -420, -300, -150, 0, 150, 300, 420, 560, 700, 850, 1100, 1450, 1800, 2050, 2200] axis=x smooth=4 profile_smooth=2

арка1 = cylinder radius=440 height=330 segments=72
арка1 = rotate [арка1] angle=90 axis=x
арка1 = place [арка1] at=[-1400,-745,335] align=center
кузов = difference [кузов, арка1]
арка2 = cylinder radius=440 height=330 segments=72
арка2 = rotate [арка2] angle=90 axis=x
арка2 = place [арка2] at=[-1400,745,335] align=center
кузов = difference [кузов, арка2]
арка3 = cylinder radius=440 height=330 segments=72
арка3 = rotate [арка3] angle=90 axis=x
арка3 = place [арка3] at=[1400,-745,335] align=center
кузов = difference [кузов, арка3]
арка4 = cylinder radius=440 height=330 segments=72
арка4 = rotate [арка4] angle=90 axis=x
арка4 = place [арка4] at=[1400,745,335] align=center
кузов = difference [кузов, арка4]

# --- остекление: три зоны, вырезанные прямо из кузова и чуть увеличенные ---
зона1 = box size=[1500,4000,520]
зона1 = place [зона1] at=[-60,0,940]
с1 = intersect [кузов, зона1]
зона2 = box size=[520,4000,600]
зона2 = rotate [зона2] angle=27 axis=y
зона2 = place [зона2] at=[-880,0,840]
с2 = intersect [кузов, зона2]
зона3 = box size=[520,4000,600]
зона3 = rotate [зона3] angle=-27 axis=y
зона3 = place [зона3] at=[760,0,840]
с3 = intersect [кузов, зона3]
стекло = union [с1, с2, с3]
стекло = scale [стекло] factor=[1.003,1.005,1.003]
show кузов
color стекло #121b26 metal=0.75 rough=0.06
color кузов #b8332f metal=0.45 rough=0.2

# --- швы дверей и капота: неглубокие канавки ---
