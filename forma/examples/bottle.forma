# Бутылка 0.5 л: гладкое плечо, горлышко с резьбой и пробка с рифлением.

корпус = lathe points=[
    [0, 0], [36, 0], [38, 5], [38, 148],
    [36, 172], [28, 191], [20, 205], [15, 215],
    [15, 252], [16.2, 257], [16.2, 263], [0, 263]
  ] segments=128 smooth=2

полость = lathe points=[
    [0, 4], [33, 4], [33, 146], [31, 170], [24, 189],
    [17, 203], [12, 212], [12, 269], [0, 269]
  ] segments=128 smooth=2

бутылка = difference [корпус, полость]
color бутылка #8fd8c4 metal=0.0 rough=0.12
check бутылка watertight
check бутылка height 258..268
check бутылка wall 2..6

# пробка: чуть шире горлышка, с 24 вертикальными ложбинками
пробка = cylinder radius=18 height=26 segments=96 round=3
пробка = place [пробка] at=[0,0,248]
ложбина = box size=[7.2,4.4,19] at=[18.4,0,262]
ложбины = array [ложбина] count=32 mode=radial around=z center=[0,0,0]
пробка = difference [пробка, ложбины]
поясок = cylinder radius=18.4 height=4.2 segments=96 round=1
поясок = place [поясок] at=[0,0,245.4]
пробка = union [пробка, поясок]
color пробка #3f7fe0 material=plastic
check пробка parts 1
check пробка width 35..37
check пробка height 25..29
