# ============================================================================
#  ГРАДАЦИЯ — ряд, в котором каждая следующая деталь изменена сильнее
# ----------------------------------------------------------------------------
#  Обычный массив повторяет одно и то же через равное расстояние. `ряд`
#  делает другое: он копит изменение. Здесь шесть одинаковых брусков, но
#  каждый следующий закручен на 35% сильнее предыдущего — сила инструмента
#  идёт ступенями: 20°, 27°, 36°, 49°, 66°, 90°.
#
#  Расстояние между брусками задано не в миллиметрах, а меркой:
#  step=[1.35*26,0,0] — 1.35 ширины бруска. Так же можно писать
#  0.5*length(плита), 2*height(ящик) и любые другие мерки.
#
#  Что попробовать: шаг_силы=1.6 — крутка растёт быстрее; grow=1.15 —
#  бруски ещё и подрастают; инструмент=сужение — вместо крутки сужение.
# ============================================================================

брусок = box size=[26,26,90] round=2
брусок = refine [брусок] length=9

бруски = ряд [брусок] count=6 step=[1.35*26,0,0] инструмент=скрутка сила=20 шаг_силы=1.35 axis=z

# плита под рядом: её размер задан мерками от самого ряда
плита = box size=[10,40,6] round=1
плита = размер [плита] width=1.06*width(бруски) depth=1.4*depth(бруски) height=6
плита = place [плита] on=бруски side=bottom offset=0

color бруски color=#cfd6e2 metal=0.15
color плита color=#8a94a6 rough=0.6
