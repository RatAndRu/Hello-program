# Мебельная фурнитура — монтажный стенд
# Все размеры в миллиметрах. Фасады 18 мм, зазор 4 мм.
# Плоскости установки выбраны явно: фасад смотрит в −Y, детали на столе — в +Z.
# Проект намеренно не объединён в один solid: каждая деталь остаётся editable/exportable.

# ---------- Общее основание ----------
основа = box size=[1120,680,24] round=10 at=[0,0,0]
разделитель = box size=[2,560,0.8] round=0.3 at=[125,5,24]

# ---------- Два фасада и узкая дверца ----------
корпус = box size=[680,40,400] round=3 at=[-220,102,24]
фасад_низ = box size=[420,18,160] round=1.2 at=[-350,72,60]
фасад_верх = box size=[420,18,160] round=1.2 at=[-350,72,224]
дверца = box size=[240,18,324] round=1.2 at=[-10,72,60]

# Ручка 192: length=202 и diameter=10 дают межосевое 202−10=192 мм.
ручка_192 = handle length=202 height=34 diameter=10 bar_shape=цилиндр post_shape=цилиндр plates=да plate_d=22 segments=48
ручка_192 = rotate [ручка_192] angle=90 axis=x
ручка_192 = translate [ручка_192] offset=[-350,63,304]

# Ручка 128: length=138 и diameter=10 дают межосевое 138−10=128 мм.
ручка_128 = handle length=138 height=30 diameter=10 bar_shape=цилиндр post_shape=цилиндр plates=да plate_d=22 segments=48
ручка_128 = rotate [ручка_128] angle=90 axis=x
ручка_128 = translate [ручка_128] offset=[-350,63,140]

# Сквозные отверстия Ø4.4 под стяжки ручек. Оси строго по Y.
отв_192_а = cylinder radius=2.2 height=28 segments=24
отв_192_а = rotate [отв_192_а] angle=90 axis=x
отв_192_а = translate [отв_192_а] offset=[-446,86,304]
отв_192_б = cylinder radius=2.2 height=28 segments=24
отв_192_б = rotate [отв_192_б] angle=90 axis=x
отв_192_б = translate [отв_192_б] offset=[-254,86,304]
зенковка_192_а = cylinder radius=2.2 r2=4.6 height=2.4 segments=56
зенковка_192_а = rotate [зенковка_192_а] angle=-90 axis=x
зенковка_192_а = translate [зенковка_192_а] offset=[-446,78.7,304]
зенковка_192_б = cylinder radius=2.2 r2=4.6 height=2.4 segments=56
зенковка_192_б = rotate [зенковка_192_б] angle=-90 axis=x
зенковка_192_б = translate [зенковка_192_б] offset=[-254,78.7,304]
фасад_верх = difference [фасад_верх, отв_192_а, отв_192_б, зенковка_192_а, зенковка_192_б]

отв_128_а = cylinder radius=2.2 height=28 segments=24
отв_128_а = rotate [отв_128_а] angle=90 axis=x
отв_128_а = translate [отв_128_а] offset=[-414,86,140]
отв_128_б = cylinder radius=2.2 height=28 segments=24
отв_128_б = rotate [отв_128_б] angle=90 axis=x
отв_128_б = translate [отв_128_б] offset=[-286,86,140]
зенковка_128_а = cylinder radius=2.2 r2=4.6 height=2.4 segments=56
зенковка_128_а = rotate [зенковка_128_а] angle=-90 axis=x
зенковка_128_а = translate [зенковка_128_а] offset=[-414,78.7,140]
зенковка_128_б = cylinder radius=2.2 r2=4.6 height=2.4 segments=56
зенковка_128_б = rotate [зенковка_128_б] angle=-90 axis=x
зенковка_128_б = translate [зенковка_128_б] offset=[-286,78.7,140]
фасад_низ = difference [фасад_низ, отв_128_а, отв_128_б, зенковка_128_а, зенковка_128_б]

# Кнопка — единый токарный профиль: розетка, ножка и округлая грибовидная головка.
кнопка = lathe points=[[0,0],[15,0],[15,2],[12,3],[6,3],[6,8],[8,9],[13,11],[16,15],[16,19],[14,23],[9,26],[0,27]] segments=64 fillet=0.7
кнопка = rotate [кнопка] angle=90 axis=x
кнопка = translate [кнопка] offset=[55,63,222]
отв_кнопки = cylinder radius=2.2 height=28 segments=24
отв_кнопки = rotate [отв_кнопки] angle=90 axis=x
отв_кнопки = translate [отв_кнопки] offset=[55,86,222]
зенковка_кнопки = cylinder radius=2.2 r2=4.6 height=2.4 segments=56
зенковка_кнопки = rotate [зенковка_кнопки] angle=-90 axis=x
зенковка_кнопки = translate [зенковка_кнопки] offset=[55,78.7,222]
дверца = difference [дверца, отв_кнопки, зенковка_кнопки]

# Обратная сторона: потайные головки приходят заподлицо с Y=81;
# конические зенковки в плитах повторяют угол головок, а не оставляют перекрытие.
# Резьба внутри фасадов скрыта, поэтому installed-стяжки без лишних витков.
стяжка_192_а = screw d=4 length=26 head=потай drive=крест thread=нет tip=1
стяжка_192_а = rotate [стяжка_192_а] angle=-90 axis=x
стяжка_192_а = translate [стяжка_192_а] offset=[-446,55,304]
стяжка_192_б = screw d=4 length=26 head=потай drive=крест thread=нет tip=1
стяжка_192_б = rotate [стяжка_192_б] angle=-90 axis=x
стяжка_192_б = translate [стяжка_192_б] offset=[-254,55,304]
стяжка_128_а = screw d=4 length=26 head=потай drive=крест thread=нет tip=1
стяжка_128_а = rotate [стяжка_128_а] angle=-90 axis=x
стяжка_128_а = translate [стяжка_128_а] offset=[-414,55,140]
стяжка_128_б = screw d=4 length=26 head=потай drive=крест thread=нет tip=1
стяжка_128_б = rotate [стяжка_128_б] angle=-90 axis=x
стяжка_128_б = translate [стяжка_128_б] offset=[-286,55,140]
стяжка_кнопки = screw d=4 length=26 head=потай drive=крест thread=нет tip=1
стяжка_кнопки = rotate [стяжка_кнопки] angle=-90 axis=x
стяжка_кнопки = translate [стяжка_кнопки] offset=[55,55,222]

# ---------- Столешница 18 мм и кабельный люверс Ø60 ----------
столешница = box size=[340,250,18] round=2 at=[330,125,24]
отв_люверса = cylinder radius=32.2 height=22 segments=64 at=[290,125,22]
столешница = difference [столешница, отв_люверса]
# Втулка занимает 18 мм плиты; вогнутый фланец начинается строго на её верхней плоскости.
люверс = grommet diameter=60 height=22 transition_h=4 wall=2 flange=5 transition=вогнутая fill=нет segments=64 at=[290,125,24]
крышка_люверса = cylinder radius=30 height=3 segments=64 round=0.7 at=[420,125,42]
прорезь_крышки = box size=[14,4,5] center=да at=[420,125,43.5]
крышка_люверса = difference [крышка_люверса, прорезь_крышки]

# ---------- Эксцентриковая стяжка Ø15 ----------
# Накатка и канал являются геометрией, а не текстурой.
эксцентрик = cylinder radius=7.5 height=12 segments=64 round=0.4
эксцентрик = knurl [эксцентрик] count=24 depth=0.22 width=0.45 axis=z
канал_эксцентрика = torus_sector major=5.6 minor=2 angle=120 hole=0 start=20 segments=64
канал_эксцентрика = translate [канал_эксцентрика] offset=[0,0,5.5]
вход_эксцентрика = box size=[9,5,3] center=да at=[4,0,5.5]
посадка_эксцентрика = cylinder radius=2.6 height=8.5 segments=40 at=[0,0,-0.5]
шлиц_эксцентрика_а = box size=[6,1.4,3] center=да at=[1,0,11.5]
шлиц_эксцентрика_б = box size=[1.4,6,3] center=да at=[1,0,11.5]
эксцентрик = difference [эксцентрик, канал_эксцентрика, вход_эксцентрика, посадка_эксцентрика, шлиц_эксцентрика_а, шлиц_эксцентрика_б]
эксцентрик = translate [эксцентрик] offset=[180,-60,24]

# Винт M6, шайба и гайка — отдельные детали с настоящей резьбой.
винт_м6 = bolt d=6 length=36 pitch=1.25 s=10 head=4
винт_м6 = rotate [винт_м6] angle=90 axis=y
винт_м6 = translate [винт_м6] offset=[225,-60,30]
шайба_м6 = washer outer=16 inner=6.4 thickness=1.5 segments=48 at=[285,-60,24]
гайка_м6 = nut d=6 h=5 s=10 pitch=1.25 thread=да at=[315,-60,24]

# ---------- Крепёжный уголок 2 мм ----------
уголок = bracket width=80 depth=50 height=50 thickness=2 angle=90 holes=2 round=2 corner=заполненный smooth=0 at=[420,-60,24]

# ---------- Confirmat 7×50 и шкант Ø8×30 ----------
конфирмат = screw d=7 length=50 head=полукруг head_d=13 head_h=2.6 drive=шестигранник drive_size=4 drive_depth=1.6 pitch=3 tip=0.5 thread=да
# Сердечник Ø5.2 закрывает микропустоты между витками; наружная резьба Ø7 неизменна.
сердечник_конфирмата = cylinder radius=2.6 height=49.5 segments=56 at=[0,0,0.5]
конфирмат = union [конфирмат, сердечник_конфирмата]
конфирмат = rotate [конфирмат] angle=90 axis=y
конфирмат = translate [конфирмат] offset=[275,-190,30.5]

шкант = cylinder radius=4 height=30 segments=40 round=0.7
шкант = knurl [шкант] count=12 depth=0.3 width=0.45 axis=z
шкант = rotate [шкант] angle=90 axis=y
шкант = translate [шкант] offset=[85,-190,28]

# ---------- Два полкодержателя Ø5 ----------
полкодержатель = cylinder radius=2.5 height=18 segments=32
бурт_полкодержателя = cylinder radius=4 height=2 segments=40 at=[0,0,12]
площадка_полкодержателя = box size=[12,8,2] round=0.7 center=да at=[0,0,15]
полкодержатель = union [полкодержатель, бурт_полкодержателя, площадка_полкодержателя]
полкодержатель = rotate [полкодержатель] angle=90 axis=y
полкодержатель = translate [полкодержатель] offset=[430,-190,30]
полкодержатели = array [полкодержатель] count=2 mode=linear offset=[50,0,0]

# ---------- Подписи на основании ----------
заголовок = text "МЕБЕЛЬНАЯ ФУРНИТУРА" size=22 depth=0.7 weight=1.1 align=center plane=xy at=[-250,-285,24]
подзаголовок = text "МОНТАЖНЫЙ СТЕНД  /  ПЛИТА 18 ММ" size=10 depth=0.6 weight=1 align=center plane=xy at=[-250,-315,24]
подпись_эксцентрика = text "ЭКСЦЕНТРИК Ø15" size=11 depth=0.6 weight=1 align=center plane=xy at=[180,-105,24]
подпись_м6 = text "M6 × 36" size=11 depth=0.6 weight=1 align=center plane=xy at=[275,-105,24]
подпись_уголка = text "УГОЛОК 2 ММ" size=11 depth=0.6 weight=1 align=center plane=xy at=[420,-125,24]
подпись_шканта = text "Ø8 × 30" size=12 depth=0.6 weight=1 align=center plane=xy at=[100,-225,24]
подпись_конфирмата = text "CONFIRMAT 7 × 50" size=12 depth=0.6 weight=1 align=center plane=xy at=[305,-230,24]
подпись_полкодержателей = text "ПОЛКА  /  Ø5" size=11 depth=0.6 weight=1 align=center plane=xy at=[465,-230,24]
подпись_люверса = text "КАБЕЛЬ  Ø60" size=12 depth=0.6 weight=1 align=center plane=xy at=[330,-20,24]

# ---------- Материалы ----------
color основа #11161c rough=0.58 metal=0.15
color разделитель #b79152 rough=0.3 metal=0.8
color корпус #20262d rough=0.55 metal=0.15
color фасад_низ #d0aa78 rough=0.48
color фасад_верх #d0aa78 rough=0.48
color дверца #d0aa78 rough=0.48
texture фасад_низ kind=дерево scale=0.75 seed=31 uv=auto
texture фасад_верх kind=дерево scale=0.75 seed=32 uv=auto
texture дверца kind=дерево scale=0.75 seed=33 uv=auto
color ручка_192 #b8bec5 rough=0.24 metal=0.92
color ручка_128 #b8bec5 rough=0.24 metal=0.92
color кнопка #c3a061 rough=0.24 metal=0.88
color стяжка_192_а #8f979f rough=0.3 metal=0.9
color стяжка_192_б #8f979f rough=0.3 metal=0.9
color стяжка_128_а #8f979f rough=0.3 metal=0.9
color стяжка_128_б #8f979f rough=0.3 metal=0.9
color стяжка_кнопки #8f979f rough=0.3 metal=0.9
color столешница #d8c7aa rough=0.5
texture столешница kind=дерево scale=0.65 seed=34 uv=auto
color люверс #b8bec5 rough=0.27 metal=0.9
color крышка_люверса #b8bec5 rough=0.27 metal=0.9
color эксцентрик #aeb6bf rough=0.28 metal=0.9
color винт_м6 #c2a263 rough=0.27 metal=0.88
color шайба_м6 #b9c0c7 rough=0.26 metal=0.92
color гайка_м6 #b9c0c7 rough=0.26 metal=0.92
color уголок #9ea7b1 rough=0.32 metal=0.9
color конфирмат #c2a263 rough=0.3 metal=0.86
color шкант #c99b61 rough=0.62
texture шкант kind=дерево scale=0.35 seed=35 uv=auto
color полкодержатели #bdc4cb rough=0.24 metal=0.92
color заголовок #d6d9dc rough=0.5 metal=0.15
color подзаголовок #9da6af rough=0.55 metal=0.1
color подпись_эксцентрика #b8c0c8 rough=0.55
color подпись_м6 #b8c0c8 rough=0.55
color подпись_уголка #b8c0c8 rough=0.55
color подпись_шканта #b8c0c8 rough=0.55
color подпись_конфирмата #b8c0c8 rough=0.55
color подпись_полкодержателей #b8c0c8 rough=0.55
color подпись_люверса #b8c0c8 rough=0.55

# ---------- Геометрическая приёмка самого проекта ----------
check фасад_верх parts 1
check фасад_верх genus 2
check фасад_верх watertight
check фасад_низ parts 1
check фасад_низ genus 2
check фасад_низ watertight
check дверца parts 1
check дверца genus 1
check дверца watertight
check ручка_192 parts 1
check ручка_128 parts 1
check кнопка parts 1
check столешница parts 1
check столешница genus 1
check столешница watertight
check люверс parts 1
check люверс genus 1
check крышка_люверса parts 1
check эксцентрик parts 1
check эксцентрик watertight
check эксцентрик genus 1
check конфирмат parts 1
check конфирмат watertight
check конфирмат genus 0
check шкант parts 1
check шкант watertight
check полкодержатели parts 2
check уголок parts 1
check уголок genus 4
check уголок watertight
