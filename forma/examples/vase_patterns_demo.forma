# Форма 3D 0.76.5 — пример росписи одной вазы.
# Вдохновлён вазой с цветными геометрическими поясами, но это НЕ копия фото:
# здесь ромбы и круги вместо точного греческого меандра.
# Отдельный PNG не нужен: профиль, цвета и узоры заданы прямо в сценарии.
# Единицы — миллиметры, +Z вверх. Роспись не добавляет физического рельефа.

ваза = lathe points=[
  [0,0], [32,0], [36,2], [36,8], [44,13], [55,20],
  [66,30], [74,42], [79,55], [80,67], [78,79],
  [73,90], [67,101], [58,112], [50,120], [45,127],
  [43,134], [45,141], [49,146], [55,150], [57,152],
  [56,154], [52,155], [48,154], [45,151], [41,145],
  [38,138], [39,130], [44,122], [52,114], [60,104],
  [67,93], [72,81], [74,68], [73,56], [69,45],
  [62,34], [52,25], [42,18], [31,12], [0,8]
] segments=96 smooth=12

# Базовая матовая керамика. Полосы — отдельные команды и легко меняются.
color ваза #f3eee2 material=ceramic rough=0.65
paint ваза #174a3c height=54..78
paint ваза #27252a height=82..101
paint ваза #ba4c58 height=105..121

# Узор условный, а не восстановление рисунка с одной фотографии.
# Сетка задана плотным профилем без дополнительного дробления.
# При меньшем size команда paint может сама увеличить число треугольников.
paint ваза #e96975 shape=ромбы size=15 step=24 height=57..76
paint ваза #f5f0e7 shape=круги size=14 step=22 height=84..99
paint ваза #29272a shape=ромбы size=14 step=22 height=107..119

check ваза watertight
