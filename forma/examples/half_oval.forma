# Полуовал — пластина с прямой кромкой снизу и дугой сверху. Отверстие —
# параметр: hole=16 делает подвес, hole=0 — глухую накладку. Одна команда
# закрывает подпятник, шильдик, ушко, подвес для шнура.

подвес = полуовал width=90 height=55 thickness=8 hole=16
накладка = полуовал width=140 height=60 thickness=5 hole=0 at=[-160,0,0]
ушко = полуовал width=40 height=24 thickness=4 hole=10 at=[0,0,60]
подпятник = полуовал width=70 height=30 thickness=10 hole=0 at=[160,0,0]
шильдик = полуовал width=100 height=44 thickness=3 hole=0 at=[0,-90,0]

color подвес color=#cfd6e2 metal=0.3 rough=0.4
color накладка color=#b8c4d4 rough=0.7
color ушко color=#e0a33a metal=0.7 rough=0.3
color подпятник color=#3f4650 metal=0.5 rough=0.5
color шильдик color=#8a6ce0 metal=0.2 rough=0.6
