# Анатомическая фигура: пропорции, мышцы, кисти, стопы, лицо.
# Форма — математическое поле (SDF), поэтому её можно менять параметрами.
# Ось Z — вверх, размеры в миллиметрах.

рост = 1780
человек = human height=рост sex=м build=спортивный pose=a detail=средний hair=да eyes=да

# кожа и волосы — материалы, которые видны в окне и в Blender
color человек #e2b79b rough=0.58
color человек_волосы #33241b rough=0.42
color человек_глаза #f4f1ea rough=0.16
color человек_радужка #4a3423 rough=0.3

# свет и фон как в студии
scene bg=#10151c env=studio exposure=1.05
light preset=портрет strength=1.05

# презентационная анимация: вращение; сохраняется в GLB
animate kind=spin axis=z seconds=12 loop=да

# словесные проверки результата
check человек height 1770..1790
check человек watertight
check человек parts 1
