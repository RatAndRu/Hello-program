# Стандартные примитивы: четырнадцать тел первого ряда.
# Каждое — одна команда. Отсюда начинается почти любая модель:
# тело → объём → детали готовыми командами.
# Два ряда по семь: габариты видно сразу, можно сравнивать размеры.

# --- первый ряд: гранёное и тела вращения ---
лист = sheet width=60 length=90 thickness=2 at=[-330,0,0]
куб = box size=[50,50,50] at=[-220,0,0]
призма = prism sides=6 radius=28 height=60 at=[-110,0,0]
октаэдр = octa radius=26 height=66 at=[0,0,0]
пирамида = pyramid sides=4 radius=30 height=58 at=[110,0,0]
конус = cone radius=28 height=58 at=[220,0,0]
цилиндр = cylinder radius=24 height=58 at=[330,0,0]

# --- второй ряд: круглые и точёные ---
шар = sphere radius=30 at=[-330,150,32]
икосфера = icosphere radius=30 divisions=2 at=[-220,130,30]
эллипсоид = ellipsoid x=38 y=24 z=20 at=[-110,120,20]
капсула = capsule radius=16 height=58 at=[0,120,0]
тор = torus major=30 minor=11 at=[110,131,11]
кольцо = ring outer=54 inner=36 height=14 at=[220,120,0]
шайба = washer outer=50 inner=20 thickness=6 at=[330,120,0]

# Дальше эти имена можно звать как есть: `круг = кольцо`, `rotate шар …`.
