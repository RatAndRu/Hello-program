// Ваза: двумерный профиль, развёрнутый в тело.
//
// Это второе, что умеет OpenSCAD (первое — CSG): взять контур и «выдавить»
// его вращением. Профиль задан списком точек, отверстие получается само,
// потому что контур замкнут и не касается оси.
//
// В DSL ФОРМЫ аналог — команда `revolve points=[...]`; смысл тот же, меняется
// только запись.

h = 120;          // высота, мм
r_base = 26;      // радиус основания
r_neck = 14;      // радиус горла
wall = 2.4;       // толщина стенки
$fn = 96;         // сегментов по кругу

profile = [
    [0, 0],
    [r_base, 0],
    [r_base + 6, 40],
    [r_neck + 4, 90],
    [r_neck, h],
    [r_neck - wall, h],
    [r_neck - wall, 90],
    [r_base - wall + 4, 42],
    [r_base - wall, wall],
    [0, wall],
];

rotate_extrude(angle = 360) polygon(points = profile);
