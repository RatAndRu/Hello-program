// Кронштейн — пример на языке OpenSCAD.
//
// Идея та же, что в DSL ФОРМЫ: текстовый файл описывает тело, а программа
// считает геометрию. Но есть два отличия, которые видно прямо здесь:
//
// 1. OpenSCAD — настоящий язык программирования: переменные, модули,
//    функции, циклы, условия, списки. Здесь `for` рисует два отверстия,
//    а `offset(3) offset(-3)` скругляет углы (классический приём: сначала
//    расширить контур, потом сжать — острые углы превращаются в радиусы).
// 2. OpenSCAD ничего не сообщает о результате: ни объёма, ни массы, ни
//    толщины стенок. Чтобы узнать объём, модель надо отрендерить в STL и
//    посчитать сторонним инструментом (это делает compare.py в CI).

w = 80;          // ширина, мм
d = 60;          // глубина, мм
t = 6;           // толщина, мм
hole_d = 5;      // диаметр отверстий, мм
hole_inset = 12; // отступ отверстий от края, мм
corner = 3;      // радиус скругления углов
$fn = 64;        // число сегментов окружностей

module plate(w = 80, d = 60, t = 6, corner = 3) {
    // пластина со скруглёнными углами, центр — в начале координат
    linear_extrude(height = t)
        offset(r = corner) offset(r = -corner)
            square([w, d], center = true);
}

module bracket(w = 80, d = 60, t = 6, hole_d = 5, hole_inset = 12, corner = 3) {
    difference() {
        plate(w, d, t, corner);
        for (x = [-1, 1])
            translate([x * (w / 2 - hole_inset), 0, -1])
                cylinder(h = t + 2, d = hole_d);
    }
}

// Ставим деталь так, чтобы её центр совпал с началом координат:
// с этим же положением сравнивается вариант на DSL ФОРМЫ.
translate([0, 0, -t / 2]) bracket(w, d, t, hole_d, hole_inset, corner);

// Проверка, что параметры действительно параметры: раскомментируйте строку
// ниже и получите деталь в два раза толще — без правки геометрии.
// translate([0, 0, -t]) bracket(w, d, t * 2, hole_d, hole_inset, corner);
