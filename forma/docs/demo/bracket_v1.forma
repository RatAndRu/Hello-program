# Кронштейн по фото: первая версия, размеры в долях высоты детали (H = 100).
H = 100

# 1. стойка
стойка = cylinder radius=20 height=96 segments=96 at=[0,0,0]

# 2. паз через верх (окно 30 × 9, глубина 30)
паз = box size=[30,9,40] at=[0,0,96-30+20]
стойка = difference [стойка, паз]

# 3. бобышка сбоку (+X) и её отверстие по Y
бобышка = box size=[28,44,52] at=[34,0,0] round=3
бобышка = union [стойка, бобышка]
отверстие = cylinder radius=11 height=60 at=[34,0,30]
отверстие = rotate [отверстие] axis=x angle=90 pivot=[34,0,30]
бобышка = difference [бобышка, отверстие]

# 4. полка между стойкой и бобышкой
полка = box size=[56,36,6] at=[6,-4,34]
узел = union [бобышка, полка]

# 5. седло — половина трубы вдоль Y, с полостью
седло = скоба length=96 width=52 height=26 wall=3 shape=овал sides=3 open=вниз at=[0,0,0]
седло = rotate [седло] axis=z angle=90
седло = translate [седло] offset=[0,-14,0]
узел = union [узел, седло]

# 6. ребро жёсткости
ребро = tri_prism a=46 b=44 c=20 height=6
ребро = rotate [ребро] axis=x angle=90
ребро = translate [ребро] offset=[-34,8,0]
узел = union [узел, ребро]

color узел #9aa3ab
check узел watertight
