# Кронштейн по фото. Размеры в долях высоты (H = 100) — как в паспорте кадра:
# диаметр стойки 0.40·H, ось стойки смещена на +0.08·H вправо, полка на 0.33·H.
H = 100

# стойка: диаметр 40, высота 0.58·H, стоит на полке
стойка = cylinder radius=20 height=58 segments=96 at=[8,-2,33]
# верхняя кромка скруглена — это видно по блику на кромке
стойка = chamfer [стойка] width=1.2 edges=convex

# паз через верх: ширина 9, длина 30, глубина 27 (окно в стенке)
паз = box size=[30,9,40] at=[8,-2,58+33-27+20]
паз = rotate [паз] axis=z angle=18 pivot=[8,-2,50]
стойка = difference [стойка, паз]
паз_в_стенке = box size=[26,9,26] at=[8-13,4,33+40]
стойка = difference [стойка, паз_в_стенке]

# бобышка позади справа, отверстие по Y
бобышка = box size=[26,26,62] at=[24,4,28] round=4
бобышка = union [стойка, бобышка]
отверстие = cylinder radius=10 height=50 at=[24,4,57]
отверстие = rotate [отверстие] axis=x angle=90 pivot=[24,4,57]
бобышка = difference [бобышка, отверстие]

# полка — плита под стойкой, на 0.33·H
полка = box size=[44,30,5] at=[4,-2,29]
узел = union [бобышка, полка]

# седло: половина трубы вдоль Y, проёмом вниз, стенка 3
седло = скоба length=66 width=44 height=22 wall=3 shape=овал sides=3 open=вниз
седло = rotate [седло] axis=z angle=90 pivot=[0,0,0]
седло = translate [седло] offset=[-6,-2,14]
узел = union [узел, седло]

# ребро жёсткости от полки к стойке, по диагонали
ребро = tri_prism a=40 b=38 c=16 height=5
ребро = rotate [ребро] axis=y angle=-90 pivot=[0,0,0]
ребро = translate [ребро] offset=[8,12,0]
узел = union [узел, ребро]

color узел #9aa3ab
check узел watertight
