# Кронштейн по фотографии — компоновочная ревизия 15.
# Канон: верх +Z, перед -Y, право +X. Размеры в мм.
# По одному фото абсолютный масштаб и скрытая сторона неизвестны.

# Ось седла вдоль X: так расположены наружная поверхность и открытый торец на фото.
седло = arch radius=82.5810 width=10.8046 thickness=171.5700 angle=180 round=2 segments=128 at=[-38.7028,7.0646,0]
rotate [седло] angle=90 axis=z pivot=[-38.7028,7.0646,0]

босс = cylinder radius=63.6429 height=239.8382 at=[0,25,42] round=5 segments=128

# Правая D-проушина с осью канала X и поднятым нижним основанием.
правая_низ = box size=[47.8529,80.5633,136.9338] at=[68.1092,53.8007,48.7024]
правая_верх = cylinder radius=40.2817 height=47.8529 center=да at=[68.1092,53.8007,185.6362] segments=128
rotate [правая_верх] angle=90 axis=y pivot=[68.1092,53.8007,185.6362]
правая = union [правая_низ, правая_верх]
правая = fillet [правая] radius=2 edges=convex segments=16

полка = loft sections=[[[-30,-96],[98,-40],[98,40],[-20,-15]], [[-30,-96],[98,-40],[98,40],[-20,-15]]] positions=[78,94] axis=z

# Гуссет в наклонной вертикальной плоскости: три вершины восстановлены по референсу.
ребро = loft sections=[[[102.5728886,47.9700],[0,225.3693],[0,108.7615]], [[102.5728886,47.9700],[0,225.3693],[0,108.7615]]] positions=[-4,4] axis=z
rotate [ребро] angle=90 axis=x pivot=[0,0,0]
rotate [ребро] angle=-163.7532553 axis=z pivot=[0,0,0]
translate [ребро] offset=[2.3749087,-35.5964023,0]
ребро = fillet [ребро] radius=3 edges=convex segments=12

# Малая D-проушина на передней стенке седла.
малый_низ = box size=[51.8883,42.0334,19.8885] at=[0,21.0167,-3.4610] round=3
малый_конец = cylinder radius=25.9441 height=19.8885 at=[0,0,-3.4610] round=3 segments=96
малый = union [малый_низ, малый_конец]
малый = fillet [малый] radius=2 edges=convex segments=12
rotate [малый] angle=-30 axis=z pivot=[0,0,0]
translate [малый] offset=[-9.5267,-93.2069,0]

корпус = fuse [седло, босс, правая, полка, ребро, малый] radius=8 edges=вогнутые detail=1.5 max_tris=500000 polish=1

# Глухое верхнее гнездо 70 x 32, глубина 70.
гнездо = box size=[70,32,100] center=да at=[0,25,261.8382]
корпус = difference [корпус, гнездо]

# Глухой правый канал ø52 вдоль X; дно x=60 остаётся перед боссом.
отверстие_правое = cylinder radius=26 height=40.0356 center=да at=[80.0178,53.8007,185.6362] segments=128
rotate [отверстие_правое] angle=90 axis=y pivot=[80.0178,53.8007,185.6362]
корпус = difference [корпус, отверстие_правое]

# Сквозное малое отверстие ø30 и конусная фаска.
отверстие_малое = cylinder radius=15 height=29.8885 center=да at=[-9.5267,-93.2069,6.4833] segments=96
фаска_малой = cylinder radius=15 r2=19 height=5 at=[-9.5267,-93.2069,12.4276] segments=96
корпус = difference [корпус, отверстие_малое, фаска_малой]

color корпус #9fa4a8 material=металл metal=0.18 rough=0.46
