# Кронштейн по фотографии пользователя.
# Канон: верх +Z, перед -Y, право +X. Размеры в миллиметрах.
# Видимая геометрия воспроизводится параметрически; скрытая сторона симметрична
# по толщине проушин, абсолютный масштаб принят по наружному радиусу седла 90 мм.

# Полуцилиндрическое основание: R90/R78, длина 170, скруглённые торцы.
седло = arch radius=84 width=12 thickness=170 angle=180 round=2 segments=128

# Вертикальный босс с настоящими радиусами верхней и нижней кромок.
босс = cylinder radius=55 height=203 at=[0,25,42] round=5 segments=128

# Правая проушина: прямоугольная часть и полукруглая вершина — один профиль.
правая_низ = box size=[100,50,135] at=[95,-10,0]
правая_верх = cylinder radius=50 height=50 center=да at=[95,-10,135] segments=128
rotate [правая_верх] angle=90 axis=x pivot=[95,-10,135]
правая = union [правая_низ, правая_верх]
правая = fillet [правая] radius=4 edges=convex segments=16

# Плоская трапециевидная полка между боссом, седлом и правой проушиной.
полка = loft sections=[[[5,-85],[110,-60],[110,-25],[15,-15]], [[5,-85],[110,-60],[110,-25],[15,-15]]] positions=[72,82] axis=z

# Тонкий треугольный гуссет; нижняя вершина входит в стенку седла,
# вертикальная сторона входит в босс, а не висит над поверхностью.
ребро = loft sections=[[[-88,12],[-34.5,165],[-34.5,70]], [[-88,12],[-34.5,165],[-34.5,70]]] positions=[6,14] axis=z
rotate [ребро] angle=90 axis=x pivot=[0,0,0]
ребро = fillet [ребро] radius=1.2 edges=convex segments=12

# Малая передняя D-образная проушина с округлым наружным концом.
малый_низ = box size=[48,50,14] at=[-82,-85,0] round=3
малый_конец = cylinder radius=24 height=14 at=[-82,-110,0] round=3 segments=96
малый = union [малый_низ, малый_конец]
малый = fillet [малый] radius=2 edges=convex segments=12

# Одна конструкционная деталь: только вогнутые стыки сглаживаются,
# плоские грани и исходная детализация вдали от стыков сохраняются.
корпус = fuse [седло, босс, правая, полка, ребро, малый] radius=8 edges=вогнутые detail=1.5 max_tris=500000 polish=1

# Глухое прямоугольное гнездо в верхней плоскости босса.
гнездо = box size=[70,32,100] center=да at=[0,25,225]
корпус = difference [корпус, гнездо]

# Сквозное горизонтальное отверстие правой проушины.
отверстие_правое = cylinder radius=24 height=80 center=да at=[98,-10,145] segments=128
rotate [отверстие_правое] angle=90 axis=x pivot=[98,-10,145]
корпус = difference [корпус, отверстие_правое]

# Сквозное вертикальное отверстие малой проушины.
отверстие_малое = cylinder radius=14 height=30 center=да at=[-82,-110,7] segments=96
корпус = difference [корпус, отверстие_малое]

color корпус #9fa4a8 material=металл metal=0.18 rough=0.46
