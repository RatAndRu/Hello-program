# Кронштейн по фотографии пользователя — исправленная ревизия.
# Канон: верх +Z, перед -Y, право +X. Размеры в миллиметрах.
# По одному ракурсу абсолютный масштаб и скрытая сторона неизвестны:
# наружный радиус седла принят 90 мм, остальные размеры редактируются ниже.

# Полуцилиндрическое седло: R90/R78, длина 200, скруглённые кромки.
седло = arch radius=84 width=12 thickness=200 angle=180 round=2 segments=128

# Вертикальный босс с настоящими радиусами верхней и нижней кромок.
босс = cylinder radius=55 height=203 at=[0,25,42] round=5 segments=128

# Правая проушина повёрнута как на фото: широкая D-плоскость на +X,
# короткая передняя сторона на -Y, ось цилиндрического канала — X.
правая_низ = box size=[56,110,135] at=[70,15,0]
правая_верх = cylinder radius=55 height=56 center=да at=[70,15,135] segments=128
rotate [правая_верх] angle=90 axis=y pivot=[70,15,135]
правая = union [правая_низ, правая_верх]
правая = fillet [правая] radius=4 edges=convex segments=16

# Широкая трапециевидная полка видна слева от проушины и входит в неё.
полка = loft sections=[[[-30,-96],[98,-40],[98,40],[-20,-15]], [[-30,-96],[98,-40],[98,40],[-20,-15]]] positions=[78,94] axis=z

# Видимый тонкий гуссет на передней стороне босса. Перекрытия достаточно,
# чтобы fillet не оставлял отдельных микрофрагментов при последующем fuse.
ребро = loft sections=[[[-88,18],[-25,175],[-25,65]], [[-88,18],[-25,175],[-25,65]]] positions=[22,30] axis=z
rotate [ребро] angle=90 axis=x pivot=[0,0,0]
ребро = fillet [ребро] radius=1.2 edges=convex segments=12

# Широкая передняя D-проушина с округлым наружным концом.
малый_низ = box size=[64,46,18] at=[-82,-86,0] round=3
малый_конец = cylinder radius=32 height=18 at=[-82,-109,0] round=3 segments=96
малый = union [малый_низ, малый_конец]
малый = fillet [малый] radius=2 edges=convex segments=12

# Одна связная деталь: сглаживаются только вогнутые стыки, плоскости сохраняются.
корпус = fuse [седло, босс, правая, полка, ребро, малый] radius=8 edges=вогнутые detail=1.5 max_tris=500000 polish=1

# Глухое прямоугольное гнездо 70 x 32, глубина 70 в верхней плоскости босса.
гнездо = box size=[70,32,100] center=да at=[0,25,225]
корпус = difference [корпус, гнездо]

# Правый цилиндрический канал ø52 вдоль X, глубина 64 от внешней плоскости.
# Дно остаётся перед материалом босса: видимая полость не пробивает весь босс.
отверстие_правое = cylinder radius=26 height=64 center=да at=[74,15,145] segments=128
rotate [отверстие_правое] angle=90 axis=y pivot=[74,15,145]
корпус = difference [корпус, отверстие_правое]

# Сквозное переднее отверстие ø30 и настоящая конусная фаска на входе.
отверстие_малое = cylinder radius=15 height=34 center=да at=[-82,-109,9] segments=96
фаска_малой = cylinder radius=15 r2=19 height=5 at=[-82,-109,14] segments=96
корпус = difference [корпус, отверстие_малое, фаска_малой]

color корпус #9fa4a8 material=металл metal=0.18 rough=0.46
