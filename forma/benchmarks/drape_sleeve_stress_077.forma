# ДИАГНОСТИЧЕСКИЙ СТРЕСС-ТЕСТ, не готовая деталь для экспорта.
# На Linux/Python 3.11 при проверке 0.77 этот режим оставил самопересечения
# плотного рукава. Точное число зависит от платформы. Проверяйте журнал.
пол = box size=[150,100,6] at=[0,0,-6] color=#d8d8d0
рукав = pipe length=70 diameter=22 wall=0.6 sides=64 at=[0,0,40] color=#ad6e83
проверка = drape рукав on=пол mesh=6 particles=5000 steps=160 constraints=24 bend=0.35 damping=0.2 friction=0.9 g=0.04 self=да self_gap=0.25
