# ДИАГНОСТИКА: лист падает на горизонтальную площадку с неподвижным шаром.
# Шар выступает верхней половиной из плоскости; проверяется контакт с двумя опорами.
площадка = box size=[150,120,6] at=[0,0,-6] color=#d8d8d0
шар = sphere radius=8 segments=16 at=[0,0,0] color=#b9855e
лист = box size=[72,60,0.6] at=[0,0,40] color=#75a8bd
результат = drape лист on=[площадка,шар] gravity=z- mesh=7 particles=1200 steps=55 constraints=14 bend=0.15 damping=0.4 friction=0.3 g=0.1 self=да gap=0.02
