головка_a = translate [головка_a] offset=[249.5, -34, 230]
головка_b = cylinder radius=11.6 height=12 segments=64 center=да
головка_b = rotate [головка_b] angle=90 axis=y
головка_b = translate [головка_b] offset=[247, -34, 230]
головка = difference [головка_a, головка_b]
