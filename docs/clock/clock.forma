# ---------------- АНИМАЦИЯ: 180 с, цикл замкнут ----------------
#  Минутная — 0,5 оборота, часовая — 1/24 (ровно 12:1 по передаче).
#  Колёса: барабан -0.125, промежуточное -1.5, секундное
#  3, анкерное -4, минутное -0.1667 оборота.
#  Баланс: 80 клипов по 2.25 с. Каждый клип — одно полуколебание
#  и ровно один зуб анкерного колеса. Сцена замедлена: в жизни баланс
#  бьёт около 5 раз в секунду, здесь — 0.44 раза, чтобы ход было видно.

animate минутная spin turns=0.5 axis=y pivot=[0, 0, 230] seconds=180 track=1
animate труба_мин spin turns=0.5 axis=y pivot=[0, 0, 230] seconds=180 track=1
animate часовая spin turns=0.04167 axis=y pivot=[0, 0, 230] seconds=180 track=1
animate труба_час spin turns=0.04167 axis=y pivot=[0, 0, 230] seconds=180 track=1
animate часовое spin turns=0.04167 axis=y pivot=[0, 0, 230] seconds=180 track=1
animate минутное spin turns=-0.16667 axis=y pivot=[-26.84, 0, 190.21] seconds=180 track=1
animate мин_трибка spin turns=-0.16667 axis=y pivot=[-26.84, 0, 190.21] seconds=180 track=1
animate вал_м spin turns=-0.16667 axis=y pivot=[-26.84, 0, 190.21] seconds=180 track=1
animate вексель spin turns=0.5 axis=y pivot=[0, 0, 230] seconds=180 track=1
animate трибка_ц spin turns=0.5 axis=y pivot=[0, 0, 230] seconds=180 track=1
animate колесо_ц spin turns=0.5 axis=y pivot=[0, 0, 230] seconds=180 track=1
animate барабан spin turns=-0.125 axis=y pivot=[-51.96, 0, 260] seconds=180 track=1
animate вал_бар spin turns=-0.125 axis=y pivot=[-51.96, 0, 260] seconds=180 track=1
animate трибка_п spin turns=-1.5 axis=y pivot=[37.59, 0, 216.32] seconds=180 track=1
animate колесо_п spin turns=-1.5 axis=y pivot=[37.59, 0, 216.32] seconds=180 track=1
animate вал_п spin turns=-1.5 axis=y pivot=[37.59, 0, 216.32] seconds=180 track=1
animate трибка_с spin turns=3 axis=y pivot=[68.24, 0, 197.44] seconds=180 track=1
animate колесо_с spin turns=3 axis=y pivot=[68.24, 0, 197.44] seconds=180 track=1
animate вал_с spin turns=3 axis=y pivot=[68.24, 0, 197.44] seconds=180 track=1
animate трибка_э spin turns=-4 axis=y pivot=[95, 0, 220] seconds=180 track=1
animate анкерное spin turns=-4 axis=y pivot=[95, 0, 220] seconds=180 track=1
animate вал_э spin turns=-4 axis=y pivot=[95, 0, 220] seconds=180 track=1

#  Баланс: 80 клипов по 2.25 с — по одному полуколебанию на зуб.
#  Клипы складываются друг с другом: первый уводит баланс на +A, каждый
#  следующий перебрасывает от +A к −A (то есть на 2A), последний гасит
#  до нуля. Так кадр 180 с совпадает с кадром 0 с, и цикл не рвётся.
animate баланс turn angle=150 axis=y pivot=[140, 0, 250] seconds=2.25 track=2
