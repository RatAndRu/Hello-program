втулка_отв = cylinder radius=3.4 height=50 segments=40 center=да
втулка_отв = rotate [втулка_отв] angle=90 axis=y
втулка_отв = translate [втулка_отв] offset=[225, -34, 230]
втулка = difference [втулка, втулка_отв]
окно_вала = cylinder radius=10.5 height=41 segments=64 center=да
окно_вала = rotate [окно_вала] angle=90 axis=y
окно_вала = translate [окно_вала] offset=[225.5, -34, 230]
корпус = difference [корпус, окно_вала]

# ---------------- ПЛАТА ----------------
