<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:orientation="vertical" android:padding="8dp"
    android:background="@drawable/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_image" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scaleType="centerCrop" android:src="@drawable/ic_pin_foreground" android:contentDescription="Закреплённое фото"/>
    <TextView android:id="@+id/widget_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="📌 ЗакрепФото" android:textColor="#FFFFFF" android:textSize="13sp" android:paddingTop="6dp"/>
</LinearLayout>
