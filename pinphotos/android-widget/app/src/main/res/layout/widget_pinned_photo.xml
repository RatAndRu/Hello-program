<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:orientation="vertical" android:padding="10dp"
    android:background="@drawable/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- Фото всегда КВАДРАТНОЕ по центру: bitmap обрезается в квадрат в коде, здесь не тянется под виджет -->
    <ImageView android:id="@+id/widget_image" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scaleType="centerInside" android:contentDescription="Закреплённое фото"/>

    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp">
        <TextView android:id="@+id/widget_prev" android:text="‹" android:textColor="#0F766E" android:textSize="24sp"
            android:paddingHorizontal="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/widget_caption" android:text="📌 ЗакрепФото" android:textColor="#24313A"
            android:textSize="13sp" android:gravity="center" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"/>
        <TextView android:id="@+id/widget_next" android:text="›" android:textColor="#0F766E" android:textSize="24sp"
            android:paddingHorizontal="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
