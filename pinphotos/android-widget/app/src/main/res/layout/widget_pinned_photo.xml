<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:padding="8dp"
    android:background="@drawable/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- Обычный режим: фото на весь виджет, centerCrop. Лупа включает увеличенный центральный фрагмент. -->
    <ImageView android:id="@+id/widget_image" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:contentDescription="Закреплённое фото"/>

    <TextView android:id="@+id/widget_zoom" android:text="🔍" android:textSize="15sp"
        android:padding="7dp" android:background="@drawable/widget_zoom_bg"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:contentDescription="Масштаб фото"/>

    <LinearLayout android:id="@+id/widget_controls" android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/widget_caption_bg"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:padding="4dp">
        <TextView android:id="@+id/widget_prev" android:text="‹" android:textColor="#0F766E" android:textSize="24sp"
            android:paddingHorizontal="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/widget_caption" android:text="📌 ЗакрепФото" android:textColor="#24313A"
            android:textSize="13sp" android:gravity="center" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/widget_next" android:text="›" android:textColor="#0F766E" android:textSize="24sp"
            android:paddingHorizontal="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
</FrameLayout>
