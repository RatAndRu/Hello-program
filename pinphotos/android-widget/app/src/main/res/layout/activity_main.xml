<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/appBackground">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp">
        <TextView android:id="@+id/exitBtn" android:text="✕" android:textColor="#DC2626" android:textSize="22sp"
            android:textStyle="bold" android:background="@drawable/exit_bg" android:paddingHorizontal="11dp" android:paddingVertical="4dp"
            android:layout_marginEnd="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:contentDescription="Полностью закрыть приложение"/>
        <TextView android:id="@+id/appTitle" android:text="ЗакрепФото" android:textColor="?attr/appText" android:textSize="22sp"
            android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <EditText android:id="@+id/searchInput" android:hint="Поиск: название или #тег" android:visibility="gone"
            android:singleLine="true" android:background="@drawable/input_bg"
            android:textColor="?attr/appText" android:textColorHint="?attr/appMuted" android:textSize="15sp"
            android:paddingHorizontal="12dp" android:paddingVertical="9dp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <TextView android:id="@+id/searchBtn" android:text="🔍" android:textSize="19sp"
            android:paddingHorizontal="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:contentDescription="Поиск"/>
        <TextView android:id="@+id/countText" android:textColor="?attr/appMuted" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/filterBtn" android:text="☷" android:textColor="?attr/appText" android:textSize="22sp"
            android:paddingHorizontal="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Фильтры и сортировка"/>
        <TextView android:id="@+id/menuBtn" android:text="⋮" android:textColor="?attr/appText" android:textSize="22sp"
            android:paddingHorizontal="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <Button android:id="@+id/selectAllAlbumBtn" android:text="Выделить все в альбоме"
        android:textColor="?attr/appAccent" android:background="@drawable/btn_soft"
        android:visibility="gone" android:layout_width="match_parent" android:layout_height="36dp"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="6dp" android:layout_marginBottom="2dp"/>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingHorizontal="12dp" android:clipToPadding="false"/>
        <LinearLayout android:id="@+id/emptyView" android:orientation="vertical" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="match_parent" android:padding="32dp">
            <ImageView android:src="@drawable/widget_placeholder" android:layout_width="180dp" android:layout_height="120dp"
                android:layout_gravity="center_horizontal" android:contentDescription="Нет фото"/>
            <TextView android:id="@+id/emptyText" android:text="Пока нет фотографий" android:textColor="?attr/appMuted"
                android:textSize="16sp" android:gravity="center"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
            <Button android:id="@+id/emptyImportBtn" android:text="Добавить фото" android:textColor="?attr/appAccent" android:background="@drawable/btn_soft"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
        </LinearLayout>
    </FrameLayout>

    <Button android:id="@+id/albumsCollapseBtn" android:text="▾  Альбомы" android:textColor="?attr/appText"
        android:background="@drawable/btn_soft" android:gravity="start|center_vertical" android:paddingHorizontal="16dp"
        android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp"/>
    <LinearLayout android:id="@+id/albumsContent" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:clipChildren="false" android:clipToPadding="false"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp">
        <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/albumsTitle" android:text="Альбомы" android:textColor="?attr/appText" android:textSize="16sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/currentAlbumText" android:text="Разное" android:textColor="?attr/appMuted" android:textSize="12sp"
                android:gravity="end" android:maxLines="1" android:ellipsize="end"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <Button android:id="@+id/albumsModeBtn" android:text="Виджеты 🧩" android:textColor="?attr/appAccent" android:background="@drawable/btn_soft"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none" android:paddingTop="8dp" android:paddingBottom="14dp"
            android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:id="@+id/albumsTiles" android:orientation="horizontal"
                android:clipChildren="false" android:clipToPadding="false"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/selectionBar" android:orientation="horizontal" android:gravity="center_vertical"
        android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp" android:padding="10dp"
        android:background="@drawable/card_bg">
        <TextView android:id="@+id/selectionText" android:textColor="?attr/appText" android:textSize="14sp"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <Button android:id="@+id/moveSelectedBtn" android:text="В альбом" android:textColor="#FFFFFF"
            android:background="@drawable/btn_primary" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Button android:id="@+id/clearSelectionBtn" android:text="Отмена" android:textColor="?attr/appAccent"
            android:background="@drawable/btn_soft" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/selectionActions2" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" android:padding="10dp" android:background="@drawable/card_bg">
        <Button android:id="@+id/widgetSelectedBtn" android:text="В виджет" android:textColor="#FFFFFF" android:background="@drawable/btn_primary"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <Button android:id="@+id/shareSelectedBtn" android:text="Поделиться" android:textColor="?attr/appAccent" android:background="@drawable/btn_soft"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"/>
        <Button android:id="@+id/deleteSelectedBtn" android:text="Удалить" android:textColor="#EF4444" android:background="@drawable/btn_soft"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <Button android:id="@+id/importBtn" android:text="＋  Добавить фото" android:textColor="#FFFFFF" android:background="@drawable/btn_primary"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:padding="14dp"/>
</LinearLayout>
