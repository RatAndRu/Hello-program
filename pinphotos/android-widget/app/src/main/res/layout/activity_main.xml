<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0F1115">
    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp">
        <TextView android:text="ЗакрепФото" android:textColor="#F5F6F8" android:textSize="22sp"
            android:textStyle="bold" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
        <TextView android:id="@+id/countText" android:textColor="#8B93A7" android:textSize="13sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/menuBtn" android:text="⋮" android:textColor="#F5F6F8" android:textSize="22sp"
            android:paddingHorizontal="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/widgetCard" android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginBottom="12dp" android:padding="14dp"
        android:background="@drawable/card_bg">
        <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
            <TextView android:text="Виджет" android:textColor="#F5F6F8" android:textSize="15sp" android:textStyle="bold"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/widgetStatus" android:textColor="#8B93A7" android:textSize="13sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <Button android:id="@+id/addWidgetBtn" android:text="Добавить"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingHorizontal="12dp" android:clipToPadding="false"/>
        <LinearLayout android:id="@+id/emptyView" android:orientation="vertical" android:gravity="center"
            android:layout_width="match_parent" android:layout_height="match_parent" android:padding="32dp">
            <ImageView android:src="@drawable/widget_placeholder" android:layout_width="180dp" android:layout_height="120dp"
                android:layout_gravity="center_horizontal" android:contentDescription="Нет фото"/>
            <TextView android:id="@+id/emptyText" android:text="Пока нет фотографий" android:textColor="#C7CBD6"
                android:textSize="16sp" android:gravity="center"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
            <Button android:id="@+id/emptyImportBtn" android:text="Добавить фото"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
        </LinearLayout>
    </FrameLayout>

    <Button android:id="@+id/importBtn" android:text="＋  Добавить фото"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:padding="14dp"/>
</LinearLayout>
