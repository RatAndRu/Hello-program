<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="5dp" android:background="@drawable/card_bg" android:clipToOutline="true">
    <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="150dp"
        android:scaleType="centerCrop" android:contentDescription="Фото"/>
    <TextView android:background="@drawable/badge_bg" android:padding="3dp" android:id="@+id/badge" android:text="📌" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="6dp" android:visibility="gone"/>
</FrameLayout>
