<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingLeft="6dp" android:paddingTop="16dp" android:paddingRight="2dp" android:paddingBottom="7dp">
    <TextView
        android:id="@+id/headerCollapse"
        android:layout_width="28dp" android:layout_height="wrap_content"
        android:gravity="center" android:text="▾" android:textSize="15sp"
        android:textColor="?attr/appAccent"
        android:contentDescription="Свернуть или развернуть группу" />
    <TextView
        android:id="@+id/headerTitle"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="?attr/appText" android:textSize="15sp" android:textStyle="bold" />
    <CheckBox
        android:id="@+id/headerCheck"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:buttonTint="?attr/appAccent"
        android:contentDescription="Выделить все фото этой группы" />
</LinearLayout>
