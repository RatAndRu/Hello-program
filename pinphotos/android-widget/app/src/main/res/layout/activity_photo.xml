<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/appBackground" android:fitsSystemWindows="true">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="#111827">
        <VideoView android:id="@+id/videoPlayer" android:visibility="gone"
            android:layout_gravity="center"
            android:layout_width="match_parent" android:layout_height="match_parent"/>
        <com.example.pinphotoswidget.ZoomImageView android:id="@+id/fullImage"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:contentDescription="Фото. Зум щипком или двойным нажатием"/>
        <TextView android:id="@+id/prevBtn" android:text="‹" android:textColor="#FFFFFF" android:textSize="38sp"
            android:background="@drawable/nav_arrow_bg" android:gravity="center"
            android:layout_width="46dp" android:layout_height="64dp" android:layout_gravity="center_vertical|start"
            android:layout_marginStart="8dp" android:contentDescription="Предыдущее фото"/>
        <TextView android:id="@+id/nextBtn" android:text="›" android:textColor="#FFFFFF" android:textSize="38sp"
            android:background="@drawable/nav_arrow_bg" android:gravity="center"
            android:layout_width="46dp" android:layout_height="64dp" android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="8dp" android:contentDescription="Следующее фото"/>
        <TextView android:id="@+id/positionText" android:textColor="#FFFFFF" android:textSize="12sp"
            android:background="@drawable/nav_arrow_bg" android:paddingHorizontal="9dp" android:paddingVertical="4dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal" android:layout_marginTop="10dp"/>
        <LinearLayout android:id="@+id/fullscreenCaption" android:orientation="vertical" android:visibility="gone"
            android:background="@drawable/nav_arrow_bg" android:padding="10dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_margin="10dp">
            <TextView android:id="@+id/fullName" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/fullMeta" android:textColor="#E5E7EB" android:textSize="12sp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>

    <LinearLayout android:id="@+id/bottomPanel" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/card_bg" android:layout_margin="12dp" android:padding="12dp">
        <TextView android:id="@+id/photoName" android:textColor="?attr/appText" android:textSize="17sp" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/photoMeta" android:textColor="?attr/appMuted" android:textSize="13sp"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp"/>

        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="56dp" android:paddingTop="8dp">
            <Button android:id="@+id/pinBtn" android:textColor="#FFFFFF" android:background="@drawable/btn_primary" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            <Button android:id="@+id/shareBtn" android:textColor="?attr/appAccent" android:background="@drawable/btn_soft" android:text="Поделиться" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp"/>
            <Button android:id="@+id/copyBtn" android:textColor="?attr/appAccent" android:background="@drawable/btn_soft" android:text="Копировать" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="56dp" android:paddingTop="8dp">
            <Button android:id="@+id/editBtn" android:textColor="?attr/appAccent" android:background="@drawable/btn_soft" android:text="Изменить" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            <Button android:id="@+id/deleteBtn" android:textColor="#EF4444" android:background="@drawable/btn_soft" android:text="Удалить" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView android:text="Зум: щипок или двойное нажатие" android:textColor="?attr/appMuted" android:textSize="12sp"
            android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp"/>
    </LinearLayout>
</LinearLayout>
