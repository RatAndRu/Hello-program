<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FFF7ED</item>
        <item name="android:statusBarColor">#FFF7ED</item>
        <item name="android:navigationBarColor">#FFF7ED</item>
        <item name="android:colorAccent">#0F766E</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenu</item>
    </style>
    <style name="ShareImportTheme" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorAccent">#0F766E</item>
        <item name="android:textColorPrimary">#24313A</item>
        <item name="android:textColorSecondary">#66727E</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogPositiveButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogNegativeButton</item>
    </style>
    <style name="DialogPositiveButton" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">#0F766E</item><item name="android:textStyle">bold</item>
    </style>
    <style name="DialogNegativeButton" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">#7A8694</item>
    </style>
    <style name="AppPopupMenu" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/dialog_bg</item>
        <item name="android:textColor">#24313A</item>
    </style>
</resources>
