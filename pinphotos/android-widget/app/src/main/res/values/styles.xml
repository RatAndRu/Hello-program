<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="AppThemeLight" />

    <style name="AppThemeLight" parent="android:style/Theme.Material.NoActionBar">
        <item name="appBackground">#FFF7ED</item>
        <item name="appSurface">#FFFFFF</item>
        <item name="appSurfaceAlt">#FFE8D6</item>
        <item name="appBorder">#F2DEC8</item>
        <item name="appText">#24313A</item>
        <item name="appMuted">#66727E</item>
        <item name="appAccent">#0F766E</item>
        <item name="android:windowBackground">#FFF7ED</item>
        <item name="android:statusBarColor">#FFF7ED</item>
        <item name="android:navigationBarColor">#FFF7ED</item>
        <item name="android:colorAccent">#0F766E</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:alertDialogTheme">@style/AppDialogThemeLight</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenuLight</item>
    </style>

    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="appBackground">#12161C</item>
        <item name="appSurface">#1E242E</item>
        <item name="appSurfaceAlt">#28313D</item>
        <item name="appBorder">#3A4656</item>
        <item name="appText">#F2F5F7</item>
        <item name="appMuted">#A8B2BF</item>
        <item name="appAccent">#5EEAD4</item>
        <item name="android:windowBackground">#12161C</item>
        <item name="android:statusBarColor">#12161C</item>
        <item name="android:navigationBarColor">#12161C</item>
        <item name="android:colorAccent">#5EEAD4</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:alertDialogTheme">@style/AppDialogThemeDark</item>
        <item name="android:popupMenuStyle">@style/AppPopupMenuDark</item>
    </style>

    <style name="ShareImportTheme" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="AppDialogTheme" parent="AppDialogThemeLight" />
    <style name="AppDialogThemeLight" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_light</item>
        <item name="android:colorAccent">#0F766E</item>
        <item name="android:textColorPrimary">#24313A</item>
        <item name="android:textColorSecondary">#66727E</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogPositiveButtonLight</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogNegativeButtonLight</item>
    </style>
    <style name="AppDialogThemeDark" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg_dark</item>
        <item name="android:colorAccent">#5EEAD4</item>
        <item name="android:textColorPrimary">#F2F5F7</item>
        <item name="android:textColorSecondary">#A8B2BF</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogPositiveButtonDark</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogNegativeButtonDark</item>
    </style>
    <style name="DialogPositiveButton" parent="DialogPositiveButtonLight" />
    <style name="DialogPositiveButtonLight" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">#0B6B5B</item><item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/btn_soft</item>
    </style>
    <style name="DialogPositiveButtonDark" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">#5EEAD4</item><item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/btn_soft_dark</item>
    </style>
    <style name="DialogNegativeButton" parent="DialogNegativeButtonLight" />
    <style name="DialogNegativeButtonLight" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">#66727E</item>
        <item name="android:background">@drawable/btn_soft</item>
    </style>
    <style name="DialogNegativeButtonDark" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">#A8B2BF</item>
        <item name="android:background">@drawable/btn_soft_dark</item>
    </style>

    <style name="AppPopupMenu" parent="AppPopupMenuLight" />
    <style name="AppPopupMenuLight" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/dialog_bg_light</item>
        <item name="android:textColor">#24313A</item>
    </style>
    <style name="AppPopupMenuDark" parent="android:style/Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/dialog_bg_dark</item>
        <item name="android:textColor">#F2F5F7</item>
    </style>
</resources>
