<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="ЗакрепФото" android:theme="@style/AppTheme" android:icon="@drawable/ic_pin_foreground">

        <!-- Реальная Activity одна, иконки переключаются алиасами -->
        <activity android:name=".MainActivity" android:exported="false" />

        <activity-alias android:name=".IconNormal" android:enabled="true" android:exported="true"
            android:icon="@drawable/ic_pin_foreground" android:label="ЗакрепФото" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconFire" android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_fire_foreground" android:label="ЗакрепФото 🔥" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".IconSleepy" android:enabled="false" android:exported="true"
            android:icon="@drawable/ic_sleepy_foreground" android:label="ЗакрепФото" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>

        <activity-alias android:name=".IconShaped" android:enabled="false" android:exported="true"
            android:icon="@mipmap/ic_shaped_launcher" android:label="ЗакрепФото" android:targetActivity=".MainActivity">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>

        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider" android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Виджет в 4 стартовых размерах: при добавлении система покажет варианты -->
        <receiver android:name=".PinnedPhotoWidget2x2" android:exported="false" android:label="ЗакрепФото 2×2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_2x2" />
        </receiver>
        <receiver android:name=".PinnedPhotoWidget3x2" android:exported="false" android:label="ЗакрепФото 3×2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_3x2" />
        </receiver>
        <receiver android:name=".PinnedPhotoWidget4x2" android:exported="false" android:label="ЗакрепФото 4×2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_4x2" />
        </receiver>
        <receiver android:name=".PinnedPhotoWidget4x3" android:exported="false" android:label="ЗакрепФото 4×3">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_4x3" />
        </receiver>

        <activity android:name=".PhotoActivity" android:exported="false" />

        <!-- Появляется в системном меню «Поделиться» у фотографий -->
        <activity android:name=".ShareImportActivity" android:exported="true"
            android:label="Сохранить в ЗакрепФото" android:theme="@style/ShareImportTheme">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
