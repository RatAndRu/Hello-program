@echo off
chcp 65001 >nul
rem ==========================================================================
rem  start_chess.bat - резервный запуск шахмат (Windows).
rem  Нужен, если start.vbs по какой-то причине не сработал.
rem --------------------------------------------------------------------------
rem  ВАЖНО: смена кодовой страницы (chcp) стоит САМОЙ ПЕРВОЙ строкой, до любого
rem  русского текста. Иначе cmd.exe после chcp перечитывает файл по неверному
rem  смещению и выполняет обрывки строк, например:
rem      'on' is not recognized as an internal or external command
rem  Файл сохранён с переводами строк CRLF - это второе обязательное условие
rem  (следит .gitattributes в корне репозитория).
rem ==========================================================================
cd /d "%~dp0"

where py >nul 2>nul
if %errorlevel%==0 (
  py -3 chess.py --console
) else (
  python chess.py --console
)

echo.
echo Партия окончена. Нажмите любую клавишу, чтобы закрыть окно...
pause >nul
