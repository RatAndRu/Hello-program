# ===========================================================================
#  .gitattributes — какие переводы строк Git выдаёт в рабочую копию
# ---------------------------------------------------------------------------
#  Зачем это здесь:
#    Windows-лаунчеры (.bat/.cmd) ломаются, если попадут на диск с юниксовыми
#    переводами строк (LF): cmd.exe читает такой файл блоками и при смене
#    кодовой страницы (chcp) начинает выполнять ОБРЫВКИ строк — в консоли
#    появляется «'on' is not recognized as an internal or external command».
#    Правило ниже гарантирует, что при checkout/клоне .bat, .cmd, .vbs и .ps1
#    всегда получат CRLF.
# ===========================================================================

# Обычные текстовые файлы: в репозитории — LF, в рабочей копии — как принято в ОС.
* text=auto

# Лаунчеры и скрипты Windows: рабочая копия обязана иметь CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.vbs  text eol=crlf
*.ps1  text eol=crlf

# Бинарные файлы: Git не должен их трогать и пытаться «нормализовать».
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.pdf   binary
*.ico   binary
