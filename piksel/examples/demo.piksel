# Демо-сценарий ПИКСЕЛЬ — как .forma, но для пикселей
# Каждая строка — команда, как в ФОРМЕ

размер 32
палитра PICO-8

# ручные пиксели (координаты)
пиксель x=14 y=14 #ff7a59
пиксель x=15 y=14 #ff7a59
пиксель x=16 y=14 #ffb86b
пиксель x=13 y=15 #ff7a59
пиксель x=14 y=15 #e7ecf3
пиксель x=15 y=15 #1a1c2c
пиксель x=16 y=15 #1a1c2c

# промпт → пиксели (генерирует нейросеть)
промпт "девочка с катаной, закат, аниме" стиль=аниме палитра=16

# проверки (как check в ФОРМЕ)
check размер 32x32
check палитра <=16
check hd 64x64

# детализация (нейросеть уплотняет)
детализация x2 стиль=аниме сила=0.45
детализация x4 стиль=аниме сила=0.40
