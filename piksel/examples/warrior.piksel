# проверки как в ФОРМЕ
check палитра <=16
check силуэт контраст>30%
check размер 32
# подсказка для HD
промпт "brave adventurer warrior with sword, side view, red cape, retro sprite"
детализация x4 сила=0.42 стиль=аниме палитра=сохранить
