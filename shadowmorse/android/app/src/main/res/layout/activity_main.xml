<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050711" android:keepScreenOn="true">
    <TextureView android:id="@+id/cameraPreview" android:layout_width="match_parent" android:layout_height="match_parent" />
    <com.example.shadowmorse.Monster3DView android:id="@+id/monster3DView" android:layout_width="match_parent" android:layout_height="match_parent" />
    <com.example.shadowmorse.GameView android:id="@+id/gameView" android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout android:id="@+id/topHud" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/timeText" style="@style/HudPill" android:text="⏱ 05:00" />
        <TextView android:id="@+id/livesText" style="@style/HudPill" android:layout_marginStart="8dp" android:text="❤ 3" />
        <TextView android:id="@+id/scoreText" style="@style/HudPill" android:layout_marginStart="8dp" android:text="☠ 0" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView style="@style/HudPill" android:text="FOV 160°×90°" android:textSize="12sp" />
    </LinearLayout>

    <ScrollView android:id="@+id/startPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/menu_bg" android:fillViewport="true" android:paddingLeft="16dp" android:paddingTop="22dp" android:paddingRight="16dp" android:paddingBottom="22dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:background="@drawable/menu_badge_bg" android:letterSpacing="0.18" android:paddingLeft="14dp" android:paddingTop="7dp" android:paddingRight="14dp" android:paddingBottom="7dp" android:text="👁  AR HORROR SURVIVAL  👁" android:textColor="#FFD7DE" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:shadowColor="#FF3153" android:shadowDx="0" android:shadowDy="3" android:shadowRadius="14" android:text="SHADOW" android:textColor="#FFFFFF" android:textSize="52sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="-12dp" android:gravity="center" android:shadowColor="#59D7FF" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="12" android:text="Morse" android:textColor="#59D7FF" android:textSize="42sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:letterSpacing="0.32" android:text="A R" android:textColor="#FFB25E" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="👻      🕷      👁" android:textColor="#55FFFFFF" android:textSize="30sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:lineSpacingMultiplier="1.3" android:text="Тьма уже вокруг тебя.\nФонарь и лазер — твоё оружие." android:textColor="#CBD5E1" android:textSize="16sp" />

            <Button android:id="@+id/startBtn" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="22dp" android:background="@drawable/button_start_game" android:text="▶  ИГРАТЬ" android:textColor="#FFFFFF" android:textSize="23sp" android:textStyle="bold" />
            <Button android:id="@+id/calibrateBtn" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:background="@drawable/button_menu_secondary" android:text="◎  КАЛИБРОВАТЬ ДАТЧИКИ" android:textColor="#EDF2FF" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Сначала держи телефон перед собой и откалибруй направление" android:textColor="#8EA0BB" android:textSize="12sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:letterSpacing="0.14" android:text="— КАК ИГРАТЬ —" android:textColor="#FFB25E" android:textSize="14sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/menu_rule_bg" android:gravity="center" android:lineSpacingMultiplier="1.25" android:padding="12dp" android:text="🔦\nТЕНИ\n\nВспышки фонаря" android:textColor="#D8E2F3" android:textSize="13sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/menu_rule_bg" android:gravity="center" android:lineSpacingMultiplier="1.25" android:padding="12dp" android:text="🔴\nПАУКИ\n\nРазрез лазером" android:textColor="#D8E2F3" android:textSize="13sp" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/menu_rule_bg" android:gravity="center" android:lineSpacingMultiplier="1.25" android:padding="12dp" android:text="⏱\n5 МИНУТ\n\n3 жизни на выживание" android:textColor="#D8E2F3" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/menu_rule_bg" android:lineSpacingMultiplier="1.3" android:padding="13dp" android:text="💀 Боссы, невидимки, морзе-тени и расходники уже ждут внутри. Поворачивайся вокруг себя и следи за радаром." android:textColor="#CBD5E1" android:textSize="13sp" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:letterSpacing="0.14" android:text="— НАСТРОЙКИ —" android:textColor="#59D7FF" android:textSize="14sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/menu_card_bg" android:orientation="vertical" android:padding="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🔦  Чувствительность фонаря" android:textColor="#E7EEFC" android:textSize="14sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/flashSensitivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" android:progressTint="#FFD76A" android:thumbTint="#FFD76A" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🔴  Чувствительность лазера" android:textColor="#E7EEFC" android:textSize="14sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/laserSensitivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" android:progressTint="#FF5B6A" android:thumbTint="#FF5B6A" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🧭  Плавность поворота" android:textColor="#E7EEFC" android:textSize="14sp" android:textStyle="bold" />
                <SeekBar android:id="@+id/smoothingSensitivity" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" android:progressTint="#59D7FF" android:thumbTint="#59D7FF" />
                <CheckBox android:id="@+id/models3DCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/menu_rule_bg" android:buttonTint="#59D7FF" android:checked="true" android:padding="13dp" android:text="  🧊 Настоящие 3D-модели (OpenGL ES)" android:textColor="#D8E2F3" android:textSize="14sp" />
                <CheckBox android:id="@+id/debugTouchCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/menu_rule_bg" android:buttonTint="#FFB25E" android:padding="13dp" android:text="  👆 Сенсорный режим: тапы и свайпы, без детектора света" android:textColor="#D8E2F3" android:textSize="14sp" />
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="SHADOW Morse AR · v2.1" android:textColor="#66758D" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="Не играй рядом с лестницами и дорогой" android:textColor="#4E5B70" android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/endPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="14dp" android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="26dp" android:visibility="gone">
        <TextView android:id="@+id/endTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Конец игры" android:textColor="#EEF2FF" android:textSize="36sp" android:textStyle="bold" />
        <TextView android:id="@+id/endStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingMultiplier="1.35" android:textColor="#CBD5E1" android:textSize="17sp" />
        <Button android:id="@+id/restartBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/button_primary" android:padding="14dp" android:text="Играть снова" android:textColor="#06101B" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/consumablesPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginLeft="10dp" android:layout_marginRight="10dp" android:layout_marginBottom="64dp" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/inventoryText" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/hud_pill" android:gravity="center" android:padding="7dp" android:text="Осколки: 0" android:textColor="#EEF2FF" android:textSize="13sp" android:textStyle="bold" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/consumablesBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView android:id="@+id/toastText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="24dp" android:background="@drawable/toast_bg" android:paddingLeft="16dp" android:paddingTop="12dp" android:paddingRight="16dp" android:paddingBottom="12dp" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
</FrameLayout>
