<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050711" android:keepScreenOn="true">
    <TextureView android:id="@+id/cameraPreview" android:layout_width="match_parent" android:layout_height="match_parent" />
    <com.example.shadowmorse.GameView android:id="@+id/gameView" android:layout_width="match_parent" android:layout_height="match_parent" />

    <LinearLayout android:id="@+id/topHud" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/timeText" style="@style/HudPill" android:text="⏱ 05:00" />
        <TextView android:id="@+id/livesText" style="@style/HudPill" android:layout_marginStart="8dp" android:text="❤ 3" />
        <TextView android:id="@+id/scoreText" style="@style/HudPill" android:layout_marginStart="8dp" android:text="☠ 0" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <TextView style="@style/HudPill" android:text="FOV 160°×90°" android:textSize="12sp" />
    </LinearLayout>

    <ScrollView android:id="@+id/startPanel" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:padding="14dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="26dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="-0.04" android:text="Shadow Morse AR" android:textColor="#EEF2FF" android:textSize="42sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingMultiplier="1.35" android:text="Нативная AR-игра для телефона: камера — фон, монстры окружают тебя в пространстве 160°×90°, а внешний фонарик и лазер — оружие." android:textColor="#CBD5E1" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/rule_bg" android:lineSpacingMultiplier="1.3" android:padding="15dp" android:text="Фонарные тени\nСвети по ним включениями фонаря. Каждая отдельная вспышка рядом снимает 1 жизнь." android:textColor="#D8E2F3" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/rule_bg" android:lineSpacingMultiplier="1.3" android:padding="15dp" android:text="Лазерные пауки\nПроведи красной или зелёной лазерной точкой сквозь монстра, как разрезом. Одна проведённая линия снимает 1 жизнь." android:textColor="#D8E2F3" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/rule_bg" android:lineSpacingMultiplier="1.3" android:padding="15dp" android:text="Выжить 5 минут\nУ тебя 3 жизни. Если монстр добрался вплотную — минус жизнь, монстр исчезает." android:textColor="#D8E2F3" android:textSize="15sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="horizontal">
                <Button android:id="@+id/startBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:layout_weight="1" android:background="@drawable/button_primary" android:padding="14dp" android:text="Начать игру" android:textColor="#06101B" android:textSize="17sp" android:textStyle="bold" />
                <Button android:id="@+id/calibrateBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/button_secondary" android:padding="14dp" android:text="Калибровать датчики" android:textColor="#EDF2FF" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:lineSpacingMultiplier="1.35" android:text="Держи телефон перед собой и нажми «Калибровать датчики», затем начинай игру. Поворачивайся вокруг себя. Если датчики недоступны, веди палец по экрану." android:textColor="#9AA7BD" android:textSize="14sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Версия 1.0 · Native Kotlin" android:textColor="#9AA7BD" android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/endPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_margin="14dp" android:background="@drawable/panel_bg" android:orientation="vertical" android:padding="26dp" android:visibility="gone">
        <TextView android:id="@+id/endTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Конец игры" android:textColor="#EEF2FF" android:textSize="36sp" android:textStyle="bold" />
        <TextView android:id="@+id/endStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingMultiplier="1.35" android:textColor="#CBD5E1" android:textSize="17sp" />
        <Button android:id="@+id/restartBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/button_primary" android:padding="14dp" android:text="Играть снова" android:textColor="#06101B" android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/toastText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="24dp" android:background="@drawable/toast_bg" android:paddingLeft="16dp" android:paddingTop="12dp" android:paddingRight="16dp" android:paddingBottom="12dp" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:visibility="gone" />
</FrameLayout>
